{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/500/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/invites/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/invites/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/menu/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/menu/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/vendors/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/search\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/stall/join/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/stall/verify-invite/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/sync-meili\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/api/vendors/create\\.json$",
			"dest": "_render"
		},
		{
			"src": "^/offline/?$",
			"dest": "_render"
		},
		{
			"src": "^/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/stall/?$",
			"dest": "_render"
		},
		{
			"src": "^/stall-join/?$",
			"dest": "_render"
		},
		{
			"src": "^/v/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}