# NITKKR Food - Environment Variables Template
# Copy to .env.local and fill in your values

# Admin Authentication
ADMIN_SECRET=your-super-secret-admin-key-change-in-production

# Database (Local Development - libSQL/SQLite)
# For local development, use file-based SQLite
DATABASE_URL=file:db/local.db

# For production (Cloudflare D1), use:
# DATABASE_URL=your-d1-database-binding

# Optional: Cloudflare KV Namespace ID for sessions (production only)
# KV_NAMESPACE_ID=your-kv-namespace-id

# Optional: Meilisearch (if re-enabled)
# MEILI_HOST=http://localhost:7700
# MEILI_MASTER_KEY=masterKey

# Optional: Cloudinary for images
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: Analytics
# PLAUSIBLE_DOMAIN=
# GOOGLE_ANALYTICS_ID=