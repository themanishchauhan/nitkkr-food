# NITKKR Food - Environment Variables
# Copy to .env and fill in your values

# Database (PostgreSQL - Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Meilisearch (Full-text search)
# Local Docker: http://localhost:7700
# Meilisearch Cloud: https://your-instance.meilisearch.cloud
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey"

# Optional: Cloudinary for image optimization (referenced in Workbox config)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# Optional: Analytics
# PLAUSIBLE_DOMAIN="nitkkr-food.pages.dev"
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Optional: Feature flags
# ENABLE_ADMIN_API="true"
# ENABLE_MEILISEARCH="true"