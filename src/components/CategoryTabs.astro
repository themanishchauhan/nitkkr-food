---
interface Props {
  categories: Array<{ slug: string; name: string; icon?: string | null; [key: string]: any }>;
  menuItems: Array<{ categorySlug?: string | null; categoryName?: string | null; [key: string]: any }>;
  vendorSlug?: string;
  vendorName?: string;
  vendorPhone?: string;
  vendorWhatsApp?: string;
  isVendorOpen?: boolean;
  vendorTelLink?: string;
  vendorDisplayPhone?: string;
  vendorWhatsAppLink?: string;
  showWhatsApp?: boolean;
  whatsAppLabel?: string;
  shareUrl?: string;
  shareTitle?: string;
  shareText?: string;
  [key: string]: any;
}
const {
  categories,
  menuItems,
  vendorSlug = '',
  vendorName = '',
  vendorPhone = '',
  vendorWhatsApp = '',
  isVendorOpen = true,
  vendorTelLink = '#',
  vendorDisplayPhone = '',
  vendorWhatsAppLink = '#',
  showWhatsApp = false,
  whatsAppLabel = 'Order on WhatsApp',
  shareUrl = '',
  shareTitle = 'Orandus',
  shareText = 'Check out this menu on Orandus'
} = Astro.props;
---

<script is:inline src="/scripts/search-engine.js"></script>
<script is:inline define:vars={{ initialCategories: categories, initialMenuItems: menuItems, shareUrlVal: shareUrl, shareTitleVal: shareTitle, shareTextVal: shareText, vendorSlugVal: vendorSlug, vendorNameVal: vendorName, vendorPhoneVal: vendorPhone, vendorWhatsAppVal: vendorWhatsApp, isVendorOpenVal: isVendorOpen }}>
  window.__VENDOR_MENU_CONFIG__ = { 
    initialCategories, 
    initialMenuItems, 
    shareUrlVal, 
    shareTitleVal, 
    shareTextVal,
    vendorSlug: vendorSlugVal,
    vendorName: vendorNameVal,
    vendorPhone: vendorPhoneVal,
    vendorWhatsApp: vendorWhatsAppVal,
    isVendorOpen: isVendorOpenVal
  };
</script>

<div
  x-data="categoryTabsComponent(window.__VENDOR_MENU_CONFIG__)"
  x-init="init()"
  class="mb-8"
>
  <!-- Menu Header -->
  <div class="mb-4">
    <h2 class="font-display text-xl font-extrabold text-slate-900 flex items-center gap-2">
      <span>🍽️</span>
      <span>Menu</span>
      <span class="text-sm font-bold text-slate-500 font-body">
        &nbsp;(<span x-text="searchQuery.trim() ? displayedItems.length + ' of ' + totalCount : totalCount">{menuItems.length}</span>)
      </span>
    </h2>
    <p class="text-xs text-slate-500 mt-0.5">Explore dishes, tap any dish to view ingredients & student reviews</p>
  </div>

  <!-- Horizontal Category Tabs -->
  <div class="flex gap-2 overflow-x-auto pb-3 mb-5 px-4 sm:px-0 scrollbar-none" role="tablist" aria-label="Menu categories">
    <button
      @click="activeCat='all'; displayLimit = 20"
      :class="activeCat==='all' ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
      class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer"
      role="tab"
      :aria-selected="activeCat==='all'"
    >
      All (<span x-text="getCatCount('all')">{menuItems.length}</span>)
    </button>
    <template x-for="cat in visibleCategories" :key="cat.slug">
      <button
        @click="activeCat=cat.slug; displayLimit = 20"
        :class="activeCat===cat.slug ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
        class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer flex items-center gap-1.5"
        role="tab"
        :aria-selected="activeCat===cat.slug"
      >
        <span x-text="cat.icon" aria-hidden="true"></span>
        <span x-text="cat.name"></span>
        <span class="text-[10px] opacity-80" x-text="'(' + getCatCount(cat.slug) + ')'"></span>
      </button>
    </template>
  </div>

  <!-- Minimalist & Clutter-Free Menu Items List -->
  <div class="space-y-2.5 pb-28">
    <template x-for="item in visibleItems" :key="item.id">
      <div
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 transform scale-98"
        x-transition:enter-end="opacity-100 transform scale-100"
        @click="openDetail(item)"
        class="bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-3.5 flex items-center justify-between gap-3
               hover:border-nitkkr-orange hover:shadow-md transition-all duration-200 cursor-pointer group select-none active:scale-[0.99]"
      >
        <!-- Left: Dish Thumbnail Image -->
        <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-100">
          <img
            :src="getThumbnailUrl(item.image, 128)"
            :alt="item.name"
            width="64"
            height="64"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Middle: Veg/Non-Veg icon + Dish Name + Subtitle -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1.5 min-w-0">
            <!-- Veg / Egg / Non-Veg Indicator (Colorblind-Safe: Circle / Egg / Triangle) -->
            <span
              class="w-3.5 h-3.5 rounded-[3px] border-[1.5px] bg-white flex items-center justify-center flex-shrink-0"
              :class="{
                'border-emerald-600': getItemDiet(item) === 'veg',
                'border-amber-600': getItemDiet(item) === 'egg',
                'border-rose-700': getItemDiet(item) === 'nonveg'
              }"
              :title="getItemDiet(item) === 'veg' ? 'Pure Veg' : (getItemDiet(item) === 'egg' ? 'Contains Egg' : 'Non-Veg')"
              :aria-label="getItemDiet(item) === 'veg' ? 'Pure Veg' : (getItemDiet(item) === 'egg' ? 'Contains Egg' : 'Non-Veg')"
            >
              <!-- Pure Veg: Circle -->
              <template x-if="getItemDiet(item) === 'veg'">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              </template>
              <!-- Egg: Oval / Egg shape -->
              <template x-if="getItemDiet(item) === 'egg'">
                <svg class="w-2 h-2 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                </svg>
              </template>
              <!-- Non-Veg: Upward Triangle -->
              <template x-if="getItemDiet(item) === 'nonveg'">
                <svg class="w-2 h-2 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                  <polygon points="5,1 9.5,8.5 0.5,8.5" />
                </svg>
              </template>
            </span>

            <h3 class="font-bold text-sm sm:text-base text-slate-900 truncate group-hover:text-nitkkr-orange transition-colors" x-text="item.name"></h3>
          </div>

          <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
            <span class="truncate" x-text="item.categoryName || 'Campus Fast Food'"></span>
            <template x-if="item.avgRating">
              <span class="inline-flex items-center gap-0.5 text-amber-600 font-bold text-[11px]">
                <span>★</span>
                <span x-text="item.avgRating"></span>
              </span>
            </template>
          </div>
        </div>

        <!-- Right: Bold Price + Action Button (Add to Cart or Stepper) -->
        <div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">
          <span class="text-slate-900 font-extrabold text-sm sm:text-base whitespace-nowrap" x-text="'₹' + Number(item.price).toFixed(0)"></span>

          <!-- If Not in Cart: Compact "+ Add" Button -->
          <template x-if="getItemCartQuantity(item.id) === 0">
            <button
              type="button"
              @click.stop="addToCart(item)"
              class="h-8 px-2.5 sm:px-3 rounded-xl bg-amber-50 hover:bg-amber-100/90 active:scale-95 text-amber-800 font-bold text-xs border border-amber-300/60 flex items-center gap-1 transition-all shadow-2xs cursor-pointer select-none"
              title="Add dish to order"
              aria-label="Add to cart"
            >
              <span class="text-sm leading-none font-black text-nitkkr-orange">+</span>
              <span class="font-extrabold">Add</span>
            </button>
          </template>

          <!-- If in Cart: Accessible Stepper [- qty +] -->
          <template x-if="getItemCartQuantity(item.id) > 0">
            <div
              @click.stop
              class="h-8 px-1 rounded-xl bg-nitkkr-orange text-white font-extrabold text-xs flex items-center gap-1.5 shadow-sm shadow-nitkkr-orange/30 select-none"
            >
              <button
                type="button"
                @click.stop="decrementCartItem(item.id)"
                class="w-6 h-6 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 transition-all cursor-pointer text-sm font-black"
                aria-label="Decrease quantity"
              >
                −
              </button>
              <span class="min-w-[14px] text-center font-black" x-text="getItemCartQuantity(item.id)"></span>
              <button
                type="button"
                @click.stop="addToCart(item)"
                class="w-6 h-6 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 transition-all cursor-pointer text-sm font-black"
                aria-label="Increase quantity"
              >
                +
              </button>
            </div>
          </template>
        </div>
      </div>
    </template>

    <!-- Load More Pagination Button -->
    <template x-if="displayedItems.length > visibleItems.length">
      <div class="text-center pt-4 pb-2">
        <p class="text-[11px] font-semibold text-slate-400 mb-2" x-text="`Showing ${visibleItems.length} of ${displayedItems.length} dishes`"></p>
        <button
          type="button"
          @click="loadMore()"
          class="px-6 py-2.5 bg-white border border-slate-200 hover:border-nitkkr-orange hover:text-nitkkr-orange text-slate-800 font-bold text-xs rounded-2xl shadow-xs transition-all active:scale-95 cursor-pointer"
        >
          Load More
        </button>
      </div>
    </template>
  </div>

  <!-- Empty Search / Category State -->
  <div
    x-show="displayedItems.length === 0"
    x-cloak
    class="text-center py-12 text-nitkkr-gray bg-white rounded-2xl border border-nitkkr-orange/20 p-6 mt-3"
  >
    <p class="text-3xl mb-2">🔍</p>
    <p class="text-base font-bold text-nitkkr-dark" x-text="searchQuery.trim() ? 'No dishes match \'' + searchQuery + '\'' : 'No dishes in this category'"></p>
    <p class="text-xs mt-1 text-slate-400" x-text="searchQuery.trim() ? 'Try typing a different item name like maggi, chai, noodles...' : 'Select another category tab above to see more items'"></p>
    <button
      type="button"
      x-show="searchQuery.trim() || activeCat !== 'all'"
      @click="searchQuery = ''; searchExpanded = false; activeCat = 'all'; displayLimit = 20"
      class="mt-3 px-4 py-1.5 bg-nitkkr-orange/10 hover:bg-nitkkr-orange/20 text-nitkkr-orange text-xs font-bold rounded-xl transition-colors cursor-pointer"
    >
      Reset Filters
    </button>
  </div>

  <!-- 🌟 Dish Detail Popup Modal (Appears on click) -->
  <div
    x-show="showDetailModal && selectedItem"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
    @click.self="showDetailModal = false"
    @keydown.escape.window="showDetailModal = false"
  >
    <template x-if="selectedItem">
      <div
        x-transition:enter="transition ease-out duration-300 transform"
        x-transition:enter-start="scale-95 translate-y-4 opacity-0"
        x-transition:enter-end="scale-100 translate-y-0 opacity-100"
        class="bg-white rounded-3xl max-w-md w-full max-h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-amber-200/50 space-y-0 relative text-slate-900"
      >
        <!-- Modal Close Button -->
        <button
          @click="showDetailModal = false"
          class="absolute top-3.5 right-3.5 z-20 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 transition-colors backdrop-blur-xs cursor-pointer font-bold"
          aria-label="Close details"
        >
          ✕
        </button>

        <!-- Large Dish Image Cover -->
        <div class="relative w-full h-44 sm:h-52 bg-slate-100 overflow-hidden flex-shrink-0">
          <img
            :src="getThumbnailUrl(selectedItem.image, 600)"
            :alt="selectedItem.name"
            class="w-full h-full object-cover"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold shadow-md"
              :class="{
                'bg-emerald-700 text-white': getItemDiet(selectedItem) === 'veg',
                'bg-amber-600 text-white': getItemDiet(selectedItem) === 'egg',
                'bg-rose-700 text-white': getItemDiet(selectedItem) === 'nonveg'
              }"
            >
              <!-- Shape icon for colorblind accessibility: Circle for Veg, Egg/Oval for Egg, Triangle for Non-Veg -->
              <span class="w-3.5 h-3.5 rounded-xs bg-white flex items-center justify-center flex-shrink-0" :class="{
                'border border-emerald-600': getItemDiet(selectedItem) === 'veg',
                'border border-amber-600': getItemDiet(selectedItem) === 'egg',
                'border border-rose-600': getItemDiet(selectedItem) === 'nonveg'
              }">
                <template x-if="getItemDiet(selectedItem) === 'veg'">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                </template>
                <template x-if="getItemDiet(selectedItem) === 'egg'">
                  <svg class="w-2 h-2 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                  </svg>
                </template>
                <template x-if="getItemDiet(selectedItem) === 'nonveg'">
                  <svg class="w-2 h-2 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                    <polygon points="5,1 9.5,8.5 0.5,8.5" />
                  </svg>
                </template>
              </span>
              <span x-text="getItemDiet(selectedItem) === 'veg' ? 'Pure Veg' : (getItemDiet(selectedItem) === 'egg' ? 'Contains Egg' : 'Non-Veg')"></span>
            </span>

            <span class="text-2xl font-black text-white drop-shadow-md" x-text="'₹' + Number(selectedItem.price).toFixed(0)"></span>
          </div>
        </div>

        <!-- Modal Body Content -->
        <div class="p-4 sm:p-5 space-y-3.5 overflow-y-auto flex-1">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h2 class="font-display text-xl sm:text-2xl font-extrabold text-slate-900" x-text="selectedItem.name"></h2>
            </div>
            <p class="text-xs text-slate-400 mt-0.5" x-text="selectedItem.categoryName || 'Fast Food'"></p>
          </div>

          <!-- Description -->
          <div class="bg-amber-50/50 rounded-2xl p-3.5 border border-amber-200/50">
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed" x-text="selectedItem.description || 'Freshly prepared campus specialty made with authentic ingredients.'"></p>
          </div>

          <!-- Tags -->
          <template x-if="selectedItem.tags && selectedItem.tags.length > 0">
            <div class="flex flex-wrap gap-1.5 items-center">
              <span class="text-[11px] font-bold text-slate-400 mr-1">Tags:</span>
              <template x-for="tag in selectedItem.tags" :key="tag">
                <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg" x-text="'#' + tag"></span>
              </template>
            </div>
          </template>

          <!-- Reviews / Ratings & Action -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-2">
              <span class="text-amber-500 text-lg">★</span>
              <div>
                <p class="text-xs font-extrabold text-slate-900" x-text="selectedItem.avgRating ? selectedItem.avgRating + ' / 5.0' : 'No ratings yet'"></p>
                <p class="text-[10px] text-slate-400" x-text="selectedItem.reviewCount > 0 ? selectedItem.reviewCount + ' student reviews' : 'Be the first to rate'"></p>
              </div>
            </div>

            <div class="flex items-center gap-1.5 ml-auto">
              <template x-if="selectedItem.reviewCount > 0">
                <button
                  type="button"
                  @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'read' } }))"
                  class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                >
                  <span>💬</span> Reviews (<span x-text="selectedItem.reviewCount"></span>)
                </button>
              </template>

              <button
                type="button"
                @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'write' } }))"
                class="px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95"
              >
                <span>⭐</span> Rate Dish
              </button>
            </div>
          </div>

          <!-- Cart Action inside Modal -->
          <div class="pt-3 border-t border-slate-100">
            <template x-if="getItemCartQuantity(selectedItem.id) === 0">
              <button
                type="button"
                @click="addToCart(selectedItem)"
                class="w-full py-3 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 text-white font-extrabold text-sm rounded-2xl shadow-md active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>🛒</span>
                <span>Add to Order • ₹<span x-text="Number(selectedItem.price).toFixed(0)"></span></span>
              </button>
            </template>
            <template x-if="getItemCartQuantity(selectedItem.id) > 0">
              <div class="w-full flex items-center justify-between bg-amber-50 p-2 sm:p-2.5 rounded-2xl border border-amber-200/80">
                <div class="flex items-center gap-2 pl-2">
                  <span class="text-xs font-bold text-amber-900">In Order:</span>
                  <span class="text-sm font-black text-nitkkr-orange" x-text="'₹' + (Number(selectedItem.price) * getItemCartQuantity(selectedItem.id)).toFixed(0)"></span>
                </div>
                <div class="flex items-center gap-2 bg-nitkkr-orange text-white rounded-xl px-2 py-1 shadow-xs">
                  <button
                    type="button"
                    @click="decrementCartItem(selectedItem.id)"
                    class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 font-black text-base cursor-pointer"
                    aria-label="Decrease quantity"
                  >
                    −
                  </button>
                  <span class="font-black text-sm min-w-[18px] text-center" x-text="getItemCartQuantity(selectedItem.id)"></span>
                  <button
                    type="button"
                    @click="addToCart(selectedItem)"
                    class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 font-black text-base cursor-pointer"
                    aria-label="Increase quantity"
                  >
                    +
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>

      </div>
    </template>
  </div>

  <!-- 📱 Sleek Floating Island Bottom Dock (Efficient, Modern & Responsive) -->
  <div class="fixed bottom-[calc(0.75rem+env(safe-area-inset-bottom,0px))] sm:bottom-5 left-0 right-0 z-40 px-4 pointer-events-none">

    <div class="max-w-md mx-auto bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-2xl p-1.5 sm:p-2 shadow-[0_8px_30px_rgb(0,0,0,0.12)] pointer-events-auto transition-all">
      
      <!-- STATE 1: Default Action Row (Call [flex-1] + Share [flex-1] + Search [icon-only]) -->
      <div
        x-show="!searchExpanded && !searchQuery.trim()"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 scale-98"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex items-center gap-2"
      >
        <!-- 1. 📞 Call Button (Equal flex-1) -->
        <a
          href={vendorTelLink}
          class="flex-1 py-2.5 sm:py-3 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 active:scale-98 text-white rounded-xl font-extrabold text-xs sm:text-sm text-center transition-all flex items-center justify-center gap-2 shadow-sm shadow-nitkkr-orange/25 cursor-pointer"
          aria-label="Call vendor"
        >
          <span class="text-base">📞</span>
          <span>Call</span>
        </a>

        <!-- 2. 🔗 Share Button (Equal flex-1) -->
        <button
          type="button"
          @click="shareVendor()"
          class="flex-1 py-2.5 sm:py-3 px-4 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-800 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer border border-slate-200/60 shadow-2xs"
          aria-label="Share vendor"
          title="Share vendor menu"
        >
          <span class="text-base">🔗</span>
          <span>Share</span>
        </button>

        {showWhatsApp && (
          <a
            href={vendorWhatsAppLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 sm:w-11 sm:h-11 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 active:scale-95 text-white rounded-xl flex items-center justify-center transition-all shadow-sm shadow-emerald-500/20 flex-shrink-0"
            aria-label={whatsAppLabel}
            title={whatsAppLabel}
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.18.51-.013 1.745-.87 2.014-1.762.27-.9.07-1.653-.599-2.185C18.918 15.288 17.787 14.532 17.472 14.382z"/>
            </svg>
          </a>
        )}

        <!-- 3. 🔍 Expand Search Button (Icon-Only at the end) -->
        <button
          type="button"
          @click="searchExpanded = true; $nextTick(() => { const el = $refs.menuSearchInput; if (el) { el.focus(); } })"
          class="w-10 h-10 sm:w-11 sm:h-11 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 rounded-xl flex items-center justify-center transition-all cursor-pointer border border-slate-200/60 shadow-2xs flex-shrink-0"
          aria-label="Search menu"
          title="Search in menu"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>

      <!-- STATE 2: Expanded Inline Search Bar (Pixel-Perfect with Clear & Done) -->
      <div
        x-show="searchExpanded || searchQuery.trim().length > 0"
        x-cloak
        x-transition:enter="transition ease-out duration-150 transform"
        x-transition:enter-start="opacity-0 scale-98"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex items-center gap-1.5 sm:gap-2"
      >
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            x-ref="menuSearchInput"
            x-model.debounce.150ms="searchQuery"
            placeholder="Search dishes (e.g. maggi, chai)..."
            class="w-full pl-9 pr-8 py-2 text-xs sm:text-sm bg-slate-100 hover:bg-slate-100/80 focus:bg-white border border-slate-200 rounded-xl font-medium text-slate-900 focus:outline-hidden focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all"
            @input="displayLimit = 20"
            @keydown.escape="searchQuery = ''; searchExpanded = false; displayLimit = 20"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            x-cloak
            @click="searchQuery = ''; $refs.menuSearchInput?.focus()"
            class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-700 cursor-pointer"
            aria-label="Clear search"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <button
          type="button"
          @click="searchQuery = ''; searchExpanded = false"
          class="py-2 px-3 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold text-xs rounded-xl border border-slate-200/60 shadow-2xs cursor-pointer transition-all flex-shrink-0"
        >
          ✕ Close
        </button>
      </div>

    </div>
  </div>

  <!-- 🛒 Floating "Cart Pending" Island Bar (Sticky recovery across scroll and browsing) -->
  <div
    x-show="cartTotalCount > 0 && !showCartScreen"
    x-cloak
    x-transition:enter="transition ease-out duration-250 transform"
    x-transition:enter-start="opacity-0 translate-y-6 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-6 scale-95"
    class="fixed bottom-[calc(4.85rem+env(safe-area-inset-bottom,0px))] sm:bottom-20 left-0 right-0 z-40 px-4 pointer-events-none"
  >
    <div
      class="max-w-md mx-auto bg-slate-900/95 backdrop-blur-xl text-white border border-slate-700/80 rounded-2xl p-2.5 sm:p-3 shadow-[0_12px_40px_rgb(0,0,0,0.35)] pointer-events-auto flex items-center justify-between gap-3 cursor-pointer select-none"
      @click="openCartScreen()"
    >
      <!-- Left: Cart Count & Total Price -->
      <div class="flex items-center gap-2.5 min-w-0 pl-1">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center flex-shrink-0 text-amber-400 font-black text-base shadow-2xs">
          🛒
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="font-black text-xs sm:text-sm text-white" x-text="cartTotalCount + (cartTotalCount === 1 ? ' item' : ' items')"></span>
            <span class="text-slate-400 text-xs">•</span>
            <span class="font-extrabold text-amber-400 text-sm sm:text-base" x-text="'₹' + cartTotalPrice"></span>
          </div>
          <p class="text-[11px] text-slate-300 truncate flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Pending order at</span>
            <span class="font-bold text-white" x-text="vendorInfo.name || 'Vendor'"></span>
          </p>
        </div>
      </div>

      <!-- Right: Review Order CTA -->
      <button
        type="button"
        @click.stop="openCartScreen()"
        class="py-2.5 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-500 hover:from-nitkkr-orange-dark hover:to-amber-600 active:scale-95 text-white font-extrabold text-xs sm:text-sm rounded-xl shadow-md flex items-center gap-1.5 flex-shrink-0 cursor-pointer transition-all"
        aria-label="Review pending order"
      >
        <span>Review Order</span>
        <span class="text-xs font-black">›</span>
      </button>
    </div>
  </div>

  <!-- 📱 FULL-SCREEN CHECKOUT VIEW (Competitor-Grade Native App UX) -->
  <div
    x-show="showCartScreen"
    x-cloak
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-4"
    class="fixed inset-0 z-50 overflow-y-auto bg-slate-50 min-h-screen flex flex-col text-slate-900"
    @keydown.escape.window="closeCartScreen()"
  >
    <!-- Top Sticky Navigation Bar -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30 px-4 py-3 sm:py-3.5 shadow-2xs">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
        <!-- Back Button -->
        <button
          type="button"
          @click="closeCartScreen()"
          class="flex items-center gap-1.5 text-xs sm:text-sm font-extrabold text-slate-700 hover:text-nitkkr-orange transition-colors active:scale-95 cursor-pointer py-1.5 px-2 -ml-2 rounded-xl hover:bg-slate-100"
          aria-label="Back to menu"
        >
          <span class="text-base font-bold">←</span>
          <span>Back to Menu</span>
        </button>

        <!-- Center Vendor Header -->
        <div class="text-center min-w-0 flex-1 px-2">
          <h1 class="text-sm sm:text-base font-black text-slate-900 leading-tight truncate" x-text="vendorInfo.name || 'Vendor'"></h1>
          <p class="text-[11px] font-semibold text-emerald-600 flex items-center justify-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Direct Campus Ordering</span>
          </p>
        </div>

        <!-- Right Action: Clear Cart -->
        <div class="flex items-center gap-1">
          <template x-if="cartItems.length > 0 && !orderPlaced">
            <button
              type="button"
              @click="if (confirm('Clear all items from your order?')) { clearCart(); closeCartScreen(); }"
              class="text-xs text-slate-400 hover:text-rose-600 font-bold px-2.5 py-1.5 rounded-lg hover:bg-rose-50 transition-colors cursor-pointer"
            >
              Clear
            </button>
          </template>
        </div>
      </div>
    </header>

    <!-- Main Full-Screen Body Container -->
    <main class="max-w-2xl w-full mx-auto px-4 py-5 sm:py-6 space-y-4 pb-36 flex-1">

      <!-- STATE 1: Active Order Review -->
      <template x-if="!orderPlaced">
        <div class="space-y-4">
          
          <!-- 1. 📍 Campus Delivery Location Card (3 Quick-Touch Chips + Manual Input) -->
          <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xs space-y-3">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-1.5">
                  <span>📍</span>
                  <span>Delivery Location</span>
                </h2>
                <span class="text-[10px] uppercase font-extrabold tracking-wider px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200">
                  Required
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-1">Tap a quick campus gate, or type your specific hostel / room below:</p>
            </div>

            <!-- 3 Easy-Touch Quick Location Chips -->
            <div class="grid grid-cols-3 gap-2 sm:gap-2.5">
              <!-- Back Gate -->
              <button
                type="button"
                @click="setDeliveryLocation('Back Gate')"
                :class="deliveryLocation.trim() === 'Back Gate' 
                  ? 'bg-nitkkr-orange text-white border-nitkkr-orange shadow-sm font-black ring-2 ring-nitkkr-orange/30' 
                  : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 font-bold'"
                class="p-2.5 sm:p-3 rounded-2xl border text-center transition-all cursor-pointer flex flex-col items-center justify-center min-h-[56px] active:scale-95"
              >
                <span class="text-base mb-0.5" aria-hidden="true">🚪</span>
                <span class="text-xs leading-tight font-extrabold">Back Gate</span>
                <span class="text-[10px] opacity-75 font-normal">Gate 2</span>
              </button>

              <!-- Front Gate -->
              <button
                type="button"
                @click="setDeliveryLocation('Front Gate')"
                :class="deliveryLocation.trim() === 'Front Gate' 
                  ? 'bg-nitkkr-orange text-white border-nitkkr-orange shadow-sm font-black ring-2 ring-nitkkr-orange/30' 
                  : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 font-bold'"
                class="p-2.5 sm:p-3 rounded-2xl border text-center transition-all cursor-pointer flex flex-col items-center justify-center min-h-[56px] active:scale-95"
              >
                <span class="text-base mb-0.5" aria-hidden="true">🏛️</span>
                <span class="text-xs leading-tight font-extrabold">Front Gate</span>
                <span class="text-[10px] opacity-75 font-normal">Main Gate 1</span>
              </button>

              <!-- Girls Hostel -->
              <button
                type="button"
                @click="setDeliveryLocation('Girls Hostel')"
                :class="deliveryLocation.trim() === 'Girls Hostel' 
                  ? 'bg-nitkkr-orange text-white border-nitkkr-orange shadow-sm font-black ring-2 ring-nitkkr-orange/30' 
                  : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 font-bold'"
                class="p-2.5 sm:p-3 rounded-2xl border text-center transition-all cursor-pointer flex flex-col items-center justify-center min-h-[56px] active:scale-95"
              >
                <span class="text-base mb-0.5" aria-hidden="true">🏢</span>
                <span class="text-xs leading-tight font-extrabold">Girls Hostel</span>
                <span class="text-[10px] opacity-75 font-normal">Kalpana C.</span>
              </button>
            </div>

            <!-- Manual Location Input with Clear Button -->
            <div class="pt-1">
              <label for="manualLocationInput" class="block text-[11px] font-bold text-slate-600 mb-1">
                Custom Address / Room / Landmark Details:
              </label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <input
                  id="manualLocationInput"
                  type="text"
                  x-model="deliveryLocation"
                  placeholder="e.g. Back Gate, Hostel 7 Room 214, Library Lawn..."
                  class="w-full pl-10 pr-9 py-2.5 sm:py-3 text-xs sm:text-sm bg-slate-50 hover:bg-slate-50/80 focus:bg-white border border-slate-200 rounded-2xl font-semibold text-slate-900 focus:outline-hidden focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all shadow-2xs"
                />
                <button
                  type="button"
                  x-show="deliveryLocation"
                  @click="deliveryLocation = ''"
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-700 cursor-pointer text-sm font-bold"
                  aria-label="Clear location"
                >
                  ✕
                </button>
              </div>
            </div>
          </section>

          <!-- 2. 🍱 Order Items Card (Zomato/Swiggy Stepper Layout) -->
          <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xs space-y-3">
            <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
              <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-1.5">
                <span>🍽️</span>
                <span>Items Ordered</span>
                <span class="text-xs font-bold text-slate-400" x-text="'(' + cartTotalCount + ')'"></span>
              </h2>
              <button
                type="button"
                @click="closeCartScreen()"
                class="text-xs text-nitkkr-orange hover:underline font-extrabold flex items-center gap-1 cursor-pointer"
              >
                <span>+ Add more items</span>
              </button>
            </div>

            <template x-if="cartItems.length === 0">
              <div class="text-center py-10 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                <p class="text-3xl mb-1">🍱</p>
                <p class="text-xs font-bold text-slate-600">Your cart is empty</p>
                <button
                  type="button"
                  @click="closeCartScreen()"
                  class="mt-3 px-4 py-2 bg-nitkkr-orange text-white font-bold text-xs rounded-xl shadow-xs"
                >
                  Explore Menu
                </button>
              </div>
            </template>

            <!-- Items List -->
            <div class="divide-y divide-slate-100">
              <template x-for="it in cartItems" :key="it.id">
                <div class="py-3 first:pt-1 last:pb-1 flex items-center justify-between gap-3">
                  <!-- Dish Diet Icon & Name -->
                  <div class="flex items-center gap-2.5 min-w-0 flex-1">
                    <span
                      class="w-4 h-4 rounded-[3px] border-[1.5px] bg-white flex items-center justify-center flex-shrink-0"
                      :class="{
                        'border-emerald-600': it.diet === 'veg',
                        'border-amber-600': it.diet === 'egg',
                        'border-rose-700': it.diet === 'nonveg'
                      }"
                    >
                      <template x-if="it.diet === 'veg'">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                      </template>
                      <template x-if="it.diet === 'egg'">
                        <svg class="w-2.5 h-2.5 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                          <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                        </svg>
                      </template>
                      <template x-if="it.diet === 'nonveg'">
                        <svg class="w-2.5 h-2.5 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                          <polygon points="5,1 9.5,8.5 0.5,8.5" />
                        </svg>
                      </template>
                    </span>

                    <div class="min-w-0">
                      <p class="font-extrabold text-xs sm:text-sm text-slate-900 truncate" x-text="it.name"></p>
                      <p class="text-[11px] text-slate-400 font-medium" x-text="'₹' + it.price + ' per dish'"></p>
                    </div>
                  </div>

                  <!-- Stepper -->
                  <div class="flex items-center gap-1.5 bg-slate-100 border border-slate-200 rounded-xl p-1 shadow-2xs flex-shrink-0">
                    <button
                      type="button"
                      @click="decrementCartItem(it.id)"
                      class="w-7 h-7 rounded-lg bg-white hover:bg-slate-200 active:scale-90 text-slate-800 flex items-center justify-center font-black text-sm cursor-pointer transition-all shadow-2xs"
                      aria-label="Decrease quantity"
                    >
                      −
                    </button>
                    <span class="min-w-[18px] text-center font-black text-xs sm:text-sm text-slate-900" x-text="it.quantity"></span>
                    <button
                      type="button"
                      @click="addToCart(it)"
                      class="w-7 h-7 rounded-lg bg-white hover:bg-slate-200 active:scale-90 text-slate-800 flex items-center justify-center font-black text-sm cursor-pointer transition-all shadow-2xs"
                      aria-label="Increase quantity"
                    >
                      +
                    </button>
                  </div>

                  <!-- Subtotal -->
                  <span class="font-black text-xs sm:text-sm text-slate-900 min-w-[54px] text-right" x-text="'₹' + (it.price * it.quantity)"></span>
                </div>
              </template>
            </div>
          </section>

          <!-- 3. 📝 Cooking & Delivery Notes Card (Competitor Best Practice) -->
          <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xs space-y-2.5">
            <h2 class="text-xs sm:text-sm font-black text-slate-900 flex items-center gap-1.5">
              <span>📝</span>
              <span>Instructions for Bhaiya (Optional)</span>
            </h2>

            <!-- Quick Chips for common notes -->
            <div class="flex flex-wrap gap-1.5">
              <button
                type="button"
                @click="addQuickNote('Make it spicy 🌶️')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 text-[11px] font-bold transition-colors cursor-pointer"
              >
                🌶️ Make it spicy
              </button>
              <button
                type="button"
                @click="addQuickNote('Extra onions 🧅')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 text-[11px] font-bold transition-colors cursor-pointer"
              >
                🧅 Extra onions
              </button>
              <button
                type="button"
                @click="addQuickNote('Less oil 🥢')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 text-[11px] font-bold transition-colors cursor-pointer"
              >
                🥢 Less oil
              </button>
              <button
                type="button"
                @click="addQuickNote('Pack separately 🥡')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-100 text-slate-700 hover:text-amber-800 text-[11px] font-bold transition-colors cursor-pointer"
              >
                🥡 Pack separately
              </button>
            </div>

            <input
              type="text"
              x-model="cookingNotes"
              placeholder="e.g. Please send extra tissue, extra mint chutney, keep spoons..."
              class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-900 focus:bg-white focus:outline-hidden focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 shadow-2xs transition-all"
            />
          </section>

          <!-- 4. 📱 Student Contact Credentials Card -->
          <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xs space-y-3">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h2 class="text-sm sm:text-base font-black text-slate-900 flex items-center gap-1.5">
                  <span>📱</span>
                  <span>Contact Information</span>
                </h2>
                <span
                  x-show="isPhoneValid"
                  x-cloak
                  class="text-emerald-700 font-extrabold text-[11px] flex items-center gap-0.5 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200"
                >
                  <span>✓</span> Valid Mobile
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-0.5">Used by bhaiya for arrival & handover confirmation:</p>
            </div>

            <!-- Mobile Phone Input with +91 Prefix -->
            <div>
              <label for="fullScreenPhoneInput" class="block text-[11px] font-bold text-slate-600 mb-1">
                WhatsApp / Mobile Number (Required):
              </label>
              <div class="flex rounded-2xl border border-slate-200 overflow-hidden bg-slate-50 focus-within:bg-white focus-within:border-nitkkr-orange focus-within:ring-2 focus-within:ring-nitkkr-orange/20 shadow-2xs transition-all">
                <span class="bg-slate-100 px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm font-extrabold text-slate-700 border-r border-slate-200 flex items-center">
                  +91
                </span>
                <input
                  id="fullScreenPhoneInput"
                  type="tel"
                  inputmode="numeric"
                  maxlength="10"
                  x-model="studentPhone"
                  @input="phoneError = ''"
                  placeholder="Enter 10-digit mobile number"
                  class="w-full px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-slate-900 outline-hidden bg-transparent"
                />
              </div>
              <template x-if="phoneError">
                <p class="text-[11px] text-rose-600 font-bold mt-1" x-text="phoneError"></p>
              </template>
            </div>

            <!-- Student Name (Optional) -->
            <div>
              <label for="fullScreenNameInput" class="block text-[11px] font-bold text-slate-600 mb-1">
                Your Name (Optional):
              </label>
              <input
                id="fullScreenNameInput"
                type="text"
                x-model="studentName"
                placeholder="e.g. Rahul, Priya, Amit"
                class="w-full px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm bg-slate-50 focus:bg-white rounded-2xl border border-slate-200 outline-hidden font-semibold text-slate-900 focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 shadow-2xs transition-all"
              />
            </div>
          </section>

          <!-- 5. 🧾 Bill Breakdown Card (Transparent & Trust-Building) -->
          <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/90 shadow-xs space-y-2.5">
            <h2 class="text-xs sm:text-sm font-black text-slate-900 flex items-center gap-1.5 border-b border-slate-100 pb-2">
              <span>🧾</span>
              <span>Bill Details</span>
            </h2>

            <div class="space-y-1.5 text-xs text-slate-600">
              <div class="flex items-center justify-between">
                <span>Items Subtotal:</span>
                <span class="font-bold text-slate-800" x-text="'₹' + cartTotalPrice"></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1">
                  <span>Campus Handover:</span>
                  <span class="text-[10px] bg-emerald-100 text-emerald-800 px-1 rounded font-bold">FREE</span>
                </span>
                <span class="font-bold text-emerald-600">₹0</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-1">
                  <span>Orandus Platform Fee:</span>
                  <span class="text-[10px] bg-emerald-100 text-emerald-800 px-1 rounded font-bold">0% COMMISSION</span>
                </span>
                <span class="font-bold text-emerald-600">₹0</span>
              </div>
            </div>

            <div class="pt-2.5 border-t border-slate-200 flex items-center justify-between">
              <span class="font-black text-sm sm:text-base text-slate-900">To Pay:</span>
              <span class="font-black text-lg sm:text-xl text-nitkkr-orange" x-text="'₹' + cartTotalPrice"></span>
            </div>

            <div class="p-2.5 bg-amber-50/80 rounded-xl border border-amber-200/80 text-[11px] text-amber-900 flex items-center gap-2">
              <span class="text-base flex-shrink-0">💡</span>
              <span>Pay directly to Bhaiya via <strong>UPI or Cash</strong> upon handover at <strong x-text="deliveryLocation || 'Selected Gate'"></strong>.</span>
            </div>
          </section>

        </div>
      </template>

      <!-- STATE 2: Order Dispatched Confirmation -->
      <template x-if="orderPlaced">
        <div class="max-w-md mx-auto py-8 text-center space-y-5">
          <div class="w-20 h-20 rounded-full bg-emerald-100 text-emerald-600 mx-auto flex items-center justify-center text-4xl font-black shadow-inner">
            ✓
          </div>
          
          <div>
            <h2 class="font-display text-2xl font-black text-slate-900">Order Sent to WhatsApp!</h2>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-sm mx-auto">
              Your formatted order ticket was sent directly to <strong class="text-slate-900" x-text="vendorInfo.name || 'Vendor'"></strong> for handover at <strong class="text-slate-900" x-text="deliveryLocation"></strong>.
            </p>
          </div>

          <!-- Urgent Bhaiya Follow-up Call Box -->
          <div class="bg-amber-50 rounded-3xl p-5 border border-amber-200 text-left space-y-3.5 shadow-sm">
            <div class="flex items-start gap-3">
              <span class="text-2xl">⚠️</span>
              <div>
                <p class="text-xs sm:text-sm font-black text-amber-950">Crucial: Call Bhaiya to Confirm</p>
                <p class="text-xs text-amber-800 mt-0.5 leading-relaxed">
                  Campus stall kitchens get extremely loud and busy. Give him a quick 10-second call to confirm he received your WhatsApp ticket and puts it on the stove immediately!
                </p>
              </div>
            </div>

            <a
              :href="'tel:' + (vendorInfo.phone || '9504316289')"
              class="w-full py-3.5 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 active:scale-98 text-white rounded-2xl font-black text-sm text-center transition-all flex items-center justify-center gap-2 shadow-md cursor-pointer"
            >
              <span>📞</span>
              <span>Call Bhaiya Now (<span x-text="vendorInfo.phone || 'Call'"></span>)</span>
            </a>
          </div>

          <div class="pt-3 flex flex-col sm:flex-row gap-2 justify-center">
            <button
              type="button"
              @click="clearCart(); closeCartScreen();"
              class="px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm rounded-2xl transition-all cursor-pointer"
            >
              Back to Menu / Start New Order
            </button>
          </div>
        </div>
      </template>

    </main>

    <!-- Sticky Bottom Checkout Action Bar (Anchored for 1-Tap Ordering) -->
    <template x-if="!orderPlaced && cartItems.length > 0">
      <footer class="fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3.5 sm:p-4 shadow-[0_-4px_25px_rgb(0,0,0,0.08)]">
        <div class="max-w-2xl mx-auto flex items-center justify-between gap-3 sm:gap-4">
          <!-- Total Price Counter -->
          <div>
            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Total to pay</p>
            <p class="text-lg sm:text-xl font-black text-slate-900" x-text="'₹' + cartTotalPrice"></p>
          </div>

          <!-- Primary Send WhatsApp CTA Button -->
          <button
            type="button"
            @click="sendWhatsAppOrder()"
            :disabled="!isPhoneValid"
            :class="isPhoneValid 
              ? 'bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-700 hover:to-green-700 text-white shadow-lg cursor-pointer active:scale-98' 
              : 'bg-slate-200 text-slate-400 cursor-not-allowed'"
            class="flex-1 py-3.5 px-4 font-black text-xs sm:text-sm rounded-2xl flex items-center justify-center gap-2 transition-all shadow-emerald-600/20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.18.51-.013 1.745-.87 2.014-1.762.27-.9.07-1.653-.599-2.185C18.918 15.288 17.787 14.532 17.472 14.382z"/>
            </svg>
            <span>Send Order to WhatsApp ›</span>
          </button>
        </div>
        
        <!-- Inline Warning Helper -->
        <p class="text-[10px] text-center text-slate-400 mt-1 max-w-2xl mx-auto" x-show="!isPhoneValid">
          ⚠️ Please enter your 10-digit mobile number above to place order
        </p>
      </footer>
    </template>
  </div>
</div>