---
interface Props {
  categories: Array<{ slug: string; name: string; icon?: string | null; [key: string]: any }>;
  menuItems: Array<{ categorySlug?: string | null; categoryName?: string | null; [key: string]: any }>;
  vendorSlug?: string;
  vendorName?: string;
  vendorPhone?: string;
  vendorWhatsApp?: string;
  isVendorOpen?: boolean;
  vendorTelLink?: string;
  vendorDisplayPhone?: string;
  vendorWhatsAppLink?: string;
  showWhatsApp?: boolean;
  whatsAppLabel?: string;
  shareUrl?: string;
  shareTitle?: string;
  shareText?: string;
  deliversTo?: string[];
  [key: string]: any;
}
const {
  categories,
  menuItems,
  vendorSlug = '',
  vendorName = '',
  vendorPhone = '',
  vendorWhatsApp = '',
  isVendorOpen = true,
  vendorTelLink = '#',
  vendorDisplayPhone = '',
  vendorWhatsAppLink = '#',
  showWhatsApp = false,
  whatsAppLabel = 'Order on WhatsApp',
  shareUrl = '',
  shareTitle = 'Orandus',
  shareText = 'Check out this menu on Orandus',
  deliversTo = []
} = Astro.props;
---

<script is:inline src="/scripts/search-engine.js"></script>
<script is:inline define:vars={{ initialCategories: categories, initialMenuItems: menuItems, shareUrlVal: shareUrl, shareTitleVal: shareTitle, shareTextVal: shareText, vendorSlugVal: vendorSlug, vendorNameVal: vendorName, vendorPhoneVal: vendorPhone, vendorWhatsAppVal: vendorWhatsApp, isVendorOpenVal: isVendorOpen, deliversToVal: deliversTo }}>
  window.__VENDOR_MENU_CONFIG__ = { 
    initialCategories, 
    initialMenuItems, 
    shareUrlVal, 
    shareTitleVal, 
    shareTextVal,
    vendorSlug: vendorSlugVal,
    vendorName: vendorNameVal,
    vendorPhone: vendorPhoneVal,
    vendorWhatsApp: vendorWhatsAppVal,
    isVendorOpen: isVendorOpenVal,
    deliversTo: deliversToVal
  };
</script>

<div
  x-data="categoryTabsComponent(window.__VENDOR_MENU_CONFIG__)"
  x-init="init()"
  class="mb-8"
>
  <!-- Menu Header -->
  <div class="mb-4">
    <h2 class="font-display text-xl font-extrabold text-slate-900 flex items-center gap-2">
      <span>🍽️</span>
      <span>Menu</span>
      <span class="text-sm font-bold text-slate-500 font-body">
        &nbsp;(<span x-text="searchQuery.trim() ? displayedItems.length + ' of ' + totalCount : totalCount">{menuItems.length}</span>)
      </span>
    </h2>
    <p class="text-xs text-slate-500 mt-0.5">Explore dishes, tap any dish to view ingredients & student reviews</p>
  </div>

  <!-- Horizontal Category Tabs -->
  <div class="flex gap-2 overflow-x-auto pb-3 mb-5 px-4 sm:px-0 scrollbar-none" role="tablist" aria-label="Menu categories">
    <button
      @click="activeCat='all'; displayLimit = 20"
      :class="activeCat==='all' ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
      class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer"
      role="tab"
      :aria-selected="activeCat==='all'"
    >
      All (<span x-text="getCatCount('all')">{menuItems.length}</span>)
    </button>
    <template x-for="cat in visibleCategories" :key="cat.slug">
      <button
        @click="activeCat=cat.slug; displayLimit = 20"
        :class="activeCat===cat.slug ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
        class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer flex items-center gap-1.5"
        role="tab"
        :aria-selected="activeCat===cat.slug"
      >
        <span x-text="cat.icon" aria-hidden="true"></span>
        <span x-text="cat.name"></span>
        <span class="text-[10px] opacity-80" x-text="'(' + getCatCount(cat.slug) + ')'"></span>
      </button>
    </template>
  </div>

  <!-- Minimalist & Clutter-Free Menu Items List -->
  <div class="space-y-2.5 pb-28">
    <template x-for="item in visibleItems" :key="item.id">
      <div
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 transform scale-98"
        x-transition:enter-end="opacity-100 transform scale-100"
        @click="openDetail(item)"
        class="bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-3.5 flex items-center justify-between gap-3
               hover:border-nitkkr-orange hover:shadow-md transition-all duration-200 cursor-pointer group select-none active:scale-[0.99]"
      >
        <!-- Left: Dish Thumbnail Image -->
        <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-100">
          <img
            :src="getThumbnailUrl(item.image, 128)"
            :alt="item.name"
            width="64"
            height="64"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Middle: Veg/Non-Veg icon + Dish Name + Subtitle -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1.5 min-w-0">
            <!-- Veg / Egg / Non-Veg Indicator (Colorblind-Safe: Circle / Egg / Triangle) -->
            <span
              class="w-3.5 h-3.5 rounded-[3px] border-[1.5px] bg-white flex items-center justify-center flex-shrink-0"
              :class="{
                'border-emerald-600': getItemDiet(item) === 'veg',
                'border-amber-600': getItemDiet(item) === 'egg',
                'border-rose-700': getItemDiet(item) === 'nonveg'
              }"
              :title="getItemDiet(item) === 'veg' ? 'Pure Veg' : (getItemDiet(item) === 'egg' ? 'Contains Egg' : 'Non-Veg')"
              :aria-label="getItemDiet(item) === 'veg' ? 'Pure Veg' : (getItemDiet(item) === 'egg' ? 'Contains Egg' : 'Non-Veg')"
            >
              <!-- Pure Veg: Circle -->
              <template x-if="getItemDiet(item) === 'veg'">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              </template>
              <!-- Egg: Oval / Egg shape -->
              <template x-if="getItemDiet(item) === 'egg'">
                <svg class="w-2 h-2 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                </svg>
              </template>
              <!-- Non-Veg: Upward Triangle -->
              <template x-if="getItemDiet(item) === 'nonveg'">
                <svg class="w-2 h-2 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                  <polygon points="5,1 9.5,8.5 0.5,8.5" />
                </svg>
              </template>
            </span>

            <h3 class="font-bold text-sm sm:text-base text-slate-900 truncate group-hover:text-nitkkr-orange transition-colors" x-text="item.name"></h3>
          </div>

          <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
            <span class="truncate" x-text="item.categoryName || 'Campus Fast Food'"></span>
            <template x-if="item.avgRating">
              <span class="inline-flex items-center gap-0.5 text-amber-600 font-bold text-[11px]">
                <span>★</span>
                <span x-text="item.avgRating"></span>
              </span>
            </template>
          </div>
        </div>

        <!-- Right: Bold Price + Action Button (Add to Cart or Stepper) -->
        <div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">
          <span class="text-slate-900 font-extrabold text-sm sm:text-base whitespace-nowrap" x-text="'₹' + Number(item.price).toFixed(0)"></span>

          <!-- When Vendor is Closed: Disabled 'Closed' Badge -->
          <template x-if="!vendorInfo.isVendorOpen">
            <span
              class="h-8 px-2.5 sm:px-3 rounded-xl bg-slate-100 text-slate-400 font-bold text-xs border border-slate-200 flex items-center select-none cursor-not-allowed"
              title="Stall is currently closed"
            >
              Closed
            </span>
          </template>

          <!-- If Vendor is Open & Not in Cart: Compact "+ Add" Button -->
          <template x-if="vendorInfo.isVendorOpen && getItemCartQuantity(item.id) === 0">
            <button
              type="button"
              @click.stop="addToCart(item)"
              class="h-8 px-2.5 sm:px-3 rounded-xl bg-amber-50 hover:bg-amber-100/90 active:scale-95 text-amber-800 font-bold text-xs border border-amber-300/60 flex items-center gap-1 transition-all shadow-2xs cursor-pointer select-none"
              title="Add dish to order"
              aria-label="Add to cart"
            >
              <span class="text-sm leading-none font-black text-nitkkr-orange">+</span>
              <span class="font-extrabold">Add</span>
            </button>
          </template>

          <!-- If Vendor is Open & in Cart: Accessible Stepper [- qty +] -->
          <template x-if="vendorInfo.isVendorOpen && getItemCartQuantity(item.id) > 0">
            <div
              @click.stop
              class="h-8 px-1 rounded-xl bg-nitkkr-orange text-white font-extrabold text-xs flex items-center gap-1.5 shadow-sm shadow-nitkkr-orange/30 select-none"
            >
              <button
                type="button"
                @click.stop="decrementCartItem(item.id)"
                class="w-6 h-6 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 transition-all cursor-pointer text-sm font-black"
                aria-label="Decrease quantity"
              >
                −
              </button>
              <span class="min-w-[14px] text-center font-black" x-text="getItemCartQuantity(item.id)"></span>
              <button
                type="button"
                @click.stop="addToCart(item)"
                class="w-6 h-6 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 transition-all cursor-pointer text-sm font-black"
                aria-label="Increase quantity"
              >
                +
              </button>
            </div>
          </template>
        </div>
      </div>
    </template>

    <!-- Load More Pagination Button -->
    <template x-if="displayedItems.length > visibleItems.length">
      <div class="text-center pt-4 pb-2">
        <p class="text-[11px] font-semibold text-slate-400 mb-2" x-text="`Showing ${visibleItems.length} of ${displayedItems.length} dishes`"></p>
        <button
          type="button"
          @click="loadMore()"
          class="px-6 py-2.5 bg-white border border-slate-200 hover:border-nitkkr-orange hover:text-nitkkr-orange text-slate-800 font-bold text-xs rounded-2xl shadow-xs transition-all active:scale-95 cursor-pointer"
        >
          Load More
        </button>
      </div>
    </template>
  </div>

  <!-- Empty Search / Category State -->
  <div
    x-show="displayedItems.length === 0"
    x-cloak
    class="text-center py-12 text-nitkkr-gray bg-white rounded-2xl border border-nitkkr-orange/20 p-6 mt-3"
  >
    <p class="text-3xl mb-2">🔍</p>
    <p class="text-base font-bold text-nitkkr-dark" x-text="searchQuery.trim() ? 'No dishes match \'' + searchQuery + '\'' : 'No dishes in this category'"></p>
    <p class="text-xs mt-1 text-slate-400" x-text="searchQuery.trim() ? 'Try typing a different item name like maggi, chai, noodles...' : 'Select another category tab above to see more items'"></p>
    <button
      type="button"
      x-show="searchQuery.trim() || activeCat !== 'all'"
      @click="searchQuery = ''; searchExpanded = false; activeCat = 'all'; displayLimit = 20"
      class="mt-3 px-4 py-1.5 bg-nitkkr-orange/10 hover:bg-nitkkr-orange/20 text-nitkkr-orange text-xs font-bold rounded-xl transition-colors cursor-pointer"
    >
      Reset Filters
    </button>
  </div>

  <!-- 🌟 Dish Detail Popup Modal (Appears on click) -->
  <div
    x-show="showDetailModal && selectedItem"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
    @click.self="showDetailModal = false"
    @keydown.escape.window="showDetailModal = false"
  >
    <template x-if="selectedItem">
      <div
        x-transition:enter="transition ease-out duration-300 transform"
        x-transition:enter-start="scale-95 translate-y-4 opacity-0"
        x-transition:enter-end="scale-100 translate-y-0 opacity-100"
        class="bg-white rounded-3xl max-w-md w-full max-h-[90vh] flex flex-col overflow-hidden shadow-2xl border border-amber-200/50 space-y-0 relative text-slate-900"
      >
        <!-- Modal Close Button -->
        <button
          @click="showDetailModal = false"
          class="absolute top-3.5 right-3.5 z-20 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 transition-colors backdrop-blur-xs cursor-pointer font-bold"
          aria-label="Close details"
        >
          ✕
        </button>

        <!-- Large Dish Image Cover -->
        <div class="relative w-full h-44 sm:h-52 bg-slate-100 overflow-hidden flex-shrink-0">
          <img
            :src="getThumbnailUrl(selectedItem.image, 600)"
            :alt="selectedItem.name"
            class="w-full h-full object-cover"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

          <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold shadow-md"
              :class="{
                'bg-emerald-700 text-white': getItemDiet(selectedItem) === 'veg',
                'bg-amber-600 text-white': getItemDiet(selectedItem) === 'egg',
                'bg-rose-700 text-white': getItemDiet(selectedItem) === 'nonveg'
              }"
            >
              <!-- Shape icon for colorblind accessibility: Circle for Veg, Egg/Oval for Egg, Triangle for Non-Veg -->
              <span class="w-3.5 h-3.5 rounded-xs bg-white flex items-center justify-center flex-shrink-0" :class="{
                'border border-emerald-600': getItemDiet(selectedItem) === 'veg',
                'border border-amber-600': getItemDiet(selectedItem) === 'egg',
                'border border-rose-600': getItemDiet(selectedItem) === 'nonveg'
              }">
                <template x-if="getItemDiet(selectedItem) === 'veg'">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                </template>
                <template x-if="getItemDiet(selectedItem) === 'egg'">
                  <svg class="w-2 h-2 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                  </svg>
                </template>
                <template x-if="getItemDiet(selectedItem) === 'nonveg'">
                  <svg class="w-2 h-2 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                    <polygon points="5,1 9.5,8.5 0.5,8.5" />
                  </svg>
                </template>
              </span>
              <span x-text="getItemDiet(selectedItem) === 'veg' ? 'Pure Veg' : (getItemDiet(selectedItem) === 'egg' ? 'Contains Egg' : 'Non-Veg')"></span>
            </span>

            <span class="text-2xl font-black text-white drop-shadow-md" x-text="'₹' + Number(selectedItem.price).toFixed(0)"></span>
          </div>
        </div>

        <!-- Modal Body Content -->
        <div class="p-4 sm:p-5 space-y-3.5 overflow-y-auto flex-1">
          <div>
            <div class="flex items-center justify-between gap-2">
              <h2 class="font-display text-xl sm:text-2xl font-extrabold text-slate-900" x-text="selectedItem.name"></h2>
            </div>
            <p class="text-xs text-slate-400 mt-0.5" x-text="selectedItem.categoryName || 'Fast Food'"></p>
          </div>

          <!-- Description -->
          <div class="bg-amber-50/50 rounded-2xl p-3.5 border border-amber-200/50">
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed" x-text="selectedItem.description || 'Freshly prepared campus specialty made with authentic ingredients.'"></p>
          </div>

          <!-- Tags -->
          <template x-if="selectedItem.tags && selectedItem.tags.length > 0">
            <div class="flex flex-wrap gap-1.5 items-center">
              <span class="text-[11px] font-bold text-slate-400 mr-1">Tags:</span>
              <template x-for="tag in selectedItem.tags" :key="tag">
                <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg" x-text="'#' + tag"></span>
              </template>
            </div>
          </template>

          <!-- Reviews / Ratings & Action -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-2">
              <span class="text-amber-500 text-lg">★</span>
              <div>
                <p class="text-xs font-extrabold text-slate-900" x-text="selectedItem.avgRating ? selectedItem.avgRating + ' / 5.0' : 'No ratings yet'"></p>
                <p class="text-[10px] text-slate-400" x-text="selectedItem.reviewCount > 0 ? selectedItem.reviewCount + ' student reviews' : 'Be the first to rate'"></p>
              </div>
            </div>

            <div class="flex items-center gap-1.5 ml-auto">
              <template x-if="selectedItem.reviewCount > 0">
                <button
                  type="button"
                  @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'read' } }))"
                  class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                >
                  <span>💬</span> Reviews (<span x-text="selectedItem.reviewCount"></span>)
                </button>
              </template>

              <button
                type="button"
                @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'write' } }))"
                class="px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95"
              >
                <span>⭐</span> Rate Dish
              </button>
            </div>
          </div>

          <!-- Cart Action inside Modal -->
          <div class="pt-3 border-t border-slate-100">
            <!-- If Vendor is Closed -->
            <template x-if="!vendorInfo.isVendorOpen">
              <div class="w-full py-3 px-4 bg-slate-100 text-slate-500 font-bold text-xs sm:text-sm rounded-2xl text-center border border-slate-200 select-none">
                <span>🚫 Stall is currently closed • Ordering unavailable</span>
              </div>
            </template>

            <!-- If Vendor is Open -->
            <template x-if="vendorInfo.isVendorOpen">
              <div>
                <template x-if="getItemCartQuantity(selectedItem.id) === 0">
                  <button
                    type="button"
                    @click="addToCart(selectedItem)"
                    class="w-full py-3 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 text-white font-extrabold text-sm rounded-2xl shadow-md active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <span>🛒</span>
                    <span>Add to Order • ₹<span x-text="Number(selectedItem.price).toFixed(0)"></span></span>
                  </button>
                </template>
                <template x-if="getItemCartQuantity(selectedItem.id) > 0">
                  <div class="w-full flex items-center justify-between bg-amber-50 p-2 sm:p-2.5 rounded-2xl border border-amber-200/80">
                    <div class="flex items-center gap-2 pl-2">
                      <span class="text-xs font-bold text-amber-900">In Order:</span>
                      <span class="text-sm font-black text-nitkkr-orange" x-text="'₹' + (Number(selectedItem.price) * getItemCartQuantity(selectedItem.id)).toFixed(0)"></span>
                    </div>
                    <div class="flex items-center gap-2 bg-nitkkr-orange text-white rounded-xl px-2 py-1 shadow-xs">
                      <button
                        type="button"
                        @click="decrementCartItem(selectedItem.id)"
                        class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 font-black text-base cursor-pointer"
                        aria-label="Decrease quantity"
                      >
                        −
                      </button>
                      <span class="font-black text-sm min-w-[18px] text-center" x-text="getItemCartQuantity(selectedItem.id)"></span>
                      <button
                        type="button"
                        @click="addToCart(selectedItem)"
                        class="w-7 h-7 rounded-lg flex items-center justify-center hover:bg-white/20 active:scale-90 font-black text-base cursor-pointer"
                        aria-label="Increase quantity"
                      >
                        +
                      </button>
                    </div>
                  </div>
                </template>
              </div>
            </template>
          </div>
        </div>

      </div>
    </template>
  </div>

  <!-- 📱 Sleek Floating Island Bottom Dock (Efficient, Modern & Responsive) -->
  <div class="fixed bottom-[calc(0.75rem+env(safe-area-inset-bottom,0px))] sm:bottom-5 left-0 right-0 z-40 px-4 pointer-events-none">

    <div class="max-w-md mx-auto bg-white/95 backdrop-blur-xl border border-slate-200/90 rounded-2xl p-1.5 sm:p-2 shadow-[0_8px_30px_rgb(0,0,0,0.12)] pointer-events-auto transition-all">
      
      <!-- STATE 1: Default Action Row (Call [flex-1] + Share [flex-1] + WhatsApp [opt] + Search [icon]) -->
      <!-- Displayed when cart is empty OR vendor is closed and search is not active -->
      <div
        x-show="(cartTotalCount === 0 || !vendorInfo.isVendorOpen) && !searchExpanded && !searchQuery.trim()"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 scale-98"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex items-center gap-2"
      >
        <!-- 1. 📞 Call Button (Equal flex-1) -->
        <a
          href={vendorTelLink}
          class="flex-1 py-2.5 sm:py-3 px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 active:scale-98 text-white rounded-xl font-extrabold text-xs sm:text-sm text-center transition-all flex items-center justify-center gap-2 shadow-sm shadow-nitkkr-orange/25 cursor-pointer"
          aria-label="Call vendor"
        >
          <span class="text-base">📞</span>
          <span>Call</span>
        </a>

        <!-- 2. 🔗 Share Button (Equal flex-1) -->
        <button
          type="button"
          @click="shareVendor()"
          class="flex-1 py-2.5 sm:py-3 px-4 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-800 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer border border-slate-200/60 shadow-2xs"
          aria-label="Share vendor"
          title="Share vendor menu"
        >
          <span class="text-base">🔗</span>
          <span>Share</span>
        </button>

        {showWhatsApp && (
          <a
            href={vendorWhatsAppLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 sm:w-11 sm:h-11 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 active:scale-95 text-white rounded-xl flex items-center justify-center transition-all shadow-sm shadow-emerald-500/20 flex-shrink-0"
            aria-label={whatsAppLabel}
            title={whatsAppLabel}
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.18.51-.013 1.745-.87 2.014-1.762.27-.9.07-1.653-.599-2.185C18.918 15.288 17.787 14.532 17.472 14.382z"/>
            </svg>
          </a>
        )}

        <!-- 3. 🔍 Expand Search Button (Icon-Only at the end) -->
        <button
          type="button"
          @click="searchExpanded = true; $nextTick(() => { const el = $refs.menuSearchInput; if (el) { el.focus(); } })"
          class="w-10 h-10 sm:w-11 sm:h-11 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 rounded-xl flex items-center justify-center transition-all cursor-pointer border border-slate-200/60 shadow-2xs flex-shrink-0"
          aria-label="Search menu"
          title="Search in menu"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>

      <!-- STATE 2: 🛒 Morphing Cart Active Action Bar (Unified, Seamless & Native App UX) -->
      <!-- Replaces the default row when cart has items AND vendor is open! NO double bar! -->
      <div
        x-show="vendorInfo.isVendorOpen && cartTotalCount > 0 && !searchExpanded && !searchQuery.trim()"
        x-cloak
        x-transition:enter="transition ease-out duration-200 transform"
        x-transition:enter-start="opacity-0 scale-98"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex items-center justify-between gap-2"
      >
        <!-- Left: Cart Count & Total Price (Clickable to open cart) -->
        <button
          type="button"
          @click="openCartScreen()"
          class="flex items-center gap-2.5 min-w-0 pl-1.5 py-0.5 text-left cursor-pointer active:scale-98 transition-transform group flex-1"
          aria-label="View cart"
        >
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white flex items-center justify-center flex-shrink-0 font-bold text-base shadow-sm shadow-orange-500/30 group-hover:scale-105 transition-transform">
            🛒
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="font-black text-xs sm:text-sm text-slate-900" x-text="cartTotalCount + (cartTotalCount === 1 ? ' item' : ' items')"></span>
              <span class="text-slate-300 text-xs">•</span>
              <span class="font-black text-xs sm:text-sm text-emerald-600" x-text="'₹' + cartTotalPrice"></span>
            </div>
            <p class="text-[10px] sm:text-[11px] text-slate-500 truncate flex items-center gap-1">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse flex-shrink-0"></span>
              <span class="truncate font-semibold" x-text="'Order at ' + (vendorInfo.name || 'Vendor')"></span>
            </p>
          </div>
        </button>

        <!-- Right Controls: Quick Direct Call Button + Prominent View Cart CTA + Search -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <!-- 📞 Quick Direct Call Button -->
          <a
            href={vendorTelLink}
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-slate-100 hover:bg-amber-50 hover:text-amber-800 text-slate-700 flex items-center justify-center text-sm border border-slate-200/60 shadow-2xs active:scale-95 transition-all cursor-pointer flex-shrink-0"
            title="Call vendor directly"
            aria-label="Call vendor"
          >
            <span class="text-base">📞</span>
          </a>

          <!-- 🛍️ Primary View Cart CTA -->
          <button
            type="button"
            @click="openCartScreen()"
            class="py-2.5 sm:py-3 px-3.5 sm:px-4 bg-gradient-to-r from-nitkkr-orange to-amber-600 hover:from-nitkkr-orange-dark hover:to-amber-700 active:scale-95 text-white font-extrabold text-xs sm:text-sm rounded-xl shadow-sm shadow-nitkkr-orange/30 flex items-center gap-1.5 cursor-pointer transition-all"
            aria-label="View Cart and Checkout"
          >
            <span>View Cart</span>
            <span class="text-xs font-black">›</span>
          </button>

          <!-- 🔍 Search Icon Button -->
          <button
            type="button"
            @click="searchExpanded = true; $nextTick(() => { const el = $refs.menuSearchInput; if (el) { el.focus(); } })"
            class="w-9 h-9 sm:w-10 sm:h-10 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 rounded-xl flex items-center justify-center transition-all cursor-pointer border border-slate-200/60 shadow-2xs flex-shrink-0"
            aria-label="Search menu"
            title="Search in menu"
          >
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- STATE 3: Expanded Inline Search Bar (Pixel-Perfect with Clear & Done) -->
      <div
        x-show="searchExpanded || searchQuery.trim().length > 0"
        x-cloak
        x-transition:enter="transition ease-out duration-150 transform"
        x-transition:enter-start="opacity-0 scale-98"
        x-transition:enter-end="opacity-100 scale-100"
        class="flex items-center gap-1.5 sm:gap-2"
      >
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            x-ref="menuSearchInput"
            x-model.debounce.150ms="searchQuery"
            placeholder="Search dishes (e.g. maggi, chai)..."
            class="w-full pl-9 pr-8 py-2 text-xs sm:text-sm bg-slate-100 hover:bg-slate-100/80 focus:bg-white border border-slate-200 rounded-xl font-medium text-slate-900 focus:outline-hidden focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all"
            @input="displayLimit = 20"
            @keydown.escape="searchQuery = ''; searchExpanded = false; displayLimit = 20"
          />
          <button
            type="button"
            x-show="searchQuery.length > 0"
            x-cloak
            @click="searchQuery = ''; $refs.menuSearchInput?.focus()"
            class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-700 cursor-pointer"
            aria-label="Clear search"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <button
          type="button"
          @click="searchQuery = ''; searchExpanded = false"
          class="py-2 px-3 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold text-xs rounded-xl border border-slate-200/60 shadow-2xs cursor-pointer transition-all flex-shrink-0"
        >
          ✕ Close
        </button>
      </div>

    </div>
  </div>

  <!-- 📱 FULL-SCREEN CHECKOUT & ORDER CONFIRMATION VIEW (Teleported to Body to Escape Parent Stacking Contexts) -->
  <template x-teleport="body">
    <div
      x-show="showCartScreen"
      x-cloak
      x-effect="lockScroll(showCartScreen)"
      x-transition:enter="transition ease-out duration-250 transform"
      x-transition:enter-start="opacity-0 translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200 transform"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-4"
      class="fixed inset-0 z-[100] overflow-hidden bg-[#FAF8F5] flex flex-col text-slate-900 font-body"
      @keydown.escape.window="closeCartScreen()"
    >
      <!-- Top Sticky Navigation Bar with Safe-Area Inset Support -->
      <header class="flex-shrink-0 bg-white/95 backdrop-blur-md border-b border-slate-200/80 z-30 px-4 py-3 sm:py-3.5 shadow-xs pt-[calc(0.75rem+env(safe-area-inset-top,0px))]">
        <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
          <!-- Back Button -->
          <button
            type="button"
            @click="closeCartScreen()"
            class="flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-all active:scale-95 cursor-pointer py-1.5 px-3 rounded-full border border-slate-200 shadow-2xs"
            aria-label="Back to menu"
          >
            <span class="text-base font-bold">←</span>
            <span>Back to Menu</span>
          </button>

          <!-- Center Vendor Header (Clean, no taglines) -->
          <div class="text-center min-w-0 flex-1 px-2">
            <h1 class="text-sm sm:text-base font-black text-slate-900 font-display leading-tight truncate" x-text="vendorInfo.name || 'Vendor'"></h1>
          </div>

          <!-- Right Action: Clear Cart or Status Badge -->
          <div class="flex items-center gap-1">
            <template x-if="cartItems.length > 0 && !orderPlaced">
              <button
                type="button"
                @click="if (confirm('Clear all items from your order?')) { clearCart(); closeCartScreen(); }"
                class="text-xs text-slate-400 hover:text-rose-600 font-bold px-2.5 py-1.5 rounded-lg hover:bg-rose-50 transition-colors cursor-pointer"
              >
                Clear
              </button>
            </template>
            <template x-if="orderPlaced">
              <span class="px-2.5 py-1 bg-slate-100 text-slate-800 font-black text-[11px] rounded-lg border border-slate-200">
                ✓ Sent
              </span>
            </template>
          </div>
        </div>
      </header>

      <!-- Main Full-Screen Body Container (Scrollable Area with min-h-0 to guarantee flex-child shrinkage on Safari/WebKit) -->
      <main class="flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 py-5 sm:py-6">
        <div class="max-w-2xl mx-auto space-y-4">

          <!-- STATE 1: Active Order Review -->
          <template x-if="!orderPlaced">
            <div class="space-y-4">

              <!-- Stall Closed Warning Banner -->
              <div x-show="!vendorInfo.isVendorOpen" class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex items-start gap-3 shadow-2xs">
                <span class="text-xl flex-shrink-0">⚠️</span>
                <div class="text-xs sm:text-sm">
                  <p class="font-extrabold text-slate-900">Stall is Currently Closed</p>
                  <p class="text-slate-600 mt-0.5 leading-relaxed">
                    <span class="font-bold text-slate-900" x-text="vendorInfo.name || 'This stall'"></span> is not accepting orders right now. Ordering will resume during active operating hours.
                  </p>
                </div>
              </div>
              
              <!-- 1. Delivery Location Card (Clean Asterisk & 3 Specific Campus Chips with Toggle) -->
              <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/80 shadow-xs space-y-3">
                <div class="flex items-center justify-between">
                  <h2 class="text-sm sm:text-base font-extrabold text-slate-900 font-display">
                    <span>Location</span> <span class="text-rose-500 font-bold">*</span>
                  </h2>
                </div>

                <!-- 3 Specific Simple Campus Chips with Toggle -->
                <div class="flex flex-wrap gap-2">
                  <template x-for="loc in ['Back Gate', 'Front Gate', 'Girls Hostel']" :key="loc">
                    <button
                      type="button"
                      @click="setDeliveryLocation(loc)"
                      :class="(deliveryLocation && deliveryLocation.trim().toLowerCase() === loc.trim().toLowerCase()) 
                        ? 'bg-slate-900 text-white border-slate-900 shadow-sm font-extrabold' 
                        : 'bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold'"
                      class="px-3.5 py-2 rounded-xl border text-center transition-all cursor-pointer flex items-center justify-center text-xs active:scale-95"
                    >
                      <span class="leading-tight" x-text="loc"></span>
                    </button>
                  </template>
                </div>

                <!-- Simple Clean Location Input with Clear cross -->
                <div class="relative">
                  <input
                    id="manualLocationInput"
                    type="text"
                    x-model="deliveryLocation"
                    placeholder="Enter hostel room, department, or landmark..."
                    class="w-full px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm bg-white hover:bg-slate-50/50 focus:bg-white border border-slate-200 rounded-xl font-medium text-slate-900 placeholder:text-slate-400 focus:outline-hidden focus:border-slate-400 focus:ring-2 focus:ring-slate-100 shadow-2xs transition-all"
                  />
                  <button
                    type="button"
                    x-show="deliveryLocation"
                    @click="deliveryLocation = ''; localStorage.removeItem('orandus_delivery_loc');"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer text-sm font-bold"
                    aria-label="Clear location"
                  >
                    ✕
                  </button>
                </div>
              </section>

              <!-- 2. Order Items Card -->
              <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/80 shadow-xs space-y-3">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
                  <h2 class="text-sm sm:text-base font-extrabold text-slate-900 font-display">
                    <span>Items</span>
                    <span class="text-xs font-bold text-slate-400 ml-0.5" x-text="'(' + cartTotalCount + ')'"></span>
                  </h2>
                  <button
                    type="button"
                    @click="closeCartScreen()"
                    class="text-xs text-slate-700 hover:text-slate-900 font-bold flex items-center gap-1 cursor-pointer bg-slate-100 hover:bg-slate-200/80 px-2.5 py-1 rounded-xl border border-slate-200 transition-colors"
                  >
                    <span>+ Add items</span>
                  </button>
                </div>

                <template x-if="cartItems.length === 0">
                  <div class="text-center py-10 bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                    <p class="text-xs font-bold text-slate-900">Your cart is empty</p>
                    <button
                      type="button"
                      @click="closeCartScreen()"
                      class="mt-3 px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-xs"
                    >
                      Explore Menu
                    </button>
                  </div>
                </template>

                <!-- Items List -->
                <div class="divide-y divide-slate-100">
                  <template x-for="it in cartItems" :key="it.id">
                    <div class="py-3 first:pt-1 last:pb-1 flex items-center justify-between gap-3">
                      <!-- Dish Diet Icon & Name -->
                      <div class="flex items-center gap-2.5 min-w-0 flex-1">
                        <span
                          class="w-4 h-4 rounded-[3px] border-[1.5px] bg-white flex items-center justify-center flex-shrink-0"
                          :class="{
                            'border-emerald-600': it.diet === 'veg',
                            'border-amber-600': it.diet === 'egg',
                            'border-rose-700': it.diet === 'nonveg'
                          }"
                        >
                          <template x-if="it.diet === 'veg'">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                          </template>
                          <template x-if="it.diet === 'egg'">
                            <svg class="w-2.5 h-2.5 fill-amber-600 text-amber-600" viewBox="0 0 10 10" aria-hidden="true">
                              <path d="M5,1 C6.5,1 8,4 8,6.8 C8,8.2 6.7,9 5,9 C3.3,9 2,8.2 2,6.8 C2,4 3.5,1 5,1 Z" />
                            </svg>
                          </template>
                          <template x-if="it.diet === 'nonveg'">
                            <svg class="w-2.5 h-2.5 fill-rose-700 text-rose-700" viewBox="0 0 10 10" aria-hidden="true">
                              <polygon points="5,1 9.5,8.5 0.5,8.5" />
                            </svg>
                          </template>
                        </span>

                        <div class="min-w-0">
                          <p class="font-extrabold text-xs sm:text-sm text-slate-900 truncate" x-text="it.name"></p>
                          <p class="text-[11px] text-slate-400 font-medium" x-text="'₹' + it.price + ' each'"></p>
                        </div>
                      </div>

                      <!-- Stepper -->
                      <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl p-1 shadow-2xs flex-shrink-0">
                        <button
                          type="button"
                          @click="decrementCartItem(it.id)"
                          class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 active:scale-90 text-slate-900 flex items-center justify-center font-black text-sm cursor-pointer transition-all shadow-2xs border border-slate-200/60"
                          aria-label="Decrease quantity"
                        >
                          −
                        </button>
                        <span class="min-w-[18px] text-center font-black text-xs sm:text-sm text-slate-900 font-display" x-text="it.quantity"></span>
                        <button
                          type="button"
                          @click="addToCart(it)"
                          class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 active:scale-90 text-slate-900 flex items-center justify-center font-black text-sm cursor-pointer transition-all shadow-2xs border border-slate-200/60"
                          aria-label="Increase quantity"
                        >
                          +
                        </button>
                      </div>

                      <!-- Subtotal -->
                      <span class="font-black text-xs sm:text-sm text-slate-900 font-display min-w-[54px] text-right" x-text="'₹' + (it.price * it.quantity)"></span>
                    </div>
                  </template>
                </div>
              </section>

              <!-- 3. Cooking & Special Requests -->
              <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/80 shadow-xs space-y-2.5">
                <h2 class="text-xs sm:text-sm font-extrabold text-slate-900 font-display">
                  <span>Special Requests?</span>
                  <span class="text-[11px] font-normal text-slate-400 ml-1">(Optional)</span>
                </h2>

                <input
                  type="text"
                  x-model="cookingNotes"
                  placeholder="e.g. Extra napkins, less spicy, pack separately..."
                  class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-white border border-slate-200 rounded-xl font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-hidden focus:border-slate-400 focus:ring-2 focus:ring-slate-100 shadow-2xs transition-all"
                />
              </section>

              <!-- 4. Contact Credentials Card (Neutral Border, Small Tick Only) -->
              <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/80 shadow-xs space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <h2 class="text-sm sm:text-base font-extrabold text-slate-900 font-display">
                    <span>Phone Number</span> <span class="text-rose-500 font-bold">*</span>
                  </h2>
                </div>

                <!-- Mobile Phone Input with +91 Prefix (Clean Neutral Border - No Green Outline) -->
                <div>
                  <div class="flex items-center rounded-xl border border-slate-200 focus-within:border-slate-400 focus-within:ring-2 focus-within:ring-slate-100 overflow-hidden bg-white shadow-2xs transition-all">
                    <span class="bg-slate-50 px-3 py-2.5 sm:py-3 text-xs sm:text-sm font-extrabold text-slate-700 border-r border-slate-200 flex items-center">
                      +91
                    </span>
                    <input
                      id="fullScreenPhoneInput"
                      type="tel"
                      inputmode="numeric"
                      maxlength="10"
                      x-model="studentPhone"
                      @input="phoneError = ''"
                      placeholder="10-digit mobile number"
                      class="w-full px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-slate-900 outline-hidden bg-transparent placeholder:text-slate-400"
                    />
                    <!-- Inline phone indicator: small green tick when valid, subtle digit counter while typing -->
                    <div class="pr-3.5 flex items-center flex-shrink-0 select-none">
                      <span
                        x-show="isPhoneValid"
                        x-cloak
                        class="text-emerald-600 font-black text-sm"
                        title="Valid phone number"
                      >
                        ✓
                      </span>
                      <span
                        x-show="!isPhoneValid && studentPhone.length > 0"
                        x-cloak
                        class="text-[10px] font-mono font-bold text-slate-400"
                        x-text="studentPhone.length + '/10'"
                      ></span>
                    </div>
                  </div>
                  <template x-if="phoneError">
                    <p class="text-[11px] text-rose-600 font-bold mt-1" x-text="phoneError"></p>
                  </template>
                </div>

                <!-- Optional Name Input -->
                <div>
                  <input
                    id="fullScreenNameInput"
                    type="text"
                    x-model="studentName"
                    placeholder="Your name (optional)"
                    class="w-full px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm bg-white focus:bg-white rounded-xl border border-slate-200 outline-hidden font-medium text-slate-900 placeholder:text-slate-400 focus:border-slate-400 focus:ring-2 focus:ring-slate-100 shadow-2xs transition-all"
                  />
                </div>
              </section>

              <!-- 5. 🧾 Bill Breakdown Card -->
              <section class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200/80 shadow-xs space-y-2.5">
                <h2 class="text-xs sm:text-sm font-extrabold text-slate-900 font-display flex items-center gap-2 border-b border-slate-100 pb-2">
                  <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">🧾</span>
                  <span>Bill Details</span>
                </h2>

                <div class="space-y-1.5 text-xs text-slate-600">
                  <div class="flex items-center justify-between">
                    <span>Items Subtotal:</span>
                    <span class="font-bold text-slate-900" x-text="'₹' + cartTotalPrice"></span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="flex items-center gap-1">
                      <span>Campus Handover:</span>
                      <span class="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200/60 px-1.5 py-0.5 rounded-sm font-bold">FREE</span>
                    </span>
                    <span class="font-bold text-emerald-600">₹0</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="flex items-center gap-1">
                      <span>Orandus Platform Fee:</span>
                      <span class="text-[10px] bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded-sm font-bold">0% COMMISSION</span>
                    </span>
                    <span class="font-bold text-emerald-600">₹0</span>
                  </div>
                </div>

                <div class="pt-2.5 border-t border-slate-200 flex items-center justify-between">
                  <span class="font-black text-sm sm:text-base text-slate-900 font-display">To Pay:</span>
                  <span class="font-black text-lg sm:text-xl text-slate-900 font-display" x-text="'₹' + cartTotalPrice"></span>
                </div>

                <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 text-[11px] text-slate-700 flex items-center gap-2">
                  <span class="text-base flex-shrink-0">💡</span>
                  <span>Pay directly to vendor via <strong>UPI or Cash</strong> upon pickup at <strong class="text-slate-900" x-text="deliveryLocation || 'Selected Gate'"></strong>.</span>
                </div>
              </section>

              <!-- Bottom spacer for comfortable scrolling inside main -->
              <div class="h-6 w-full pointer-events-none select-none" aria-hidden="true"></div>

            </div>
          </template>

          <!-- STATE 2: Order Dispatched Confirmation & Digital Receipt (Unified Philosophy - Clean, No Orange Overuse) -->
          <template x-if="orderPlaced">
            <div class="max-w-xl mx-auto py-6 space-y-4">
              
              <!-- Top Celebratory Status Card -->
              <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs text-center space-y-3">
                <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 mx-auto flex items-center justify-center text-3xl font-black shadow-inner">
                  ✓
                </div>
                
                <div>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-800 border border-emerald-200/80 mb-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Order Dispatched • <strong x-text="'#' + ((placedOrder && placedOrder.orderId) || 'OR-READY')"></strong></span>
                  </span>
                  <h2 class="font-display text-2xl font-black text-slate-900 tracking-tight">Order Sent Successfully!</h2>
                  <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-md mx-auto leading-relaxed">
                    Your order was sent directly to <strong class="text-slate-900" x-text="(placedOrder && placedOrder.vendorName) || vendorInfo.name || 'the kitchen'"></strong> for pickup at <strong class="text-slate-900" x-text="(placedOrder && placedOrder.location) || deliveryLocation || 'your selected location'"></strong>.
                  </p>
                </div>
              </div>

              <!-- 📞 Reassuring Confirmation Call Notice (Neutral Styling) -->
              <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 text-left flex items-start gap-3 shadow-2xs">
                <div class="w-9 h-9 rounded-xl bg-slate-200 text-slate-700 flex items-center justify-center text-base flex-shrink-0">
                  📞
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-extrabold text-slate-900">Confirmation Call Upcoming</p>
                  <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
                    You will receive a quick confirmation call from the vendor on <span class="font-bold text-slate-900" x-text="'+91 ' + (((placedOrder && placedOrder.phone) || studentPhone) || 'your mobile')"></span> to confirm your order details and preparation.
                  </p>
                </div>
              </div>

              <!-- 🧾 Itemized Order Receipt Card -->
              <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200/80 shadow-xs space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <div>
                    <h3 class="text-sm sm:text-base font-black text-slate-900 font-display flex items-center gap-1.5">
                      <span>🧾</span>
                      <span>Receipt Summary</span>
                      <span class="text-[11px] font-black px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 border border-slate-200" x-text="'#' + ((placedOrder && placedOrder.orderId) || '')"></span>
                    </h3>
                    <p class="text-[11px] text-slate-400 font-medium" x-text="'Sent at ' + ((placedOrder && placedOrder.timestamp) || 'Just now')"></p>
                  </div>
                  <span class="text-xs font-black px-2.5 py-1 rounded-xl bg-slate-100 text-slate-700 border border-slate-200">
                    <span x-text="(((placedOrder && placedOrder.items) || cartItems).length) + ' items'"></span>
                  </span>
                </div>

                <!-- Customer & Delivery Metadata Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs">
                  <div class="flex items-start gap-2">
                    <span class="text-sm">📍</span>
                    <div>
                      <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Pickup Location</span>
                      <span class="font-black text-slate-900 text-xs sm:text-sm" x-text="(placedOrder && placedOrder.location) || deliveryLocation || 'Selected Location'"></span>
                    </div>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-sm">📱</span>
                    <div>
                      <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Contact Number</span>
                      <span class="font-extrabold text-slate-900 text-xs sm:text-sm" x-text="((placedOrder && placedOrder.name) || studentName ? (((placedOrder && placedOrder.name) || studentName) + ' • ') : '') + '+91 ' + (((placedOrder && placedOrder.phone) || studentPhone) || '—')"></span>
                    </div>
                  </div>
                </div>

                <!-- Special Instructions Note (If any) -->
                <template x-if="(placedOrder && placedOrder.notes) || cookingNotes">
                  <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 text-xs flex items-start gap-2">
                    <span class="text-base flex-shrink-0">📝</span>
                    <div>
                      <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Cooking / Handover Notes</span>
                      <span class="text-slate-800 font-medium italic" x-text="(placedOrder && placedOrder.notes) || cookingNotes"></span>
                    </div>
                  </div>
                </template>

                <!-- Itemized Breakdown Table -->
                <div class="divide-y divide-slate-100 text-xs">
                  <template x-for="item in ((placedOrder && placedOrder.items) || cartItems)" :key="item.id">
                    <div class="py-2.5 flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-slate-500" x-text="item.quantity + 'x'"></span>
                        <span class="font-bold text-slate-900" x-text="item.name"></span>
                      </div>
                      <span class="font-extrabold text-slate-900" x-text="'₹' + (item.price * item.quantity)"></span>
                    </div>
                  </template>
                </div>

                <!-- Grand Total Row -->
                <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-sm sm:text-base font-black text-slate-900 font-display">
                  <span>Grand Total (Pay at Pickup)</span>
                  <span class="text-slate-900 text-lg sm:text-xl font-black" x-text="'₹' + ((placedOrder && placedOrder.totalPrice) || cartTotalPrice)"></span>
                </div>
              </div>

              <!-- Action Controls on Receipt: Reopen WhatsApp, Copy Summary, or Return -->
              <div class="flex flex-col sm:flex-row items-center gap-2.5 pt-2">
                <template x-if="placedOrder && placedOrder.whatsappUrl">
                  <a
                    :href="placedOrder.whatsappUrl"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full sm:flex-1 py-3 px-4 bg-[#25D366] hover:bg-[#20bd5a] active:scale-98 text-white font-extrabold text-xs sm:text-sm rounded-2xl flex items-center justify-center gap-2 transition-all shadow-md shadow-emerald-500/20 text-center"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.18.51-.013 1.745-.87 2.014-1.762.27-.9.07-1.653-.599-2.185C18.918 15.288 17.787 14.532 17.472 14.382z"/>
                    </svg>
                    <span>Re-open WhatsApp Chat</span>
                  </a>
                </template>

                <button
                  type="button"
                  @click="copyOrderSummary()"
                  class="w-full sm:w-auto py-3 px-4 bg-white hover:bg-slate-50 border border-slate-200 active:scale-98 text-slate-700 font-bold text-xs sm:text-sm rounded-2xl flex items-center justify-center gap-1.5 transition-all cursor-pointer"
                >
                  <span x-text="copiedOrderSummary ? '✓ Copied!' : '📋 Copy Receipt'">📋 Copy Receipt</span>
                </button>
              </div>

              <!-- Return / Back to Menu button -->
              <div class="pt-2 flex justify-center">
                <button
                  type="button"
                  @click="clearCart(); closeCartScreen();"
                  class="py-2.5 px-6 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs sm:text-sm rounded-2xl transition-all cursor-pointer text-center"
                >
                  ← Order More / Back to Menu
                </button>
              </div>

              <div class="h-6 w-full pointer-events-none select-none" aria-hidden="true"></div>

            </div>
          </template>

        </div>
      </main>

      <!-- Anchored Bottom Action Dock (Flex-shrink-0: Guarantees 100% visibility on all screen sizes & viewports) -->
      <template x-if="!orderPlaced && cartItems.length > 0">
        <footer class="flex-shrink-0 bg-white/95 backdrop-blur-md border-t border-slate-200/90 p-3 sm:p-4 shadow-lg pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] z-30">
          <div class="max-w-2xl mx-auto">
            <div class="flex items-center justify-between gap-3 sm:gap-4">
              <!-- Total Price Display -->
              <div class="flex flex-col">
                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Total to pay</span>
                <span class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight font-display" x-text="'₹' + cartTotalPrice"></span>
              </div>

              <!-- Primary Send WhatsApp CTA Button (Disabled when stall is closed) -->
              <template x-if="vendorInfo.isVendorOpen">
                <button
                  type="button"
                  @click="if (isPhoneValid) { sendWhatsAppOrder(); } else { document.getElementById('fullScreenPhoneInput')?.focus(); }"
                  :disabled="isDispatching"
                  :class="(isPhoneValid && !isDispatching)
                    ? 'bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-lg shadow-emerald-500/20 cursor-pointer active:scale-98' 
                    : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700 border border-slate-200 cursor-pointer'"
                  class="flex-1 max-w-md py-3.5 px-5 font-black text-xs sm:text-sm rounded-2xl flex items-center justify-center gap-2.5 transition-all shadow-sm"
                >
                  <!-- Official Full WhatsApp Logo (Speech Bubble with Phone) -->
                  <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-10.416c-5.523 0-10 4.477-10 10 0 1.76.457 3.414 1.258 4.856l-1.336 4.877 4.996-1.31c1.401.764 3.007 1.2 4.712 1.2 5.523 0 10-4.477 10-10s-4.477-10.623-10-10.623z"/>
                  </svg>

                  <span x-text="typeof whatsAppButtonLabel !== 'undefined' && whatsAppButtonLabel ? whatsAppButtonLabel : (isPhoneValid ? 'Send Order on WhatsApp ›' : 'Enter Mobile Number to Order')">Enter Mobile Number to Order</span>
                </button>
              </template>
              <template x-if="!vendorInfo.isVendorOpen">
                <div class="flex-1 max-w-md py-3.5 px-5 font-bold text-xs sm:text-sm rounded-2xl flex items-center justify-center gap-2 bg-slate-100 text-slate-500 border border-slate-200 cursor-not-allowed select-none">
                  <span>🚫</span>
                  <span>Stall Closed • Orders Paused</span>
                </div>
              </template>
            </div>
          </div>
        </footer>
      </template>
    </div>
  </template>
</div>