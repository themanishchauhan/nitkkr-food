---
interface Props {
  categories: Array<{ slug: string; name: string; icon?: string | null; [key: string]: any }>;
  menuItems: Array<{ categorySlug?: string | null; categoryName?: string | null; [key: string]: any }>;
  [key: string]: any;
}
const { categories, menuItems } = Astro.props;

---
<div x-data={`{ activeCat: 'all', categories: ${JSON.stringify(categories)}, menuItems: ${JSON.stringify(menuItems)} }`} class="mb-6">
  <!-- Horizontal Category Tabs -->
  <div class="flex gap-2 overflow-x-auto pb-3 mb-4 -mx-4 px-4 scrollbar-none" role="tablist" aria-label="Menu categories">
    <button
      @click="activeCat='all'"
      :class="activeCat==='all' ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
      class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer"
      role="tab"
      :aria-selected="activeCat==='all'"
    >
      All ({menuItems.length})
    </button>
    <template x-for="cat in categories" :key="cat.slug">
      <button
        @click="activeCat=cat.slug"
        :class="activeCat===cat.slug ? 'bg-nitkkr-orange text-white shadow-sm font-bold' : 'bg-white text-nitkkr-dark border border-nitkkr-orange/30 font-medium'"
        class="px-4 py-2 rounded-full text-xs whitespace-nowrap transition-all duration-200 cursor-pointer flex items-center gap-1"
        role="tab"
        :aria-selected="activeCat===cat.slug"
      >
        <span x-text="cat.icon" aria-hidden="true"></span>
        <span x-text="cat.name"></span>
      </button>
    </template>
  </div>

  <!-- Menu Items List -->
  <div class="space-y-3">
    <template x-for="item in menuItems" :key="item.id">
      <div
        x-show="activeCat==='all' || activeCat===item.categorySlug"
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 transform scale-98"
        x-transition:enter-end="opacity-100 transform scale-100"
        class="bg-white rounded-2xl border border-nitkkr-orange/20 p-3.5 sm:p-4 flex gap-3 sm:gap-4
               hover:border-nitkkr-orange hover:shadow-sm transition-all duration-200 overflow-hidden"
      >
        <img
          :src="item.image || '/placeholder-food.svg'"
          alt=""
          class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover flex-shrink-0"
          loading="lazy"
        />
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 class="font-bold text-sm sm:text-base text-nitkkr-dark truncate" x-text="item.name"></h3>
                <template x-if="item.avgRating">
                  <span
                    @click.stop="window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: item.id, name: item.name, mode: 'read' } }))"
                    class="inline-flex items-center gap-0.5 px-1.5 py-0.5 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 rounded-md text-[11px] font-bold text-amber-800 cursor-pointer transition-colors shadow-2xs"
                    title="Read student reviews"
                  >
                    <span class="text-amber-500">★</span>
                    <span x-text="item.avgRating"></span>
                    <span class="text-slate-400 text-[10px] font-normal" x-text="'(' + item.reviewCount + ')'"></span>
                  </span>
                </template>
              </div>
              <p class="text-[11px] text-nitkkr-gray truncate" x-text="item.categoryName || ''"></p>
            </div>
            <span class="text-nitkkr-orange font-bold text-base sm:text-lg whitespace-nowrap flex-shrink-0" x-text="'₹' + Number(item.price).toFixed(0)"></span>
          </div>

          <template x-if="item.description">
            <p class="text-xs text-nitkkr-gray mt-1 line-clamp-2" x-text="item.description"></p>
          </template>

          <div class="flex flex-wrap items-center justify-between gap-2 mt-2.5 pt-2 border-t border-nitkkr-cream">
            <div class="flex flex-wrap gap-1 items-center">
              <template x-if="item.isVeg">
                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-[10px] font-bold rounded-full">🌱 Veg</span>
              </template>
              <template x-if="!item.isVeg">
                <span class="px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded-full">🍗 Non-Veg</span>
              </template>
              <template x-for="tag in (item.tags || [])" :key="tag">
                <span class="px-2 py-0.5 bg-nitkkr-cream text-nitkkr-orange text-[10px] font-medium rounded-full" x-text="tag"></span>
              </template>
            </div>

            <!-- Action: Rate / Review Dish -->
            <button
              type="button"
              @click="window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: item.id, name: item.name, mode: item.reviewCount > 0 ? 'read' : 'write' } }))"
              class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-700 border border-amber-200 rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all cursor-pointer flex-shrink-0 ml-auto shadow-2xs"
              :aria-label="item.reviewCount > 0 ? 'Read or write reviews for ' + item.name : 'Rate ' + item.name"
            >
              <span>⭐</span>
              <span x-text="item.reviewCount > 0 ? item.avgRating + ' (' + item.reviewCount + ')' : 'Rate'"></span>
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>

  <div
    x-show="menuItems.length === 0 || menuItems.filter(i => activeCat==='all' || activeCat===i.categorySlug).length === 0"
    x-cloak
    class="text-center py-12 text-nitkkr-gray bg-white rounded-2xl border border-nitkkr-orange/20 p-6"
  >
    <p class="text-3xl mb-2">🍱</p>
    <p class="text-base font-bold text-nitkkr-dark">No dishes in this category</p>
    <p class="text-xs mt-1">Select another category tab above to see more items</p>
  </div>
</div>