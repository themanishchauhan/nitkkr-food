---
interface Props {
  placeholder?: string;
  autoFocus?: boolean;
}
const { placeholder = 'What are you craving? momos, biryani, burger...', autoFocus = false } = Astro.props;
---
<form action="/search" method="GET" class="w-full" role="search" onsubmit="document.activeElement instanceof HTMLElement && document.activeElement.blur()">
  <label for="search-input" class="sr-only">Search food</label>
  <div class="relative">
    <input
      type="search"
      id="search-input"
      name="q"
      placeholder={placeholder}
      class="w-full pl-4 pr-11 py-3 text-xs sm:text-sm bg-white border-2 border-slate-200/90 rounded-2xl
             focus:outline-hidden focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20
             placeholder:text-slate-400 font-medium text-slate-900 shadow-2xs transition-all"
      autofocus={autoFocus}
      autocomplete="off"
      enterkeyhint="search"
      aria-label="Search food items"
    />

    <button
      type="submit"
      class="absolute right-2.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xl bg-nitkkr-orange/10 hover:bg-nitkkr-orange text-nitkkr-orange hover:text-white transition-all flex items-center justify-center cursor-pointer active:scale-95"
      aria-label="Search"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </button>
  </div>
</form>