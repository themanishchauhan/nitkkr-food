---
interface Props {
  chips?: Array<{ label: string; icon?: string; href: string; isEnabled?: boolean }>;
}

const defaultChips = [
  { label: 'Under ₹50', icon: '💸', href: '/search?maxPrice=50', isEnabled: true },
  { label: 'Pure Veg', icon: '🌱', href: '/search?isVeg=true', isEnabled: true },
  { label: 'Non-Veg', icon: '🍗', href: '/search?isVeg=false', isEnabled: true },
  { label: 'Chowmein', icon: '🥢', href: '/search?q=chowmein', isEnabled: true },
  { label: 'Paneer', icon: '🧈', href: '/search?q=paneer', isEnabled: true },
  { label: 'Rolls & Wraps', icon: '🌯', href: '/search?q=roll', isEnabled: true },
  { label: 'Maggi', icon: '🧀', href: '/search?q=maggi', isEnabled: true },
  { label: 'Cold Shakes & Coffee', icon: '🥤', href: '/search?category=beverages', isEnabled: true },
];

const { chips = defaultChips } = Astro.props;
const rawChips = (chips && chips.length > 0 ? chips : defaultChips).filter(c => c.isEnabled !== false);

// Clean up duplicate trailing emojis from labels if present
const activeChips = rawChips.map(c => ({
  ...c,
  label: c.label.replace(/[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}]/gu, '').trim()
}));
---

<div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 scrollbar-none" role="group" aria-label="Quick student filters">
  {activeChips.map(chip => (
    <a
      href={chip.href}
      class="px-2.5 py-1 bg-white border border-slate-200/90 text-slate-700 rounded-full text-xs font-semibold
             hover:bg-amber-50/80 hover:border-nitkkr-orange hover:text-nitkkr-orange transition-all duration-150 flex items-center gap-1 whitespace-nowrap active:scale-95 shadow-2xs"
    >
      {chip.icon && <span class="text-xs" aria-hidden="true">{chip.icon}</span>}
      <span>{chip.label}</span>
    </a>
  ))}
</div>