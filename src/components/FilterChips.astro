---
interface Props {
  chips?: Array<{ label: string; icon: string; href: string; isEnabled?: boolean }>;
}

const defaultChips = [
  { label: 'Under ₹50 💸', icon: '💰', href: '/search?maxPrice=50', isEnabled: true },
  { label: 'Chowmein & Noodles 🥢', icon: '🥢', href: '/search?q=chowmein', isEnabled: true },
  { label: 'Paneer Dishes 🧈', icon: '🍲', href: '/search?q=paneer', isEnabled: true },
  { label: 'Rolls & Wraps 🌯', icon: '🌯', href: '/search?q=roll', isEnabled: true },
  { label: 'Maggi & Pasta 🧀', icon: '🧀', href: '/search?q=maggi', isEnabled: true },
  { label: 'Cold Shakes & Coffee 🧋', icon: '🧋', href: '/search?category=beverages', isEnabled: true },
  { label: 'Pure Veg 🌱', icon: '🌱', href: '/search?isVeg=true', isEnabled: true },
  { label: 'Chicken & Non-Veg 🍗', icon: '🍗', href: '/search?isVeg=false', isEnabled: true },
];


const { chips = defaultChips } = Astro.props;
const activeChips = (chips && chips.length > 0 ? chips : defaultChips).filter(c => c.isEnabled !== false);
---

<div class="flex flex-wrap gap-2.5 mb-8 px-4 sm:px-0" role="group" aria-label="Quick student filters">
  {activeChips.map(chip => (
    <a
      href={chip.href}
      class="px-4 py-2.5 bg-white border border-bistro-200 text-nitkkr-dark rounded-full text-xs font-bold
             hover:bg-bistro-50 hover:border-bistro-300 hover:text-bistro-600 transition-all duration-200 flex items-center gap-1.5 whitespace-nowrap active:scale-[0.98]"
    >
      <span aria-hidden="true">{chip.icon}</span>
      <span>{chip.label}</span>
    </a>
  ))}
</div>