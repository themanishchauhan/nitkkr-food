---
interface Props {
  category: {
    name: string;
    slug: string;
    icon: string;
  };
}
const { category } = Astro.props;
---
<a
  href={`/search?category=${category.slug}`}
  class="bg-white px-2 py-2 sm:py-2.5 rounded-xl border border-slate-200/90 text-center
         hover:border-nitkkr-orange hover:shadow-xs active:scale-95 transition-all duration-150 flex flex-col items-center justify-center shadow-2xs group"
>
  <span class="text-xl sm:text-2xl block mb-0.5 group-hover:scale-110 transition-transform duration-200" aria-hidden="true">{category.icon}</span>
  <span class="font-bold text-[11px] text-slate-700 leading-tight truncate w-full text-center group-hover:text-nitkkr-orange">{category.name}</span>
</a>