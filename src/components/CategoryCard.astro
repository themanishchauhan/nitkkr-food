---
interface Props {
  category: {
    name: string;
    slug: string;
    icon: string;
  };
}
const { category } = Astro.props;
---
<a
  href={`/search?category=${category.slug}`}
  class="bg-white p-2.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200/90 text-center
         hover:border-nitkkr-orange hover:shadow-md active:scale-95 transition-all duration-150 flex flex-col items-center justify-center min-w-[72px] sm:min-w-0 shadow-2xs group"
>
  <span class="text-2xl sm:text-3xl block mb-1 group-hover:scale-110 transition-transform duration-200" aria-hidden="true">{category.icon}</span>
  <span class="font-bold text-[11px] sm:text-xs text-slate-800 leading-tight line-clamp-2">{category.name}</span>
</a>