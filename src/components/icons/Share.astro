---
interface Props {
  class?: string;
  'aria-label'?: string;
}
const { class: className = 'w-5 h-5', 'aria-label': ariaLabel = 'Share' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-label={ariaLabel}
  role="img"
>
  <circle cx="18" cy="5" r="3" />
  <circle cx="6" cy="19" r="3" />
  <path d="M8.59 13.51l1.51 1.51L19 8.49" />
</svg>