---
interface Props {
  class?: string;
  'aria-label'?: string;
}
const { class: className = 'w-5 h-5', 'aria-label': ariaLabel = 'Search' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-label={ariaLabel}
  role="img"
>
  <circle cx="11" cy="11" r="8" />
  <path d="M21 21l-4.35-4.35" />
</svg>