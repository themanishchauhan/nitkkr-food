---
interface Props {
  item: {
    id: number;
    name: string;
    description?: string | null;
    price: string | number;
    image?: string | null;
    isVeg: boolean;
    tags: string[];
    categorySlug?: string;
    categoryName?: string;
  };
}
const { item } = Astro.props;
const price = typeof item.price === 'string' ? parseFloat(item.price) : item.price;
---
<div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-3.5 sm:p-4 mb-3 flex gap-3 sm:gap-4
            hover:border-nitkkr-orange/50 hover:shadow-xs transition-all duration-200 overflow-hidden">
  <img
    src={item.image || '/placeholder-food.svg'}
    alt=""
    class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover flex-shrink-0"
    loading="lazy"
  />
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <h3 class="font-bold text-sm sm:text-base text-nitkkr-dark truncate">{item.name}</h3>
        {item.categoryName && (
          <p class="text-[11px] text-nitkkr-gray truncate">{item.categoryName}</p>
        )}
      </div>
      <span class="text-nitkkr-orange font-bold text-base sm:text-lg whitespace-nowrap flex-shrink-0">₹{price.toFixed(0)}</span>
    </div>

    {item.description && (
      <p class="text-xs text-nitkkr-gray mt-1 line-clamp-2">{item.description}</p>
    )}

    <div class="flex flex-wrap items-center justify-between gap-2 mt-2.5 pt-2 border-t border-nitkkr-cream">
      <div class="flex flex-wrap gap-1 items-center">
        {item.isVeg ? (
          <span class="px-2 py-0.5 bg-green-100 text-green-700 text-[10px] font-bold rounded-full" aria-label="Vegetarian">🌱 Veg</span>
        ) : (
          <span class="px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded-full" aria-label="Non-Vegetarian">🍗 Non-Veg</span>
        )}
        {item.tags.map(tag => (
          <span class="px-2 py-0.5 bg-nitkkr-cream text-nitkkr-orange text-[10px] font-medium rounded-full">{tag}</span>
        ))}
      </div>

      <div class="flex items-center gap-1.5 flex-shrink-0 ml-auto">
        <button
          type="button"
          onclick={`window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: ${item.id}, name: ${JSON.stringify(item.name)} } }))`}
          class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 rounded-xl font-bold text-xs flex items-center gap-1 transition-all cursor-pointer"
          aria-label={`Rate ${item.name}`}
        >
          <span>⭐</span> Rate
        </button>
      </div>
    </div>
  </div>
</div>