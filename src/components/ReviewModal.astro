---
interface Props {
  vendorReviews?: any[];
  stallReviews?: any[];
  menuItems?: any[];
}
const { vendorReviews, stallReviews, menuItems = [] } = Astro.props;
const reviewsData = vendorReviews || stallReviews || [];
---

<div
  x-data="reviewModalComponent()"
  x-init="init()"
  x-show="showModal"
  x-cloak
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
  @click.self="showModal = false"
  @keydown.escape.window="showModal = false"
>
  <div
    class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-bistro-500/20 relative overflow-hidden max-h-[90vh] flex flex-col"
    @click.stop
  >
    <!-- Modal Header -->
    <div class="flex items-start justify-between pb-4 border-b border-slate-100">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-[11px] font-bold">
          <span>⭐</span> Student Verified Ratings
        </div>
        <h3 class="font-display text-lg font-bold text-slate-900 mt-1 truncate max-w-[280px]" x-text="itemName || 'Rate Dish'"></h3>
      </div>
      <button
        type="button"
        @click="showModal = false"
        class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center font-bold text-sm transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        ✕
      </button>
    </div>

    <!-- Tabs: Write Review vs Read Reviews -->
    <div class="flex border-b border-slate-100 mt-4 mb-4">
      <button
        type="button"
        @click="activeTab = 'write'"
        :class="activeTab === 'write' ? 'border-b-2 border-bistro-500 text-bistro-600 font-bold' : 'text-slate-500 font-medium hover:text-slate-800'"
        class="flex-1 pb-3 text-xs text-center transition-colors cursor-pointer"
      >
        ✍️ Write Review
      </button>
      <button
        type="button"
        @click="activeTab = 'read'"
        :class="activeTab === 'read' ? 'border-b-2 border-bistro-500 text-bistro-600 font-bold' : 'text-slate-500 font-medium hover:text-slate-800'"
        class="flex-1 pb-3 text-xs text-center transition-colors cursor-pointer"
      >
        Reviews (<span x-text="filteredReviews.length"></span>)
      </button>
    </div>

    <!-- TAB 1: WRITE REVIEW -->
    <div x-show="activeTab === 'write'" class="flex-1 overflow-y-auto pr-1">
      <form @submit.prevent="submitReview()" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-900 mb-1">Your Name / Hostel *</label>
          <input
            type="text"
            x-model="studentName"
            required
            placeholder="e.g. Rahul (H-7)"
            class="w-full px-3.5 py-2.5 bg-bistro-50/50 border border-bistro-300 rounded-xl text-xs font-medium text-slate-900 focus:outline-hidden focus:border-bistro-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-900 mb-1">Star Rating *</label>
          <div class="flex items-center gap-2">
            <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
              <button
                type="button"
                @click="rating = star"
                class="text-2xl transition-transform active:scale-125 hover:scale-110 cursor-pointer focus:outline-hidden"
                :class="rating >= star ? 'text-amber-500' : 'text-slate-300 hover:text-amber-300'"
                :aria-label="star + ' stars'"
              >
                ★
              </button>
            </template>
            <span
              class="text-xs font-bold ml-2 transition-colors"
              :class="rating > 0 ? 'text-amber-700' : 'text-slate-400 font-normal'"
              x-text="rating > 0 ? rating + ' / 5 stars' : 'Tap stars to rate (1 to 5)'"
            ></span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-900 mb-1">Your Review</label>
          <textarea
            x-model="comment"
            rows="3"
            placeholder="How was the taste, portion, spice level, or delivery time?"
            class="w-full px-3.5 py-2.5 bg-bistro-50/50 border border-bistro-300 rounded-xl text-xs font-medium text-slate-900 focus:outline-hidden focus:border-bistro-500 leading-relaxed"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-900 mb-1">Dish Photo <span class="text-amber-600 font-medium">(Recommended)</span></label>
          <div class="flex items-center gap-2">
            <!-- Hidden File Input -->
            <input
              type="file"
              x-ref="photoInput"
              @change="handlePhotoSelect($event)"
              accept="image/*"
              capture="environment"
              class="hidden"
            />
            <!-- Upload Trigger Button -->
            <button
              type="button"
              @click="$refs.photoInput.click()"
              class="px-3.5 py-2 bg-amber-50 hover:bg-amber-100 border border-amber-300/80 rounded-xl text-xs font-bold text-amber-900 flex items-center gap-1.5 transition-all cursor-pointer active:scale-95 shadow-2xs"
            >
              <span>📷</span>
              <span x-text="photoData ? 'Change Photo' : 'Attach Photo'"></span>
            </button>
            <span x-show="compressingPhoto" class="text-[11px] text-amber-700 animate-pulse font-medium">Optimizing photo...</span>
          </div>

          <!-- Photo Preview Thumbnail with Remove button -->
          <template x-if="photoData">
            <div class="mt-2.5 relative inline-block group">
              <img
                :src="photoData"
                alt="Uploaded dish preview"
                class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-2xl border-2 border-amber-400 shadow-sm cursor-pointer hover:opacity-90 transition-opacity"
                @click="zoomedPhoto = photoData"
                title="Tap to view preview"
              />
              <button
                type="button"
                @click="removePhoto()"
                class="absolute -top-1.5 -right-1.5 w-6 h-6 rounded-full bg-rose-600 text-white text-xs font-bold flex items-center justify-center shadow-md hover:bg-rose-700 active:scale-90 transition-all cursor-pointer"
                title="Remove photo"
                aria-label="Remove photo"
              >
                ✕
              </button>
              <span class="block text-[10px] text-slate-500 mt-1 truncate max-w-[120px]" x-text="photoName || 'Dish Photo'"></span>
            </div>
          </template>
        </div>

        <template x-if="error">
          <p class="text-xs font-bold text-rose-600 bg-rose-50 p-2.5 rounded-xl border border-rose-200" x-text="error"></p>
        </template>

        <template x-if="submitted">
          <p class="text-xs font-bold text-emerald-700 bg-emerald-50 p-2.5 rounded-xl border border-emerald-200">
            🎉 Thank you! Your review & photo have been published.
          </p>
        </template>

        <div class="pt-2">
          <button
            type="submit"
            :disabled="loading || submitted || compressingPhoto"
            class="w-full py-3 bg-bistro-500 hover:bg-bistro-600 text-white rounded-xl font-bold text-xs shadow-md shadow-bistro-500/20 transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50"
          >
            <span x-show="!loading">Submit Review ⭐</span>
            <span x-show="loading">Submitting...</span>
          </button>
        </div>
      </form>
    </div>

    <!-- TAB 2: READ REVIEWS -->
    <div x-show="activeTab === 'read'" class="flex-1 overflow-y-auto space-y-3 pr-1">
      <template x-if="filteredReviews.length === 0">
        <div class="py-10 text-center text-slate-400">
          <span class="text-3xl block mb-2">📝</span>
          <p class="text-xs font-semibold">No reviews yet for this dish.</p>
          <button
            type="button"
            @click="activeTab = 'write'"
            class="mt-3 px-4 py-2 bg-bistro-500 text-white text-xs font-bold rounded-xl shadow-xs hover:bg-bistro-600 cursor-pointer"
          >
            Be the first to review!
          </button>
        </div>
      </template>

      <template x-for="rev in filteredReviews" :key="rev.id">
        <div class="p-3.5 rounded-2xl bg-bistro-50/60 border border-bistro-200/50 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-slate-900" x-text="rev.studentName"></span>
            <div class="flex items-center gap-0.5 text-amber-500 text-xs">
              <template x-for="i in 5">
                <span x-text="i <= rev.rating ? '★' : '☆'"></span>
              </template>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed" x-text="rev.comment || ('Rated ' + rev.rating + '/5 stars')"></p>
          
          <!-- Dish Photo Thumbnail -->
          <template x-if="rev.photoUrl">
            <div class="pt-1">
              <img
                :src="rev.photoUrl"
                alt="Student dish photo"
                class="w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-xl border border-slate-200 shadow-2xs hover:scale-105 transition-transform cursor-pointer"
                @click="zoomedPhoto = rev.photoUrl"
                title="Tap to enlarge photo"
              />
            </div>
          </template>
        </div>
      </template>
    </div>
  </div>

  <!-- 🔍 Fullscreen Zoom Lightbox Modal -->
  <div
    x-show="zoomedPhoto"
    x-cloak
    class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-black/85 backdrop-blur-md"
    @click.self="zoomedPhoto = null"
    @keydown.escape.window="zoomedPhoto = null"
  >
    <div class="relative max-w-lg w-full max-h-[90vh] flex flex-col items-center">
      <button
        type="button"
        @click="zoomedPhoto = null"
        class="absolute -top-10 right-0 text-white hover:text-amber-400 font-bold text-sm p-1.5 cursor-pointer flex items-center gap-1 transition-colors"
      >
        <span>✕ Close</span>
      </button>
      <img
        :src="zoomedPhoto"
        alt="Full Dish Photo"
        class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl border border-white/20"
        @click.stop
      />
    </div>
  </div>
</div>

<script is:inline define:vars={{ initialReviews: reviewsData, initialMenuItems: menuItems }}>
  window.reviewModalComponent = function() {
    return {
      showModal: false,
      activeTab: 'write',
      itemId: null,
      itemName: '',
      studentName: '',
      rating: 0,
      comment: '',
      photoData: null,
      photoName: '',
      compressingPhoto: false,
      zoomedPhoto: null,
      loading: false,
      submitted: false,
      error: '',
      reviewsList: Array.isArray(initialReviews) ? initialReviews : [],
      menuItemsList: Array.isArray(initialMenuItems) ? initialMenuItems : [],

      init() {
        window.addEventListener('open-review-modal', async (e) => {
          this.itemId = e.detail?.id ? Number(e.detail.id) : null;
          this.itemName = e.detail?.name || (this.itemId ? (this.menuItemsList.find(m => m.id === this.itemId)?.name || '') : 'Dish Review');
          this.activeTab = e.detail?.mode || 'write';
          this.rating = e.detail?.initialRating || 0;
          this.comment = '';
          this.photoData = null;
          this.photoName = '';
          this.compressingPhoto = false;
          this.zoomedPhoto = null;
          this.studentName = localStorage.getItem('student_name') || '';
          this.submitted = false;
          this.error = '';
          this.showModal = true;

          if (this.itemId) {
            try {
              const res = await fetch('/api/reviews?menuItemId=' + this.itemId);
              if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data.reviews)) {
                  const otherReviews = this.reviewsList.filter(r => Number(r.menuItemId) !== Number(this.itemId));
                  this.reviewsList = [...data.reviews, ...otherReviews];
                }
              }
            } catch (err) {}
          }
        });
      },

      handlePhotoSelect(e) {
        const file = e.target.files?.[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          this.error = 'Please select a valid image file (JPG, PNG, WebP)';
          return;
        }
        this.compressingPhoto = true;
        this.photoName = file.name;
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            try {
              const canvas = document.createElement('canvas');
              let width = img.width;
              let height = img.height;
              const maxDim = 800; // Optimal 800px for retina crispness & ~50-80KB size
              if (width > maxDim || height > maxDim) {
                if (width > height) {
                  height = Math.round((height * maxDim) / width);
                  width = maxDim;
                } else {
                  width = Math.round((width * maxDim) / height);
                  height = maxDim;
                }
              }
              canvas.width = width;
              canvas.height = height;
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, width, height);
              // Export as JPEG with 0.75 quality
              this.photoData = canvas.toDataURL('image/jpeg', 0.75);
            } catch (err) {
              this.photoData = event.target.result;
            } finally {
              this.compressingPhoto = false;
            }
          };
          img.onerror = () => {
            this.compressingPhoto = false;
            this.error = 'Could not load image';
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      },

      removePhoto() {
        this.photoData = null;
        this.photoName = '';
        if (this.$refs.photoInput) this.$refs.photoInput.value = '';
      },

      get filteredReviews() {
        if (!this.itemId) return this.reviewsList;
        return this.reviewsList.filter(r => Number(r.menuItemId) === Number(this.itemId));
      },

      async submitReview() {
        if (!this.studentName.trim()) {
          this.error = 'Please enter your name or hostel (e.g. Rahul H-7)';
          return;
        }
        if (this.rating <= 0) {
          this.error = 'Please tap 1 to 5 stars to rate this dish';
          return;
        }
        if (!this.itemId && this.menuItemsList.length > 0) {
          this.itemId = this.menuItemsList[0].id;
        }
        this.loading = true;
        this.error = '';

        try {
          localStorage.setItem('student_name', this.studentName.trim());
          const res = await fetch('/api/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              menuItemId: this.itemId,
              studentName: this.studentName.trim(),
              rating: this.rating,
              comment: this.comment.trim() || undefined,
              photoUrl: this.photoData || undefined,
            })
          });

          let data = {};
          try {
            data = await res.json();
          } catch (jsonErr) {
            data = { error: 'Server error: ' + res.status };
          }

          if (res.ok && data.success) {
            this.submitted = true;
            if (data.review) {
              this.reviewsList = this.reviewsList.filter(r => !(Number(r.menuItemId) === Number(this.itemId) && r.studentName?.toLowerCase() === this.studentName.trim().toLowerCase()));
              this.reviewsList.unshift(data.review);
            }
            window.dispatchEvent(new CustomEvent('review-updated', { detail: { menuItemId: this.itemId, rating: this.rating } }));
            setTimeout(() => {
              this.submitted = false;
              this.photoData = null;
              this.photoName = '';
              this.activeTab = 'read';
            }, 1000);
          } else {
            this.error = data.error || ('Failed with status ' + res.status);
          }
        } catch (err) {
          this.error = err?.message || 'Network error. Please try again.';
        } finally {
          this.loading = false;
        }
      }
    };
  };
</script>
