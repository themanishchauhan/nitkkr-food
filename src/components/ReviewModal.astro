---
interface Props {
  vendorReviews?: any[];
  stallReviews?: any[];
  menuItems: any[];
}
const { vendorReviews, stallReviews, menuItems } = Astro.props;
const reviewsData = vendorReviews || stallReviews || [];
---

<div
  x-data={`{
    showModal: false,
    activeTab: 'read',
    itemId: null,
    itemName: '',
    studentName: '',
    rating: 5,
    comment: '',
    loading: false,
    submitted: false,
    error: '',
    dishDropdownOpen: false,
    reviewsList: ${JSON.stringify(reviewsData)},
    menuItemsList: ${JSON.stringify(menuItems)},

    init() {
      window.addEventListener('open-review-modal', (e) => {
        this.itemId = e.detail?.id || null;
        this.itemName = e.detail?.name || (this.itemId ? (this.menuItemsList.find(m => m.id === this.itemId)?.name || '') : 'General Feedback');
        this.activeTab = e.detail?.mode || (this.filteredReviews.length > 0 ? 'read' : 'write');
        this.dishDropdownOpen = false;
        this.rating = 5;
        this.comment = '';
        this.studentName = localStorage.getItem('student_name') || '';
        this.submitted = false;
        this.error = '';
        this.showModal = true;
      });
    },
    get selectedItem() {
      if (!this.itemId) return this.menuItemsList[0] || null;
      return this.menuItemsList.find(m => m.id === this.itemId) || this.menuItemsList[0] || null;
    },
    get filteredReviews() {
      if (!this.itemId) return this.reviewsList;
      return this.reviewsList.filter(r => r.menuItemId === this.itemId);
    },
    get modalAvgRating() {
      const revs = this.filteredReviews;
      if (revs.length === 0) return '0.0';
      const sum = revs.reduce((acc, r) => acc + (r.rating || 0), 0);
      return (sum / revs.length).toFixed(1);
    },

    async submitReview() {
      if (!this.studentName.trim()) {
        this.error = 'Please enter your name / hostel';
        return;
      }
      if (!this.itemId && this.menuItemsList.length > 0) {
        this.itemId = this.menuItemsList[0].id;
      }
      this.loading = true;
      this.error = '';
      try {
        localStorage.setItem('student_name', this.studentName.trim());
        const res = await fetch('/api/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            menuItemId: this.itemId,
            studentName: this.studentName.trim(),
            rating: this.rating,
            comment: this.comment.trim() || undefined
          })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          this.submitted = true;
          this.reviewsList.unshift(data.review);
          setTimeout(() => {
            this.submitted = false;
            this.activeTab = 'read';
          }, 1500);
        } else {
          this.error = data.error || 'Failed to submit review. Try again.';
        }
      } catch (err) {
        this.error = 'Network error. Please try again.';
      } finally {
        this.loading = false;
      }
    }
  }`}
  x-show="showModal"
  x-cloak
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
  @click.self="showModal = false"
  @keydown.escape.window="showModal = false"
>
  <div
    class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl border border-nitkkr-orange/20 relative overflow-hidden max-h-[90vh] flex flex-col"
    @click.stop
  >
    <!-- Modal Header -->
    <div class="flex items-start justify-between pb-4 border-b border-slate-100">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-[11px] font-bold">
          <span>⭐</span> Student Verified Ratings
        </div>
        <h3 class="font-display text-lg font-bold text-nitkkr-dark mt-1 truncate max-w-[280px]" x-text="itemName"></h3>
      </div>
      <button
        type="button"
        @click="showModal = false"
        class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center font-bold text-sm transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        ✕
      </button>
    </div>

    <!-- Tabs: Read vs Write -->
    <div class="flex border-b border-slate-100 mt-4 mb-4">
      <button
        type="button"
        @click="activeTab = 'read'"
        :class="activeTab === 'read' ? 'border-b-2 border-nitkkr-orange text-nitkkr-orange font-bold' : 'text-slate-500 font-medium hover:text-slate-800'"
        class="flex-1 pb-3 text-xs text-center transition-colors cursor-pointer"
      >
        Reviews (<span x-text="filteredReviews.length"></span>)
      </button>
      <button
        type="button"
        @click="activeTab = 'write'"
        :class="activeTab === 'write' ? 'border-b-2 border-nitkkr-orange text-nitkkr-orange font-bold' : 'text-slate-500 font-medium hover:text-slate-800'"
        class="flex-1 pb-3 text-xs text-center transition-colors cursor-pointer"
      >
        ✍️ Write Review
      </button>
    </div>

    <!-- TAB 1: READ REVIEWS -->
    <div x-show="activeTab === 'read'" class="flex-1 overflow-y-auto space-y-3 pr-1">
      <template x-if="filteredReviews.length === 0">
        <div class="py-10 text-center text-slate-400">
          <span class="text-3xl block mb-2">📝</span>
          <p class="text-xs font-semibold">No reviews yet for this dish.</p>
          <button
            type="button"
            @click="activeTab = 'write'"
            class="mt-3 px-4 py-2 bg-nitkkr-orange text-white text-xs font-bold rounded-xl shadow-xs hover:bg-nitkkr-orange-dark cursor-pointer"
          >
            Be the first to review!
          </button>
        </div>
      </template>

      <template x-for="rev in filteredReviews" :key="rev.id">
        <div class="p-3.5 rounded-2xl bg-nitkkr-cream/40 border border-nitkkr-orange/10 space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="font-bold text-xs text-nitkkr-dark" x-text="rev.studentName"></span>
            <div class="flex items-center gap-0.5 text-amber-500 text-xs">
              <template x-for="i in 5">
                <span x-text="i <= rev.rating ? '★' : '☆'"></span>
              </template>
            </div>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed" x-text="rev.comment || 'Rated ' + rev.rating + '/5 stars'"></p>
        </div>
      </template>
    </div>

    <!-- TAB 2: WRITE REVIEW -->
    <div x-show="activeTab === 'write'" class="flex-1 overflow-y-auto pr-1">
      <form @submit.prevent="submitReview()" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-nitkkr-dark mb-1">Your Name / Hostel *</label>
          <input
            type="text"
            x-model="studentName"
            required
            placeholder="e.g. Manish (H-7)"
            class="w-full px-3.5 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-medium text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-nitkkr-dark mb-1">Star Rating</label>
          <div class="flex items-center gap-2">
            <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
              <button
                type="button"
                @click="rating = star"
                class="text-2xl transition-transform active:scale-125 cursor-pointer focus:outline-hidden"
                :class="rating >= star ? 'text-amber-500' : 'text-slate-300'"
              >
                ★
              </button>
            </template>
            <span class="text-xs font-bold text-amber-700 ml-2" x-text="rating + ' / 5 stars'"></span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-nitkkr-dark mb-1">Your Review (Optional)</label>
          <textarea
            x-model="comment"
            rows="3"
            placeholder="How was the taste, portion, spice level, or delivery time?"
            class="w-full px-3.5 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-medium text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange leading-relaxed"
          ></textarea>
        </div>

        <template x-if="error">
          <p class="text-xs font-bold text-rose-600 bg-rose-50 p-2.5 rounded-xl border border-rose-200" x-text="error"></p>
        </template>

        <template x-if="submitted">
          <p class="text-xs font-bold text-emerald-700 bg-emerald-50 p-2.5 rounded-xl border border-emerald-200">
            🎉 Thank you! Your review has been published.
          </p>
        </template>

        <div class="pt-2">
          <button
            type="submit"
            :disabled="loading || submitted"
            class="w-full py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white rounded-xl font-bold text-xs shadow-md shadow-nitkkr-orange/20 transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50"
          >
            <span x-show="!loading">Submit Review ⭐</span>
            <span x-show="loading">Submitting...</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
