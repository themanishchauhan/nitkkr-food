---
interface Slide {
  id?: string;
  badge: string;
  vendorName?: string;
  title: string;
  description: string;
  ctaText?: string;
  ctaLink?: string;
  gradient?: string;
  icon?: string;
  isEnabled?: boolean;
}

interface Props {
  slides?: Slide[];
}

const defaultSlides: Slide[] = [
  {
    id: 'parantha-challenge-1100',
    badge: '🏆 1 PARANTHA 20 MINUTE CHALLENGE',
    vendorName: 'Yummy Tummy Foods & Guest House',
    title: 'Eat Bharat Ka Sabse Bada Parantha & Win ₹1100!',
    description: '1 पराठा 20 मिनट में खाईए, ₹1100/- नकद ईनाम पाईए! Ek baar khaaoge, baar-baar aaoge.',
    ctaText: 'Accept Challenge →',
    ctaLink: '/v/yummy-tummy-foods',
    gradient: 'from-amber-900 via-bistro-800 to-orange-800',
    icon: '🫓',
    isEnabled: true
  }
];

const { slides: propSlides } = Astro.props;
const rawSlides = propSlides && propSlides.length > 0 ? propSlides : defaultSlides;
const activeSlides = rawSlides.filter(s => s.isEnabled !== false && s.title?.trim());
---

{activeSlides.length > 0 && (
  <div
    x-data={`{
      current: 0,
      total: ${activeSlides.length},
      touchStartX: 0,
      touchEndX: 0,
      autoplayTimer: null,
      startAutoplay() {
        if (this.total <= 1) return;
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          this.next();
        }, 4000);
      },
      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      },
      next() {
        this.current = (this.current + 1) % this.total;
      },
      prev() {
        this.current = (this.current - 1 + this.total) % this.total;
      },
      goTo(idx) {
        this.current = idx;
        this.stopAutoplay();
        this.startAutoplay();
      },
      handleTouchStart(e) {
        this.touchStartX = e.touches[0].clientX;
        this.stopAutoplay();
      },
      handleTouchEnd(e) {
        this.touchEndX = e.changedTouches[0].clientX;
        const diff = this.touchStartX - this.touchEndX;
        if (diff > 45) {
          this.next();
        } else if (diff < -45) {
          this.prev();
        }
        this.startAutoplay();
      }
    }`}
    x-init="startAutoplay()"
    @mouseenter="stopAutoplay()"
    @mouseleave="startAutoplay()"
    @touchstart.passive="handleTouchStart($event)"
    @touchend.passive="handleTouchEnd($event)"
    class="relative w-full select-none"
  >
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-2 px-0.5">
      <h2 class="font-display text-xs sm:text-sm font-extrabold flex items-center gap-1.5 text-slate-900 tracking-tight">
        <span class="text-amber-500">🎁</span>
        <span>Campus Offers & Deals</span>
      </h2>

      {activeSlides.length > 1 && (
        <div class="flex items-center gap-1">
          <button
            type="button"
            @click="prev(); stopAutoplay(); startAutoplay();"
            class="w-6 h-6 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-amber-50 hover:text-nitkkr-orange flex items-center justify-center text-xs font-bold transition-all shadow-2xs cursor-pointer active:scale-95"
            aria-label="Previous offer"
          >
            ‹
          </button>
          <button
            type="button"
            @click="next(); stopAutoplay(); startAutoplay();"
            class="w-6 h-6 rounded-full bg-white border border-slate-200 text-slate-700 hover:bg-amber-50 hover:text-nitkkr-orange flex items-center justify-center text-xs font-bold transition-all shadow-2xs cursor-pointer active:scale-95"
            aria-label="Next offer"
          >
            ›
          </button>
        </div>
      )}
    </div>

    <!-- Carousel Viewport & Horizontal Track -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl shadow-sm border border-amber-950/10 bg-stone-900">
      <div
        class="flex w-full transition-transform duration-500 ease-[cubic-bezier(0.2,1,0.3,1)]"
        :style="`transform: translateX(-${current * 100}%);`"
      >
        {activeSlides.map((slide) => (
          <div
            class={`w-full shrink-0 p-4 sm:p-4.5 text-white flex flex-col justify-between min-h-[140px] sm:min-h-[145px] relative overflow-hidden bg-gradient-to-r ${slide.gradient || 'from-bistro-800 via-bistro-700 to-amber-700'}`}
          >
            <!-- Background Decorative Watermark Icon -->
            <span class="absolute -right-2 -bottom-3 text-5xl sm:text-6xl opacity-10 select-none pointer-events-none" aria-hidden="true">
              {slide.icon || '🔥'}
            </span>

            <!-- Header: Badge & Vendor -->
            <div class="flex items-center justify-between gap-2 relative z-10">
              <span class="px-2.5 py-0.5 rounded-full text-[9px] sm:text-[10px] font-black uppercase tracking-wider bg-white/20 backdrop-blur-md border border-white/25 text-white shadow-xs">
                {slide.badge}
              </span>
              {slide.vendorName && (
                <span class="text-[10px] sm:text-[11px] font-semibold text-white/85 truncate">
                  {slide.vendorName}
                </span>
              )}
            </div>

            <!-- Slide Content -->
            <div class="my-2 relative z-10">
              <h3 class="font-display text-sm sm:text-base font-black text-white tracking-tight leading-snug">
                {slide.title}
              </h3>
              <p class="text-[11px] text-white/90 font-medium mt-0.5 line-clamp-2 leading-relaxed">
                {slide.description}
              </p>
            </div>

            <!-- Footer Actions & Progress Indicators -->
            <div class="flex items-center justify-between pt-1 relative z-10">
              <a
                href={slide.ctaLink || '/search'}
                class="px-3.5 py-1.5 bg-white text-slate-900 hover:bg-amber-50 active:scale-95 rounded-xl font-extrabold text-[11px] sm:text-xs shadow-xs transition-all inline-flex items-center gap-1 cursor-pointer"
              >
                <span>{slide.ctaText || 'View Deal →'}</span>
              </a>

              <!-- Pagination Dots -->
              {activeSlides.length > 1 && (
                <div class="flex items-center gap-1.5">
                  {activeSlides.map((_, dotIdx) => (
                    <button
                      type="button"
                      @click={`goTo(${dotIdx})`}
                      class="transition-all duration-300 rounded-full cursor-pointer h-1.5"
                      :class={`current === ${dotIdx} ? 'w-5 bg-white shadow-xs' : 'w-1.5 bg-white/40 hover:bg-white/70'`}
                      aria-label={`Go to slide ${dotIdx + 1}`}
                    ></button>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
)}
