---
import { getVendorTimingStatus } from '../lib/utils';

interface Props {
  vendor: {
    id: number;
    name: string;
    slug: string;
    image?: string | null;
    deliversTo?: string[] | null;
    opensAt?: string | null;
    closesAt?: string | null;
    minPrice?: number | null;
  };
  isOpen?: boolean;
}

const { vendor } = Astro.props;
const timing = getVendorTimingStatus(vendor.opensAt, vendor.closesAt);
---

<a
  href={`/v/${vendor.slug}`}
  class="flex items-center gap-3.5 bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200/90
         hover:border-nitkkr-orange hover:shadow-md active:scale-[0.99] transition-all duration-200 group shadow-2xs"
>
  <img
    src={vendor.image || '/placeholder-vendor.svg'}
    alt={vendor.name}
    class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform duration-300 border border-slate-100 bg-slate-50"
    loading="lazy"
  />
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <p class="font-bold text-sm sm:text-base truncate text-slate-900 group-hover:text-nitkkr-orange transition-colors">{vendor.name}</p>
    </div>
    <p class="text-xs text-slate-500 flex items-center gap-1.5 mt-0.5">
      <span
        class={`w-2 h-2 rounded-full flex-shrink-0 ${timing.isOpen ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}
        aria-hidden="true"
      ></span>
      <span class={`truncate font-medium ${timing.isUrgent ? 'text-amber-600 font-semibold' : 'text-slate-500'}`}>
        {timing.statusText}
      </span>
    </p>
  </div>
  <!-- Sleek navigation indicator (Removes repetitive menu icon) -->
  <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-orange-50 group-hover:text-nitkkr-orange group-hover:translate-x-0.5 transition-all flex-shrink-0 border border-slate-100/80">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>