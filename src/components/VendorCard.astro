---
import { getVendorTimingStatus, cleanTelHref, isPureVegVendor } from '../lib/utils';
import { getOptimizedImageUrl } from '../lib/images';

interface Props {
  vendor: {
    id: number;
    name: string;
    slug: string;
    phone?: string | null;
    image?: string | null;
    deliversTo?: string[] | null;
    opensAt?: string | null;
    closesAt?: string | null;
    minPrice?: number | null;
    isPureVeg?: boolean;
  };
  isOpen?: boolean;
}

const { vendor } = Astro.props;
const isPureVeg = isPureVegVendor(vendor);
const closedDays = (vendor as any).closedDays || ((vendor.slug === 'the-hangry-club' || vendor.slug === 'hangry-club') ? ['Tuesday'] : null);
const timing = getVendorTimingStatus(vendor.opensAt, vendor.closesAt, undefined, closedDays);
const optimizedImg = getOptimizedImageUrl(vendor.image || '/placeholder-vendor.svg', { width: 160, quality: 80, format: 'auto' });
const telHref = cleanTelHref(vendor.phone);
---

<div
  class={`flex items-center gap-3 sm:gap-3.5 p-3 sm:p-3.5 rounded-2xl border transition-all duration-200 group shadow-2xs ${
    timing.isOpen
      ? 'bg-white border-slate-200/90 hover:border-nitkkr-orange hover:shadow-md'
      : 'bg-slate-50/70 border-slate-200 opacity-75 grayscale-[40%] hover:grayscale-0 hover:opacity-100'
  }`}
>
  <!-- Main Clickable Area: Image + Details (Click opens full menu) -->
  <a
    href={`/v/${vendor.slug}`}
    class="flex items-center gap-3 sm:gap-3.5 flex-1 min-w-0"
  >
    <img
      src={optimizedImg}
      alt={vendor.name}
      width="64"
      height="64"
      class={`w-14 h-14 sm:w-16 sm:h-16 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform duration-300 border border-slate-100 bg-slate-50 ${
        !timing.isOpen ? 'grayscale opacity-80' : ''
      }`}
      loading="lazy"
      decoding="async"
    />
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <p class={`font-bold text-sm sm:text-base truncate transition-colors ${timing.isOpen ? 'text-slate-900 group-hover:text-nitkkr-orange' : 'text-slate-600'}`}>{vendor.name}</p>

        {isPureVeg && (
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-emerald-50 border border-emerald-300 text-emerald-800 text-[10px] font-bold tracking-tight shadow-2xs flex-shrink-0">
            <span class="w-2.5 h-2.5 border border-emerald-600 rounded-[2px] flex items-center justify-center p-[1px] bg-white">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            </span>
            <span>PURE VEG</span>
          </span>
        )}
      </div>
      <p class="text-xs text-slate-500 flex items-center gap-1.5 mt-0.5">
        <span
          class={`w-2 h-2 rounded-full flex-shrink-0 ${timing.isOpen ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`}
          aria-hidden="true"
        ></span>
        <span class={`truncate font-medium ${timing.isUrgent ? 'text-amber-600 font-semibold' : 'text-slate-500'}`}>
          {timing.statusText}
        </span>
      </p>
    </div>
  </a>

  <!-- Right Actions Group: Dedicated Call Action + Subtle Trailing Chevron -->
  <div class="flex items-center gap-2 flex-shrink-0">
    {telHref && (
      <a
        href={telHref}
        class="w-9 h-9 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 flex items-center justify-center transition-all active:scale-95 shadow-2xs cursor-pointer border border-emerald-200/70"
        aria-label={`Call ${vendor.name}`}
        title={`Call ${vendor.name}`}
      >
        <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      </a>
    )}

    <!-- Sleek Navigation Indicator to View Full Menu (integrated chevron) -->
    <a
      href={`/v/${vendor.slug}`}
      class="p-1 text-slate-300 group-hover:text-nitkkr-orange group-hover:translate-x-0.5 transition-all flex-shrink-0"
      aria-label={`View ${vendor.name} menu`}
      title="View Menu"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>