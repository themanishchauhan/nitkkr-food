---
import { getActiveVendors, getCategories, getAllMenuItemsForSearch, getAllReviews } from '../lib/queries';

interface Props {
  currentPath: string;
  stallsCount?: number;
  categoriesCount?: number;
  menuCount?: number;
  reviewsCount?: number;
}

const {
  currentPath = '/admin',
  stallsCount: propStalls,
  categoriesCount: propCategories,
  menuCount: propMenu,
  reviewsCount: propReviews
} = Astro.props;

// Fetch SSR counts safely with fallback
const [serverVendors, serverCategories, serverMenu, serverReviews] = await Promise.all([
  propStalls !== undefined ? Promise.resolve(null) : getActiveVendors().catch(() => []),
  propCategories !== undefined ? Promise.resolve(null) : getCategories().catch(() => []),
  propMenu !== undefined ? Promise.resolve(null) : getAllMenuItemsForSearch().catch(() => []),
  propReviews !== undefined ? Promise.resolve(null) : getAllReviews().catch(() => [])
]);

const counts: Record<string, { count: number; reactiveKey: string }> = {
  '/admin/stalls': { count: propStalls ?? (Array.isArray(serverVendors) ? serverVendors.length : 0), reactiveKey: 'vendors' },
  '/admin/categories': { count: propCategories ?? (Array.isArray(serverCategories) ? serverCategories.length : 0), reactiveKey: 'categories' },
  '/admin/menu-items': { count: propMenu ?? (Array.isArray(serverMenu) ? serverMenu.length : 0), reactiveKey: 'menuItems' },
  '/admin/reviews': { count: propReviews ?? (Array.isArray(serverReviews) ? serverReviews.length : 0), reactiveKey: 'reviews' },
};

const navItems = [
  { path: '/admin', label: 'Dashboard Hub', icon: '📊' },
  { path: '/admin/stalls', label: 'Campus Vendors', icon: '🏪' },
  { path: '/admin/categories', label: 'Categories', icon: '🍽️' },
  { path: '/admin/menu-items', label: 'Menu Dishes & Prices', icon: '🍱' },
  { path: '/admin/reviews', label: 'Student Reviews', icon: '⭐' },
  { path: '/admin/pages', label: 'Footer Pages & Content', icon: '📄' },
  { path: '/admin/qr', label: 'QR Marketing Studio', icon: '📱' },
  { path: '/admin/site-settings', label: 'Website Control Center', icon: '⚙️' },
];
---


<aside class="w-full lg:w-64 bg-slate-950 border-r border-slate-800 flex-shrink-0 flex flex-col justify-between p-4 lg:p-5 lg:min-h-screen shadow-xl text-slate-200 select-none">
  <div>
    <!-- Brand Badge / Terminal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
      <a href="/admin" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-600 flex items-center justify-center text-lg shadow-md shadow-amber-500/20 text-white font-mono">
          ⚡
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h2 class="font-display font-black text-sm text-white tracking-wide">ORANDUS</h2>
            <span class="text-[9px] font-mono px-1.5 py-0.2 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded font-bold">OPS</span>
          </div>
          <div class="flex items-center gap-1.5 mt-0.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[10px] font-mono text-emerald-400 font-semibold tracking-wider uppercase">TERMINAL v2.6</span>
          </div>
        </div>
      </a>

      <!-- Mobile Drawer Button -->
      <button @click="sidebarOpen = !sidebarOpen" class="lg:hidden p-2 text-slate-400 hover:text-white" aria-label="Toggle Navigation Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="mt-5 space-y-1" :class="sidebarOpen ? 'block' : 'hidden lg:block'">
      {navItems.map((item, idx) => {
        const isActive = currentPath === item.path;
        const countInfo = counts[item.path];
        return (
          <a
            href={item.path}
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl font-medium text-xs transition-all group ${
              isActive
                ? 'bg-amber-500 text-slate-950 font-bold shadow-md shadow-amber-500/25'
                : 'text-slate-400 hover:text-white hover:bg-slate-900/80 border border-transparent hover:border-slate-800'
            }`}
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="text-sm flex-shrink-0 group-hover:scale-110 transition-transform">{item.icon}</span>
              <span class="truncate">{item.label}</span>
            </div>
            {countInfo && (
              <span
                class={`text-[10px] font-mono px-2 py-0.5 rounded font-bold border flex-shrink-0 ${
                  isActive
                    ? 'bg-slate-950/20 text-slate-950 border-slate-950/30'
                    : 'bg-slate-900 text-amber-400 border-slate-800'
                }`}
                x-text={`(typeof ${countInfo.reactiveKey} !== 'undefined' && Array.isArray(${countInfo.reactiveKey})) ? ${countInfo.reactiveKey}.length : ${countInfo.count}`}
              >{countInfo.count}</span>
            )}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Terminal Account Footer -->
  <div class="mt-6 pt-4 border-t border-slate-800/80 space-y-2.5" :class="sidebarOpen ? 'block' : 'hidden lg:block'">
    <a
      href="/"
      target="_blank"
      class="w-full py-2 px-3 bg-slate-900 hover:bg-slate-850 text-slate-300 hover:text-white font-mono text-xs rounded-xl flex items-center justify-center gap-2 transition-all border border-slate-800"
    >
      <span class="text-emerald-400">●</span> Live Website <span class="text-slate-500 font-sans">↗</span>
    </a>

    <div class="flex items-center justify-between p-2.5 bg-slate-900/90 rounded-xl border border-slate-800">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-7 h-7 rounded-lg bg-amber-500/20 border border-amber-500/40 text-amber-400 font-mono font-bold flex items-center justify-center text-xs">
          OP
        </div>
        <div class="truncate">
          <p class="text-xs font-bold text-white truncate font-mono">manishchauhan</p>
          <p class="text-[10px] text-slate-400 font-mono">Terminal Superuser</p>
        </div>
      </div>
      <button
        @click="typeof logout === 'function' ? logout() : (async () => { if (confirm('Log out from Admin Panel?')) { await fetch('/api/admin/auth', { method: 'DELETE' }); window.location.href = '/admin/login'; } })()"
        class="text-slate-400 hover:text-rose-400 p-1.5 transition-colors cursor-pointer"
        title="Logout from Terminal"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </button>
    </div>
  </div>
</aside>
