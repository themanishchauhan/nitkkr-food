  <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  <script is:inline>
    if ('serviceWorker' in navigator) {
      let refreshing = false;

      // Automatically reload the page seamlessly when a new service worker takes control
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (!refreshing) {
          refreshing = true;
          window.location.reload();
        }
      });

      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then((reg) => {
          // Immediately check for updates
          reg.update().catch(() => {});

          // Auto-check for updates whenever user returns to the tab or unlocks phone
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
              reg.update().catch(() => {});
            }
          });

          // Periodic check every 15 minutes if page stays open
          setInterval(() => {
            reg.update().catch(() => {});
          }, 15 * 60 * 1000);

          // If a new worker is waiting, activate immediately
          if (reg.waiting) {
            reg.waiting.postMessage({ type: 'SKIP_WAITING' });
          }

          // If a new worker is found installing, activate as soon as it's installed
          reg.addEventListener('updatefound', () => {
            const newWorker = reg.installing;
            if (newWorker) {
              newWorker.addEventListener('statechange', () => {
                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  newWorker.postMessage({ type: 'SKIP_WAITING' });
                }
              });
            }
          });
        }).catch(() => {});
      });
    }
  </script>

  <!-- 📱 Physical & Digital Marketing Telemetry Tracker -->
  <script is:inline>
    (function() {
      try {
        var params = new URLSearchParams(window.location.search);
        var src = params.get('utm_source') || params.get('src');
        var med = params.get('utm_medium');
        var camp = params.get('utm_campaign');

        // Check if user landed via QR scan (deduplicated per browser session)
        var qrSessionKey = 'orandus_qr_logged_' + window.location.pathname + '_' + (camp || '');
        if ((src === 'qr' || params.get('qr') === '1') && !sessionStorage.getItem(qrSessionKey)) {
          sessionStorage.setItem(qrSessionKey, '1');
          sessionStorage.setItem('orandus_qr_attr', JSON.stringify({
            source: 'qr',
            medium: med || 'direct_scan',
            campaign: camp || window.location.pathname.replace('/v/', '') || 'campus_general',
            ts: Date.now()
          }));

          var qrPayload = JSON.stringify({
            eventType: 'qr_scan',
            source: 'qr',
            medium: med || 'direct_scan',
            campaign: camp || window.location.pathname.replace('/v/', '') || 'campus_general',
            metadata: { path: window.location.pathname }
          });

          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/analytics/event', new Blob([qrPayload], { type: 'application/json' }));
          } else {
            fetch('/api/analytics/event', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: qrPayload,
              keepalive: true
            }).catch(function() {});
          }
        }

        // Track PWA app installs
        window.addEventListener('appinstalled', function() {
          var pwaPayload = JSON.stringify({
            eventType: 'pwa_install',
            source: 'pwa',
            medium: 'standalone',
            campaign: 'install_prompt',
            metadata: { path: window.location.pathname }
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/analytics/event', new Blob([pwaPayload], { type: 'application/json' }));
          } else {
            fetch('/api/analytics/event', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: pwaPayload,
              keepalive: true
            }).catch(function() {});
          }
        });

        // Global delegate for Call and WhatsApp click attribution
        document.addEventListener('click', function(e) {
          var target = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!target) return;
          var href = target.getAttribute('href') || '';
          var isCall = href.indexOf('tel:') === 0;
          var isWhatsApp = href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1;

          if (isCall || isWhatsApp) {
            var qrAttr = null;
            try {
              qrAttr = JSON.parse(sessionStorage.getItem('orandus_qr_attr') || 'null');
            } catch (err) {}

            var vendorSlug = null;
            if (window.location.pathname.indexOf('/v/') === 0) {
              vendorSlug = window.location.pathname.split('/v/')[1]?.split('/')[0]?.split('?')[0] || null;
            } else {
              var parentVendor = target.closest('[data-vendor-slug]');
              if (parentVendor) vendorSlug = parentVendor.getAttribute('data-vendor-slug');
            }

            var payload = JSON.stringify({
              eventType: isCall ? 'call_click' : 'whatsapp_click',
              source: qrAttr ? qrAttr.source : 'web',
              medium: qrAttr ? qrAttr.medium : 'direct',
              campaign: qrAttr ? qrAttr.campaign : (vendorSlug || 'web_organic'),
              metadata: { href: href, path: window.location.pathname, vendorSlug: vendorSlug }
            });

            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/analytics/event', new Blob([payload], { type: 'application/json' }));
            } else {
              fetch('/api/analytics/event', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: payload,
                keepalive: true
              }).catch(function() {});
            }
          }
        }, { passive: true });
      } catch (err) {}
    })();
  </script>
</body>
