---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}
const {
  title = 'NITKKR Food',
  description = 'Find food around NIT Kurukshetra instantly',
  ogImage = '/og-default.jpg',
  ogUrl = Astro.url.href,
} = Astro.props;

const siteBase = Astro.site || Astro.url.origin || 'https://nitkkr-food.pages.dev';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href;

let customFooterPages: any[] = [];
try {
  const rawD1 = (globalThis as any).DB || 
                (globalThis as any).__CF_ENV__?.DB || 
                (globalThis as any).env?.DB;
  if (rawD1 && typeof rawD1.prepare === 'function') {
    const res = await rawD1.prepare('SELECT title, slug, category, icon FROM custom_pages WHERE show_in_footer = 1 AND is_published = 1 ORDER BY display_order ASC, id ASC').all();
    customFooterPages = res?.results || [];
  }
} catch (e) {}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FF6B35" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>[x-cloak] { display: none !important; }</style>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={resolvedOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />
</head>

<body class="font-body bg-nitkkr-cream text-nitkkr-dark min-h-screen flex flex-col">

  <!-- 📲 Smart PWA Install Top Banner -->
  <div
    x-data="{
      showBanner: false,
      deferredPrompt: null,
      isIOS: false,
      showIOSGuide: false,
      init() {
        if (localStorage.getItem('pwa_dismissed') === 'true') return;
        
        // Detect iOS
        const isIosDevice = /iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase());
        const isInStandaloneMode = ('standalone' in window.navigator) && (window.navigator.standalone);
        
        if (isIosDevice && !isInStandaloneMode) {
          this.isIOS = true;
          this.showBanner = true;
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          this.deferredPrompt = e;
          this.showBanner = true;
        });
      },
      async installPWA() {
        if (this.isIOS) {
          this.showIOSGuide = true;
          return;
        }
        if (!this.deferredPrompt) return;
        this.deferredPrompt.prompt();
        const { outcome } = await this.deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          this.showBanner = false;
        }
        this.deferredPrompt = null;
      },
      dismiss() {
        this.showBanner = false;
        localStorage.setItem('pwa_dismissed', 'true');
      }
    }"
    x-show="showBanner"
    x-cloak
    class="bg-gradient-to-r from-amber-600 via-nitkkr-orange to-rose-600 text-white px-4 py-2.5 shadow-md relative z-50 animate-in slide-in-from-top duration-300"
  >
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 text-xs sm:text-sm">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-base sm:text-lg flex-shrink-0 animate-bounce">📲</span>
        <p class="font-medium truncate">
          <strong class="font-bold">Install NITKKR Food:</strong> Instant menu access & faster WhatsApp orders!
        </p>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <button
          @click="installPWA()"
          class="px-3 py-1 bg-white text-nitkkr-orange font-bold text-xs rounded-lg hover:bg-amber-50 active:scale-95 shadow-sm transition-all cursor-pointer"
        >
          Install App
        </button>
        <button
          @click="dismiss()"
          class="text-white/80 hover:text-white font-bold text-base p-1 leading-none cursor-pointer"
          aria-label="Dismiss banner"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- iOS Add to Home Screen Instructions Modal -->
    <div
      x-show="showIOSGuide"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 text-slate-900"
      @click.self="showIOSGuide = false"
    >
      <div class="bg-white rounded-2xl p-5 max-w-xs w-full text-center shadow-2xl space-y-3">
        <span class="text-3xl">📱</span>
        <h4 class="font-bold text-sm">Install on iPhone / iPad</h4>
        <p class="text-xs text-slate-600 leading-relaxed text-left">
          1. Tap the <strong>Share</strong> button <span class="text-blue-500 font-bold">⎋</span> at the bottom of Safari.<br/>
          2. Scroll down and tap <strong>"Add to Home Screen"</strong> ⊞.<br/>
          3. Tap <strong>Add</strong> in the top right.
        </p>
        <button @click="showIOSGuide = false" class="w-full py-2 bg-nitkkr-orange text-white font-bold text-xs rounded-xl cursor-pointer">Got it!</button>
      </div>
    </div>
  </div>

  <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none" aria-live="polite"></div>
  <main class="flex-1">
    <slot />
  </main>

  <!-- 🌟 Modern Campus Footer -->
  <footer class="border-t border-amber-200/60 bg-white/60 backdrop-blur-xs py-10 mt-auto">
    <div class="max-w-4xl mx-auto px-4 space-y-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 text-xs">
        <!-- Col 1: Brand -->
        <div class="col-span-2 sm:col-span-1 space-y-2">
          <a href="/" class="font-display font-bold text-base text-nitkkr-dark flex items-center gap-1.5">
            <span>🍜</span> NITKKR Food
          </a>
          <p class="text-slate-500 leading-relaxed text-[11px]">
            Instant menu search & direct WhatsApp ordering for NIT Kurukshetra campus.
          </p>
        </div>

        <!-- Col 2: Quick Links -->
        <div class="space-y-2">
          <span class="font-bold text-slate-800 uppercase tracking-wider text-[10px] block">Explore</span>
          <ul class="space-y-1.5 text-slate-600">
            <li><a href="/search" class="hover:text-nitkkr-orange transition-colors">🔍 Search Food</a></li>
            <li><a href="/search?tab=stalls" class="hover:text-nitkkr-orange transition-colors">🏪 Campus Stalls</a></li>
            <li><a href="/how-it-works" class="hover:text-nitkkr-orange transition-colors">📖 How It Works</a></li>
            <li><a href="/about" class="hover:text-nitkkr-orange transition-colors">ℹ️ About Us</a></li>
            {customFooterPages.filter(p => p.category === 'Explore').map((p: any) => (
              <li><a href={`/p/${p.slug}`} class="hover:text-nitkkr-orange transition-colors">{p.icon || '📄'} {p.title}</a></li>
            ))}
          </ul>
        </div>

        <!-- Col 3: Legal & Policy -->
        <div class="space-y-2">
          <span class="font-bold text-slate-800 uppercase tracking-wider text-[10px] block">Trust & Legal</span>
          <ul class="space-y-1.5 text-slate-600">
            <li><a href="/terms" class="hover:text-nitkkr-orange transition-colors">📜 Terms of Service</a></li>
            <li><a href="/privacy" class="hover:text-nitkkr-orange transition-colors">🔒 Privacy Policy</a></li>
            <li><a href="/contact" class="hover:text-nitkkr-orange transition-colors">🏪 List Your Stall</a></li>
            {customFooterPages.filter(p => p.category !== 'Explore').map((p: any) => (
              <li><a href={`/p/${p.slug}`} class="hover:text-nitkkr-orange transition-colors">{p.icon || '📄'} {p.title}</a></li>
            ))}
          </ul>
        </div>
      </div>


      <div class="pt-6 border-t border-slate-200/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-400 text-center sm:text-left">
        <p>© {new Date().getFullYear()} NITKKR Food • Built with ❤️ for NIT Kurukshetra students</p>
        <p class="text-slate-400">Zero Commissions • Direct Vendor Connect</p>
      </div>
    </div>
  </footer>


  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
</body>
</html>