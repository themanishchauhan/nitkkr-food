---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}
const {
  title = 'Orandus - Find Food. See the Menu.',
  description = 'Discover campus food spots, menus, prices and locations in one place.',
  ogImage = '/og-default.jpg',
  ogUrl = Astro.url.href,
} = Astro.props;

const siteBase = Astro.url.origin || Astro.site || 'https://orandus.pages.dev';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href;

import { getAllSiteSettings } from '../lib/queries';
import { getRawD1Binding } from '../lib/db';

let customFooterPages: any[] = [];
let siteSettingsObj: Record<string, string> = {};
try {
  const settings = await getAllSiteSettings();
  const settingsList = Array.isArray(settings) ? settings : [];
  siteSettingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);

  const rawD1 = (Astro.locals as any)?.db || getRawD1Binding();
  if (rawD1 && typeof rawD1.prepare === 'function') {
    const res = await rawD1.prepare('SELECT title, slug, category, icon FROM custom_pages WHERE show_in_footer = 1 AND is_published = 1 ORDER BY display_order ASC, id ASC').all();
    customFooterPages = res?.results || [];
  }
} catch (e) {}

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = currentPath === '/';
const isVendorPage = currentPath.startsWith('/v/');
const cfAnalyticsToken = siteSettingsObj.cloudflare_analytics_token || (import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string) || '769ece91027a424eae4907f4cd2e6d79';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#E87D2E" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- 🍎 Apple iOS PWA & Home Screen Icons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Orandus" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>[x-cloak] { display: none !important; }</style>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={resolvedOgImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <!-- 📊 Cloudflare Web Analytics (Privacy-First & Cookie-less) -->
  {cfAnalyticsToken && (
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}></script>
  )}
</head>

<body class="font-body bg-nitkkr-cream text-nitkkr-dark min-h-screen flex flex-col antialiased">

  <!-- 📲 Smart PWA Install Top Banner -->
  <div
    x-data="{
      showBanner: false,
      deferredPrompt: null,
      isIOS: false,
      showIOSGuide: false,
      init() {
        window.addEventListener('trigger-pwa-install', () => {
          this.installPWA();
        });

        if (localStorage.getItem('pwa_dismissed') === 'true') return;
        
        // Detect iOS
        const isIosDevice = /iphone|ipad|ipod/.test(window.navigator.userAgent.toLowerCase());
        const isInStandaloneMode = ('standalone' in window.navigator) && (window.navigator.standalone);
        
        if (isIosDevice && !isInStandaloneMode) {
          this.isIOS = true;
          this.showBanner = true;
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          this.deferredPrompt = e;
          this.showBanner = true;
        });
      },
      async installPWA() {
        if (this.isIOS) {
          this.showIOSGuide = true;
          return;
        }
        if (!this.deferredPrompt) {
          alert('To install: tap your browser menu and select Add to Home screen');
          return;
        }

        this.deferredPrompt.prompt();
        const { outcome } = await this.deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          this.showBanner = false;
        }
        this.deferredPrompt = null;
      },
      dismiss() {
        this.showBanner = false;
        localStorage.setItem('pwa_dismissed', 'true');
      }
    }"
    x-show="showBanner"
    x-cloak
    class="bg-gradient-to-r from-amber-600 via-nitkkr-orange to-rose-600 text-white px-4 py-2.5 shadow-md relative z-50 animate-in slide-in-from-top duration-300"
  >
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-3 text-xs sm:text-sm">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-base sm:text-lg flex-shrink-0 animate-bounce">📲</span>
        <p class="font-medium truncate">
          <strong class="font-bold">Install Orandus:</strong> Instant campus menu access & direct vendor contact!
        </p>
      </div>

      <div class="flex items-center gap-2 flex-shrink-0">
        <button
          @click="installPWA()"
          class="px-3 py-1 bg-white text-nitkkr-orange font-bold text-xs rounded-lg hover:bg-amber-50 active:scale-95 shadow-sm transition-all cursor-pointer"
        >
          Install App
        </button>
        <button
          @click="dismiss()"
          class="text-white/80 hover:text-white font-bold text-base p-1 leading-none cursor-pointer"
          aria-label="Dismiss banner"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- iOS Add to Home Screen Instructions Modal -->
    <div
      x-show="showIOSGuide"
      x-cloak
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 text-slate-900"
      @click.self="showIOSGuide = false"
    >
      <div class="bg-white rounded-2xl p-5 max-w-xs w-full text-center shadow-2xl space-y-3">
        <span class="text-3xl">📱</span>
        <h4 class="font-bold text-sm">Install on iPhone / iPad</h4>
        <p class="text-xs text-slate-600 leading-relaxed text-left">
          1. Tap the <strong>Share</strong> button <span class="text-blue-500 font-bold">⎋</span> at the bottom of Safari.<br/>
          2. Scroll down and tap <strong>"Add to Home Screen"</strong> ⊞.<br/>
          3. Tap <strong>Add</strong> in the top right.
        </p>
        <button @click="showIOSGuide = false" class="w-full py-2 bg-nitkkr-orange text-white font-bold text-xs rounded-xl cursor-pointer">Got it!</button>
      </div>
    </div>
  </div>


  <!-- 🌟 Sticky Micro-Header for Inner Subpages -->
  {!isHomePage && !isVendorPage && (
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-amber-200/50 shadow-2xs py-2.5 px-4 transition-all">
      <div class="max-w-3xl mx-auto flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 font-display font-bold text-sm text-slate-900 hover:text-nitkkr-orange transition-colors group">
          <span class="w-6 h-6 rounded-lg bg-amber-50 group-hover:bg-amber-100 flex items-center justify-center text-amber-700 transition-colors shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </span>
          <span>Orandus</span>
        </a>
        <div class="flex items-center gap-2">
          {currentPath !== '/search' && (
            <a
              href="/search"
              class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 text-xs font-semibold rounded-xl flex items-center gap-1.5 transition-all shadow-2xs"
            >
              <span>🔍 Search</span>
            </a>
          )}
        </div>
      </div>
    </header>
  )}

  <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none" aria-live="polite"></div>
  <main class="flex-1">
    <slot />
  </main>


  <!-- 🌟 Modern Campus Footer -->
  <footer class="border-t border-amber-200/60 bg-white/60 backdrop-blur-xs py-10 mt-auto">
    <div class="max-w-4xl mx-auto px-4 space-y-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 text-xs">
        <!-- Col 1: Brand -->
        <div class="col-span-2 sm:col-span-1 space-y-2">
          <a href="/" class="font-display font-bold text-base text-nitkkr-dark flex items-center gap-1.5">
            <span>🍜</span> Orandus
          </a>
          <p class="text-slate-500 leading-relaxed text-[11px]">
            {siteSettingsObj.footer_tagline || 'Discover campus food spots, menus, prices and locations in one place.'}
          </p>
        </div>

        <!-- Col 2: Quick Links -->
        <div class="space-y-2">
          <span class="font-bold text-slate-800 uppercase tracking-wider text-[10px] block">Explore</span>
          <ul class="space-y-1.5 text-slate-600">
            <li><a href="/search" class="hover:text-nitkkr-orange transition-colors">🔍 Search Food</a></li>
            <li><a href="/search?tab=vendors" class="hover:text-nitkkr-orange transition-colors">🏪 Food Spots</a></li>
            <li>
              <button
                type="button"
                onclick="window.dispatchEvent(new CustomEvent('trigger-pwa-install'))"
                class="hover:text-nitkkr-orange transition-colors text-left flex items-center gap-1 cursor-pointer"
              >
                📲 Install App
              </button>
            </li>
            <li><a href="/how-it-works" class="hover:text-nitkkr-orange transition-colors">📖 How It Works</a></li>
            <li><a href="/about" class="hover:text-nitkkr-orange transition-colors">ℹ️ About Us</a></li>
            {customFooterPages.filter(p => p.category === 'Explore').map((p: any) => (
              <li><a href={`/p/${p.slug}`} class="hover:text-nitkkr-orange transition-colors">{p.icon || '📄'} {p.title}</a></li>
            ))}
          </ul>

        </div>

        <!-- Col 3: Legal & Policy -->
        <div class="space-y-2">
          <span class="font-bold text-slate-800 uppercase tracking-wider text-[10px] block">Trust & Legal</span>
          <ul class="space-y-1.5 text-slate-600">
            <li><a href="/terms" class="hover:text-nitkkr-orange transition-colors">📜 Terms of Service</a></li>
            <li><a href="/privacy" class="hover:text-nitkkr-orange transition-colors">🔒 Privacy Policy</a></li>
            <li><a href="/contact" class="hover:text-nitkkr-orange transition-colors">📍 Drop Your Food Outlet</a></li>
            <li><a href="mailto:m.chauhan@zohomail.in?subject=Suggestion%20-%20Orandus&body=Hey%20Orandus%20team%2C%0A%0AI%20have%20a%20suggestion%3A%0A%0A" class="hover:text-nitkkr-orange transition-colors">💡 Have a Suggestion?</a></li>
            {customFooterPages.filter(p => p.category !== 'Explore').map((p: any) => (
              <li><a href={`/p/${p.slug}`} class="hover:text-nitkkr-orange transition-colors">{p.icon || '📄'} {p.title}</a></li>
            ))}
          </ul>
        </div>

      </div>


      <div class="pt-6 border-t border-slate-200/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-400 text-center sm:text-left">
        <p>© {new Date().getFullYear()} {siteSettingsObj.company_name || 'Orandus'} • {siteSettingsObj.footer_copyright || siteSettingsObj.footer_copyright_text || 'Find Food. See the Menu.'}</p>
        <p class="text-slate-400">{siteSettingsObj.footer_custom_note || 'Fast menus • Local food • Simple discovery'}</p>
      </div>

    </div>
  </footer>


  <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
</body>
</html>