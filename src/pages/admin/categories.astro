---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<Layout title="Categories Management - NITKKR Food Admin" description="Manage campus food categories">
  <section class="min-h-screen bg-nitkkr-cream flex flex-col lg:flex-row text-nitkkr-dark">
    <div
      x-data="{
        sidebarOpen: false,
        vendors: [],
        categories: [],
        menuItems: [],
        reviews: [],
        showAddModal: false,
        editingCategory: null,
        form: { name: '', icon: '🍽️' },
        saving: false,
        toastMsg: '',

        async init() {
          await this.loadAll();
        },

        showToast(msg) {
          this.toastMsg = msg;
          setTimeout(() => { this.toastMsg = ''; }, 3500);
        },

        async loadAll() {
          try {
            const [cRes, vRes, mRes, rRes] = await Promise.all([
              fetch('/api/admin/categories').catch(() => null),
              fetch('/api/admin/vendors').catch(() => null),
              fetch('/api/admin/menu').catch(() => null),
              fetch('/api/admin/reviews').catch(() => null)
            ]);

            if (cRes && cRes.ok) { const d = await cRes.json(); this.categories = d.categories || []; }
            if (vRes && vRes.ok) { const d = await vRes.json(); this.vendors = d.vendors || []; }
            if (mRes && mRes.ok) { const d = await mRes.json(); this.menuItems = d.items || []; }
            if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
          } catch (e) {
            console.error('Load error', e);
          }
        },

        openAdd() {
          this.editingCategory = null;
          this.form = { name: '', icon: '🍽️' };
          this.showAddModal = true;
        },

        openEdit(c) {
          this.editingCategory = c;
          this.form = { name: c.name, icon: c.icon };
          this.showAddModal = true;
        },

        async saveCategory() {
          if (!this.form.name.trim()) { alert('Category name is required'); return; }
          this.saving = true;
          try {
            const url = '/api/admin/categories';
            const method = this.editingCategory ? 'PATCH' : 'POST';
            const payload = this.editingCategory ? { ...this.form, id: this.editingCategory.id } : this.form;

            const res = await fetch(url, {
              method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              this.showToast(this.editingCategory ? '✅ Category updated!' : '✅ Category created!');
              this.showAddModal = false;
              await this.loadAll();
            } else {
              const d = await res.json();
              alert(d.error || 'Failed to save category');
            }
          } catch (e) {
            alert('Server error');
          } finally {
            this.saving = false;
          }
        },

        async deleteCategory(c) {
          if (!confirm('Delete ' + c.name + '?')) return;
          try {
            const res = await fetch('/api/admin/categories?id=' + c.id, { method: 'DELETE' });
            if (res.ok) {
              this.categories = this.categories.filter(x => x.id !== c.id);
              this.showToast('Category deleted');
            } else {
              alert('Failed to delete category');
            }
          } catch (e) {
            alert('Error deleting category');
          }
        },

        async logout() {
          if (!confirm('Log out from Founder Panel?')) return;
          await fetch('/api/admin/auth', { method: 'DELETE' });
          window.location.href = '/';
        }
      }"
      x-init="init()"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >

      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-nitkkr-dark text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 border border-nitkkr-orange/40"
      >
        <span class="text-base">🔔</span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/categories" />

      <!-- Main Content Area -->
      <main class="flex-1 p-4 sm:p-8 lg:p-10 overflow-y-auto max-w-6xl">
        <div class="space-y-8">

          <!-- Header -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nitkkr-orange/10 border border-nitkkr-orange/20 text-nitkkr-orange text-[11px] font-bold mb-2">
                <span>🍽️</span> Food Taxonomies
              </div>
              <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark">
                Categories Manager
              </h1>
              <p class="text-xs sm:text-sm text-nitkkr-gray mt-1">
                Add and organize food classifications (Fast Food, Chinese, Beverages, North Indian, etc.)
              </p>
            </div>

            <button
              @click="openAdd()"
              class="px-5 py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-2xl shadow-md shadow-nitkkr-orange/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
            >
              <span>➕</span> Add New Category
            </button>
          </div>

          <!-- Categories Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <template x-for="c in categories" :key="c.id">
              <div class="bg-white rounded-3xl border border-nitkkr-orange/20 p-5 space-y-3 shadow-sm hover:border-nitkkr-orange/50 transition-all text-center flex flex-col justify-between">
                <div>
                  <span class="text-4xl block mb-2" x-text="c.icon"></span>
                  <h4 class="font-bold text-sm text-nitkkr-dark" x-text="c.name"></h4>
                  <span class="text-[10px] font-mono text-nitkkr-gray" x-text="'slug: ' + c.slug"></span>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-center gap-3">
                  <button @click="openEdit(c)" class="text-xs text-blue-600 font-bold hover:underline">Edit</button>
                  <button @click="deleteCategory(c)" class="text-xs text-rose-600 font-bold hover:underline">Delete</button>
                </div>
              </div>
            </template>
          </div>

        </div>
      </main>

      <!-- Modal: Add / Edit Category -->
      <div
        x-show="showAddModal"
        x-transition
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
        @click.self="showAddModal = false"
      >
        <div class="bg-white rounded-3xl p-6 max-w-sm w-full space-y-5 border border-nitkkr-orange/30 shadow-2xl">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="font-display text-base font-bold text-nitkkr-dark" x-text="editingCategory ? '✏️ Edit Category' : '🍽️ Add Category'"></h3>
            <button @click="showAddModal = false" class="text-slate-400 hover:text-slate-700 text-lg cursor-pointer">✕</button>
          </div>

          <form @submit.prevent="saveCategory()" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Category Name *</label>
              <input type="text" x-model="form.name" required placeholder="e.g. South Indian" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
            </div>

            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Emoji Icon *</label>
              <input type="text" x-model="form.icon" required placeholder="e.g. 🫓" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t border-slate-100">
              <button type="button" @click="showAddModal = false" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500">Cancel</button>
              <button type="submit" :disabled="saving" class="px-5 py-2 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white rounded-xl text-xs font-bold shadow-sm">
                <span x-show="!saving">Save</span>
                <span x-show="saving">Saving...</span>
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>