---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getCategories, getActiveVendors, getAllMenuItemsForSearch, getAllReviews } from '../../lib/queries';

const initialCategories = await getCategories();
const initialVendors = await getActiveVendors();
const initialMenuItems = await getAllMenuItemsForSearch();
const initialReviews = await getAllReviews();
---

<script is:inline define:vars={{ initialCategories, initialVendors, initialMenuItems, initialReviews }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('categoriesAdmin', () => ({
      sidebarOpen: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      search: '',
      showAddModal: false,
      editingCategory: null,
      form: { name: '', icon: '🍽️' },
      saving: false,
      toastMsg: '',
      popularIcons: ['🍕', '🍔', '🫓', '☕', '🍚', '🍜', '🥗', '🥪', '🥤', '🍰', '🍗', '🍱', '🥟', '🌮', '🍳', '🍫'],

      async init() {
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAll() {
        try {
          const [cRes, vRes, mRes, rRes] = await Promise.all([
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/menu').catch(() => null),
            fetch('/api/admin/reviews').catch(() => null)
          ]);

          if (cRes && cRes.ok) { const d = await cRes.json(); if (d.categories && d.categories.length > 0) this.categories = d.categories; }
          if (vRes && vRes.ok) { const d = await vRes.json(); if (d.vendors && d.vendors.length > 0) this.vendors = d.vendors; }
          if (mRes && mRes.ok) { const d = await mRes.json(); if (d.items && d.items.length > 0) this.menuItems = d.items; }
          if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
        } catch (e) {
          console.error('Load error', e);
        }
      },

      getCategoryDishCount(categoryId) {
        if (!this.menuItems || !Array.isArray(this.menuItems)) return 0;
        return this.menuItems.filter(m => String(m.categoryId) === String(categoryId)).length;
      },

      get filteredCategories() {
        if (!this.search.trim()) return this.categories;
        const q = this.search.toLowerCase();
        return this.categories.filter(c => 
          (c.name && c.name.toLowerCase().includes(q)) || 
          (c.slug && c.slug.toLowerCase().includes(q))
        );
      },

      openAdd() {
        this.editingCategory = null;
        this.form = { name: '', icon: '🍽️' };
        this.showAddModal = true;
      },

      openEdit(c) {
        this.editingCategory = c;
        this.form = { name: c.name, icon: c.icon || '🍽️' };
        this.showAddModal = true;
      },

      selectIcon(emoji) {
        this.form.icon = emoji;
      },

      async saveCategory() {
        if (!this.form.name.trim()) { alert('Category name is required'); return; }
        this.saving = true;
        try {
          const url = '/api/admin/categories';
          const method = this.editingCategory ? 'PATCH' : 'POST';
          const payload = this.editingCategory ? { ...this.form, id: this.editingCategory.id } : this.form;

          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            this.showToast(this.editingCategory ? '✅ Category updated!' : '✅ Category created!');
            this.showAddModal = false;
            await this.loadAll();
          } else {
            const err = await res.json();
            alert('Failed to save category: ' + (err.error || 'Unknown error'));
          }
        } catch (e) {
          alert('Network error while saving category');
        } finally {
          this.saving = false;
        }
      },

      async deleteCategory(c) {
        const dishCount = this.getCategoryDishCount(c.id);
        const confirmMsg = dishCount > 0 
          ? `Category "${c.name}" contains ${dishCount} menu items. Deleting it may detach those dishes. Proceed?` 
          : `Are you sure you want to delete category "${c.name}"?`;
        if (!confirm(confirmMsg)) return;
        try {
          const res = await fetch(`/api/admin/categories?id=${c.id}`, { method: 'DELETE' });
          if (res.ok) {
            this.showToast('✅ Category removed');
            await this.loadAll();
          } else {
            alert('Failed to delete category');
          }
        } catch (e) {
          alert('Network error');
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      }
    }));
  });
</script>

<Layout title="Categories & Taxonomy - Orandus Ops" description="Manage campus food categories and taxonomy">
  <section x-data="categoriesAdmin" class="min-h-screen bg-[#090D15] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    <!-- Toast Notification -->
    <div
      x-show="toastMsg"
      x-transition
      class="fixed bottom-6 right-6 z-50 bg-[#161F30] border border-amber-500/40 text-amber-300 px-4 py-2.5 rounded-xl shadow-2xl font-medium text-xs flex items-center gap-2.5 backdrop-blur-md"
    >
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span x-text="toastMsg"></span>
    </div>

    <!-- Shared Sidebar Component -->
    <AdminSidebar currentPath="/admin/categories" />

    <!-- Main Content Area -->
    <main class="flex-1 p-3.5 sm:p-6 lg:p-7 overflow-y-auto space-y-5 max-w-6xl w-full">
      
      <!-- Header Card -->
      <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold mb-2">
            <span>🍽️</span> Food Taxonomy & Navigation
          </div>
          <h1 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
            Menu Categories
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            Organize dishes into browsable categories across campus search, filter bars, and stall menus.
          </p>
        </div>

        <button
          @click="openAdd()"
          class="px-4 py-2 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs rounded-xl shadow-sm shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
        >
          <span>➕</span> Add Category
        </button>
      </div>

      <!-- Quick Stats & Search -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
          <div>
            <p class="text-[11px] font-medium text-slate-400">Total Categories</p>
            <p class="text-lg font-bold text-white mt-0.5" x-text="categories.length"></p>
          </div>
          <span class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-sm">🗂️</span>
        </div>

        <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
          <div>
            <p class="text-[11px] font-medium text-slate-400">Dishes Categorized</p>
            <p class="text-lg font-bold text-emerald-400 mt-0.5" x-text="menuItems.length"></p>
          </div>
          <span class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm font-bold">🍱</span>
        </div>

        <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3 flex items-center">
          <div class="relative w-full">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-slate-400">🔍</span>
            <input
              type="text"
              x-model="search"
              placeholder="Search category name..."
              class="w-full pl-8 pr-7 py-2 bg-[#0A0F1A] border border-slate-800 rounded-lg text-xs font-medium text-slate-200 placeholder-slate-500 focus:outline-hidden focus:border-amber-500/50"
            />
            <button
              x-show="search"
              @click="search = ''"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs text-slate-500 hover:text-slate-300"
            >✕</button>
          </div>
        </div>
      </div>

      <!-- Categories Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        <template x-for="cat in filteredCategories" :key="cat.id">
          <div class="bg-[#101726] rounded-2xl border border-slate-800/80 p-3.5 shadow-xs hover:border-slate-700 transition-all flex items-center justify-between gap-3 group">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-10 h-10 rounded-xl bg-[#0A0F1A] border border-slate-800 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                <span x-text="cat.icon || '🍽️'"></span>
              </div>
              <div class="min-w-0">
                <h4 class="font-bold text-xs text-slate-100 truncate" x-text="cat.name"></h4>
                <div class="flex items-center gap-2 mt-0.5">
                  <span class="text-[10px] font-mono text-slate-400 truncate" x-text="'/' + cat.slug"></span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-900 border border-slate-800 text-amber-300 font-mono" x-text="getCategoryDishCount(cat.id) + ' dishes'"></span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-1 flex-shrink-0">
              <button @click="openEdit(cat)" title="Edit Category" class="p-1.5 text-slate-400 hover:text-amber-300 rounded-lg hover:bg-slate-800 transition-colors text-xs cursor-pointer">✏️</button>
              <button @click="deleteCategory(cat)" title="Delete Category" class="p-1.5 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition-colors text-xs cursor-pointer">🗑️</button>
            </div>
          </div>
        </template>

        <div x-show="filteredCategories.length === 0" class="col-span-full py-12 text-center text-slate-500 bg-[#101726] border border-slate-800/80 rounded-2xl">
          <p class="text-sm">No categories found matching "<span x-text="search"></span>".</p>
          <button @click="search = ''" class="mt-2 text-xs text-amber-400 hover:underline">Clear Search</button>
        </div>
      </div>

    </main>

    <!-- Modal: Add / Edit Category -->
    <div
      x-show="showAddModal"
      x-transition
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-xs"
      @click.self="showAddModal = false"
    >
      <div class="bg-[#101726] rounded-2xl p-6 max-w-sm w-full space-y-4 border border-slate-800 shadow-2xl text-slate-200">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <h3 class="font-display text-base font-bold text-white" x-text="editingCategory ? '✏️ Edit Category' : '🍽️ Add Category'"></h3>
          <button @click="showAddModal = false" class="text-slate-400 hover:text-slate-200 text-lg cursor-pointer">✕</button>
        </div>

        <form @submit.prevent="saveCategory()" class="space-y-3.5">
          <div>
            <label class="text-xs font-semibold text-slate-300 block mb-1">Category Name *</label>
            <input type="text" x-model="form.name" required placeholder="e.g. South Indian Dosa" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 placeholder-slate-500 focus:outline-hidden focus:border-amber-500/50" />
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-300 block mb-1">Emoji Icon *</label>
            <div class="flex items-center gap-2">
              <input type="text" x-model="form.icon" required placeholder="🫓" class="w-16 text-center px-2 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-lg font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
              <span class="text-[11px] text-slate-400">Quick pick icon:</span>
            </div>
            
            <!-- Quick emoji picker chips -->
            <div class="flex flex-wrap gap-1 mt-2 p-2 bg-[#0A0F1A] border border-slate-800 rounded-xl">
              <template x-for="emoji in popularIcons" :key="emoji">
                <button
                  type="button"
                  @click="selectIcon(emoji)"
                  class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-slate-800 text-sm cursor-pointer transition-transform hover:scale-110"
                  x-text="emoji"
                ></button>
              </template>
            </div>
          </div>

          <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
            <button type="button" @click="showAddModal = false" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-slate-200">Cancel</button>
            <button type="submit" :disabled="saving" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer">
              <span x-show="!saving" x-text="editingCategory ? 'Update' : 'Save'"></span>
              <span x-show="saving">Saving...</span>
            </button>
          </div>
        </form>
      </div>
    </div>

  </section>
</Layout>