---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getActiveVendors, getCategories } from '../../lib/queries';

const initialVendors = await getActiveVendors();
const initialCategories = await getCategories();
---

<script is:inline define:vars={{ initialVendors, initialCategories }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('stallsAdmin', () => ({
      sidebarOpen: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: [],
      reviews: [],
      search: '',
      showAddModal: false,
      editingVendor: null,
      form: { name: '', slug: '', phone: '', whatsapp: '', address: '', description: '', image: '', opensAt: '09:00', closesAt: '23:00', deliversTo: 'Campus wide', isActive: true, isFeatured: false },
      loading: false,
      saving: false,
      toastMsg: '',

      get filteredVendors() {
        if (!this.search.trim()) return this.vendors;
        const q = this.search.toLowerCase();
        return this.vendors.filter(v => 
          (v.name && v.name.toLowerCase().includes(q)) || 
          (v.address && v.address.toLowerCase().includes(q)) || 
          (v.phone && v.phone.includes(q))
        );
      },

      exportCSV() {
        const headers = ['ID', 'Name', 'Phone', 'WhatsApp', 'Address', 'Opens At', 'Closes At', 'Status'];
        const rows = this.filteredVendors.map(v => [
          v.id,
          '"' + (v.name || '').replace(/"/g, '') + '"',
          v.phone || '',
          v.whatsapp || '',
          '"' + (v.address || '').replace(/"/g, '') + '"',
          v.opensAt || '',
          v.closesAt || '',
          v.isActive ? 'Active' : 'Closed'
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', 'orandus_vendors_' + new Date().toISOString().slice(0,10) + '.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      },

      async init() {
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAll() {
        this.loading = true;
        try {
          const [vRes, cRes, mRes, rRes] = await Promise.all([
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/menu').catch(() => null),
            fetch('/api/admin/reviews').catch(() => null)
          ]);

          if (vRes && vRes.ok) { 
            const d = await vRes.json(); 
            if (d.vendors && d.vendors.length > 0) {
              this.vendors = d.vendors;
            }
          }
          if (cRes && cRes.ok) { 
            const d = await cRes.json(); 
            if (d.categories && d.categories.length > 0) {
              this.categories = d.categories;
            }
          }
          if (mRes && mRes.ok) { const d = await mRes.json(); this.menuItems = d.items || []; }
          if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
        } catch (e) {
          console.error('Load error', e);
        } finally {
          this.loading = false;
        }
      },

      openAdd() {
        this.editingVendor = null;
        this.form = { name: '', slug: '', phone: '', whatsapp: '', address: '', description: '', image: '', opensAt: '09:00', closesAt: '23:00', deliversTo: 'Campus wide', isActive: true, isFeatured: false };
        this.showAddModal = true;
      },

      openEdit(v) {
        this.editingVendor = v;
        this.form = {
          name: v.name,
          slug: v.slug,
          phone: v.phone || '',
          whatsapp: v.whatsapp || '',
          address: v.address || '',
          description: v.description || v.notice || '',
          image: v.image || '',
          opensAt: v.opensAt || '09:00',
          closesAt: v.closesAt || '23:00',
          deliversTo: Array.isArray(v.deliversTo) ? v.deliversTo.join(', ') : (v.deliversTo || 'Campus wide'),
          isActive: v.isActive,
          isFeatured: v.isFeatured
        };
        this.showAddModal = true;
      },

      async saveVendor() {
        if (!this.form.name.trim()) { alert('Vendor name is required'); return; }
        this.saving = true;
        try {
          const url = '/api/admin/vendors';
          const method = this.editingVendor ? 'PATCH' : 'POST';
          const payload = {
            ...this.form,
            id: this.editingVendor ? this.editingVendor.id : undefined,
            deliversTo: typeof this.form.deliversTo === 'string' ? this.form.deliversTo.split(',').map(s => s.trim()).filter(Boolean) : this.form.deliversTo
          };

          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            this.showToast(this.editingVendor ? '✅ Vendor updated successfully!' : '✅ New vendor created!');
            this.showAddModal = false;
            await this.loadAll();
          } else {
            const err = await res.json();
            alert('Failed to save vendor: ' + (err.error || 'Unknown error'));
          }
        } catch (e) {
          alert('Network error while saving vendor');
        } finally {
          this.saving = false;
        }
      },

      async toggleStatus(v) {
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: v.id, isActive: !v.isActive })
          });
          if (res.ok) {
            v.isActive = !v.isActive;
            this.showToast(`Vendor ${v.name} is now ${v.isActive ? 'Open' : 'Closed'}`);
          }
        } catch (e) {
          alert('Failed to toggle status');
        }
      },

      async deleteStall(v) {
        if (!confirm(`Are you sure you want to delete "${v.name}" and all its menu dishes?`)) return;
        try {
          const res = await fetch(`/api/admin/vendors?id=${v.id}`, { method: 'DELETE' });
          if (res.ok) {
            this.showToast('✅ Vendor deleted');
            await this.loadAll();
          } else {
            alert('Failed to delete vendor');
          }
        } catch (e) {
          alert('Network error');
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/';
      }
    }));
  });
</script>

<Layout title="Food Spots Fleet - Orandus Ops" description="Manage campus food spots, timings, delivery coverage and availability">
  <section class="min-h-screen bg-[#090D15] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    <div
      x-data="stallsAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >

      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-[#161F30] border border-amber-500/40 text-amber-300 px-4 py-2.5 rounded-xl shadow-2xl font-medium text-xs flex items-center gap-2.5 backdrop-blur-md"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/stalls" />

      <!-- Main Content Area -->
      <main class="flex-1 p-3.5 sm:p-6 lg:p-7 overflow-y-auto space-y-5 max-w-6xl w-full">
        
        <!-- Header -->
        <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold mb-2">
              <span>🏪</span> Campus Fleet Management
            </div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
              Food Spots Directory
            </h1>
            <p class="text-xs text-slate-400 mt-1">
              Configure food stalls, WhatsApp ordering numbers, active hours, and delivery coverage across hostels.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <button
              @click="exportCSV()"
              class="px-3 py-2 bg-[#0A0F1A] border border-slate-800 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2 cursor-pointer"
            >
              <span>📥</span> Export CSV
            </button>
            <button
              @click="openAdd()"
              class="px-4 py-2 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs rounded-xl shadow-sm shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer"
            >
              <span>➕</span> Onboard Spot
            </button>
          </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="flex items-center gap-3">
          <div class="relative flex-1">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-500">🔍</span>
            <input
              type="text"
              x-model="search"
              placeholder="Search by spot name, phone, or location (e.g. 'Food Cave', 'Gate 1')..."
              class="w-full pl-9 pr-4 py-2.5 bg-[#101726] border border-slate-800/80 rounded-xl text-xs font-medium text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500 transition-colors shadow-2xs"
            />
          </div>
        </div>

        <!-- Vendors Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <template x-for="v in filteredVendors" :key="v.id">

            <div class="bg-[#101726] rounded-2xl border border-slate-800/80 p-4 space-y-3.5 shadow-sm hover:border-slate-700 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" :class="v.isActive ? 'bg-emerald-400 shadow-xs shadow-emerald-400/50' : 'bg-rose-500'"></span>
                    <h4 class="font-bold text-sm text-white truncate" x-text="v.name"></h4>
                  </div>
                  <span x-show="v.isFeatured" class="px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30 text-[10px] font-semibold">★ Featured</span>
                </div>

                <p class="text-xs text-slate-400 line-clamp-1" x-text="v.address || 'NIT Kurukshetra'"></p>
                
                <div class="mt-3 space-y-1 text-xs text-slate-300 bg-[#0A0F1A] p-2.5 rounded-xl border border-slate-800/80 font-mono text-[11px]">
                  <p>🕒 <span class="text-slate-300" x-text="v.opensAt + ' – ' + v.closesAt"></span></p>
                  <p x-show="v.whatsapp">💬 <span class="text-emerald-400" x-text="v.whatsapp"></span></p>
                  <p x-show="v.description" class="text-[10px] text-slate-500 italic truncate" x-text="v.description"></p>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
                <button
                  @click="toggleStatus(v)"
                  class="px-3 py-1 rounded-full text-[11px] font-semibold transition-all cursor-pointer border"
                  :class="v.isActive ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30 hover:bg-emerald-500/20' : 'bg-rose-500/10 text-rose-300 border-rose-500/30 hover:bg-rose-500/20'"
                  x-text="v.isActive ? 'Open Now 🟢' : 'Closed 🔴'"
                ></button>

                <div class="flex items-center gap-1">
                  <a :href="'/v/' + v.slug" target="_blank" class="p-1.5 text-slate-400 hover:text-amber-300 transition-colors text-xs font-medium" title="View Live Menu">Menu ↗</a>
                  <button @click="openEdit(v)" class="p-1.5 text-slate-400 hover:text-white font-medium text-xs transition-colors cursor-pointer">Edit</button>
                  <button @click="deleteStall(v)" class="p-1.5 text-slate-500 hover:text-rose-400 text-xs transition-colors cursor-pointer" title="Delete">🗑️</button>
                </div>
              </div>
            </div>
          </template>
        </div>

      </main>

      <!-- Modal: Add / Edit Vendor -->
      <div
        x-show="showAddModal"
        x-transition
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
        @click.self="showAddModal = false"
      >
        <div class="bg-[#101726] rounded-2xl p-6 sm:p-7 max-w-lg w-full space-y-4 border border-slate-800 shadow-2xl max-h-[90vh] overflow-y-auto text-slate-200">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="font-bold text-sm text-white" x-text="editingVendor ? '✏️ Edit Food Spot Details' : '🏪 Onboard New Campus Food Spot'"></h3>
            <button @click="showAddModal = false" class="text-slate-500 hover:text-white text-lg cursor-pointer">✕</button>
          </div>

          <form @submit.prevent="saveVendor()" class="space-y-3.5 text-xs">
            <div>
              <label class="block text-[11px] font-semibold text-slate-400 mb-1">Spot Brand Name *</label>
              <input type="text" x-model="form.name" required class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1">Phone Number</label>
                <input type="text" x-model="form.phone" placeholder="+91 98765 43210" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1">WhatsApp Number</label>
                <input type="text" x-model="form.whatsapp" placeholder="919876543210" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-slate-400 mb-1">Campus Location / Address</label>
              <input type="text" x-model="form.address" placeholder="e.g. Near Gate 1 / Market Complex" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1">Opens At</label>
                <input type="time" x-model="form.opensAt" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white focus:outline-hidden focus:border-amber-500" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 mb-1">Closes At</label>
                <input type="time" x-model="form.closesAt" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white focus:outline-hidden focus:border-amber-500" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-slate-400 mb-1">Special Note / Notice (Displayed on menu)</label>
              <input type="text" x-model="form.description" placeholder="e.g. Closed on Tuesdays • Bulk orders call directly" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-amber-500" />
            </div>

            <div class="flex items-center gap-4 pt-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="form.isActive" class="rounded text-emerald-600 bg-slate-900 border-slate-700">
                <span class="text-xs font-semibold text-emerald-400">Spot Open</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="form.isFeatured" class="rounded text-amber-500 bg-slate-900 border-slate-700">
                <span class="text-xs font-semibold text-amber-300">Featured on Homepage</span>
              </label>
            </div>

            <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
              <button type="button" @click="showAddModal = false" class="px-4 py-2 bg-[#0A0F1A] hover:bg-slate-800 text-slate-400 hover:text-white rounded-xl cursor-pointer">Cancel</button>
              <button type="submit" :disabled="saving" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl cursor-pointer shadow-xs">
                <span x-show="!saving" x-text="editingVendor ? 'Save Changes' : 'Onboard Spot'"></span>
                <span x-show="saving">Saving...</span>
              </button>
            </div>

          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>