---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<Layout title="Menu Items & Prices - NITKKR Food Admin" description="Full CRUD operations for dishes and prices across all campus stalls">
  <section class="min-h-screen bg-nitkkr-cream flex flex-col lg:flex-row text-nitkkr-dark">
    <div
      x-data="{
        sidebarOpen: false,
        vendors: [],
        categories: [],
        menuItems: [],
        reviews: [],
        selectedVendorId: '',
        showAddModal: false,
        editingItem: null,
        form: { vendorId: '', categoryId: '', name: '', price: '', description: '', image: '', isVeg: true, isAvailable: true },
        saving: false,
        toastMsg: '',

        async init() {
          await this.loadAll();
        },

        showToast(msg) {
          this.toastMsg = msg;
          setTimeout(() => { this.toastMsg = ''; }, 3500);
        },

        async loadAll() {
          try {
            const [vRes, cRes, mRes, rRes] = await Promise.all([
              fetch('/api/admin/vendors').catch(() => null),
              fetch('/api/admin/categories').catch(() => null),
              fetch('/api/admin/menu').catch(() => null),
              fetch('/api/admin/reviews').catch(() => null)
            ]);

            if (vRes && vRes.ok) { const d = await vRes.json(); this.vendors = d.vendors || []; }
            if (cRes && cRes.ok) { const d = await cRes.json(); this.categories = d.categories || []; }
            if (mRes && mRes.ok) { const d = await mRes.json(); this.menuItems = d.items || []; }
            if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
          } catch (e) {
            console.error('Load error', e);
          }
        },

        get filteredItems() {
          if (!this.selectedVendorId) return this.menuItems;
          return this.menuItems.filter(m => String(m.vendorId) === String(this.selectedVendorId));
        },

        openAdd() {
          this.editingItem = null;
          this.form = { vendorId: this.selectedVendorId || (this.vendors[0]?.id || ''), categoryId: '', name: '', price: '', description: '', image: '', isVeg: true, isAvailable: true };
          this.showAddModal = true;
        },

        openEdit(item) {
          this.editingItem = item;
          this.form = {
            vendorId: item.vendorId,
            categoryId: item.categoryId || '',
            name: item.name,
            price: item.price,
            description: item.description || '',
            image: item.image || '',
            isVeg: item.isVeg,
            isAvailable: item.isAvailable
          };
          this.showAddModal = true;
        },

        async saveItem() {
          if (!this.form.name.trim() || !this.form.vendorId || !this.form.price) {
            alert('Stall, name, and price are required');
            return;
          }
          this.saving = true;
          try {
            const url = '/api/admin/menu';
            const method = this.editingItem ? 'PATCH' : 'POST';
            const payload = this.editingItem ? { ...this.form, id: this.editingItem.id } : this.form;

            const res = await fetch(url, {
              method,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              this.showToast(this.editingItem ? '✅ Dish updated!' : '✅ Dish added!');
              this.showAddModal = false;
              await this.loadAll();
            } else {
              const d = await res.json();
              alert(d.error || 'Failed to save dish');
            }
          } catch (e) {
            alert('Server error saving dish');
          } finally {
            this.saving = false;
          }
        },

        async deleteItem(item) {
          if (!confirm('Delete ' + item.name + '?')) return;
          try {
            const res = await fetch('/api/admin/menu?id=' + item.id, { method: 'DELETE' });
            if (res.ok) {
              this.menuItems = this.menuItems.filter(x => x.id !== item.id);
              this.showToast('Dish removed');
            } else {
              alert('Failed to delete dish');
            }
          } catch (e) {
            alert('Error deleting dish');
          }
        },

        async logout() {
          if (!confirm('Log out from Founder Panel?')) return;
          await fetch('/api/admin/auth', { method: 'DELETE' });
          window.location.href = '/';
        }
      }"
      x-init="init()"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >

      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-nitkkr-dark text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 border border-nitkkr-orange/40"
      >
        <span class="text-base">🔔</span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/menu-items" />

      <!-- Main Content Area -->
      <main class="flex-1 p-4 sm:p-8 lg:p-10 overflow-y-auto max-w-6xl">
        <div class="space-y-8">

          <!-- Header -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nitkkr-orange/10 border border-nitkkr-orange/20 text-nitkkr-orange text-[11px] font-bold mb-2">
                <span>🍱</span> Dish Catalogs & Pricing
              </div>
              <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark">
                Menu Dishes Manager
              </h1>
              <p class="text-xs sm:text-sm text-nitkkr-gray mt-1">
                Add dishes, update student prices, adjust veg/non-veg tags, and toggle availability.
              </p>
            </div>

            <button
              @click="openAdd()"
              class="px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
            >
              <span>➕</span> Add New Dish
            </button>
          </div>

          <!-- Stall Filter Selector -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-2xl p-4 shadow-sm flex items-center gap-3">
            <span class="text-xs font-bold text-nitkkr-dark">Filter by Stall:</span>
            <select x-model="selectedVendorId" class="px-4 py-2 bg-nitkkr-cream/50 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden">
              <option value="">All Stalls (Total: <span x-text="menuItems.length"></span>)</option>
              <template x-for="v in vendors" :key="v.id">
                <option :value="v.id" x-text="v.name"></option>
              </template>
            </select>
          </div>

          <!-- Dishes Table / Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <template x-for="item in filteredItems" :key="item.id">
              <div class="bg-white rounded-3xl border border-nitkkr-orange/20 p-5 space-y-3 shadow-sm hover:border-emerald-500/50 transition-all flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <div class="flex items-center gap-1.5">
                      <span class="w-3 h-3 rounded-full border" :class="item.isVeg ? 'border-emerald-600 bg-emerald-500' : 'border-rose-600 bg-rose-500'"></span>
                      <h4 class="font-bold text-sm text-nitkkr-dark" x-text="item.name"></h4>
                    </div>
                    <span class="font-display font-bold text-sm text-emerald-700" x-text="'₹' + item.price"></span>
                  </div>

                  <p class="text-xs text-nitkkr-gray line-clamp-2" x-text="item.description || 'Delicious campus preparation'"></p>
                  
                  <div class="pt-2 flex items-center justify-between text-[11px] text-slate-500">
                    <span x-text="item.categoryName || 'General'"></span>
                    <span :class="item.isAvailable ? 'text-emerald-600 font-bold' : 'text-rose-500 font-bold'" x-text="item.isAvailable ? 'In Stock' : 'Out of Stock'"></span>
                  </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-3">
                  <button @click="openEdit(item)" class="text-xs text-blue-600 font-bold hover:underline">Edit Price</button>
                  <button @click="deleteItem(item)" class="text-xs text-rose-600 font-bold hover:underline">Delete</button>
                </div>
              </div>
            </template>
          </div>

        </div>
      </main>

      <!-- Modal: Add / Edit Dish -->
      <div
        x-show="showAddModal"
        x-transition
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
        @click.self="showAddModal = false"
      >
        <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-5 border border-nitkkr-orange/30 shadow-2xl">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="font-display text-lg font-bold text-nitkkr-dark" x-text="editingItem ? '✏️ Edit Dish' : '🍱 Add New Dish'"></h3>
            <button @click="showAddModal = false" class="text-slate-400 hover:text-slate-700 text-lg cursor-pointer">✕</button>
          </div>

          <form @submit.prevent="saveItem()" class="space-y-4">
            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Select Food Stall *</label>
              <select x-model="form.vendorId" required class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden">
                <option value="">-- Choose Stall --</option>
                <template x-for="v in vendors" :key="v.id">
                  <option :value="v.id" x-text="v.name"></option>
                </template>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Dish Name *</label>
                <input type="text" x-model="form.name" required placeholder="e.g. Butter Paneer Paratha" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Price (₹) *</label>
                <input type="number" x-model="form.price" required placeholder="60" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Category</label>
              <select x-model="form.categoryId" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden">
                <option value="">-- Select Category --</option>
                <template x-for="c in categories" :key="c.id">
                  <option :value="c.id" x-text="c.icon + ' ' + c.name"></option>
                </template>
              </select>
            </div>

            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Description</label>
              <input type="text" x-model="form.description" placeholder="Served hot with mint chutney & curd" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
            </div>

            <div class="flex items-center gap-4 pt-2">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="form.isVeg" class="rounded text-emerald-600">
                <span class="text-xs font-bold text-emerald-700">🌱 Pure Veg</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="form.isAvailable" class="rounded text-nitkkr-orange">
                <span class="text-xs font-bold text-nitkkr-dark">Available in Stock</span>
              </label>
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t border-slate-100">
              <button type="button" @click="showAddModal = false" class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-500">Cancel</button>
              <button type="submit" :disabled="saving" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-sm">
                <span x-show="!saving" x-text="editingItem ? 'Save Changes' : 'Add Dish'"></span>
                <span x-show="saving">Saving...</span>
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>
