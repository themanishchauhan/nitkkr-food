---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('pagesAdmin', () => ({
      sidebarOpen: false,
      activeTab: 'custom', // 'custom' | 'policies' | 'footer'
      pages: [],
      search: '',
      loading: false,
      saving: false,
      toastMsg: '',
      showAddModal: false,
      editingPage: null,

      pageForm: {
        title: '',
        slug: '',
        category: 'Explore',
        icon: '📄',
        content: '',
        showInFooter: true,
        isPublished: true,
        displayOrder: 0
      },

      settings: {
        terms_custom_text: '',
        privacy_custom_text: '',
        about_custom_text: '',
        contact_email: 'admin@nitkkr-food.com',
        support_whatsapp: '+91 98765 43210',
        instagram_url: 'https://instagram.com/nitkkr_food',
        footer_tagline: 'Instant menu search & direct WhatsApp ordering for NIT Kurukshetra campus.',
        footer_custom_note: 'Zero Commissions • Direct Vendor Connect',
        footer_copyright: 'Built with ❤️ for NIT Kurukshetra students'
      },
      selectedPolicy: 'terms',

      async init() {
        await Promise.all([this.loadPages(), this.loadSettings()]);
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      get filteredPages() {
        if (!this.search.trim()) return this.pages;
        const q = this.search.toLowerCase();
        return this.pages.filter(p => 
          (p.title && p.title.toLowerCase().includes(q)) || 
          (p.slug && p.slug.toLowerCase().includes(q)) || 
          (p.category && p.category.toLowerCase().includes(q))
        );
      },

      async loadPages() {
        this.loading = true;
        try {
          const res = await fetch('/api/admin/custom-pages');
          if (res.ok) {
            const data = await res.json();
            this.pages = data.pages || [];
          }
        } catch (e) {
          console.error('Error loading custom pages', e);
        } finally {
          this.loading = false;
        }
      },

      async loadSettings() {
        try {
          const res = await fetch('/api/admin/settings');
          if (res.ok) {
            const data = await res.json();
            this.settings = Object.assign({}, this.settings, data.settings || {});
          }
        } catch (e) {
          console.error('Error loading settings', e);
        }
      },

      openAdd() {
        this.editingPage = null;
        this.pageForm = {
          title: '',
          slug: '',
          category: 'Explore',
          icon: '📄',
          content: '',
          showInFooter: true,
          isPublished: true,
          displayOrder: 0
        };
        this.showAddModal = true;
      },

      openEdit(p) {
        this.editingPage = p;
        this.pageForm = {
          title: p.title,
          slug: p.slug,
          category: p.category || 'Explore',
          icon: p.icon || '📄',
          content: p.content || '',
          showInFooter: p.showInFooter !== false,
          isPublished: p.isPublished !== false,
          displayOrder: p.displayOrder || 0
        };
        this.showAddModal = true;
      },

      autoGenerateSlug() {
        if (!this.editingPage && this.pageForm.title) {
          this.pageForm.slug = this.pageForm.title
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }
      },

      async saveCustomPage() {
        if (!this.pageForm.title.trim() || !this.pageForm.content.trim()) {
          alert('Page title and content are required');
          return;
        }
        this.saving = true;
        try {
          const method = this.editingPage ? 'PATCH' : 'POST';
          const payload = this.editingPage ? { ...this.pageForm, id: this.editingPage.id } : this.pageForm;

          const res = await fetch('/api/admin/custom-pages', {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            this.showToast(this.editingPage ? '✅ Page updated successfully!' : '🎉 New page published live!');
            this.showAddModal = false;
            await this.loadPages();
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Failed to save page');
          }
        } catch (e) {
          alert('Server error saving page');
        } finally {
          this.saving = false;
        }
      },

      async deletePage(p) {
        if (!confirm('Are you sure you want to delete "' + p.title + '"? Live URL /p/' + p.slug + ' will be removed.')) return;
        try {
          const res = await fetch('/api/admin/custom-pages?id=' + p.id, { method: 'DELETE' });
          if (res.ok) {
            this.pages = this.pages.filter(x => x.id !== p.id);
            this.showToast('🗑️ Page removed');
          } else {
            alert('Failed to delete page');
          }
        } catch (e) {
          alert('Error deleting page');
        }
      },

      async savePolicySettings() {
        this.saving = true;
        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: this.settings })
          });
          if (res.ok) {
            this.showToast('✅ Policy content saved live on the website!');
          } else {
            alert('Failed to save policy settings');
          }
        } catch (e) {
          alert('Error saving policy settings');
        } finally {
          this.saving = false;
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/';
      }
    }));
  });
</script>

<Layout title="Footer Pages & Custom Content Hub - NITKKR Food Admin" description="Full CRUD operations for custom pages and footer legal policies">
  <section class="min-h-screen bg-nitkkr-cream flex flex-col lg:flex-row text-nitkkr-dark">
    
    <div
      x-data="pagesAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >

      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-nitkkr-dark text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 border border-nitkkr-orange/40"
      >
        <span class="text-base">🔔</span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/pages" />

      <!-- Main Content Area -->
      <main class="flex-1 p-4 sm:p-8 lg:p-10 overflow-y-auto max-w-6xl">
        <div class="space-y-8">

          <!-- Header -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nitkkr-orange/10 border border-nitkkr-orange/20 text-nitkkr-orange text-[11px] font-bold mb-2">
                <span>📄</span> Custom Pages & Footer Navigation Engine
              </div>
              <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark">
                Pages & Legal Policies Hub
              </h1>
              <p class="text-xs sm:text-sm text-nitkkr-gray mt-1">
                Create custom campus pages, manage live links, edit legal policies, and customize footer sections.
              </p>
            </div>

            <div class="flex items-center gap-3">
              <button
                x-show="activeTab === 'custom'"
                @click="openAdd()"
                class="px-5 py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-2xl shadow-md shadow-nitkkr-orange/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
              >
                <span>➕</span> Create New Page
              </button>

              <button
                x-show="activeTab !== 'custom'"
                @click="savePolicySettings()"
                :disabled="saving"
                class="px-6 py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-2xl shadow-md shadow-nitkkr-orange/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
              >
                <span x-text="saving ? 'Saving...' : '💾 Save Changes'"></span>
              </button>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="flex flex-wrap gap-2 pb-2">
            <button
              @click="activeTab = 'custom'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'custom' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>📑</span> Custom Dynamic Pages (<span x-text="pages.length"></span>)
            </button>

            <button
              @click="activeTab = 'policies'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'policies' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>📜</span> Core Policies (Terms, Privacy, About)
            </button>

            <button
              @click="activeTab = 'footer'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'footer' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🦶</span> Global Footer Branding
            </button>
          </div>

          <!-- TAB 1: CUSTOM PAGES CRUD -->
          <div x-show="activeTab === 'custom'" class="space-y-6">
            
            <!-- Search Filter Bar -->
            <div class="bg-white border border-nitkkr-orange/20 rounded-2xl p-4 shadow-xs flex items-center gap-3">
              <span class="text-slate-400">🔍</span>
              <input
                type="text"
                x-model="search"
                placeholder="Search custom pages by title, slug, or section..."
                class="w-full bg-transparent text-xs font-semibold text-nitkkr-dark placeholder-slate-400 focus:outline-hidden"
              />
            </div>

            <!-- Custom Pages List Table -->
            <div class="bg-white border border-nitkkr-orange/20 rounded-3xl overflow-hidden shadow-sm">
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                  <thead class="bg-nitkkr-cream/60 border-b border-nitkkr-orange/20 text-nitkkr-gray font-bold uppercase tracking-wider text-[10px]">
                    <tr>
                      <th class="p-4 sm:px-6">Page Title & Slug</th>
                      <th class="p-4">Footer Column</th>
                      <th class="p-4">Status</th>
                      <th class="p-4">Live URL</th>
                      <th class="p-4 text-right sm:px-6">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <template x-for="p in filteredPages" :key="p.id">
                      <tr class="hover:bg-amber-50/40 transition-colors">
                        <td class="p-4 sm:px-6 font-bold text-nitkkr-dark">
                          <div class="flex items-center gap-2.5">
                            <span class="text-lg" x-text="p.icon || '📄'"></span>
                            <div>
                              <span class="block text-sm" x-text="p.title"></span>
                              <span class="text-[11px] text-nitkkr-gray font-mono font-normal" x-text="'/p/' + p.slug"></span>
                            </div>
                          </div>
                        </td>
                        <td class="p-4">
                          <span class="px-2.5 py-1 bg-nitkkr-cream text-nitkkr-dark font-bold text-[11px] rounded-lg border border-nitkkr-orange/20" x-text="p.category || 'Explore'"></span>
                          <span x-show="p.showInFooter" class="ml-1 text-[10px] text-emerald-600 font-bold" title="Visible in footer">🦶 In Footer</span>
                        </td>
                        <td class="p-4">
                          <span
                            class="px-2 py-0.5 rounded-full font-bold text-[10px]"
                            :class="p.isPublished ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-500'"
                            x-text="p.isPublished ? 'Published 🟢' : 'Draft ⚪'"
                          ></span>
                        </td>
                        <td class="p-4">
                          <a
                            :href="'/p/' + p.slug"
                            target="_blank"
                            class="text-nitkkr-orange hover:underline font-bold text-xs inline-flex items-center gap-1"
                          >
                            View Page ↗
                          </a>
                        </td>
                        <td class="p-4 sm:px-6 text-right space-x-2 whitespace-nowrap">
                          <button
                            @click="openEdit(p)"
                            class="px-3 py-1.5 bg-nitkkr-cream hover:bg-nitkkr-orange/10 border border-nitkkr-orange/30 text-nitkkr-dark rounded-xl font-bold text-[11px] transition-colors cursor-pointer"
                          >
                            ✏️ Edit
                          </button>
                          <button
                            @click="deletePage(p)"
                            class="px-3 py-1.5 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 rounded-xl font-bold text-[11px] transition-colors cursor-pointer"
                          >
                            🗑️ Delete
                          </button>
                        </td>
                      </tr>
                    </template>

                    <tr x-show="filteredPages.length === 0">
                      <td colspan="5" class="p-12 text-center text-nitkkr-gray">
                        <span class="text-3xl block mb-2">📑</span>
                        <span class="font-bold block text-nitkkr-dark">No custom pages found</span>
                        <span class="text-xs text-slate-400 mt-1 block">Click "+ Create New Page" to add custom content or hostel guides.</span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

          </div>

          <!-- TAB 2: CORE POLICIES -->
          <div x-show="activeTab === 'policies'" class="space-y-6">
            
            <!-- Policy Switcher -->
            <div class="flex gap-2">
              <button
                @click="selectedPolicy = 'terms'"
                class="px-4 py-2 rounded-xl font-bold text-xs transition-colors cursor-pointer"
                :class="selectedPolicy === 'terms' ? 'bg-nitkkr-dark text-white' : 'bg-white border border-slate-200 text-slate-700'"
              >
                📜 Terms (/terms)
              </button>
              <button
                @click="selectedPolicy = 'privacy'"
                class="px-4 py-2 rounded-xl font-bold text-xs transition-colors cursor-pointer"
                :class="selectedPolicy === 'privacy' ? 'bg-nitkkr-dark text-white' : 'bg-white border border-slate-200 text-slate-700'"
              >
                🔒 Privacy (/privacy)
              </button>
              <button
                @click="selectedPolicy = 'about'"
                class="px-4 py-2 rounded-xl font-bold text-xs transition-colors cursor-pointer"
                :class="selectedPolicy === 'about' ? 'bg-nitkkr-dark text-white' : 'bg-white border border-slate-200 text-slate-700'"
              >
                ℹ️ About Us (/about)
              </button>
            </div>

            <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
              <div x-show="selectedPolicy === 'terms'">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                  <h3 class="font-display text-base font-bold text-nitkkr-dark">📜 Terms of Service Editor</h3>
                  <a href="/terms" target="_blank" class="text-nitkkr-orange text-xs underline font-bold">Preview Live ↗</a>
                </div>
                <textarea
                  x-model="settings.terms_custom_text"
                  rows="12"
                  class="w-full p-4 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-2xl text-xs font-mono text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange leading-relaxed"
                  placeholder="Custom student terms and food safety guidelines..."
                ></textarea>
              </div>

              <div x-show="selectedPolicy === 'privacy'">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                  <h3 class="font-display text-base font-bold text-nitkkr-dark">🔒 Privacy Policy Editor</h3>
                  <a href="/privacy" target="_blank" class="text-nitkkr-orange text-xs underline font-bold">Preview Live ↗</a>
                </div>
                <textarea
                  x-model="settings.privacy_custom_text"
                  rows="12"
                  class="w-full p-4 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-2xl text-xs font-mono text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange leading-relaxed"
                  placeholder="Custom privacy and data protection clauses..."
                ></textarea>
              </div>

              <div x-show="selectedPolicy === 'about'">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                  <h3 class="font-display text-base font-bold text-nitkkr-dark">ℹ️ About Us & Campus Story</h3>
                  <a href="/about" target="_blank" class="text-nitkkr-orange text-xs underline font-bold">Preview Live ↗</a>
                </div>
                <textarea
                  x-model="settings.about_custom_text"
                  rows="12"
                  class="w-full p-4 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-2xl text-xs font-mono text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange leading-relaxed"
                  placeholder="Describe your student mission and campus food ecosystem..."
                ></textarea>
              </div>
            </div>

          </div>

          <!-- TAB 3: FOOTER BRANDING -->
          <div x-show="activeTab === 'footer'" class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
            <div class="pb-3 border-b border-slate-100">
              <h3 class="font-display text-lg font-bold text-nitkkr-dark">🏷️ Global Footer Branding</h3>
              <p class="text-xs text-nitkkr-gray">Controls text and links rendered across the bottom of every page</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Footer Tagline</label>
                <input type="text" x-model="settings.footer_tagline" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Footer Custom Highlight Note</label>
                <input type="text" x-model="settings.footer_custom_note" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Copyright Line</label>
                <input type="text" x-model="settings.footer_copyright" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>
            </div>
          </div>

        </div>
      </main>

      <!-- ➕ CREATE / EDIT CUSTOM PAGE MODAL -->
      <div
        x-show="showAddModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 overflow-y-auto"
      >
        <div
          @click.outside="showAddModal = false"
          class="bg-white rounded-3xl p-6 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto space-y-5 shadow-2xl border border-nitkkr-orange/30 text-nitkkr-dark"
        >
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
              <span class="text-[11px] font-bold text-nitkkr-orange uppercase tracking-wider block">Custom Page Studio</span>
              <h3 class="font-display text-xl font-bold text-nitkkr-dark" x-text="editingPage ? 'Edit Page: ' + editingPage.title : 'Create New Custom Page'"></h3>
            </div>
            <button @click="showAddModal = false" class="text-slate-400 hover:text-slate-600 text-xl font-bold cursor-pointer">✕</button>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div class="sm:col-span-3">
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Page Title *</label>
                <input
                  type="text"
                  x-model="pageForm.title"
                  @input="autoGenerateSlug()"
                  placeholder="e.g. Hostel Late-Night Food Rules"
                  class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden"
                />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Icon</label>
                <input
                  type="text"
                  x-model="pageForm.icon"
                  placeholder="🌙"
                  class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark text-center focus:outline-hidden"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">URL Slug * (Live at /p/[slug])</label>
                <input
                  type="text"
                  x-model="pageForm.slug"
                  placeholder="hostel-rules"
                  class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-mono font-semibold text-nitkkr-dark focus:outline-hidden"
                />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Footer Section</label>
                <select x-model="pageForm.category" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden">
                  <option value="Explore">Explore Column</option>
                  <option value="Trust & Legal">Trust & Legal Column</option>
                  <option value="Campus Info">Campus Info Column</option>
                </select>
              </div>
            </div>

            <div>
              <label class="text-xs font-bold text-nitkkr-dark block mb-1">Page Body Content (Markdown supported) *</label>
              <textarea
                x-model="pageForm.content"
                rows="8"
                class="w-full p-4 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-2xl text-xs font-mono text-nitkkr-dark focus:outline-hidden focus:border-nitkkr-orange leading-relaxed"
                placeholder="# Welcome to our campus guide...&#10;&#10;Here are the details for NITKKR students:&#10;- Delivery timings: 10 PM to 3 AM&#10;- Direct stall WhatsApp connect"
              ></textarea>
            </div>

            <div class="flex flex-wrap items-center gap-6 pt-2">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="pageForm.showInFooter" class="rounded text-nitkkr-orange" />
                <span class="text-xs font-bold text-nitkkr-dark">Show link in website footer</span>
              </label>

              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="pageForm.isPublished" class="rounded text-emerald-600" />
                <span class="text-xs font-bold text-emerald-700">Published (Visible to students)</span>
              </label>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
            <button
              @click="showAddModal = false"
              class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl cursor-pointer"
            >
              Cancel
            </button>
            <button
              @click="saveCustomPage()"
              :disabled="saving"
              class="px-6 py-2.5 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl shadow-xs transition-colors cursor-pointer"
            >
              <span x-text="saving ? 'Saving...' : (editingPage ? 'Save Changes' : 'Publish Page')"></span>
            </button>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>
