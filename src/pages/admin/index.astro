          <div>
            <label class="block text-[11px] font-semibold text-slate-400 mb-1">Description</label>
            <input type="text" x-model="newDish.description" placeholder="Served fresh with mint chutney and curd" class="w-full px-3 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-hidden focus:border-emerald-500" />
          </div>

          <div class="flex items-center gap-4 pt-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" x-model="newDish.isVeg" class="rounded text-emerald-600 bg-slate-900 border-slate-700">
              <span class="text-xs font-bold text-emerald-400">🌱 Pure Veg</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" x-model="newDish.isAvailable" class="rounded text-amber-500 bg-slate-900 border-slate-700">
              <span class="text-xs font-semibold text-slate-300">In Stock</span>
            </label>
          </div>

          <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
            <button type="button" @click="showAddDishModal = false" class="px-4 py-2 bg-[#0A0F1A] hover:bg-slate-800 text-slate-400 hover:text-white rounded-xl cursor-pointer">Cancel</button>
            <button type="submit" :disabled="savingDish" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl cursor-pointer shadow-xs">
              <span x-show="!savingDish">Deploy Item</span>
              <span x-show="savingDish">Saving...</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ✏️ Modal 3: Fast Numeric Price Editor -->
    <div
      x-show="showPriceModal"
      x-transition
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
      @click.self="showPriceModal = false"
      @keydown.escape.window="showPriceModal = false"
    >
      <div class="bg-[#101726] border border-slate-800 rounded-2xl p-6 max-w-sm w-full space-y-4 shadow-2xl text-slate-200" @keydown.enter="savePriceModal()">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <div>
            <h3 class="font-bold text-sm text-white flex items-center gap-1.5">
              <span>✏️</span> Quick Price Adjuster
            </h3>
            <span class="text-[11px] text-slate-400 truncate block max-w-xs" x-text="editingPriceDish ? editingPriceDish.name : ''"></span>
          </div>
          <button @click="showPriceModal = false" class="text-slate-500 hover:text-white cursor-pointer font-bold">✕</button>
        </div>

        <div class="space-y-3 text-xs">
          <div>
            <label class="block text-[11px] font-semibold text-slate-400 mb-1">Student Price (₹ INR)</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 font-mono text-base font-bold text-amber-300">₹</span>
              <input
                type="number"
                x-model="tempPrice"
                x-ref="priceInput"
                min="1"
                step="1"
                class="w-full pl-8 pr-4 py-2.5 bg-[#0A0F1A] border border-slate-700 rounded-xl text-lg font-mono font-bold text-white focus:outline-hidden focus:border-amber-500"
              />
            </div>
          </div>

          <!-- Quick delta chips -->
          <div class="space-y-1.5">
            <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Quick Adjustments</span>
            <div class="grid grid-cols-5 gap-1.5 text-center font-mono text-xs">
              <button @click="adjustTempPrice(-10)" class="py-1 bg-[#162034] hover:bg-slate-800 rounded-lg text-rose-300 border border-slate-700/80 cursor-pointer">-₹10</button>
              <button @click="adjustTempPrice(-5)" class="py-1 bg-[#162034] hover:bg-slate-800 rounded-lg text-rose-300 border border-slate-700/80 cursor-pointer">-₹5</button>
              <button @click="adjustTempPrice(5)" class="py-1 bg-[#162034] hover:bg-slate-800 rounded-lg text-emerald-300 border border-slate-700/80 cursor-pointer">+₹5</button>
              <button @click="adjustTempPrice(10)" class="py-1 bg-[#162034] hover:bg-slate-800 rounded-lg text-emerald-300 border border-slate-700/80 cursor-pointer">+₹10</button>
              <button @click="adjustTempPrice(20)" class="py-1 bg-[#162034] hover:bg-slate-800 rounded-lg text-emerald-300 border border-slate-700/80 cursor-pointer">+₹20</button>
            </div>
          </div>

          <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
            <button type="button" @click="showPriceModal = false" class="px-3 py-1.5 bg-[#0A0F1A] hover:bg-slate-800 text-slate-400 hover:text-white rounded-xl cursor-pointer">Cancel</button>
            <button
              type="button"
              @click="savePriceModal()"
              :disabled="savingPrice"
              class="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl cursor-pointer shadow-xs"
            >
              <span x-show="!savingPrice">Save Price (↵)</span>
              <span x-show="savingPrice">Saving...</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ⚡ Modal 4: Pro Command Palette (Cmd + K or /) -->
    <div
      x-show="commandPaletteOpen"
      x-transition
      class="fixed inset-0 z-50 flex items-start justify-center p-4 pt-16 sm:pt-24 bg-black/80 backdrop-blur-md"
      @click.self="commandPaletteOpen = false"
      @keydown.escape.window="commandPaletteOpen = false"
    >
      <div class="bg-[#101726] border border-slate-700/80 rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden text-slate-200">
        
        <!-- Search Input Bar -->
        <div class="p-3.5 border-b border-slate-800 flex items-center gap-3 bg-[#0C111D]">
          <span class="text-slate-400 text-base">🔍</span>
          <input
            type="text"
            x-model="commandQuery"
            x-ref="commandInput"
            placeholder="Type a command, stall name, dish, or route... (Esc to exit)"
            class="w-full bg-transparent text-sm text-white placeholder-slate-500 focus:outline-hidden"
          />
          <kbd class="text-[10px] font-mono px-1.5 py-0.5 bg-slate-900 border border-slate-800 rounded text-slate-400">Esc</kbd>
        </div>

        <!-- Results Viewport -->
        <div class="max-h-96 overflow-y-auto p-2 space-y-3 text-xs">
          
          <!-- Actions -->
          <template x-if="commandResults.actions && commandResults.actions.length > 0">
            <div>
              <span class="px-2.5 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Quick Actions</span>
              <div class="space-y-0.5">
                <template x-for="(act, idx) in commandResults.actions" :key="idx">
                  <div
                    @click="act.action ? act.action() : (act.url ? window.open(act.url, '_blank') : null)"
                    class="p-2.5 rounded-xl hover:bg-[#162034] flex items-center justify-between cursor-pointer group transition-colors"
                  >
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="text-sm" x-text="act.icon"></span>
                      <div class="truncate">
                        <span class="font-medium text-white group-hover:text-amber-300 block truncate" x-text="act.title"></span>
                        <span class="text-[10px] text-slate-400 truncate block" x-text="act.subtitle"></span>
                      </div>
                    </div>
                    <span class="text-slate-500 group-hover:text-amber-400 font-mono text-[11px]">&rarr;</span>
                  </div>
                </template>
              </div>
            </div>
          </template>

          <!-- Matching Stalls -->
          <template x-if="commandResults.vendors && commandResults.vendors.length > 0">
            <div>
              <span class="px-2.5 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Matching Food Spots</span>
              <div class="space-y-0.5">
                <template x-for="v in commandResults.vendors" :key="v.id">
                  <div
                    @click="activeTab = 'fleet'; expandedVendorId = v.id; commandPaletteOpen = false;"
                    class="p-2.5 rounded-xl hover:bg-[#162034] flex items-center justify-between cursor-pointer group transition-colors"
                  >
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="text-sm">🏪</span>
                      <div class="truncate">
                        <span class="font-medium text-white group-hover:text-amber-300 block truncate" x-text="v.title"></span>
                        <span class="text-[10px] text-slate-400 truncate block" x-text="v.subtitle"></span>
                      </div>
                    </div>
                    <span class="text-[11px] text-amber-400 font-medium">Inspect &rarr;</span>
                  </div>
                </template>
              </div>
            </div>
          </template>

          <!-- Matching Dishes -->
          <template x-if="commandResults.dishes && commandResults.dishes.length > 0">
            <div>
              <span class="px-2.5 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Matching Dishes</span>
              <div class="space-y-0.5">
                <template x-for="(d, idx) in commandResults.dishes" :key="idx">
                  <div
                    @click="openPriceModal(d.dish); commandPaletteOpen = false;"
                    class="p-2.5 rounded-xl hover:bg-[#162034] flex items-center justify-between cursor-pointer group transition-colors"
                  >
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="text-sm">🍱</span>
                      <div class="truncate">
                        <span class="font-medium text-white group-hover:text-emerald-300 block truncate" x-text="d.title"></span>
                        <span class="text-[10px] text-slate-400 truncate block" x-text="d.subtitle"></span>
                      </div>
                    </div>
                    <span class="text-[11px] text-amber-300 font-mono font-bold">Edit Price ✏️</span>
                  </div>
                </template>
              </div>
            </div>
          </template>

          <!-- Navigation Shortcuts -->
          <template x-if="commandResults.nav && commandResults.nav.length > 0">
            <div>
              <span class="px-2.5 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Navigation Routes</span>
              <div class="grid grid-cols-2 gap-1">
                <template x-for="(n, idx) in commandResults.nav" :key="idx">
                  <div
                    @click="if (n.tab) { activeTab = n.tab; commandPaletteOpen = false; } else if (n.url) { window.location.href = n.url; }"
                    class="p-2 rounded-xl hover:bg-[#162034] flex items-center gap-2 cursor-pointer group transition-colors border border-transparent hover:border-slate-700/60"
                  >
                    <span class="text-sm" x-text="n.icon"></span>
                    <span class="font-medium text-slate-300 group-hover:text-white truncate" x-text="n.title"></span>
                  </div>
                </template>
              </div>
            </div>
          </template>

        </div>

        <!-- Footer Shortcuts Guide -->
        <div class="p-2.5 bg-[#0C111D] border-t border-slate-800 flex items-center justify-between text-[10px] text-slate-500 font-mono">
          <div class="flex items-center gap-3">
            <span>[1-5] Switch Tabs</span>
            <span>[N] New Stall</span>
            <span>[D] New Dish</span>
            <span>[B] Broadcast</span>
          </div>
          <span>[Esc] Close</span>
        </div>

      </div>
    </div>

    <!-- ⌨️ Modal 5: Keyboard Shortcuts Reference Cheat Sheet -->
    <div
      x-show="showShortcutsModal"
      x-transition
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
      @click.self="showShortcutsModal = false"
      @keydown.escape.window="showShortcutsModal = false"
    >
      <div class="bg-[#101726] border border-slate-800 rounded-2xl p-6 max-w-md w-full space-y-4 shadow-2xl text-slate-200">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <h3 class="font-bold text-sm text-white flex items-center gap-2">
            <span>⌨️</span> Bloomberg Operations Hotkeys
          </h3>
          <button @click="showShortcutsModal = false" class="text-slate-500 hover:text-white cursor-pointer font-bold">✕</button>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Command Palette</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-amber-300 font-mono text-[11px]">⌘K or /</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Food Spots Fleet Matrix</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">1</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Catalog Dishes Explorer</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">2</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Live Campus Telemetry</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">3</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Pricing & Analytics Intel</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">4</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Catalog Health & Diagnostics</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">5</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Onboard New Stall</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-amber-400 font-mono text-[11px]">N</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Add New Menu Dish</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-emerald-400 font-mono text-[11px]">D</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Toggle Campus Broadcast Bar</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">B</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5 border-b border-slate-850">
            <span class="text-slate-300">Sync & Refresh Data</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-300 font-mono text-[11px]">R</kbd>
          </div>
          <div class="flex items-center justify-between py-1.5">
            <span class="text-slate-300">Close Active Modal</span>
            <kbd class="px-2 py-0.5 bg-slate-900 border border-slate-700 rounded text-slate-400 font-mono text-[11px]">Esc</kbd>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-800 flex justify-end">
          <button @click="showShortcutsModal = false" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs cursor-pointer">
            Got it!
          </button>
        </div>
      </div>
    </div>

  </section>
</Layout>