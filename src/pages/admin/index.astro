---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { 
  getActiveVendors, 
  getCategories, 
  getAllSiteSettings, 
  getAllMenuItemsForSearch, 
  getAllReviews, 
  getQrAnalyticsData 
} from '../../lib/queries';

const initialVendors = await getActiveVendors();
const initialCategories = await getCategories();
const initialMenuItems = await getAllMenuItemsForSearch();
const initialReviews = await getAllReviews();
const rawSettings = await getAllSiteSettings();
const initialSettingsList = Array.isArray(rawSettings) ? rawSettings : [];
const initialSettingsObj = initialSettingsList.reduce((acc: any, s: any) => { 
  if (s && s.key) acc[s.key] = s.value; 
  return acc; 
}, {} as Record<string, string>);
const initialQrStats = await getQrAnalyticsData();
---

<script is:inline define:vars={{ initialVendors, initialCategories, initialMenuItems, initialReviews, initialSettingsObj, initialQrStats }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('dashboardAdmin', () => ({
      sidebarOpen: false,
      loading: false,
      activeTab: 'fleet', // 'fleet' | 'dishes' | 'telemetry' | 'analytics'
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      qrStats: initialQrStats || { totalScans: 0, totalCalls: 0, totalWhatsApp: 0, totalInstalls: 0, campaigns: [], recentEvents: [] },
      settings: {
        homepage_title: initialSettingsObj.homepage_title || 'Stop Asking “Bhai, Menu Bhej.”',
        homepage_tagline: initialSettingsObj.homepage_tagline || 'Find campus food, menus and prices in seconds.',
        announcement_banner_enabled: initialSettingsObj.announcement_banner_enabled || 'false',
        announcement_banner_text: initialSettingsObj.announcement_banner_text || '',
        announcement_banner_type: initialSettingsObj.announcement_banner_type || 'info',
        ad_banner_enabled: initialSettingsObj.ad_banner_enabled || 'false',
        ad_banner_badge: initialSettingsObj.ad_banner_badge || '⚡ SPONSORED DEAL',
        ad_banner_title: initialSettingsObj.ad_banner_title || '',
        ad_banner_description: initialSettingsObj.ad_banner_description || '',
        ad_banner_cta: initialSettingsObj.ad_banner_cta || 'Claim Offer 💬',
        ad_banner_link: initialSettingsObj.ad_banner_link || '#'
      },
      analyticsData: null,
      currentTime: '',
      currentDate: '',
      
      // Global Search
      globalSearch: '',
      
      // Fleet Filters & Expanded Row
      vendorZoneFilter: 'all', // 'all' | 'gate1' | 'gate2' | 'late_night' | 'open' | 'featured'
      expandedVendorId: null,

      // Dish Explorer Filters
      dishSearch: '',
      dishVendorFilter: '',
      dishPriceFilter: 'all', // 'all' | 'under50' | '50to100' | '100to200' | 'above200'
      dishDietFilter: 'all', // 'all' | 'veg' | 'nonveg'
      dishPage: 1,
      dishPageSize: 20,

      // Telemetry Filters
      telemetryFilter: 'all', // 'all' | 'qr_scan' | 'call_click' | 'whatsapp_click' | 'pwa_install'

      // Announcement quick-editor
      showBroadcastBar: false,
      savingBroadcast: false,

      // Modals & Tools
      showAddStallModal: false,
      showAddDishModal: false,
      savingStall: false,
      savingDish: false,
      toastMsg: '',
      
      // Pro Command Palette & Shortcuts
      commandPaletteOpen: false,
      commandQuery: '',
      showShortcutsModal: false,

      // Fast Numeric Price Editor Modal
      showPriceModal: false,
      editingPriceDish: null,
      tempPrice: 0,
      savingPrice: false,

      // Catalog Data Health & Diagnostics
      healthData: null,
      loadingHealth: false,

      // Clipboard state
      copiedKey: '',
      
      // Forms
      newStall: {
        name: '',
        phone: '',
        whatsapp: '',
        address: '',
        opensAt: '09:00',
        closesAt: '23:00',
        deliversTo: 'Hostels 1-10, Faculty Residences',
        image: '',
        isActive: true,
        isFeatured: false
      },

      newDish: {
        vendorId: '',
        categoryId: '',
        name: '',
        price: '',
        description: '',
        isVeg: true,
        isAvailable: true
      },

      async init() {
        this.updateClock();
        setInterval(() => this.updateClock(), 1000);
        await this.loadAllData();
        await this.loadAnalytics();
        await this.loadHealthAudit();
      },

      updateClock() {
        const now = new Date();
        this.currentTime = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });
        this.currentDate = now.toLocaleDateString('en-IN', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAllData() {
        this.loading = true;
        try {
          const [vRes, cRes, mRes, rRes, sRes, qRes] = await Promise.all([
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/menu').catch(() => null),
            fetch('/api/admin/reviews').catch(() => null),
            fetch('/api/admin/settings').catch(() => null),
            fetch('/api/admin/qr').catch(() => null)
          ]);

          if (vRes && vRes.ok) {
            const d = await vRes.json();
            if (d.vendors && d.vendors.length > 0) this.vendors = d.vendors;
          }
          if (cRes && cRes.ok) {
            const d = await cRes.json();
            if (d.categories && d.categories.length > 0) this.categories = d.categories;
          }
          if (mRes && mRes.ok) {
            const d = await mRes.json();
            if (d.items && d.items.length > 0) this.menuItems = d.items;
          }
          if (rRes && rRes.ok) {
            const d = await rRes.json();
            this.reviews = d.reviews || [];
          }
          if (sRes && sRes.ok) {
            const d = await sRes.json();
            this.settings = Object.assign({}, this.settings, d.settings || {});
          }
          if (qRes && qRes.ok) {
            const q = await qRes.json();
            if (q) this.qrStats = q;
          }
        } catch (err) {
          console.error('Error loading dashboard data:', err);
        } finally {
          this.loading = false;
        }
      },

      async loadAnalytics() {
        try {
          const res = await fetch('/api/admin/analytics?range=7d');
          if (res.ok) {
            const d = await res.json();
            if (d.success && d.data) {
              this.analyticsData = d.data;
            }
          }
        } catch (e) {
          console.warn('Analytics engine background fetch error:', e);
        }
      },

      async toggleVendorStatus(vendor) {
        const prev = vendor.isActive;
        vendor.isActive = !prev; // Optimistic update
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: vendor.id, isActive: vendor.isActive })
          });
          if (res.ok) {
            this.showToast(`Updated: ${vendor.name} is now ${vendor.isActive ? 'Open 🟢' : 'Closed 🔴'}`);
          } else {
            vendor.isActive = prev; // Rollback
            this.showToast('Failed to update status on server');
          }
        } catch (e) {
          vendor.isActive = prev;
          this.showToast('Network error updating status');
        }
      },

      async toggleVendorFeatured(vendor) {
        const prev = vendor.isFeatured;
        vendor.isFeatured = !prev;
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: vendor.id, isFeatured: vendor.isFeatured })
          });
          if (res.ok) {
            this.showToast(`${vendor.name} ${vendor.isFeatured ? 'featured on campus homepage ★' : 'removed from featured'}`);
          } else {
            vendor.isFeatured = prev;
          }
        } catch (e) {
          vendor.isFeatured = prev;
        }
      },

      async saveBroadcastAnnouncement() {
        this.savingBroadcast = true;
        try {
          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              settings: {
                announcement_banner_enabled: this.settings.announcement_banner_enabled,
                announcement_banner_text: this.settings.announcement_banner_text,
                announcement_banner_type: this.settings.announcement_banner_type
              }
            })
          });
          if (res.ok) {
            this.showToast('📢 Campus broadcast announcement published live!');
          } else {
            this.showToast('Failed to save announcement');
          }
        } catch (e) {
          this.showToast('Network error updating announcement');
        } finally {
          this.savingBroadcast = false;
        }
      },

      async toggleDishAvailability(dish) {
        const prev = dish.isAvailable;
        dish.isAvailable = !prev;
        try {
          const res = await fetch('/api/admin/menu', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: dish.id, isAvailable: dish.isAvailable })
          });
          if (res.ok) {
            this.showToast(`${dish.name} marked as ${dish.isAvailable ? 'In Stock' : 'Sold Out'}`);
          } else {
            dish.isAvailable = prev;
          }
        } catch (e) {
          dish.isAvailable = prev;
        }
      },

      openPriceModal(dish) {
        this.editingPriceDish = dish;
        this.tempPrice = Number(dish.price) || 0;
        this.showPriceModal = true;
        this.$nextTick(() => {
          if (this.$refs.priceInput) {
            this.$refs.priceInput.focus();
            this.$refs.priceInput.select();
          }
        });
      },

      adjustTempPrice(delta) {
        this.tempPrice = Math.max(1, Number(this.tempPrice) + delta);
      },

      async savePriceModal() {
        if (!this.editingPriceDish || isNaN(Number(this.tempPrice)) || Number(this.tempPrice) <= 0) {
          this.showToast('Please enter a valid positive price');
          return;
        }
        this.savingPrice = true;
        const dish = this.editingPriceDish;
        const prev = dish.price;
        dish.price = Number(this.tempPrice);
        try {
          const res = await fetch('/api/admin/menu', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: dish.id, price: dish.price })
          });
          if (res.ok) {
            this.showToast(`✅ Price updated: ${dish.name} -> ₹${dish.price}`);
            this.showPriceModal = false;
          } else {
            dish.price = prev;
            this.showToast('Failed to update price on server');
          }
        } catch (err) {
          dish.price = prev;
          this.showToast('Network error saving price');
        } finally {
          this.savingPrice = false;
        }
      },

      async batchToggleVendorStock(vendorId, isAvailable) {
        const vendor = this.vendors.find(v => v.id === vendorId);
        const vendorName = vendor ? vendor.name : 'Vendor';
        
        // Optimistic update
        this.menuItems.forEach(item => {
          if (item.vendorId === vendorId) {
            item.isAvailable = isAvailable;
          }
        });

        try {
          const res = await fetch('/api/admin/menu', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ vendorId, bulkAllForVendor: true, isAvailable })
          });
          if (res.ok) {
            this.showToast(`⚡ All dishes for "${vendorName}" marked as ${isAvailable ? 'In Stock 🟢' : 'Sold Out 🔴'}`);
          } else {
            this.showToast('Failed to update batch availability');
          }
        } catch (err) {
          this.showToast('Network error updating batch availability');
        }
      },

      async loadHealthAudit() {
        this.loadingHealth = true;
        try {
          const res = await fetch('/api/admin/health-audit');
          if (res.ok) {
            const data = await res.json();
            if (data.success) {
              this.healthData = data;
            }
          }
        } catch (err) {
          console.warn('Health audit fetch error:', err);
        } finally {
          this.loadingHealth = false;
        }
      },

      async quickUpdatePrice(dish) {
        this.openPriceModal(dish);
      },

      async createStall() {
        if (!this.newStall.name.trim()) {
          alert('Vendor name is required');
          return;
        }
        this.savingStall = true;
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...this.newStall,
              deliversTo: this.newStall.deliversTo.split(',').map(s => s.trim()).filter(Boolean)
            })
          });

          if (res.ok) {
            const d = await res.json();
            this.vendors.unshift({
              ...this.newStall,
              id: d.id || d.vendor?.id || Date.now(),
              slug: this.newStall.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')
            });
            this.showAddStallModal = false;
            this.newStall = { name: '', phone: '', whatsapp: '', address: '', opensAt: '09:00', closesAt: '23:00', deliversTo: 'Hostels 1-10, Faculty Residences', image: '', isActive: true, isFeatured: false };
            this.showToast('✅ New vendor onboarded to fleet!');
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Failed to create vendor');
          }
        } catch (e) {
          alert('Server error creating vendor');
        } finally {
          this.savingStall = false;
        }
      },

      async createDish() {
        if (!this.newDish.vendorId || !this.newDish.name.trim() || !this.newDish.price) {
          alert('Please select vendor, enter dish name and price');
          return;
        }
        this.savingDish = true;
        try {
          const res = await fetch('/api/admin/menu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.newDish)
          });
          if (res.ok) {
            const data = await res.json();
            if (data.item) this.menuItems.unshift(data.item);
            this.showAddDishModal = false;
            this.newDish = { vendorId: '', categoryId: '', name: '', price: '', description: '', isVeg: true, isAvailable: true };
            this.showToast('🍱 New dish added to campus catalog!');
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Failed to create dish');
          }
        } catch (e) {
          alert('Server error creating dish');
        } finally {
          this.savingDish = false;
        }
      },

      async logout() {
        if (!confirm('Log out from Operations Hub?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      },

      // Computed Filters
      get filteredVendors() {
        let list = this.vendors;
        const q = (this.globalSearch || '').trim().toLowerCase();

        if (q) {
          list = list.filter(v => 
            (v.name && v.name.toLowerCase().includes(q)) ||
            (v.slug && v.slug.toLowerCase().includes(q)) ||
            (v.address && v.address.toLowerCase().includes(q)) ||
            (v.phone && v.phone.includes(q))
          );
        }

        if (this.vendorZoneFilter === 'gate1') {
          list = list.filter(v => (v.address || '').toLowerCase().includes('gate 1') || (v.address || '').toLowerCase().includes('market'));
        } else if (this.vendorZoneFilter === 'gate2') {
          list = list.filter(v => (v.address || '').toLowerCase().includes('gate 2') || (v.address || '').toLowerCase().includes('kirmach'));
        } else if (this.vendorZoneFilter === 'late_night') {
          list = list.filter(v => (v.closesAt || '').startsWith('0') || (v.closesAt || '').startsWith('23') || (v.closesAt || '').startsWith('03'));
        } else if (this.vendorZoneFilter === 'open') {
          list = list.filter(v => v.isActive);
        } else if (this.vendorZoneFilter === 'featured') {
          list = list.filter(v => v.isFeatured);
        }

        return list;
      },

      get filteredDishes() {
        let list = this.menuItems;
        const q = (this.dishSearch || this.globalSearch || '').trim().toLowerCase();

        if (q) {
          list = list.filter(d => 
            (d.name && d.name.toLowerCase().includes(q)) ||
            (d.description && d.description.toLowerCase().includes(q)) ||
            (d.categoryName && d.categoryName.toLowerCase().includes(q)) ||
            (d.vendorName && d.vendorName.toLowerCase().includes(q))
          );
        }

        if (this.dishVendorFilter) {
          list = list.filter(d => String(d.vendorId) === String(this.dishVendorFilter));
        }

        if (this.dishDietFilter === 'veg') {
          list = list.filter(d => d.isVeg);
        } else if (this.dishDietFilter === 'nonveg') {
          list = list.filter(d => !d.isVeg);
        }

        if (this.dishPriceFilter === 'under50') {
          list = list.filter(d => Number(d.price) < 50);
        } else if (this.dishPriceFilter === '50to100') {
          list = list.filter(d => Number(d.price) >= 50 && Number(d.price) < 100);
        } else if (this.dishPriceFilter === '100to200') {
          list = list.filter(d => Number(d.price) >= 100 && Number(d.price) < 200);
        } else if (this.dishPriceFilter === 'above200') {
          list = list.filter(d => Number(d.price) >= 200);
        }

        return list;
      },

      get paginatedDishes() {
        const start = (this.dishPage - 1) * this.dishPageSize;
        return this.filteredDishes.slice(start, start + this.dishPageSize);
      },

      get dishTotalPages() {
        return Math.ceil(this.filteredDishes.length / this.dishPageSize) || 1;
      },

      get filteredTelemetry() {
        const events = this.qrStats?.recentEvents || [];
        if (this.telemetryFilter === 'all') return events;
        return events.filter(e => e.event_type === this.telemetryFilter);
      },

      get activeVendorsCount() {
        return this.vendors.filter(v => v.isActive).length;
      },

      get avgRating() {
        if (this.reviews.length === 0) return '5.0';
        const sum = this.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
        return (sum / this.reviews.length).toFixed(1);
      },

      get vegCount() {
        return this.menuItems.filter(m => m.isVeg).length;
      },

      get nonVegCount() {
        return this.menuItems.length - this.vegCount;
      },

      get avgDishPrice() {
        if (this.menuItems.length === 0) return 0;
        const total = this.menuItems.reduce((acc, m) => acc + (Number(m.price) || 0), 0);
        return Math.round(total / this.menuItems.length);
      },

      getDishesForVendor(vendorId) {
        return this.menuItems.filter(m => m.vendorId === vendorId).slice(0, 5);
      },

      formatTimeAgo(isoString) {
        if (!isoString) return 'just now';
        const date = new Date(isoString);
        const sec = Math.floor((Date.now() - date.getTime()) / 1000);
        if (isNaN(sec) || sec < 5) return 'Just now';
        if (sec < 60) return `${sec}s ago`;
        const min = Math.floor(sec / 60);
        if (min < 60) return `${min}m ago`;
        const hr = Math.floor(min / 60);
        if (hr < 24) return `${hr}h ago`;
        return `${Math.floor(hr / 24)}d ago`;
      },

      exportAllJSON() {
        const snapshot = {
          exportedAt: new Date().toISOString(),
          system: 'Orandus Operations Hub NIT Kurukshetra',
          stats: {
            vendorsCount: this.vendors.length,
            dishesCount: this.menuItems.length,
            categoriesCount: this.categories.length,
            reviewsCount: this.reviews.length,
          },
          vendors: this.vendors,
          categories: this.categories,
          menuItems: this.menuItems,
          reviews: this.reviews,
          settings: this.settings,
          healthAudit: this.healthData
        };
        const blob = new Blob([JSON.stringify(snapshot, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `orandus_full_backup_${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        this.showToast('💾 Full Operations JSON Backup downloaded!');
      },

      exportDishesCSV() {
        const headers = ['ID', 'Dish Name', 'Vendor', 'Category', 'Price (INR)', 'Diet', 'Status', 'Description'];
        const rows = this.menuItems.map(m => [
          m.id,
          '"' + (m.name || '').replace(/"/g, '""') + '"',
          '"' + (m.vendorName || '').replace(/"/g, '""') + '"',
          '"' + (m.categoryName || '').replace(/"/g, '""') + '"',
          m.price,
          m.isVeg ? 'Veg' : 'Non-Veg',
          m.isAvailable ? 'In Stock' : 'Sold Out',
          '"' + (m.description || '').replace(/"/g, '""') + '"'
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `orandus_dishes_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        this.showToast('📊 Menu Catalog CSV exported!');
      },

      exportVendorsCSV() {
        const headers = ['ID', 'Vendor Name', 'Phone', 'WhatsApp', 'Address', 'Opens At', 'Closes At', 'Delivery Hostels', 'Status', 'Featured'];
        const rows = this.vendors.map(v => [
          v.id,
          '"' + (v.name || '').replace(/"/g, '""') + '"',
          v.phone || '',
          v.whatsapp || '',
          '"' + (v.address || '').replace(/"/g, '""') + '"',
          v.opensAt || '',
          v.closesAt || '',
          '"' + (Array.isArray(v.deliversTo) ? v.deliversTo.join('; ') : (v.deliversTo || '')).replace(/"/g, '""') + '"',
          v.isActive ? 'Open' : 'Closed',
          v.isFeatured ? 'Yes' : 'No'
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `orandus_vendors_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        this.showToast('🏪 Vendors Directory CSV exported!');
      },

      copyToClipboard(text, label) {
        if (!text) return;
        navigator.clipboard.writeText(text);
        this.copiedKey = text;
        setTimeout(() => { this.copiedKey = ''; }, 2000);
        this.showToast(`📋 Copied ${label} to clipboard!`);
      },

      handleGlobalKeydown(e) {
        const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
        const isInput = tag === 'input' || tag === 'textarea' || tag === 'select';

        // Cmd + K or Ctrl + K opens/toggles Command Palette
        if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          this.commandPaletteOpen = !this.commandPaletteOpen;
          if (this.commandPaletteOpen) {
            this.$nextTick(() => { this.$refs.commandInput && this.$refs.commandInput.focus(); });
          }
          return;
        }

        // Escape key closes modals
        if (e.key === 'Escape') {
          if (this.commandPaletteOpen) { this.commandPaletteOpen = false; return; }
          if (this.showShortcutsModal) { this.showShortcutsModal = false; return; }
          if (this.showPriceModal) { this.showPriceModal = false; return; }
          if (this.showAddStallModal) { this.showAddStallModal = false; return; }
          if (this.showAddDishModal) { this.showAddDishModal = false; return; }
        }

        // Avoid firing hotkeys when user is actively filling an input field
        if (isInput) return;

        if (e.key === '/') {
          e.preventDefault();
          this.commandPaletteOpen = true;
          this.$nextTick(() => { this.$refs.commandInput && this.$refs.commandInput.focus(); });
          return;
        }

        if (e.key === '1') { this.activeTab = 'fleet'; return; }
        if (e.key === '2') { this.activeTab = 'dishes'; return; }
        if (e.key === '3') { this.activeTab = 'telemetry'; return; }
        if (e.key === '4') { this.activeTab = 'analytics'; return; }
        if (e.key === '5') { this.activeTab = 'health'; return; }
        if (e.key === 'n' || e.key === 'N') { e.preventDefault(); this.showAddStallModal = true; return; }
        if (e.key === 'd' || e.key === 'D') { e.preventDefault(); this.showAddDishModal = true; return; }
        if (e.key === 'b' || e.key === 'B') { e.preventDefault(); this.showBroadcastBar = !this.showBroadcastBar; return; }
        if (e.key === 'r' || e.key === 'R') { e.preventDefault(); this.loadAllData(); this.loadHealthAudit(); this.showToast('🔄 Operations data refreshed'); return; }
        if (e.key === '?') { e.preventDefault(); this.showShortcutsModal = true; return; }
      },

      get commandResults() {
        const q = (this.commandQuery || '').trim().toLowerCase();
        
        const navItems = [
          { type: 'nav', title: 'Campus Vendors Fleet', subtitle: 'View & manage all stalls', icon: '🏪', tab: 'fleet' },
          { type: 'nav', title: '1,420 Catalog Dishes', subtitle: 'Search dishes, prices, and stock', icon: '🍱', tab: 'dishes' },
          { type: 'nav', title: 'Live Telemetry & QR', subtitle: 'Realtime scans, calls, PWA installs', icon: '⚡', tab: 'telemetry' },
          { type: 'nav', title: 'Analytics & Pricing Intel', subtitle: 'Vendor breakdown & category coverage', icon: '📊', tab: 'analytics' },
          { type: 'nav', title: 'Catalog Health & Audit', subtitle: 'Detect missing phones & zero prices', icon: '🛡️', tab: 'health' },
          { type: 'nav', title: 'Food Categories', subtitle: 'Manage categories & icons', icon: '🍽️', url: '/admin/categories' },
          { type: 'nav', title: 'Student Reviews', subtitle: 'Moderate reviews and ratings', icon: '⭐', url: '/admin/reviews' },
          { type: 'nav', title: 'QR Marketing Studio', subtitle: 'Generate hostel posters & track scans', icon: '📱', url: '/admin/qr' },
          { type: 'nav', title: 'Website Control Center', subtitle: 'Banners, taglines, and ad configs', icon: '⚙️', url: '/admin/site-settings' },
          { type: 'nav', title: 'Footer Pages CMS', subtitle: 'About, privacy, terms content', icon: '📄', url: '/admin/pages' },
        ];

        const actions = [
          { type: 'action', title: 'Onboard New Stall', subtitle: 'Add a new food spot to campus fleet', icon: '➕', action: () => { this.showAddStallModal = true; this.commandPaletteOpen = false; } },
          { type: 'action', title: 'Add New Menu Dish', subtitle: 'Create a new dish with price and veg tag', icon: '🍱', action: () => { this.showAddDishModal = true; this.commandPaletteOpen = false; } },
          { type: 'action', title: 'Toggle Campus Alert Bar', subtitle: 'Show or hide campus announcement banner', icon: '📢', action: () => { this.showBroadcastBar = !this.showBroadcastBar; this.commandPaletteOpen = false; } },
          { type: 'action', title: 'Export Full JSON Backup', subtitle: 'Download complete system snapshot', icon: '💾', action: () => { this.exportAllJSON(); this.commandPaletteOpen = false; } },
          { type: 'action', title: 'Export Dishes Catalog CSV', subtitle: 'Download all dishes as spreadsheet', icon: '📊', action: () => { this.exportDishesCSV(); this.commandPaletteOpen = false; } },
          { type: 'action', title: 'Export Vendors CSV', subtitle: 'Download all vendors directory', icon: '🏪', action: () => { this.exportVendorsCSV(); this.commandPaletteOpen = false; } },
          { type: 'action', title: 'View Public Campus Website', subtitle: 'Open orandus.in in new tab', icon: '↗', url: '/' },
        ];

        if (!q) {
          return {
            actions: actions.slice(0, 4),
            nav: navItems.slice(0, 5),
            vendors: this.vendors.slice(0, 4).map(v => ({
              type: 'vendor',
              id: v.id,
              title: v.name,
              subtitle: `${v.address || 'Campus'} • ${v.phone || 'No phone'}`,
              icon: '🏪'
            })),
            dishes: []
          };
        }

        const matchingActions = actions.filter(a => a.title.toLowerCase().includes(q) || a.subtitle.toLowerCase().includes(q));
        const matchingNav = navItems.filter(n => n.title.toLowerCase().includes(q) || n.subtitle.toLowerCase().includes(q));
        const matchingVendors = this.vendors
          .filter(v => (v.name && v.name.toLowerCase().includes(q)) || (v.phone && v.phone.includes(q)) || (v.address && v.address.toLowerCase().includes(q)))
          .slice(0, 5)
          .map(v => ({
            type: 'vendor',
            id: v.id,
            title: v.name,
            subtitle: `${v.address || 'Campus'} • ${v.phone || 'No phone'} (${v.isActive ? 'Open' : 'Closed'})`,
            icon: '🏪'
          }));
        const matchingDishes = this.menuItems
          .filter(m => (m.name && m.name.toLowerCase().includes(q)) || (m.vendorName && m.vendorName.toLowerCase().includes(q)) || (m.categoryName && m.categoryName.toLowerCase().includes(q)))
          .slice(0, 6)
          .map(m => ({
            type: 'dish',
            dish: m,
            title: (m.isVeg ? '🌱 ' : '🍗 ') + m.name,
            subtitle: `₹${m.price} • ${m.vendorName || 'Spot'} (${m.isAvailable ? 'In Stock' : 'Sold Out'})`,
            icon: '🍱'
          }));

        return {
          actions: matchingActions,
          nav: matchingNav,
          vendors: matchingVendors,
          dishes: matchingDishes
        };
      }
    }));
  });
</script>

