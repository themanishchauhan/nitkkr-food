---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getActiveVendors, getCategories, getAllReviews } from '../../lib/queries';

const vendors = await getActiveVendors();
const categories = await getCategories();
const reviews = await getAllReviews();

const pendingReviews = reviews.filter(r => true).length; // All reviews shown
---

<Layout title="Admin Dashboard - NITKKR Food" description="Manage your campus food platform">
  <section class="min-h-screen bg-nitkkr-cream">
    <div x-data="adminLayout()" class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-nitkkr-orange/20 min-h-screen hidden lg:block">
        <div class="p-6 border-b border-nitkkr-orange/20">
          <h1 class="font-display text-xl font-bold text-nitkkr-dark flex items-center gap-2">
            <span>⚙️</span> Admin Panel
          </h1>
        </div>
        <nav class="p-4 space-y-2">
          <a href="/admin" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>📊</span> Dashboard
          </a>
          <a href="/admin/stalls" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>🏪</span> Stalls
          </a>
          <a href="/admin/categories" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>🍽️</span> Categories
          </a>
          <a href="/admin/menu-items" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>🍽️</span> Menu Items
          </a>
          <a href="/admin/reviews" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>⭐</span> Reviews
          </a>
          <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors">
            <span>⚙️</span> Settings
          </a>
        </nav>
      </aside>

      <!-- Mobile menu button -->
      <div class="lg:hidden fixed top-4 left-4 z-50">
        <button @click="sidebarOpen = !sidebarOpen" class="bg-nitkkr-orange text-white p-3 rounded-xl shadow-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <div x-show="sidebarOpen" x-transition class="lg:hidden fixed inset-0 z-40 bg-black/50" @click.self="sidebarOpen = false"></div>
      <aside x-show="sidebarOpen" x-transition class="lg:hidden fixed inset-y-0 left-0 w-64 bg-white border-r border-nitkkr-orange/20 z-50">
        <div class="p-6 border-b border-nitkkr-orange/20">
          <h1 class="font-display text-xl font-bold text-nitkkr-dark flex items-center gap-2">
            <span>⚙️</span> Admin Panel
          </h1>
        </div>
        <nav class="p-4 space-y-2">
          <a href="/admin" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>📊</span> Dashboard
          </a>
          <a href="/admin/stalls" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>🏪</span> Stalls
          </a>
          <a href="/admin/categories" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>🍽️</span> Categories
          </a>
          <a href="/admin/menu-items" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>🍽️</span> Menu Items
          </a>
          <a href="/admin/reviews" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>⭐</span> Reviews
          </a>
          <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 text-nitkkr-dark hover:bg-nitkkr-orange/10 rounded-xl font-medium transition-colors block">
            <span>⚙️</span> Settings
          </a>
        </nav>
      </aside>

      <!-- Main content -->
      <main class="flex-1 p-8 lg:ml-0">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <h1 class="font-display text-3xl font-bold text-nitkkr-dark">Dashboard</h1>
            <p class="text-nitkkr-gray mt-1">Manage your campus food platform</p>
          </div>

          <!-- Stats cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <p class="text-xs font-semibold text-nitkkr-gray mb-1">Total Stalls</p>
              <p class="font-display text-3xl font-bold text-nitkkr-orange" x-text="vendors.length"></p>
            </div>
            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <p class="text-xs font-semibold text-nitkkr-gray mb-1">Total Categories</p>
              <p class="font-display text-3xl font-bold text-nitkkr-dark" x-text="categories.length"></p>
            </div>
            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <p class="text-xs font-semibold text-nitkkr-gray mb-1">Total Reviews</p>
              <p class="font-display text-3xl font-bold text-green-600" x-text="reviews.length"></p>
            </div>
            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <p class="text-xs font-semibold text-nitkkr-gray mb-1">Active Stalls</p>
              <p class="font-display text-3xl font-bold text-green-600" x-text="vendors.filter(v => v.isActive).length"></p>
            </div>
          </div>

          <!-- Quick actions -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <h3 class="font-display text-lg font-bold text-nitkkr-dark mb-4">Quick Actions</h3>
              <div class="space-y-3">
                <a href="/admin/stalls" class="flex items-center gap-3 p-4 bg-nitkkr-cream rounded-xl hover:bg-nitkkr-orange/10 transition-colors block">
                  <span class="w-10 h-10 bg-nitkkr-orange rounded-lg flex items-center justify-center text-white">🏪</span>
                  <div>
                    <p class="font-bold text-nitkkr-dark">Add New Stall</p>
                    <p class="text-xs text-nitkkr-gray">Create a new food stall listing</p>
                  </div>
                </a>
                <a href="/admin/categories" class="flex items-center gap-3 p-4 bg-nitkkr-cream rounded-xl hover:bg-nitkkr-orange/10 transition-colors block">
                  <span class="w-10 h-10 bg-green-500 rounded-lg flex items-center justify-center text-white">🍽️</span>
                  <div>
                    <p class="font-bold text-nitkkr-dark">Manage Categories</p>
                    <p class="text-xs text-nitkkr-gray">Add or edit food categories</p>
                  </div>
                </a>
                <a href="/admin/menu-items" class="flex items-center gap-3 p-4 bg-nitkkr-cream rounded-xl hover:bg-nitkkr-orange/10 transition-colors block">
                  <span class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center text-white">🍽️</span>
                  <div>
                    <p class="font-bold text-nitkkr-dark">Manage Menu Items</p>
                    <p class="text-xs text-nitkkr-gray">Add or edit food items</p>
                  </div>
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-nitkkr-orange/20 p-6 shadow-sm">
              <h3 class="font-display text-lg font-bold text-nitkkr-dark mb-4">Recent Reviews</h3>
              <div class="space-y-3 max-h-64 overflow-y-auto">
                <template x-for="review in reviews.slice(0, 5)" :key="review.id">
                  <div class="flex items-center justify-between p-3 bg-nitkkr-cream rounded-xl">
                    <div class="flex items-center gap-3">
                      <span class="w-8 h-8 bg-nitkkr-orange/20 rounded-full flex items-center justify-center text-nitkkr-orange font-bold" x-text="review.studentName.charAt(0)"></span>
                      <div>
                        <p class="font-medium text-nitkkr-dark text-sm" x-text="review.studentName"></p>
                        <p class="text-xs text-nitkkr-gray" x-text="review.menuItemName + ' @ ' + review.vendorName"></p>
                      </div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-nitkkr-orange font-bold" x-text="'★ ' + review.rating"></span>
                    </div>
                  </div>
                </template>
                <div x-show="reviews.length === 0" class="text-center py-8 text-nitkkr-gray">
                  <p class="text-xl mb-1">⭐</p>
                  <p>No reviews yet</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </section>

  <script is:inline>
    function adminLayout() {
      return {
        sidebarOpen: false,
        vendors: JSON.parse(document.getElementById('vendors-data').textContent || '[]'),
        categories: JSON.parse(document.getElementById('categories-data').textContent || '[]'),
        reviews: JSON.parse(document.getElementById('reviews-data').textContent || '[]'),
      };
    }
  </script>
</Layout>

<script id="vendors-data" type="application/json" is:inline set:html={JSON.stringify(vendors)}></script>
<script id="categories-data" type="application/json" is:inline set:html={JSON.stringify(categories)}></script>
<script id="reviews-data" type="application/json" is:inline set:html={JSON.stringify(reviews)}></script>