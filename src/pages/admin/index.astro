---
import Layout from '../../layouts/Layout.astro';
import { getActiveVendors, getCategories } from '../../lib/queries';

const vendors = await getActiveVendors();
const categories = await getCategories();
const initialVendorsJson = JSON.stringify(vendors);
const initialCategoriesJson = JSON.stringify(categories);
const initialSelectedId = vendors[0]?.id || 1;
---

<Layout title="Vendor Admin Portal - NITKKR Food" description="Stall owner management dashboard for NITKKR food discovery platform.">
  <section class="min-h-screen bg-nitkkr-cream py-8 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <a href="/" class="text-xs text-nitkkr-gray hover:text-nitkkr-orange mb-1 inline-block">← Back to Campus Food</a>
          <h1 class="font-display text-2xl font-bold text-nitkkr-dark flex items-center gap-2">
            <span>⚙️</span> Stall Owner Dashboard
          </h1>
        </div>
        <span class="px-3 py-1 bg-nitkkr-orange/10 text-nitkkr-orange rounded-full text-xs font-semibold">Admin Panel</span>
      </div>

      <div
        x-data={`adminDashboard(${JSON.stringify(vendors)}, ${JSON.stringify(categories)})`}
        class="space-y-6"
      >
        <!-- Tab Navigation -->
        <div class="flex gap-2 bg-white rounded-xl border border-nitkkr-orange/20 p-1 shadow-sm">
          <button
            @click="activeTab = 'stalls'"
            :class="activeTab === 'stalls' ? 'bg-nitkkr-orange text-white' : 'text-nitkkr-gray hover:text-nitkkr-dark'"
            class="flex-1 py-2.5 px-4 rounded-lg text-sm font-bold transition-all cursor-pointer"
          >
            <span class="flex items-center justify-center gap-1.5">
              <span>🏪</span> Stalls
            </span>
          </button>
          <button
            @click="activeTab = 'menu'; loadMenuItems()"
            :class="activeTab === 'menu' ? 'bg-nitkkr-orange text-white' : 'text-nitkkr-gray hover:text-nitkkr-dark'"
            class="flex-1 py-2.5 px-4 rounded-lg text-sm font-bold transition-all cursor-pointer"
            :disabled="!selectedVendorId"
          >
            <span class="flex items-center justify-center gap-1.5">
              <span>🍽️</span> Menu
            </span>
          </button>
          <button
            @click="activeTab = 'invites'; loadInvites()"
            :class="activeTab === 'invites' ? 'bg-nitkkr-orange text-white' : 'text-nitkkr-gray hover:text-nitkkr-dark'"
            class="flex-1 py-2.5 px-4 rounded-lg text-sm font-bold transition-all cursor-pointer"
            :disabled="!selectedVendorId"
          >
            <span class="flex items-center justify-center gap-1.5">
              <span>🔗</span> Invites
            </span>
          </button>
        </div>

        <!-- STALLS TAB -->
        <div x-show="activeTab === 'stalls'" x-transition class="space-y-6">
          <!-- Vendor Selector -->
          <div class="card p-4 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm">
            <label class="block text-xs font-semibold text-nitkkr-gray mb-1">Select Stall to Manage</label>
            <select
              x-model="selectedVendorId"
              class="w-full px-4 py-3 bg-nitkkr-cream border border-nitkkr-orange/30 rounded-xl font-bold text-nitkkr-dark text-base outline-none focus:border-nitkkr-orange cursor-pointer"
            >
              <template x-for="v in vendors" :key="v.id">
                <option :value="String(v.id)" x-text="v.name + ' (' + v.address + ')'"></option>
              </template>
            </select>
          </div>

          <!-- Live Status Controls -->
          <div class="card p-5 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="font-display font-bold text-lg text-nitkkr-dark" x-text="currentVendor.name"></h3>
                <p class="text-xs text-nitkkr-gray" x-text="currentVendor.address"></p>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full" :class="currentVendor.isActive ? 'bg-green-500 animate-pulse' : 'bg-red-500'"></span>
                <span class="text-xs font-bold" x-text="currentVendor.isActive ? 'Open Now' : 'Closed'"></span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-nitkkr-cream">
              <button
                @click="toggleVendorStatus()"
                :disabled="loading"
                class="py-2.5 px-4 rounded-xl font-bold text-xs transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                :class="currentVendor.isActive ? 'bg-red-100 text-red-700 hover:bg-red-200' : 'bg-green-500 text-white hover:bg-green-600'"
              >
                <span x-text="currentVendor.isActive ? 'Mark Stall Closed' : 'Mark Stall Open'"></span>
              </button>

              <a
                :href="`https://wa.me/91${currentVendor.whatsapp || currentVendor.phone}`"
                target="_blank"
                class="py-2.5 px-4 bg-nitkkr-cream hover:bg-nitkkr-orange/10 text-nitkkr-dark border border-nitkkr-orange/30 rounded-xl font-bold text-xs text-center flex items-center justify-center gap-1"
              >
                Test WhatsApp Link
              </a>
            </div>
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-white p-4 rounded-xl border border-nitkkr-orange/20 text-center">
              <p class="text-2xl font-bold text-nitkkr-orange" x-text="getTotalMenuItems()"></p>
              <p class="text-[11px] text-nitkkr-gray font-medium mt-0.5">Menu Items</p>
            </div>
            <div class="bg-white p-4 rounded-xl border border-nitkkr-orange/20 text-center">
              <p class="text-2xl font-bold text-green-600">28</p>
              <p class="text-[11px] text-nitkkr-gray font-medium mt-0.5">WhatsApp Orders</p>
            </div>
            <div class="bg-white p-4 rounded-xl border border-nitkkr-orange/20 text-center">
              <p class="text-2xl font-bold text-nitkkr-dark">4.8 ★</p>
              <p class="text-[11px] text-nitkkr-gray font-medium mt-0.5">Student Rating</p>
            </div>
          </div>

          <!-- Add New Stall -->
          <div>
            <div class="flex items-center justify-between card p-4 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm">
              <div>
                <h4 class="font-bold text-sm text-nitkkr-dark">Own a food stall on campus?</h4>
                <p class="text-xs text-nitkkr-gray">List your eatery on NITKKR Food for free in 2 minutes.</p>
              </div>
              <button
                @click="showStallModal = true"
                class="px-4 py-2.5 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
              >
                <span>➕</span> Add New Stall
              </button>
            </div>

            <!-- Add Stall Modal -->
            <div
              x-show="showStallModal"
              class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
              style="display: none;"
              @click.self="showStallModal = false"
            >
              <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-nitkkr-orange/30">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="font-display font-bold text-lg text-nitkkr-dark">Add New Campus Stall</h3>
                  <button @click="showStallModal = false" class="text-nitkkr-gray hover:text-nitkkr-dark font-bold text-xl cursor-pointer">&times;</button>
                </div>

                <form @submit.prevent="addNewStall()" class="space-y-3">
                  <div x-show="error" x-transition class="mb-3 p-3 bg-red-50 text-red-700 text-xs rounded-lg" x-text="error"></div>

                  <div>
                    <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Stall Name *</label>
                    <input type="text" x-model="newStallName" required placeholder="e.g. Royal Chai & Snacks" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Phone / WhatsApp Number *</label>
                    <input type="tel" x-model="newStallPhone" required placeholder="e.g. 98765 43210" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Campus Location / Address *</label>
                    <input type="text" x-model="newStallAddress" required placeholder="e.g. Near Hostel 6 Gate" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Opens At</label>
                      <input type="time" x-model="newStallOpens" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                    </div>
                    <div>
                      <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Closes At</label>
                      <input type="time" x-model="newStallCloses" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                    </div>
                  </div>

                  <div class="pt-3 flex gap-2">
                    <button type="button" @click="showStallModal = false" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-cream text-nitkkr-dark rounded-xl text-xs font-bold hover:bg-gray-200 cursor-pointer disabled:opacity-50">Cancel</button>
                    <button type="submit" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-orange text-white rounded-xl text-xs font-bold hover:bg-nitkkr-orange-dark shadow-sm cursor-pointer disabled:opacity-50">
                      <span x-show="!loading">Save & Publish</span>
                      <span x-show="loading">Saving...</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Vendor QR Download Section -->
          <div class="card p-5 bg-gradient-to-r from-nitkkr-cream to-white rounded-2xl border border-nitkkr-orange/30">
            <h4 class="font-display font-bold text-sm text-nitkkr-dark mb-1">Stall QR Code Sticker</h4>
            <p class="text-xs text-nitkkr-gray mb-3">Print this QR sticker for your stall counter or takeaway packaging.</p>
            <a
              :href="`/v/${currentVendor.slug}`"
              class="inline-block px-4 py-2 bg-nitkkr-dark text-white rounded-xl text-xs font-bold hover:bg-nitkkr-orange transition-colors"
            >
              View Live Public Stall Page →
            </a>
          </div>
        </div>

        <!-- MENU TAB -->
        <div x-show="activeTab === 'menu'" x-transition class="space-y-6">
          <div x-show="!selectedVendorId" class="card p-8 text-center text-nitkkr-gray">
            <p class="text-xl mb-2">🍽️</p>
            <p class="font-medium">Select a stall from the dropdown above to manage its menu</p>
          </div>

          <template x-if="selectedVendorId">
            <div class="flex items-center justify-between mb-4">
              <h2 class="font-display font-bold text-lg text-nitkkr-dark" x-text="currentVendor.name + ' - Menu Management'"></h2>
              <button
                @click="showMenuItemModal = true; resetMenuItemForm()"
                class="px-4 py-2 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
              >
                <span>➕</span> Add Menu Item
              </button>
            </div>

            <div x-show="menuLoading" class="card p-8 text-center text-nitkkr-gray">
              <p class="text-lg">Loading menu items...</p>
            </div>

            <template x-if="!menuLoading">
              <div class="space-y-3" x-show="menuItems.length > 0">
                <template x-for="item in menuItems" :key="item.id">
                  <div class="card p-4 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm flex flex-col sm:flex-row sm:items-center gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-start justify-between gap-2">
                        <div>
                          <h3 class="font-semibold text-nitkkr-dark" x-text="item.name"></h3>
                          <p class="text-xs text-nitkkr-gray mt-0.5" x-text="item.categoryName || 'Uncategorized'"></p>
                        </div>
                        <span class="text-nitkkr-orange font-bold text-lg whitespace-nowrap" x-text="'₹' + Number(item.price).toFixed(0)"></span>
                      </div>
                      <p class="text-xs text-nitkkr-gray mt-1 line-clamp-2" x-text="item.description || ''"></p>
                      <div class="flex items-center gap-2 mt-2">
                        <span class="px-2 py-0.5 text-[10px] font-bold rounded-full" :class="item.isVeg ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'" x-text="item.isVeg ? '🌱 Veg' : '🍗 Non-Veg'"></span>
                        <span class="px-2 py-0.5 bg-nitkkr-cream text-nitkkr-orange text-[10px] font-bold rounded-full" x-text="item.isAvailable ? 'Available' : 'Hidden'"></span>
                        <template x-for="tag in (item.tags || [])" :key="tag">
                          <span class="px-2 py-0.5 bg-gray-100 text-gray-700 text-[10px] rounded-full" x-text="tag"></span>
                        </template>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 sm:ml-4">
                      <button
                        @click="editMenuItem(item)"
                        class="px-3 py-1.5 bg-nitkkr-cream hover:bg-nitkkr-orange/10 text-nitkkr-orange border border-nitkkr-orange/30 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                      >
                        Edit
                      </button>
                      <button
                        @click="deleteMenuItem(item.id)"
                        class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </template>
              </div>

              <div x-show="menuItems.length === 0" class="card p-8 text-center text-nitkkr-gray">
                <p class="text-2xl mb-2">📭</p>
                <p class="font-medium">No menu items yet</p>
                <p class="text-xs mt-1">Click "Add Menu Item" to get started</p>
              </div>
            </template>
          </template>

          <!-- Add/Edit Menu Item Modal -->
          <div
            x-show="showMenuItemModal"
            class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
            style="display: none;"
            @click.self="showMenuItemModal = false"
          >
            <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-nitkkr-orange/30">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-display font-bold text-lg text-nitkkr-dark" x-text="editingMenuItem ? 'Edit Menu Item' : 'Add Menu Item'"></h3>
                <button @click="showMenuItemModal = false" class="text-nitkkr-gray hover:text-nitkkr-dark font-bold text-xl cursor-pointer">&times;</button>
              </div>

              <form @submit.prevent="saveMenuItem()" class="space-y-3">
                <div x-show="error" x-transition class="mb-3 p-3 bg-red-50 text-red-700 text-xs rounded-lg" x-text="error"></div>

                <input type="hidden" x-model="editingMenuItemId" />

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Item Name *</label>
                  <input type="text" x-model="menuItemName" required placeholder="e.g. Steamed Paneer Momos" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Price (₹) *</label>
                  <input type="number" step="0.5" min="0" x-model.number="menuItemPrice" required placeholder="e.g. 70" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Category</label>
                  <select x-model="menuItemCategoryId" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange">
                    <option value="">Select Category</option>
                    <template x-for="cat in categories" :key="cat.id">
                      <option :value="String(cat.id)" x-text="cat.icon + ' ' + cat.name"></option>
                    </template>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Description</label>
                  <textarea x-model="menuItemDescription" rows="2" placeholder="e.g. 8 pcs with spicy red chutney" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange resize-none"></textarea>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Image URL</label>
                  <input type="url" x-model="menuItemImage" placeholder="https://example.com/image.jpg" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div class="flex items-center gap-2">
                    <input type="checkbox" x-model="menuItemIsVeg" id="menuItemIsVeg" class="w-4 h-4 text-nitkkr-orange border-nitkkr-orange/30 rounded focus:ring-nitkkr-orange" />
                    <label for="menuItemIsVeg" class="text-xs font-medium text-nitkkr-dark cursor-pointer">🌱 Vegetarian</label>
                  </div>
                  <div class="flex items-center gap-2">
                    <input type="checkbox" x-model="menuItemIsAvailable" id="menuItemIsAvailable" class="w-4 h-4 text-nitkkr-orange border-nitkkr-orange/30 rounded focus:ring-nitkkr-orange" />
                    <label for="menuItemIsAvailable" class="text-xs font-medium text-nitkkr-dark cursor-pointer">Available</label>
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Tags (comma separated)</label>
                  <input type="text" x-model="menuItemTags" placeholder="bestseller, spicy, snack" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div class="pt-3 flex gap-2">
                  <button type="button" @click="showMenuItemModal = false" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-cream text-nitkkr-dark rounded-xl text-xs font-bold hover:bg-gray-200 cursor-pointer disabled:opacity-50">Cancel</button>
                  <button type="submit" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-orange text-white rounded-xl text-xs font-bold hover:bg-nitkkr-orange-dark shadow-sm cursor-pointer disabled:opacity-50">
                    <span x-show="!loading" x-text="editingMenuItem ? 'Update Item' : 'Add Item'"></span>
                    <span x-show="loading">Saving...</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- INVITES TAB -->
        <div x-show="activeTab === 'invites'" x-transition class="space-y-6">
          <div x-show="!selectedVendorId" class="card p-8 text-center text-nitkkr-gray">
            <p class="text-xl mb-2">🔗</p>
            <p class="font-medium">Select a stall to manage invite links for stall members</p>
          </div>

          <template x-if="selectedVendorId">
            <div class="flex items-center justify-between mb-4">
              <h2 class="font-display font-bold text-lg text-nitkkr-dark" x-text="currentVendor.name + ' - Stall Member Invites'"></h2>
              <button
                @click="showInviteModal = true; resetInviteForm()"
                class="px-4 py-2 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
              >
                <span>➕</span> Create Invite Link
              </button>
            </div>

            <div class="space-y-3" x-show="invites.length > 0">
              <template x-for="invite in invites" :key="invite.id">
                <div class="card p-4 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm">
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="font-semibold text-nitkkr-dark" x-text="invite.email || invite.phone || 'Open Invite'"></p>
                      <p class="text-xs text-nitkkr-gray mt-0.5">
                        <span x-text="invite.usedAt ? '✅ Used' : '⏳ Pending'"></span>
                        <span class="mx-2">·</span>
                        <span x-text="invite.expiresAt ? 'Expires: ' + new Date(invite.expiresAt).toLocaleDateString() : 'No expiry'"></span>
                      </p>
                    </div>
                    <div class="flex items-center gap-2">
                      <button
                        @click="copyInviteLink(invite.token)"
                        class="px-3 py-1.5 bg-nitkkr-cream hover:bg-nitkkr-orange/10 text-nitkkr-orange border border-nitkkr-orange/30 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                      >
                        Copy Link
                      </button>
                      <button
                        @click="revokeInvite(invite.id)"
                        :disabled="invite.usedAt"
                        class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded-lg font-bold text-xs transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                      >
                        Revoke
                      </button>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <div x-show="invites.length === 0" class="card p-8 text-center text-nitkkr-gray">
              <p class="text-2xl mb-2">📭</p>
              <p class="font-medium">No invite links created yet</p>
              <p class="text-xs mt-1">Click "Create Invite Link" to generate a link for stall members</p>
            </div>
          </template>

          <!-- Create Invite Modal -->
          <div
            x-show="showInviteModal"
            class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
            style="display: none;"
            @click.self="showInviteModal = false"
          >
            <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-nitkkr-orange/30">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-display font-bold text-lg text-nitkkr-dark">Create Stall Member Invite</h3>
                <button @click="showInviteModal = false" class="text-nitkkr-gray hover:text-nitkkr-dark font-bold text-xl cursor-pointer">&times;</button>
              </div>

              <form @submit.prevent="createInvite()" class="space-y-3">
                <div x-show="error" x-transition class="mb-3 p-3 bg-red-50 text-red-700 text-xs rounded-lg" x-text="error"></div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Email (optional)</label>
                  <input type="email" x-model="inviteEmail" placeholder="stallowner@example.com" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Phone (optional)</label>
                  <input type="tel" x-model="invitePhone" placeholder="98765 43210" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Expires In (days, optional)</label>
                  <input type="number" x-model.number="inviteExpiresDays" min="1" max="365" placeholder="7" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
                </div>

                <p class="text-xs text-nitkkr-gray">Leave email/phone empty for a generic link. Link format: <code class="bg-nitkkr-cream px-1 rounded">/stall-join?token=...</code></p>

                <div class="pt-3 flex gap-2">
                  <button type="button" @click="showInviteModal = false" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-cream text-nitkkr-dark rounded-xl text-xs font-bold hover:bg-gray-200 cursor-pointer disabled:opacity-50">Cancel</button>
                  <button type="submit" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-orange text-white rounded-xl text-xs font-bold hover:bg-nitkkr-orange-dark shadow-sm cursor-pointer disabled:opacity-50">
                    <span x-show="!loading">Create Invite Link</span>
                    <span x-show="loading">Creating...</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <script is:inline>
        function adminDashboard(initialVendors = [], initialCategories = []) {
          return {
            selectedVendorId: String(initialVendors[0]?.id || 1),
            vendors: initialVendors,
            categories: initialCategories,
            activeTab: 'stalls',
            loading: false,
            menuLoading: false,
            menuItems: [],
            showStallModal: false,
            showMenuItemModal: false,
            showInviteModal: false,
            invites: [],
            error: null,

            // Stall form
            newStallName: '',
            newStallPhone: '',
            newStallAddress: '',
            newStallOpens: '09:00',
            newStallCloses: '23:00',

            // Menu item form
            editingMenuItem: false,
            editingMenuItemId: null,
            menuItemName: '',
            menuItemPrice: '',
            menuItemCategoryId: '',
            menuItemDescription: '',
            menuItemImage: '',
            menuItemIsVeg: true,
            menuItemIsAvailable: true,
            menuItemTags: '',

            // Invite form
            inviteEmail: '',
            invitePhone: '',
            inviteExpiresDays: 7,

            async init() {},

            get currentVendor() {
              const idStr = String(this.selectedVendorId);
              return this.vendors.find(v => String(v.id) === idStr) || this.vendors[0] || { name: 'Stall', address: '', isActive: true, slug: 'momo-corner' };
            },

            getTotalMenuItems() {
              if (!this.selectedVendorId) return 0;
              return this.menuItems.length;
            },

            async refreshVendors() {
              try {
                const res = await fetch('/api/admin/vendors');
                if (res.ok) {
                  const data = await res.json();
                  this.vendors = data.vendors || [];
                }
              } catch (e) {
                console.error('Failed to refresh vendors:', e);
              }
            },

            async loadMenuItems() {
              if (!this.selectedVendorId) return;
              this.menuLoading = true;
              try {
                const res = await fetch(`/api/admin/menu?vendorId=${this.selectedVendorId}`, {
                  headers: { 'x-admin-key': import.meta.env.ADMIN_SECRET || '' }
                });
                if (res.ok) {
                  const data = await res.json();
                  this.menuItems = data.items || [];
                }
              } catch (e) {
                console.error('Failed to load menu items:', e);
              } finally {
                this.menuLoading = false;
              }
            },

            async loadInvites() {
              if (!this.selectedVendorId) return;
              try {
                const res = await fetch(`/api/admin/invites?vendorId=${this.selectedVendorId}`, {
                  headers: { 'x-admin-key': import.meta.env.ADMIN_SECRET || '' }
                });
                if (res.ok) {
                  const data = await res.json();
                  this.invites = data.invites || [];
                }
              } catch (e) {
                console.error('Failed to load invites:', e);
              }
            },

            async toggleVendorStatus() {
              const v = this.currentVendor;
              if (!v) return;
              this.loading = true;
              this.error = null;
              try {
                const res = await fetch('/api/admin/vendors', {
                  method: 'PATCH',
                  headers: { 
                    'Content-Type': 'application/json',
                    'x-admin-key': import.meta.env.ADMIN_SECRET || ''
                  },
                  body: JSON.stringify({ id: v.id, isActive: !v.isActive })
                });
                if (!res.ok) throw new Error('Failed to update');
                const data = await res.json();
                v.isActive = data.vendor.isActive;
              } catch (e) {
                this.error = 'Failed to update stall status';
                console.error(e);
              } finally {
                this.loading = false;
              }
            },

            async addNewStall() {
              if (!this.newStallName.trim()) return;
              this.loading = true;
              this.error = null;
              try {
                const res = await fetch('/api/admin/vendors', {
                  method: 'POST',
                  headers: { 
                    'Content-Type': 'application/json',
                    'x-admin-key': import.meta.env.ADMIN_SECRET || ''
                  },
                  body: JSON.stringify({
                    name: this.newStallName.trim(),
                    phone: this.newStallPhone.trim(),
                    whatsapp: this.newStallPhone.trim(),
                    address: this.newStallAddress.trim(),
                    opensAt: this.newStallOpens,
                    closesAt: this.newStallCloses,
                    deliversTo: ['All Hostels & Locations']
                  })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                  this.vendors.unshift(data.vendor);
                  this.selectedVendorId = String(data.vendor.id);
                  this.showStallModal = false;
                  this.newStallName = '';
                  this.newStallPhone = '';
                  this.newStallAddress = '';
                  alert('🎉 Stall "' + data.vendor.name + '" registered & saved to backend database!');
                  this.loading = false;
                  return;
                } else {
                  this.error = data.error || 'Failed to create stall';
                }
              } catch (err) {
                console.error('Create stall error:', err);
                this.error = 'Network error - please try again';
              }
              this.loading = false;
            },

            // Menu item methods
            resetMenuItemForm() {
              this.editingMenuItem = false;
              this.editingMenuItemId = null;
              this.menuItemName = '';
              this.menuItemPrice = '';
              this.menuItemCategoryId = '';
              this.menuItemDescription = '';
              this.menuItemImage = '';
              this.menuItemIsVeg = true;
              this.menuItemIsAvailable = true;
              this.menuItemTags = '';
            },

            editMenuItem(item) {
              this.editingMenuItem = true;
              this.editingMenuItemId = item.id;
              this.menuItemName = item.name;
              this.menuItemPrice = item.price;
              this.menuItemCategoryId = item.categoryId ? String(item.categoryId) : '';
              this.menuItemDescription = item.description || '';
              this.menuItemImage = item.image || '';
              this.menuItemIsVeg = item.isVeg;
              this.menuItemIsAvailable = item.isAvailable;
              this.menuItemTags = (item.tags || []).join(', ');
              this.showMenuItemModal = true;
            },

            async saveMenuItem() {
              if (!this.menuItemName.trim() || this.menuItemPrice === '') {
                this.error = 'Name and price are required';
                return;
              }
              this.loading = true;
              this.error = null;
              try {
                const payload = {
                  vendorId: this.selectedVendorId,
                  categoryId: this.menuItemCategoryId || null,
                  name: this.menuItemName.trim(),
                  description: this.menuItemDescription.trim() || null,
                  price: parseFloat(this.menuItemPrice),
                  image: this.menuItemImage.trim() || null,
                  isVeg: this.menuItemIsVeg,
                  isAvailable: this.menuItemIsAvailable,
                  tags: this.menuItemTags.split(',').map(t => t.trim()).filter(t => t),
                };

                let res, data;
                if (this.editingMenuItem) {
                  res = await fetch(`/api/admin/menu/${this.editingMenuItemId}`, {
                    method: 'PATCH',
                    headers: { 
                      'Content-Type': 'application/json',
                      'x-admin-key': import.meta.env.ADMIN_SECRET || ''
                    },
                    body: JSON.stringify(payload)
                  });
                } else {
                  res = await fetch('/api/admin/menu', {
                    method: 'POST',
                    headers: { 
                      'Content-Type': 'application/json',
                      'x-admin-key': import.meta.env.ADMIN_SECRET || ''
                    },
                    body: JSON.stringify(payload)
                  });
                }
                data = await res.json();
                if (res.ok && data.success) {
                  await this.loadMenuItems();
                  this.showMenuItemModal = false;
                  this.resetMenuItemForm();
                  alert('🎉 Menu item ' + (this.editingMenuItem ? 'updated' : 'added') + ' successfully!');
                  this.loading = false;
                  return;
                } else {
                  this.error = data.error || 'Failed to save menu item';
                }
              } catch (err) {
                console.error('Save menu item error:', err);
                this.error = 'Network error - please try again';
              }
              this.loading = false;
            },

            async deleteMenuItem(id) {
              if (!confirm('Delete this menu item?')) return;
              try {
                const res = await fetch(`/api/admin/menu/${id}`, {
                  method: 'DELETE',
                  headers: { 'x-admin-key': import.meta.env.ADMIN_SECRET || '' }
                });
                if (res.ok) {
                  await this.loadMenuItems();
                  alert('Menu item deleted');
                }
              } catch (e) {
                console.error('Delete menu item error:', e);
                alert('Failed to delete menu item');
              }
            },

            // Invite methods
            resetInviteForm() {
              this.inviteEmail = '';
              this.invitePhone = '';
              this.inviteExpiresDays = 7;
            },

            async createInvite() {
              this.loading = true;
              this.error = null;
              try {
                const res = await fetch('/api/admin/invites', {
                  method: 'POST',
                  headers: { 
                    'Content-Type': 'application/json',
                    'x-admin-key': import.meta.env.ADMIN_SECRET || ''
                  },
                  body: JSON.stringify({
                    vendorId: this.selectedVendorId,
                    email: this.inviteEmail.trim() || null,
                    phone: this.invitePhone.trim() || null,
                    expiresDays: this.inviteExpiresDays || null,
                  })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                  this.invites.unshift(data.invite);
                  this.showInviteModal = false;
                  this.resetInviteForm();
                  const link = `${window.location.origin}/stall-join?token=${data.invite.token}`;
                  navigator.clipboard.writeText(link);
                  alert('🎉 Invite link created and copied to clipboard!\n\n' + link);
                  this.loading = false;
                  return;
                } else {
                  this.error = data.error || 'Failed to create invite';
                }
              } catch (err) {
                console.error('Create invite error:', err);
                this.error = 'Network error - please try again';
              }
              this.loading = false;
            },

            copyInviteLink(token) {
              const link = `${window.location.origin}/stall-join?token=${token}`;
              navigator.clipboard.writeText(link);
              alert('Invite link copied to clipboard!\n\n' + link);
            },

            async revokeInvite(id) {
              if (!confirm('Revoke this invite link?')) return;
              try {
                const res = await fetch(`/api/admin/invites/${id}`, {
                  method: 'DELETE',
                  headers: { 'x-admin-key': import.meta.env.ADMIN_SECRET || '' }
                });
                if (res.ok) {
                  await this.loadInvites();
                  alert('Invite revoked');
                }
              } catch (e) {
                console.error('Revoke invite error:', e);
                alert('Failed to revoke invite');
              }
            }
          };
        }
      </script>
    </div>
  </section>
</Layout>