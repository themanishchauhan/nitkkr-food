---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { 
  getActiveVendors, 
  getCategories, 
  getAllSiteSettings, 
  getAllMenuItemsForSearch, 
  getAllReviews, 
  getQrAnalyticsData 
} from '../../lib/queries';

const initialVendors = await getActiveVendors();
const initialCategories = await getCategories();
const initialMenuItems = await getAllMenuItemsForSearch();
const initialReviews = await getAllReviews();
const rawSettings = await getAllSiteSettings();
const initialSettingsList = Array.isArray(rawSettings) ? rawSettings : [];
const initialSettingsObj = initialSettingsList.reduce((acc: any, s: any) => { 
  if (s && s.key) acc[s.key] = s.value; 
  return acc; 
}, {} as Record<string, string>);
const initialQrStats = await getQrAnalyticsData();
---

<script is:inline define:vars={{ initialVendors, initialCategories, initialMenuItems, initialReviews, initialSettingsObj, initialQrStats }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('dashboardAdmin', () => ({
      sidebarOpen: false,
      loading: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      qrStats: initialQrStats || { totalScans: 0, totalCalls: 0, totalWhatsApp: 0, totalInstalls: 0, campaigns: [], recentEvents: [] },
      settings: {
        homepage_title: initialSettingsObj.homepage_title || 'Stop Asking “Bhai, Menu Bhej.”',
        homepage_tagline: initialSettingsObj.homepage_tagline || 'Find campus food, menus and prices in seconds.',
        announcement_banner_enabled: initialSettingsObj.announcement_banner_enabled || 'false',
        announcement_banner_text: initialSettingsObj.announcement_banner_text || '',
        announcement_banner_type: initialSettingsObj.announcement_banner_type || 'info',
        ad_banner_enabled: initialSettingsObj.ad_banner_enabled || 'false',
        ad_banner_badge: initialSettingsObj.ad_banner_badge || '⚡ SPONSORED DEAL',
        ad_banner_title: initialSettingsObj.ad_banner_title || '',
        ad_banner_description: initialSettingsObj.ad_banner_description || '',
        ad_banner_cta: initialSettingsObj.ad_banner_cta || 'Claim Offer 💬',
        ad_banner_link: initialSettingsObj.ad_banner_link || '#'
      },
      analyticsData: null,
      currentTime: '',
      currentDate: '',
      vendorSearch: '',
      vendorFilter: 'all', // 'all' | 'open' | 'closed' | 'featured'
      telemetryFilter: 'all', // 'all' | 'qr_scan' | 'call_click' | 'whatsapp_click' | 'pwa_install'
      showAddStallModal: false,
      showAddDishModal: false,
      savingStall: false,
      savingDish: false,
      toastMsg: '',
      
      // New Vendor Form Model
      newStall: {
        name: '',
        phone: '',
        whatsapp: '',
        address: '',
        opensAt: '09:00',
        closesAt: '23:00',
        deliversTo: 'Campus wide',
        image: '',
        isActive: true,
        isFeatured: false
      },

      // New Dish Form Model
      newDish: {
        vendorId: '',
        categoryId: '',
        name: '',
        price: '',
        description: '',
        isVeg: true,
        isAvailable: true
      },

      async init() {
        this.updateClock();
        setInterval(() => this.updateClock(), 1000);
        await this.loadAllData();
        await this.loadAnalytics();
      },

      updateClock() {
        const now = new Date();
        this.currentTime = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' }) + ' IST';
        this.currentDate = now.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAllData() {
        this.loading = true;
        try {
          const [vRes, cRes, mRes, rRes, sRes, qRes] = await Promise.all([
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/menu').catch(() => null),
            fetch('/api/admin/reviews').catch(() => null),
            fetch('/api/admin/settings').catch(() => null),
            fetch('/api/admin/qr').catch(() => null)
          ]);

          if (vRes && vRes.ok) {
            const d = await vRes.json();
            if (d.vendors && d.vendors.length > 0) this.vendors = d.vendors;
          }
          if (cRes && cRes.ok) {
            const d = await cRes.json();
            if (d.categories && d.categories.length > 0) this.categories = d.categories;
          }
          if (mRes && mRes.ok) {
            const d = await mRes.json();
            if (d.items && d.items.length > 0) this.menuItems = d.items;
          }
          if (rRes && rRes.ok) {
            const d = await rRes.json();
            this.reviews = d.reviews || [];
          }
          if (sRes && sRes.ok) {
            const d = await sRes.json();
            this.settings = Object.assign({}, this.settings, d.settings || {});
          }
          if (qRes && qRes.ok) {
            const q = await qRes.json();
            if (q) this.qrStats = q;
          }
        } catch (err) {
          console.error('Error loading dashboard data:', err);
        } finally {
          this.loading = false;
        }
      },

      async loadAnalytics() {
        try {
          const res = await fetch('/api/admin/analytics?range=7d');
          if (res.ok) {
            const d = await res.json();
            if (d.success && d.data) {
              this.analyticsData = d.data;
            }
          }
        } catch (e) {
          console.warn('Analytics engine background fetch error:', e);
        }
      },

      async toggleVendorStatus(vendor) {
        const prev = vendor.isActive;
        vendor.isActive = !prev; // Optimistic update
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: vendor.id, isActive: vendor.isActive })
          });
          if (res.ok) {
            this.showToast(`Vendor ${vendor.name} is now ${vendor.isActive ? 'ONLINE 🟢' : 'OFFLINE 🔴'}`);
          } else {
            vendor.isActive = prev; // Rollback
            this.showToast('❌ Failed to update vendor status on server');
          }
        } catch (e) {
          vendor.isActive = prev; // Rollback
          this.showToast('❌ Network error updating vendor status');
        }
      },

      async createStall() {
        if (!this.newStall.name.trim()) {
          alert('Vendor name is required');
          return;
        }
        this.savingStall = true;
        try {
          const res = await fetch('/api/admin/vendors', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...this.newStall,
              deliversTo: this.newStall.deliversTo.split(',').map(s => s.trim()).filter(Boolean)
            })
          });

          if (res.ok) {
            const d = await res.json();
            this.vendors.unshift({
              ...this.newStall,
              id: d.id || d.vendor?.id || Date.now(),
              slug: this.newStall.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')
            });
            this.showAddStallModal = false;
            this.newStall = { name: '', phone: '', whatsapp: '', address: '', opensAt: '09:00', closesAt: '23:00', deliversTo: 'Campus wide', image: '', isActive: true, isFeatured: false };
            this.showToast('✅ New vendor onboarded to fleet!');
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Failed to create vendor');
          }
        } catch (e) {
          alert('Server error creating vendor');
        } finally {
          this.savingStall = false;
        }
      },

      async createDish() {
        if (!this.newDish.vendorId || !this.newDish.name.trim() || !this.newDish.price) {
          alert('Please select vendor, enter dish name and price');
          return;
        }
        this.savingDish = true;
        try {
          const res = await fetch('/api/admin/menu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.newDish)
          });
          if (res.ok) {
            const data = await res.json();
            if (data.item) this.menuItems.unshift(data.item);
            this.showAddDishModal = false;
            this.newDish = { vendorId: '', categoryId: '', name: '', price: '', description: '', isVeg: true, isAvailable: true };
            this.showToast('🍱 New dish added to menu!');
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Failed to create dish');
          }
        } catch (e) {
          alert('Server error creating dish');
        } finally {
          this.savingDish = false;
        }
      },

      async deleteReview(id) {
        if (!confirm('Delete this review from database?')) return;
        try {
          const res = await fetch('/api/admin/reviews?id=' + id, { method: 'DELETE' });
          if (res.ok) {
            this.reviews = this.reviews.filter(r => r.id !== id);
            this.showToast('Review removed');
          } else {
            const err = await res.json().catch(() => ({}));
            this.showToast('❌ ' + (err.error || 'Failed to delete review'));
          }
        } catch (e) {
          this.showToast('❌ Network error deleting review');
        }
      },

      async logout() {
        if (!confirm('Log out from Operations Terminal?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      },

      get filteredVendors() {
        let list = this.vendors;
        if (this.vendorFilter === 'open') list = list.filter(v => v.isActive);
        if (this.vendorFilter === 'closed') list = list.filter(v => !v.isActive);
        if (this.vendorFilter === 'featured') list = list.filter(v => v.isFeatured);
        if (this.vendorSearch.trim()) {
          const q = this.vendorSearch.toLowerCase();
          list = list.filter(v => 
            (v.name && v.name.toLowerCase().includes(q)) ||
            (v.slug && v.slug.toLowerCase().includes(q)) ||
            (v.address && v.address.toLowerCase().includes(q)) ||
            (v.phone && v.phone.includes(q))
          );
        }
        return list;
      },

      get filteredTelemetry() {
        const events = this.qrStats?.recentEvents || [];
        if (this.telemetryFilter === 'all') return events;
        return events.filter(e => e.event_type === this.telemetryFilter);
      },

      get activeVendorsCount() {
        return this.vendors.filter(v => v.isActive).length;
      },

      get avgRating() {
        if (this.reviews.length === 0) return '5.0';
        const sum = this.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
        return (sum / this.reviews.length).toFixed(1);
      },

      get vegCount() {
        return this.menuItems.filter(m => m.isVeg).length;
      },

      get nonVegCount() {
        return this.menuItems.length - this.vegCount;
      },

      get avgDishPrice() {
        if (this.menuItems.length === 0) return 0;
        const total = this.menuItems.reduce((acc, m) => acc + (Number(m.price) || 0), 0);
        return Math.round(total / this.menuItems.length);
      },

      formatTimeAgo(isoString) {
        if (!isoString) return 'recently';
        const date = new Date(isoString);
        const sec = Math.floor((Date.now() - date.getTime()) / 1000);
        if (isNaN(sec) || sec < 5) return 'Just now';
        if (sec < 60) return `${sec}s ago`;
        const min = Math.floor(sec / 60);
        if (min < 60) return `${min}m ago`;
        const hr = Math.floor(min / 60);
        if (hr < 24) return `${hr}h ago`;
        return `${Math.floor(hr / 24)}d ago`;
      }
    }));
  });
</script>

<Layout title="Operations Command Terminal - Orandus Ops" description="High-density Bloomberg-style real-time campus food operations terminal">
  <section x-data="dashboardAdmin" class="min-h-screen bg-[#070B12] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    
    <!-- Toast Notification -->
    <div
      x-show="toastMsg"
      x-transition
      class="fixed bottom-6 right-6 z-50 bg-slate-900 border border-amber-500/50 text-amber-400 px-4 py-2.5 rounded-xl shadow-2xl font-mono text-xs flex items-center gap-2"
    >
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      <span x-text="toastMsg"></span>
    </div>

    <!-- Bloomberg Dark Terminal Sidebar -->
    <AdminSidebar currentPath="/admin" />

    <!-- 🚀 Main Bloomberg Operations Workspace -->
    <main class="flex-1 p-3 sm:p-5 lg:p-6 overflow-y-auto space-y-4 max-w-[1700px] w-full">

      <!-- 1. Global Terminal Header Ticker Bar -->
      <header class="bg-[#0D131F] border border-slate-800/90 rounded-2xl p-3 sm:p-4 shadow-lg flex flex-col xl:flex-row xl:items-center justify-between gap-3 select-none">
        
        <!-- Left: Status & Realtime IST Clock -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2 px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-emerald-400 font-bold tracking-wider">LIVE TELEMETRY</span>
          </div>

          <div class="flex items-center gap-2 px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-xs">
            <span class="text-slate-500">CLOCK:</span>
            <span class="text-amber-400 font-bold" x-text="currentTime || 'IST'"></span>
            <span class="text-slate-600">|</span>
            <span class="text-slate-400" x-text="currentDate"></span>
          </div>

          <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-xs text-slate-400">
            <span class="text-slate-500">DB:</span>
            <span class="text-emerald-400 font-bold">CLOUDFLARE D1</span>
            <span class="text-slate-600">|</span>
            <span class="text-slate-500">REGION:</span>
            <span class="text-slate-300">DELHI/EDGE</span>
          </div>
        </div>

        <!-- Right: Fast Actions & Shortcut Triggers -->
        <div class="flex flex-wrap items-center gap-2">
          <button
            @click="loadAllData(); loadAnalytics(); showToast('🔄 Refreshing telemetry stream...')"
            :disabled="loading"
            class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 rounded-lg text-xs font-mono font-bold text-slate-300 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer"
            title="Reload live feeds"
          >
            <span :class="loading ? 'animate-spin' : ''">↻</span> Sync Data
          </button>

          <button
            @click="showAddStallModal = true"
            class="px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-lg text-xs font-mono font-bold transition-all shadow-sm shadow-amber-500/20 active:scale-95 flex items-center gap-1.5 cursor-pointer"
          >
            <span>+</span> Onboard Vendor
          </button>

          <button
            @click="showAddDishModal = true"
            class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-mono font-bold transition-all shadow-sm shadow-emerald-600/20 active:scale-95 flex items-center gap-1.5 cursor-pointer"
          >
            <span>🍱</span> Add Dish
          </button>

          <a
            href="/admin/site-settings"
            class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 rounded-lg text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5"
          >
            <span>⚙️</span> Control
          </a>
        </div>
      </header>

      <!-- 2. Dense Financial Metric Tickers (4 Columns) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        
        <!-- Metric 1: Campus Vendor Fleet -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-xl p-3.5 space-y-1.5 hover:border-amber-500/40 transition-colors group">
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>FLEET STATUS</span>
            <span class="text-xs">🏪</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl sm:text-3xl font-black text-amber-400 tracking-tight" x-text="activeVendorsCount + '/' + vendors.length"></span>
            <span class="text-[11px] font-mono font-bold text-emerald-400 uppercase">ONLINE</span>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 border-t border-slate-800/80 pt-1.5">
            <span>Covering NIT Campus</span>
            <a href="/admin/stalls" class="text-amber-400 hover:underline">Manage &rarr;</a>
          </div>
        </div>

        <!-- Metric 2: Dish Inventory & Price Spread -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-xl p-3.5 space-y-1.5 hover:border-emerald-500/40 transition-colors group">
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>DISH CATALOG</span>
            <span class="text-xs">🍱</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl sm:text-3xl font-black text-emerald-400 tracking-tight" x-text="menuItems.length"></span>
            <span class="text-[11px] font-mono text-slate-400" x-text="'Avg ₹' + avgDishPrice"></span>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 border-t border-slate-800/80 pt-1.5">
            <span class="text-emerald-400 font-bold" x-text="vegCount + ' Veg'"></span>
            <span class="text-rose-400 font-bold" x-text="nonVegCount + ' Non-Veg'"></span>
          </div>
        </div>

        <!-- Metric 3: Student Sentiment & Ratings -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-xl p-3.5 space-y-1.5 hover:border-cyan-500/40 transition-colors group">
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>STUDENT REVIEWS</span>
            <span class="text-xs">⭐</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl sm:text-3xl font-black text-cyan-400 tracking-tight" x-text="'★ ' + avgRating"></span>
            <span class="text-[11px] font-mono text-slate-400" x-text="reviews.length + ' rated'"></span>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 border-t border-slate-800/80 pt-1.5">
            <span>100% Student Verified</span>
            <a href="/admin/reviews" class="text-cyan-400 hover:underline">Moderate &rarr;</a>
          </div>
        </div>

        <!-- Metric 4: Physical QR & Digital Telemetry -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-xl p-3.5 space-y-1.5 hover:border-purple-500/40 transition-colors group">
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>QR & CONVERSIONS</span>
            <span class="text-xs">📱</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl sm:text-3xl font-black text-purple-400 tracking-tight" x-text="qrStats.totalScans || 0"></span>
            <span class="text-[11px] font-mono text-slate-400">Scans</span>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 border-t border-slate-800/80 pt-1.5">
            <span class="text-emerald-400 font-bold" x-text="(qrStats.totalCalls || 0) + ' Calls'"></span>
            <span class="text-cyan-400 font-bold" x-text="(qrStats.totalWhatsApp || 0) + ' WA Orders'"></span>
          </div>
        </div>

      </div>

      <!-- 3. Dual Main Workspaces: Fleet Matrix (Left 7 cols) & Live Telemetry Stream (Right 5 cols) -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-4">
        
        <!-- Left: Vendor Fleet Operations Matrix (7 Cols) -->
        <div class="xl:col-span-7 bg-[#0D131F] border border-slate-800/90 rounded-2xl p-4 shadow-lg space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 border-b border-slate-800/80">
            <div>
              <h3 class="font-mono font-bold text-sm text-white flex items-center gap-2">
                <span class="text-amber-400">■</span> FLEET COMMAND MATRIX
                <span class="text-[10px] text-slate-400 font-normal" x-text="'(' + filteredVendors.length + ' spots listed)'"></span>
              </h3>
            </div>

            <!-- Controls: Search & Filter Tabs -->
            <div class="flex items-center gap-2">
              <input
                type="text"
                x-model="vendorSearch"
                placeholder="Filter stalls..."
                class="px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg font-mono text-xs text-white placeholder-slate-600 focus:outline-none focus:border-amber-500 w-36 sm:w-44"
              />

              <div class="flex rounded-lg bg-slate-950 border border-slate-800 p-0.5 font-mono text-[10px]">
                <button
                  @click="vendorFilter = 'all'"
                  :class="vendorFilter === 'all' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >All</button>
                <button
                  @click="vendorFilter = 'open'"
                  :class="vendorFilter === 'open' ? 'bg-emerald-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >Open</button>
                <button
                  @click="vendorFilter = 'closed'"
                  :class="vendorFilter === 'closed' ? 'bg-rose-500 text-white font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >Closed</button>
              </div>
            </div>
          </div>

          <!-- High-Density Vendor Matrix Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-xs">
              <thead>
                <tr class="border-b border-slate-800 text-slate-500 text-[10px] uppercase tracking-wider">
                  <th class="py-2 px-2">Spot</th>
                  <th class="py-2 px-2">Operating Hours</th>
                  <th class="py-2 px-2 text-center">Status (1-Click)</th>
                  <th class="py-2 px-2 text-right">Quick Access</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-850">
                <template x-for="v in filteredVendors" :key="v.id">
                  <tr class="hover:bg-slate-900/60 transition-colors group">
                    <td class="py-2 px-2">
                      <div class="font-bold text-white group-hover:text-amber-400 transition-colors" x-text="v.name"></div>
                      <div class="text-[10px] text-slate-500 flex items-center gap-1.5 truncate max-w-[200px]">
                        <span x-text="v.address || 'Campus Area'"></span>
                        <span x-show="v.isFeatured" class="text-amber-400 font-bold">★ FEATURED</span>
                      </div>
                    </td>
                    <td class="py-2 px-2 text-slate-400 whitespace-nowrap">
                      <span class="text-[11px] font-mono text-slate-300" x-text="(v.opensAt || '09:00') + ' - ' + (v.closesAt || '23:00')"></span>
                    </td>
                    <td class="py-2 px-2 text-center whitespace-nowrap">
                      <button
                        type="button"
                        @click="toggleVendorStatus(v)"
                        :class="v.isActive ? 'bg-emerald-950/80 text-emerald-400 border-emerald-700/80 hover:bg-emerald-900' : 'bg-rose-950/80 text-rose-400 border-rose-800/80 hover:bg-rose-900'"
                        class="px-2.5 py-1 rounded-md text-[10px] font-bold border transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-xs"
                        :title="v.isActive ? 'Click to mark Closed' : 'Click to mark Open'"
                      >
                        <span class="w-1.5 h-1.5 rounded-full" :class="v.isActive ? 'bg-emerald-400' : 'bg-rose-400'"></span>
                        <span x-text="v.isActive ? 'ONLINE' : 'OFFLINE'"></span>
                      </button>
                    </td>
                    <td class="py-2 px-2 text-right whitespace-nowrap space-x-1.5">
                      <a
                        :href="'/v/' + v.slug"
                        target="_blank"
                        class="p-1 bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-amber-400 rounded border border-slate-800 inline-block text-[10px] transition-colors"
                        title="View Live Public Menu"
                      >
                        Menu ↗
                      </a>
                      <a
                        :href="'tel:' + v.phone"
                        class="p-1 bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-emerald-400 rounded border border-slate-800 inline-block text-[10px] transition-colors"
                        title="Test Stall Call"
                      >
                        📞 Call
                      </a>
                      <a
                        href="/admin/stalls"
                        class="p-1 bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-white rounded border border-slate-800 inline-block text-[10px] transition-colors"
                        title="Edit Stall in Full View"
                      >
                        ✏️ Edit
                      </a>
                    </td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right: Realtime Telemetry Feed (5 Cols) -->
        <div class="xl:col-span-5 bg-[#0D131F] border border-slate-800/90 rounded-2xl p-4 shadow-lg space-y-3 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
              <h3 class="font-mono font-bold text-sm text-white flex items-center gap-2">
                <span class="text-cyan-400">■</span> REALTIME EVENT FEED
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              </h3>
              
              <!-- Feed Filter Tabs -->
              <div class="flex rounded-lg bg-slate-950 border border-slate-800 p-0.5 font-mono text-[10px]">
                <button
                  @click="telemetryFilter = 'all'"
                  :class="telemetryFilter === 'all' ? 'bg-cyan-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >All</button>
                <button
                  @click="telemetryFilter = 'qr_scan'"
                  :class="telemetryFilter === 'qr_scan' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >QR</button>
                <button
                  @click="telemetryFilter = 'call_click'"
                  :class="telemetryFilter === 'call_click' ? 'bg-emerald-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >Calls</button>
                <button
                  @click="telemetryFilter = 'whatsapp_click'"
                  :class="telemetryFilter === 'whatsapp_click' ? 'bg-emerald-500 text-slate-950 font-bold' : 'text-slate-400 hover:text-white'"
                  class="px-2 py-0.5 rounded cursor-pointer"
                >WA</button>
              </div>
            </div>

            <!-- Feed Event Stream -->
            <div class="mt-3 space-y-2 max-h-[380px] overflow-y-auto pr-1">
              <template x-if="filteredTelemetry.length === 0">
                <div class="py-12 text-center text-slate-600 font-mono text-xs">
                  <div>📡</div>
                  <p class="mt-1">Awaiting physical campus scan telemetry...</p>
                </div>
              </template>

              <template x-for="(event, idx) in filteredTelemetry" :key="event.id || idx">
                <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between text-xs font-mono group hover:border-slate-700 transition-colors">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span
                      class="w-7 h-7 rounded-lg flex items-center justify-center text-xs flex-shrink-0"
                      :class="
                        event.event_type === 'qr_scan' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' :
                        event.event_type === 'call_click' ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' :
                        event.event_type === 'whatsapp_click' ? 'bg-teal-500/15 text-teal-400 border border-teal-500/30' :
                        'bg-purple-500/15 text-purple-400 border border-purple-500/30'
                      "
                    >
                      <span x-text="
                        event.event_type === 'qr_scan' ? '📱' :
                        event.event_type === 'call_click' ? '📞' :
                        event.event_type === 'whatsapp_click' ? '💬' : '⚡'
                      "></span>
                    </span>

                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class="font-bold text-white uppercase text-[11px]" x-text="(event.event_type || 'event').replace('_', ' ')"></span>
                        <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-900 text-slate-400 border border-slate-800" x-text="event.medium || 'direct'"></span>
                      </div>
                      <p class="text-[10px] text-slate-500 truncate" x-text="event.vendor_slug || event.campaign || 'campus_general'"></p>
                    </div>
                  </div>

                  <span class="text-[10px] text-slate-500 whitespace-nowrap" x-text="formatTimeAgo(event.timestamp)"></span>
                </div>
              </template>
            </div>
          </div>

          <!-- Bottom Telemetry Summary -->
          <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>Campaign Studio Telemetry</span>
            <a href="/admin/qr" class="text-cyan-400 hover:underline">Launch Studio &rarr;</a>
          </div>
        </div>

      </div>

      <!-- 4. Deep Analytics HUD (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <!-- Panel 1: Price Distribution Histogram -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-2xl p-4 shadow-lg space-y-3 font-mono">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
            <h4 class="font-bold text-xs text-white flex items-center gap-2">
              <span class="text-amber-400">■</span> PRICE SPREAD HISTOGRAM
            </h4>
            <span class="text-[10px] text-slate-500">Student Affordability</span>
          </div>

          <div class="space-y-2.5 pt-1 text-xs">
            <div>
              <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                <span>Under ₹50 (Pocket Friendly)</span>
                <span class="text-emerald-400 font-bold" x-text="menuItems.filter(m => Number(m.price) < 50).length + ' items'"></span>
              </div>
              <div class="h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                <div class="h-full bg-emerald-500 rounded-full" :style="'width: ' + ((menuItems.filter(m => Number(m.price) < 50).length / (menuItems.length || 1)) * 100) + '%'"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                <span>₹50 – ₹100 (Standard Meals)</span>
                <span class="text-amber-400 font-bold" x-text="menuItems.filter(m => Number(m.price) >= 50 && Number(m.price) < 100).length + ' items'"></span>
              </div>
              <div class="h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                <div class="h-full bg-amber-500 rounded-full" :style="'width: ' + ((menuItems.filter(m => Number(m.price) >= 50 && Number(m.price) < 100).length / (menuItems.length || 1)) * 100) + '%'"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                <span>₹100 – ₹200 (Loaded Platters)</span>
                <span class="text-cyan-400 font-bold" x-text="menuItems.filter(m => Number(m.price) >= 100 && Number(m.price) < 200).length + ' items'"></span>
              </div>
              <div class="h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                <div class="h-full bg-cyan-500 rounded-full" :style="'width: ' + ((menuItems.filter(m => Number(m.price) >= 100 && Number(m.price) < 200).length / (menuItems.length || 1)) * 100) + '%'"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-[11px] text-slate-400 mb-1">
                <span>Over ₹200 (Group Combos)</span>
                <span class="text-purple-400 font-bold" x-text="menuItems.filter(m => Number(m.price) >= 200).length + ' items'"></span>
              </div>
              <div class="h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
                <div class="h-full bg-purple-500 rounded-full" :style="'width: ' + ((menuItems.filter(m => Number(m.price) >= 200).length / (menuItems.length || 1)) * 100) + '%'"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel 2: Dietary Split & Category Health -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-2xl p-4 shadow-lg space-y-3 font-mono">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
            <h4 class="font-bold text-xs text-white flex items-center gap-2">
              <span class="text-emerald-400">■</span> DIETARY & CATEGORY SPREAD
            </h4>
            <span class="text-[10px] text-slate-500">Taxonomy Ratio</span>
          </div>

          <!-- Veg vs Non-Veg Progress Meter -->
          <div class="pt-1 space-y-1.5">
            <div class="flex justify-between text-[11px]">
              <span class="text-emerald-400 font-bold" x-text="'🌱 ' + Math.round((vegCount / (menuItems.length || 1)) * 100) + '% Veg'"></span>
              <span class="text-rose-400 font-bold" x-text="'🍗 ' + Math.round((nonVegCount / (menuItems.length || 1)) * 100) + '% Non-Veg'"></span>
            </div>
            <div class="h-2.5 bg-slate-950 rounded-full overflow-hidden flex border border-slate-800">
              <div class="bg-emerald-500 h-full" :style="'width: ' + ((vegCount / (menuItems.length || 1)) * 100) + '%'"></div>
              <div class="bg-rose-500 h-full" :style="'width: ' + ((nonVegCount / (menuItems.length || 1)) * 100) + '%'"></div>
            </div>
          </div>

          <!-- Category Counts List -->
          <div class="pt-2 border-t border-slate-800/80 space-y-1.5 max-h-[140px] overflow-y-auto pr-1">
            <template x-for="c in categories.slice(0, 6)" :key="c.id">
              <div class="flex items-center justify-between text-[11px] py-0.5 text-slate-400 hover:text-white">
                <span class="truncate flex items-center gap-1.5">
                  <span x-text="c.icon || '🍽️'"></span>
                  <span x-text="c.name"></span>
                </span>
                <span class="text-slate-500" x-text="menuItems.filter(m => m.categoryId === c.id).length + ' items'"></span>
              </div>
            </template>
          </div>
        </div>

        <!-- Panel 3: Top Rated Campus Dishes -->
        <div class="bg-[#0D131F] border border-slate-800/90 rounded-2xl p-4 shadow-lg space-y-3 font-mono">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
            <h4 class="font-bold text-xs text-white flex items-center gap-2">
              <span class="text-cyan-400">■</span> TOP RATED CAMPUS DISHES
            </h4>
            <span class="text-[10px] text-slate-500">Student Picks</span>
          </div>

          <div class="space-y-2 pt-1 max-h-[210px] overflow-y-auto pr-1">
            <template x-if="menuItems.length === 0">
              <p class="text-xs text-slate-600 text-center py-6">No menu items found</p>
            </template>

            <template x-for="(dish, idx) in menuItems.slice(0, 5)" :key="dish.id">
              <div class="p-2 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between text-xs hover:border-amber-500/40 transition-colors">
                <div class="min-w-0 pr-2">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full flex-shrink-0" :class="dish.isVeg ? 'bg-emerald-400' : 'bg-rose-400'"></span>
                    <span class="font-bold text-white truncate" x-text="dish.name"></span>
                  </div>
                  <span class="text-[10px] text-slate-500 truncate block" x-text="dish.categoryName || 'Campus Preparation'"></span>
                </div>
                <div class="text-right flex-shrink-0">
                  <span class="text-emerald-400 font-bold block" x-text="'₹' + dish.price"></span>
                  <span class="text-[10px] text-amber-400 font-bold">★ 4.9</span>
                </div>
              </div>
            </template>
          </div>
        </div>

      </div>

    </main>

    <!-- ➕ Modal 1: Add New Campus Vendor -->
    <div
      x-show="showAddStallModal"
      x-transition
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
      @click.self="showAddStallModal = false"
      @keydown.escape.window="showAddStallModal = false"
    >
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 max-w-lg w-full space-y-4 shadow-2xl font-mono text-slate-200">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="text-amber-400">■</span> ONBOARD NEW FOOD SPOT
          </h3>
          <button @click="showAddStallModal = false" class="text-slate-500 hover:text-white cursor-pointer font-bold">✕</button>
        </div>

        <form @submit.prevent="createStall()" class="space-y-3.5 text-xs">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Vendor Brand Name *</label>
            <input type="text" x-model="newStall.name" required placeholder="e.g. Night Canteen H-7" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Phone Number</label>
              <input type="text" x-model="newStall.phone" placeholder="+91 98765 43210" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">WhatsApp (Orders)</label>
              <input type="text" x-model="newStall.whatsapp" placeholder="919876543210" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Campus Location</label>
            <input type="text" x-model="newStall.address" placeholder="e.g. Gate 1, Near SBI / Market" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Opens At</label>
              <input type="time" x-model="newStall.opensAt" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-amber-500" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Closes At</label>
              <input type="time" x-model="newStall.closesAt" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-amber-500" />
            </div>
          </div>

          <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
            <button type="button" @click="showAddStallModal = false" class="px-4 py-2 bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-white rounded-lg cursor-pointer">Cancel</button>
            <button type="submit" :disabled="savingStall" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg cursor-pointer shadow-sm">
              <span x-show="!savingStall">Create Vendor</span>
              <span x-show="savingStall">Deploying...</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ➕ Modal 2: Add New Menu Dish -->
    <div
      x-show="showAddDishModal"
      x-transition
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
      @click.self="showAddDishModal = false"
      @keydown.escape.window="showAddDishModal = false"
    >
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 max-w-lg w-full space-y-4 shadow-2xl font-mono text-slate-200">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="text-emerald-400">■</span> CATALOG NEW MENU ITEM
          </h3>
          <button @click="showAddDishModal = false" class="text-slate-500 hover:text-white cursor-pointer font-bold">✕</button>
        </div>

        <form @submit.prevent="createDish()" class="space-y-3.5 text-xs">
          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Target Vendor *</label>
            <select x-model="newDish.vendorId" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500">
              <option value="">-- Select Food Spot --</option>
              <template x-for="v in vendors" :key="v.id">
                <option :value="v.id" x-text="v.name"></option>
              </template>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Category</label>
            <select x-model="newDish.categoryId" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-emerald-500">
              <option value="">-- Choose Category --</option>
              <template x-for="c in categories" :key="c.id">
                <option :value="c.id" x-text="c.icon + ' ' + c.name"></option>
              </template>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Dish Name *</label>
              <input type="text" x-model="newDish.name" required placeholder="e.g. Butter Paneer Paratha" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Price (₹ INR) *</label>
              <input type="number" x-model="newDish.price" required placeholder="60" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-400 mb-1">Preparation Note</label>
            <input type="text" x-model="newDish.description" placeholder="Served hot with mint chutney & curd" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-emerald-500" />
          </div>

          <div class="flex items-center gap-4 pt-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" x-model="newDish.isVeg" class="rounded border-slate-700 bg-slate-950 text-emerald-500">
              <span class="text-xs font-bold text-emerald-400">🌱 Pure Veg</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" x-model="newDish.isAvailable" class="rounded border-slate-700 bg-slate-950 text-amber-500">
              <span class="text-xs font-bold text-slate-300">In Stock</span>
            </label>
          </div>

          <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-800">
            <button type="button" @click="showAddDishModal = false" class="px-4 py-2 bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-white rounded-lg cursor-pointer">Cancel</button>
            <button type="submit" :disabled="savingDish" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg cursor-pointer shadow-sm">
              <span x-show="!savingDish">Deploy Item</span>
              <span x-show="savingDish">Saving...</span>
            </button>
          </div>
        </form>
      </div>
    </div>

  </section>
</Layout>