---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getAllReviews, getActiveVendors, getCategories, getAllMenuItemsForSearch } from '../../lib/queries';

const initialReviews = await getAllReviews();
const initialVendors = await getActiveVendors();
const initialCategories = await getCategories();
const initialMenuItems = await getAllMenuItemsForSearch();
---

<script is:inline define:vars={{ initialReviews, initialVendors, initialCategories, initialMenuItems }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('reviewsAdmin', () => ({
      sidebarOpen: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      selectedRating: '',
      search: '',
      toastMsg: '',
      previewPhoto: null,

      async init() {
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAll() {
        try {
          const [rRes, vRes, cRes, mRes] = await Promise.all([
            fetch('/api/admin/reviews').catch(() => null),
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/menu').catch(() => null)
          ]);

          if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
          if (vRes && vRes.ok) { const d = await vRes.json(); if (d.vendors && d.vendors.length > 0) this.vendors = d.vendors; }
          if (cRes && cRes.ok) { const d = await cRes.json(); if (d.categories && d.categories.length > 0) this.categories = d.categories; }
          if (mRes && mRes.ok) { const d = await mRes.json(); if (d.items && d.items.length > 0) this.menuItems = d.items; }
        } catch (e) {
          console.error('Load error', e);
        }
      },

      get filteredReviews() {
        return this.reviews.filter(r => {
          if (this.selectedRating) {
            if (this.selectedRating === 'low') {
              if (Number(r.rating) > 2) return false;
            } else if (String(r.rating) !== String(this.selectedRating)) {
              return false;
            }
          }
          if (this.search.trim()) {
            const q = this.search.toLowerCase();
            const name = (r.studentName || '').toLowerCase();
            const dish = (r.menuItemName || r.dishName || '').toLowerCase();
            const vendor = (r.vendorName || '').toLowerCase();
            const comment = (r.comment || '').toLowerCase();
            return name.includes(q) || dish.includes(q) || vendor.includes(q) || comment.includes(q);
          }
          return true;
        });
      },

      get reviewStats() {
        const total = this.reviews.length;
        if (!total) return { total: 0, avg: '5.0', fiveStars: 0, withPhoto: 0 };
        const sum = this.reviews.reduce((acc, r) => acc + (Number(r.rating) || 5), 0);
        const fiveStars = this.reviews.filter(r => Number(r.rating) === 5).length;
        const withPhoto = this.reviews.filter(r => Boolean(r.photoUrl)).length;
        return {
          total,
          avg: (sum / total).toFixed(1),
          fiveStarsPercent: Math.round((fiveStars / total) * 100),
          withPhoto
        };
      },

      exportCSV() {
        const headers = ['ID', 'Student Name', 'Rating', 'Dish', 'Vendor', 'Comment', 'Date'];
        const rows = this.filteredReviews.map(r => [
          r.id,
          '"' + (r.studentName || '').replace(/"/g, '') + '"',
          r.rating,
          '"' + (r.dishName || r.menuItemName || '').replace(/"/g, '') + '"',
          '"' + (r.vendorName || '').replace(/"/g, '') + '"',
          '"' + (r.comment || '').replace(/"/g, '') + '"',
          r.createdAt || ''
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', 'orandus_reviews_' + new Date().toISOString().slice(0,10) + '.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      },

      async deleteReview(id) {
        if (!confirm('Are you sure you want to delete this student review?')) return;
        try {
          const res = await fetch('/api/reviews?id=' + id, { method: 'DELETE' });
          if (res.ok) {
            this.reviews = this.reviews.filter(r => r.id !== id);
            this.showToast('✅ Review removed');
          } else {
            alert('Failed to delete review');
          }
        } catch (e) {
          alert('Error deleting review');
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      }
    }));
  });
</script>

<Layout title="Student Reviews & Feedback - Orandus Ops" description="Moderate and manage verified campus student feedback">
  <section class="min-h-screen bg-[#090D15] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    <div
      x-data="reviewsAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >
      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-[#161F30] border border-amber-500/40 text-amber-300 px-4 py-2.5 rounded-xl shadow-2xl font-medium text-xs flex items-center gap-2.5 backdrop-blur-md"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/reviews" />

      <!-- Main Content Area -->
      <main class="flex-1 p-3.5 sm:p-6 lg:p-7 overflow-y-auto space-y-5 max-w-6xl w-full">
        
        <!-- Header -->
        <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold mb-2">
              <span>⭐</span> Quality Ratings & Telemetry
            </div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
              Student Reviews Moderation
            </h1>
            <p class="text-xs text-slate-400 mt-1">
              Track real food ratings, dish reviews, and student feedback across all campus spots.
            </p>
          </div>

          <div class="flex items-center gap-2.5">
            <button
              @click="exportCSV()"
              class="px-3 py-2 bg-[#0A0F1A] border border-slate-800 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2 cursor-pointer"
            >
              <span>📥</span> Export CSV
            </button>
          </div>
        </div>

        <!-- Telemetry Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
            <div>
              <p class="text-[11px] font-medium text-slate-400">Total Reviews</p>
              <p class="text-lg font-bold text-white mt-0.5" x-text="reviewStats.total"></p>
            </div>
            <span class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-sm">💬</span>
          </div>

          <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
            <div>
              <p class="text-[11px] font-medium text-slate-400">Campus Rating</p>
              <p class="text-lg font-bold text-amber-300 mt-0.5" x-text="'★ ' + reviewStats.avg"></p>
            </div>
            <span class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 flex items-center justify-center text-sm">⭐</span>
          </div>

          <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
            <div>
              <p class="text-[11px] font-medium text-slate-400">5-Star Ratio</p>
              <p class="text-lg font-bold text-emerald-400 mt-0.5" x-text="(reviewStats.fiveStarsPercent || 0) + '%'"></p>
            </div>
            <span class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm">✨</span>
          </div>

          <div class="bg-[#101726] border border-slate-800/80 rounded-xl p-3.5 flex items-center justify-between">
            <div>
              <p class="text-[11px] font-medium text-slate-400">With Photos</p>
              <p class="text-lg font-bold text-slate-200 mt-0.5" x-text="reviewStats.withPhoto"></p>
            </div>
            <span class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-sm">📸</span>
          </div>
        </div>

        <!-- Filters Bar -->
        <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
          <div class="relative flex-1">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400">🔍</span>
            <input
              type="text"
              x-model="search"
              placeholder="Search by student, dish, food stall, or comment..."
              class="w-full pl-9 pr-8 py-2 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 placeholder-slate-500 focus:outline-hidden focus:border-amber-500/50"
            />
            <button
              x-show="search"
              @click="search = ''"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-500 hover:text-slate-300"
            >✕</button>
          </div>

          <!-- Quick Rating Chips -->
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0">
            <button
              @click="selectedRating = ''"
              :class="selectedRating === '' ? 'bg-amber-500/20 border-amber-500/40 text-amber-300' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
              class="px-2.5 py-1.5 border rounded-xl text-xs font-medium transition-colors cursor-pointer whitespace-nowrap"
            >All Stars</button>
            <button
              @click="selectedRating = '5'"
              :class="selectedRating === '5' ? 'bg-amber-500/20 border-amber-500/40 text-amber-300' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
              class="px-2.5 py-1.5 border rounded-xl text-xs font-medium transition-colors cursor-pointer whitespace-nowrap"
            >5 ⭐</button>
            <button
              @click="selectedRating = '4'"
              :class="selectedRating === '4' ? 'bg-amber-500/20 border-amber-500/40 text-amber-300' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
              class="px-2.5 py-1.5 border rounded-xl text-xs font-medium transition-colors cursor-pointer whitespace-nowrap"
            >4 ⭐</button>
            <button
              @click="selectedRating = '3'"
              :class="selectedRating === '3' ? 'bg-amber-500/20 border-amber-500/40 text-amber-300' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
              class="px-2.5 py-1.5 border rounded-xl text-xs font-medium transition-colors cursor-pointer whitespace-nowrap"
            >3 ⭐</button>
            <button
              @click="selectedRating = 'low'"
              :class="selectedRating === 'low' ? 'bg-rose-500/20 border-rose-500/40 text-rose-300' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
              class="px-2.5 py-1.5 border rounded-xl text-xs font-medium transition-colors cursor-pointer whitespace-nowrap"
            >≤ 2 ⭐ Flagged</button>
          </div>
        </div>

        <!-- Reviews Stream -->
        <template x-if="filteredReviews.length === 0">
          <div class="text-center py-12 bg-[#101726] rounded-2xl border border-slate-800/80">
            <span class="text-3xl block mb-2">⭐</span>
            <p class="text-xs font-semibold text-slate-300">No student reviews match your active filter</p>
            <button @click="search = ''; selectedRating = ''" class="mt-2 text-xs text-amber-400 hover:underline cursor-pointer">Reset Filters</button>
          </div>
        </template>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <template x-for="r in filteredReviews" :key="r.id">
            <div class="bg-[#101726] rounded-2xl border border-slate-800/80 p-4 space-y-3 shadow-xs hover:border-slate-700 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 font-bold text-xs flex items-center justify-center flex-shrink-0" x-text="r.studentName ? r.studentName.charAt(0).toUpperCase() : 'S'"></div>
                    <div>
                      <div class="flex items-center gap-1.5">
                        <h4 class="font-bold text-xs text-slate-100" x-text="r.studentName || 'NIT Student'"></h4>
                        <span class="text-[10px] px-1.5 py-0.2 rounded bg-slate-900 border border-slate-800 text-emerald-400">Verified</span>
                      </div>
                      <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5" x-text="r.menuItemName ? (r.menuItemName + (r.vendorName ? ' @ ' + r.vendorName : '')) : 'General Campus Feedback'"></p>
                    </div>
                  </div>
                  <span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-amber-500/10 text-amber-300 border border-amber-500/20 flex-shrink-0" x-text="'★ ' + r.rating"></span>
                </div>

                <p class="text-xs text-slate-300 italic bg-[#0A0F1A] p-3 rounded-xl border border-slate-800/80 leading-relaxed" x-text="'“' + (r.comment || 'Great campus food!') + '”'"></p>

                <!-- Review Photo Thumbnail (if attached) -->
                <template x-if="r.photoUrl">
                  <div class="mt-2.5 flex items-center gap-2 pt-1">
                    <img
                      :src="r.photoUrl"
                      alt="Dish Photo"
                      class="w-12 h-12 object-cover rounded-xl border border-slate-700 shadow-2xs hover:scale-105 transition-transform cursor-pointer"
                      @click="previewPhoto = r.photoUrl"
                      title="Click to zoom dish photo"
                    />
                    <span class="text-[10px] font-medium text-amber-300 bg-amber-500/10 px-2 py-0.5 rounded-lg border border-amber-500/20">📷 Photo Attached</span>
                  </div>
                </template>
              </div>

              <div class="pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                <span x-text="new Date(r.createdAt || Date.now()).toLocaleDateString('en-IN')"></span>
                <button @click="deleteReview(r.id)" class="text-rose-400 hover:text-rose-300 font-semibold text-xs cursor-pointer">Delete Review</button>
              </div>
            </div>
          </template>
        </div>

      </main>

    </div>
  </section>

  <!-- 🔍 Admin Lightbox Modal -->
  <div
    x-show="previewPhoto"
    x-cloak
    class="fixed inset-0 z-[120] flex items-center justify-center p-4 bg-black/85 backdrop-blur-md"
    @click.self="previewPhoto = null"
    @keydown.escape.window="previewPhoto = null"
  >
    <div class="relative max-w-lg w-full max-h-[90vh] flex flex-col items-center">
      <button
        type="button"
        @click="previewPhoto = null"
        class="absolute -top-10 right-0 text-white hover:text-amber-400 font-bold text-sm p-1.5 cursor-pointer flex items-center gap-1 transition-colors"
      >
        <span>✕ Close</span>
      </button>
      <img
        :src="previewPhoto"
        alt="Enlarged Dish Photo"
        class="max-w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl border border-white/20"
        @click.stop
      />
    </div>
  </div>
</Layout>
