---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getAllReviews, getActiveVendors, getCategories, getMenuItemsByVendor } from '../../lib/queries';

const initialReviews = await getAllReviews();
const initialVendors = await getActiveVendors();
const initialCategories = await getCategories();
const initialMenuItems = await getMenuItemsByVendor(21);
---

<script is:inline define:vars={{ initialReviews, initialVendors, initialCategories, initialMenuItems }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('reviewsAdmin', () => ({
      sidebarOpen: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      selectedRating: '',
      search: '',
      toastMsg: '',

      async init() {
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      async loadAll() {
        try {
          const [rRes, vRes, cRes, mRes] = await Promise.all([
            fetch('/api/admin/reviews').catch(() => null),
            fetch('/api/admin/vendors').catch(() => null),
            fetch('/api/admin/categories').catch(() => null),
            fetch('/api/admin/menu').catch(() => null)
          ]);

          if (rRes && rRes.ok) { const d = await rRes.json(); this.reviews = d.reviews || []; }
          if (vRes && vRes.ok) { const d = await vRes.json(); if (d.vendors && d.vendors.length > 0) this.vendors = d.vendors; }
          if (cRes && cRes.ok) { const d = await cRes.json(); if (d.categories && d.categories.length > 0) this.categories = d.categories; }
          if (mRes && mRes.ok) { const d = await mRes.json(); if (d.items && d.items.length > 0) this.menuItems = d.items; }
        } catch (e) {
          console.error('Load error', e);
        }
      },

      get filteredReviews() {
        return this.reviews.filter(r => {
          if (this.selectedRating && String(r.rating) !== String(this.selectedRating)) {
            return false;
          }
          if (this.search.trim()) {
            const q = this.search.toLowerCase();
            const name = (r.studentName || '').toLowerCase();
            const dish = (r.menuItemName || '').toLowerCase();
            const vendor = (r.vendorName || '').toLowerCase();
            const comment = (r.comment || '').toLowerCase();
            return name.includes(q) || dish.includes(q) || vendor.includes(q) || comment.includes(q);
          }
          return true;
        });
      },

      exportCSV() {
        const headers = ['ID', 'Student Name', 'Rating', 'Dish', 'Vendor', 'Comment', 'Date'];
        const rows = this.filteredReviews.map(r => [
          r.id,
          '"' + (r.studentName || '').replace(/"/g, '') + '"',
          r.rating,
          '"' + (r.dishName || r.menuItemName || '').replace(/"/g, '') + '"',
          '"' + (r.vendorName || '').replace(/"/g, '') + '"',
          '"' + (r.comment || '').replace(/"/g, '') + '"',
          r.createdAt || ''
        ]);
        const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', 'orandus_reviews_' + new Date().toISOString().slice(0,10) + '.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      },

      async deleteReview(id) {
        if (!confirm('Are you sure you want to delete this review?')) return;
        try {
          const res = await fetch('/api/reviews?id=' + id, { method: 'DELETE' });
          if (res.ok) {
            this.reviews = this.reviews.filter(r => r.id !== id);
            this.showToast('Review removed');
          } else {
            alert('Failed to delete review');
          }
        } catch (e) {
          alert('Error deleting review');
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/';
      }
    }));
  });
</script>

<Layout title="Student Reviews & Feedback - Orandus Admin" description="Moderate and manage verified campus student feedback">
  <section class="min-h-screen bg-nitkkr-cream flex flex-col lg:flex-row text-nitkkr-dark">
    <div
      x-data="reviewsAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >


      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-nitkkr-dark text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 border border-nitkkr-orange/40"
      >
        <span class="text-base">🔔</span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/reviews" />

      <!-- Main Content Area -->
      <main class="flex-1 p-4 sm:p-8 lg:p-10 overflow-y-auto max-w-6xl">
        <div class="space-y-8">

          <!-- Header -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nitkkr-orange/10 border border-nitkkr-orange/20 text-nitkkr-orange text-[11px] font-bold mb-2">
                <span>⭐</span> Quality Ratings & Reviews
              </div>
              <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark">
                Student Feedback Moderation
              </h1>
              <p class="text-xs sm:text-sm text-nitkkr-gray mt-1">
                Review, filter, and moderate authentic ratings submitted by NIT Kurukshetra students.
              </p>
            </div>

            <div class="flex items-center gap-3">
              <button
                @click="exportCSV()"
                class="px-4 py-3 bg-white border border-nitkkr-orange/30 hover:bg-nitkkr-orange/10 text-nitkkr-dark font-bold text-xs rounded-2xl shadow-xs transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
              >
                <span>📥</span> Export CSV
              </button>
              <div class="px-5 py-3 bg-amber-50 border border-amber-200 rounded-2xl text-center self-start sm:self-auto">
                <span class="text-[10px] font-bold text-amber-800 uppercase block">Total Reviews</span>
                <span class="font-display text-xl font-bold text-amber-600" x-text="reviews.length"></span>
              </div>
            </div>
          </div>

          <!-- Filters Bar -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row gap-3 items-center justify-between">
            <input
              type="text"
              x-model="search"
              placeholder="Search by student, dish, or vendor..."
              class="w-full sm:w-80 px-4 py-2 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden"
            />


            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
              <span class="text-xs font-bold text-slate-600">Rating:</span>
              <select x-model="selectedRating" class="px-3 py-2 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden">
                <option value="">All Stars</option>
                <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
                <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
                <option value="3">⭐⭐⭐ (3 Stars)</option>
                <option value="2">⭐⭐ (2 Stars)</option>
                <option value="1">⭐ (1 Star)</option>
              </select>
            </div>
          </div>

          <!-- Reviews Stream -->
          <template x-if="filteredReviews.length === 0">
            <div class="text-center py-12 bg-white rounded-3xl border border-nitkkr-orange/20">
              <span class="text-4xl block mb-2">⭐</span>
              <p class="text-xs font-bold text-nitkkr-dark">No student reviews match your filters</p>
            </div>
          </template>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <template x-for="r in filteredReviews" :key="r.id">
              <div class="bg-white rounded-3xl border border-nitkkr-orange/20 p-5 space-y-3 shadow-sm hover:border-amber-400 transition-all flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                      <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-800 font-bold text-xs flex items-center justify-center" x-text="r.studentName ? r.studentName.charAt(0).toUpperCase() : 'S'"></div>
                      <div>
                        <h4 class="font-bold text-xs text-nitkkr-dark" x-text="r.studentName || 'NIT Student'"></h4>
                        <p class="text-[10px] text-slate-500" x-text="r.menuItemName ? (r.menuItemName + (r.vendorName ? ' @ ' + r.vendorName : '')) : 'General Feedback'"></p>
                      </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200" x-text="'★ ' + r.rating"></span>
                  </div>

                  <p class="text-xs text-slate-700 italic bg-nitkkr-cream/40 p-3 rounded-2xl border border-nitkkr-orange/15 leading-relaxed" x-text="'“' + (r.comment || 'Great taste!') + '”'"></p>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
                  <span x-text="new Date(r.createdAt || Date.now()).toLocaleDateString('en-IN')"></span>
                  <button @click="deleteReview(r.id)" class="text-rose-600 font-bold text-xs hover:underline cursor-pointer">Delete Review</button>
                </div>
              </div>
            </template>
          </div>

        </div>
      </main>

    </div>
  </section>
</Layout>
