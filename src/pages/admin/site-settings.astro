                    type="button"
                    @click="settings.how_it_works_step3_title = '3. 1-Tap WhatsApp Order'; settings.how_it_works_step3_desc = 'Tap \'Order on WhatsApp\' to send a pre-filled greeting directly to the vendor owner. Zero commissions, zero middleman markups!';"
                    class="px-2.5 py-1 bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-[10px] font-bold rounded-lg transition-colors cursor-pointer"
                  >
                    Reset to WhatsApp
                  </button>
                </div>
              </div>

              <div class="space-y-3">
                <div>
                  <label class="text-xs font-bold text-nitkkr-dark block mb-1">Step 3 Title</label>
                  <input type="text" x-model="settings.how_it_works_step3_title" placeholder="3. Call or Visit Counter" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
                </div>
                <div>
                  <label class="text-xs font-bold text-nitkkr-dark block mb-1">Step 3 Description</label>
                  <textarea x-model="settings.how_it_works_step3_desc" rows="2" placeholder="Call the vendor directly to check availability or walk up to their campus counter..." class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden"></textarea>
                </div>
              </div>
            </div>

            <!-- Maintenance Notice -->
            <div class="space-y-3 pt-2 border-t border-slate-100">
              <div class="flex items-center justify-between">
                <div>
                  <label class="text-xs font-bold text-nitkkr-dark block">Maintenance / Off-Peak Notice</label>
                  <span class="text-[11px] text-nitkkr-gray">Shown when overall platform ordering is paused</span>
                </div>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" x-model="settings.ordering_enabled" :checked="settings.ordering_enabled === 'true'" @change="settings.ordering_enabled = $el.checked ? 'true' : 'false'" class="rounded text-emerald-600" />
                  <span class="text-xs font-bold text-emerald-700">Platform Online</span>
                </label>
              </div>
              <input type="text" x-model="settings.maintenance_message" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
            </div>
          </div>


          <!-- TAB 7: FOOTER BRANDING -->
          <div x-show="activeTab === 'footer'" class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
            <div class="pb-3 border-b border-slate-100">
              <h3 class="font-display text-lg font-bold text-nitkkr-dark">🦶 Footer Branding Controls</h3>
              <p class="text-xs text-nitkkr-gray">Controls text displayed at the bottom of every page</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Footer Tagline</label>
                <input type="text" x-model="settings.footer_tagline" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Footer Highlight Note</label>
                <input type="text" x-model="settings.footer_custom_note" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Copyright Line</label>
                <input type="text" x-model="settings.footer_copyright" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>
            </div>
          </div>

        </div>
      </main>

    </div>
  </section>
</Layout>