---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('siteSettingsAdmin', () => ({
      sidebarOpen: false,
      activeTab: 'general',
      saving: false,
      toastMsg: '',

      vibeChips: [
        { label: 'High Protein 🏋️‍♂️', icon: '⚡', href: '/search?tag=protein', isEnabled: true },
        { label: 'Late Night 2AM 🌙', icon: '🌙', href: '/search?tag=late-night', isEnabled: true },
        { label: 'Under ₹50 💸', icon: '💰', href: '/search?maxPrice=50', isEnabled: true },
        { label: 'Spicy Momos 🔥', icon: '🥢', href: '/search?q=momos', isEnabled: true },
        { label: 'Cheesy & Loaded 🧀', icon: '🧀', href: '/search?q=cheese', isEnabled: true },
        { label: 'Thick Shakes 🧋', icon: '🧋', href: '/search?category=beverages', isEnabled: true },
        { label: 'Pure Veg 🌱', icon: '🌱', href: '/search?isVeg=true', isEnabled: true },
        { label: 'Non-Veg 🍗', icon: '🍗', href: '/search?isVeg=false', isEnabled: true },
      ],

      newChip: {
        label: '',
        icon: '⚡',
        href: '/search?q='
      },

      announcementSlides: [
        {
          id: 'deal-1',
          badge: "🔥 TODAY'S CAMPUS DEAL",
          vendorName: 'Food Cave Fast Food',
          title: 'Free Hostel Delivery on ₹149+',
          description: 'Direct delivery to H-1 to H-11, DBH & Kalpana Bhawan till 2:00 AM!',
          ctaText: 'Order Now →',
          ctaLink: '/v/food-cave',
          gradient: 'from-orange-600 via-amber-600 to-rose-600',
          icon: '🛵',
          isEnabled: true
        },
        {
          id: 'deal-2',
          badge: '⚡ STUDENT SPECIAL',
          vendorName: 'Campus Specials',
          title: 'Butter Maggi + Hot Chai @ ₹59',
          description: 'Perfect evening study snack! Freshly prepared in 10 mins.',
          ctaText: 'View Deal →',
          ctaLink: '/search?q=maggi',
          gradient: 'from-emerald-700 via-teal-700 to-cyan-800',
          icon: '🍜',
          isEnabled: true
        },
        {
          id: 'deal-3',
          badge: '🎉 15% STUDENT DISCOUNT',
          vendorName: 'Food Cave Fast Food',
          title: 'Buy 2 Paneer Rolls & Save 15%',
          description: 'Hot grilled rolls with extra paneer & mint sauce. Show NIT ID.',
          ctaText: 'Explore Menu →',
          ctaLink: '/v/food-cave',
          gradient: 'from-indigo-700 via-purple-700 to-pink-700',
          icon: '🌯',
          isEnabled: true
        }
      ],

      newSlide: {
        badge: '🔥 CAMPUS OFFER',
        vendorName: 'Food Cave Fast Food',
        title: '',
        description: '',
        ctaText: 'Explore Menu →',
        ctaLink: '/search',
        gradient: 'from-orange-600 via-amber-600 to-rose-600',
        icon: '🍕'
      },

      settings: {
        homepage_title: 'Hungry? We got you. 🍜',
        homepage_tagline: 'Search 20+ food vendors around NITKKR',
        meta_description: 'Search 20+ food vendors around NIT Kurukshetra. View menus, prices, and connect directly with campus food spots.',
        announcement_banner_enabled: 'false',
        announcement_banner_text: '',
        announcement_banner_type: 'info',
        announcement_carousel_enabled: 'true',
        announcement_carousel_json: '',
        ad_banner_enabled: 'false',
        ad_banner_badge: '⚡ SPONSORED DEAL',
        ad_banner_title: 'Kurukshetra Protein & Shake Hub',
        ad_banner_description: '15% Flat Student Discount on all Whey Shakes & Healthy Bowls! Show NIT ID.',
        ad_banner_image: '',
        ad_banner_cta: 'Claim Offer 💬',
        ad_banner_link: '',
        ordering_enabled: 'true',
        whatsapp_ordering_enabled: 'false',
        show_whatsapp_button: 'false',
        whatsapp_button_label: 'Order on WhatsApp',
        whatsapp_msg_template: 'Hi {vendor_name}! I would like to check availability from Orandus.',
        how_it_works_step3_title: '3. Call or Visit Counter',
        how_it_works_step3_desc: 'Call the vendor directly to check availability or walk up to their campus counter with exact dishes and prices ready. Zero commissions, zero markups!',
        maintenance_message: 'Ordering is temporarily paused for campus break. Vendors reopen tomorrow at 8 AM.',
        footer_tagline: 'Instant campus menu directory & direct vendor connect for campus and city.',
        footer_custom_note: 'Zero Commissions • Direct Vendor Connect',
        footer_copyright: 'Food Spots & Services Directory',
        
        // 🏢 Company Profile Settings
        company_name: 'Orandus',
        founder_name: 'Manish Chauhan',
        company_legal_entity: 'Orandus Technologies',
        company_tagline: 'Instant Menu Search & Direct Vendor Connect',
        company_support_email: 'support@orandus.in',
        company_support_phone: '+91 98765 43210',
        company_address: 'NIT Kurukshetra Campus, Kurukshetra, Haryana 136119',
        company_instagram: 'https://instagram.com/orandus.in',
        company_linkedin: '',
        company_twitter: '',
        company_logo_url: '',
        company_favicon_url: '',
        company_mission: 'Empowering campus students with transparent prices, instant menus, and zero-commission food discovery.'
      },


      async init() {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab');
        if (tab && ['general', 'vibes', 'company', 'announcements', 'ads', 'ordering', 'footer'].includes(tab)) {
          this.activeTab = tab;
        }
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 4000);
      },

      async loadAll() {
        try {
          const res = await fetch('/api/admin/settings');
          if (res.ok) {
            const d = await res.json();
            this.settings = Object.assign({}, this.settings, d.settings || {});
            
            if (this.settings.vibe_chips_json) {
              try {
                const parsed = JSON.parse(this.settings.vibe_chips_json);
                if (Array.isArray(parsed) && parsed.length > 0) {
                  this.vibeChips = parsed;
                }
              } catch (e) {}
            }

            if (this.settings.announcement_carousel_json) {
              try {
                const parsedSlides = JSON.parse(this.settings.announcement_carousel_json);
                if (Array.isArray(parsedSlides) && parsedSlides.length > 0) {
                  this.announcementSlides = parsedSlides;
                }
              } catch (e) {}
            }
          }
        } catch (e) {
          console.error('Load settings error', e);
        }
      },

      addVibeChip() {
        if (!this.newChip.label.trim()) {
          alert('Chip label is required');
          return;
        }
        this.vibeChips.push({
          label: this.newChip.label.trim(),
          icon: this.newChip.icon || '⚡',
          href: this.newChip.href.trim() || '/search?q=' + encodeURIComponent(this.newChip.label.trim()),
          isEnabled: true
        });
        this.newChip = { label: '', icon: '⚡', href: '/search?q=' };
        this.showToast('Chip added! Click "Save All Changes" to publish.');
      },

      removeVibeChip(index) {
        this.vibeChips.splice(index, 1);
      },

      toggleVibeChip(index) {
        this.vibeChips[index].isEnabled = !this.vibeChips[index].isEnabled;
      },

      addSlide() {
        if (!this.newSlide.title.trim()) {
          alert('Offer / Announcement title is required');
          return;
        }
        this.announcementSlides.push({
          id: 'deal-' + Date.now(),
          badge: this.newSlide.badge.trim() || '🔥 CAMPUS DEAL',
          vendorName: this.newSlide.vendorName.trim() || 'Campus Food Spot',
          title: this.newSlide.title.trim(),
          description: this.newSlide.description.trim() || 'Special campus discount for NITKKR students.',
          ctaText: this.newSlide.ctaText.trim() || 'View Deal →',
          ctaLink: this.newSlide.ctaLink.trim() || '/search',
          gradient: this.newSlide.gradient || 'from-bistro-800 via-bistro-700 to-amber-700',
          icon: this.newSlide.icon || '🔥',
          isEnabled: true
        });
        this.newSlide = {
          badge: '🔥 CAMPUS OFFER',
          vendorName: 'Food Cave Fast Food',
          title: '',
          description: '',
          ctaText: 'Explore Menu →',
          ctaLink: '/search',
          gradient: 'from-bistro-800 via-bistro-700 to-amber-700',
          icon: '🍕'
        };
        this.showToast('Slide added! Click "Save All Changes" to publish live.');
      },

      removeSlide(index) {
        this.announcementSlides.splice(index, 1);
      },

      toggleSlide(index) {
        this.announcementSlides[index].isEnabled = !this.announcementSlides[index].isEnabled;
      },

      async saveAllSettings() {
        this.saving = true;
        try {
          this.settings.vibe_chips_json = JSON.stringify(this.vibeChips);
          this.settings.announcement_carousel_json = JSON.stringify(this.announcementSlides);

          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: this.settings })
          });
          if (res.ok) {
            this.showToast('🎉 All website settings & deals carousel saved live!');
          } else {
            const errData = await res.json().catch(() => ({}));
            this.showToast('❌ ' + (errData.error || 'Failed to save settings'));
          }
        } catch (err) {
          this.showToast('❌ Network error saving settings');
        } finally {
          this.saving = false;
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/';
      }
    }));
  });
</script>

<Layout title="Website Control Center - Orandus Admin" description="Control live hero text, Gen-Z vibe tags, company profile, ads, sponsors, and footer branding">
  <section class="min-h-screen bg-nitkkr-cream flex flex-col lg:flex-row text-nitkkr-dark">
    
    <div
      x-data="siteSettingsAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >

      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-nitkkr-dark text-white px-5 py-3 rounded-2xl shadow-2xl font-bold text-xs flex items-center gap-2 border border-nitkkr-orange/40"
      >
        <span class="text-base">🔔</span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/site-settings" />

      <!-- Main Content Area -->
      <main class="flex-1 p-4 sm:p-8 lg:p-10 overflow-y-auto max-w-6xl">
        <div class="space-y-8">

          <!-- Header -->
          <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nitkkr-orange/10 border border-nitkkr-orange/20 text-nitkkr-orange text-[11px] font-bold mb-2">
                <span>⚙️</span> Global Configuration & Live Customizer
              </div>
              <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark">
                Website Control Center
              </h1>
              <p class="text-xs sm:text-sm text-nitkkr-gray mt-1">
                Customize hero text, Gen-Z vibe tags, company identity, live alert banners, ads, and platform branding.
              </p>
            </div>

            <button
              @click="saveAllSettings()"
              :disabled="saving"
              class="px-6 py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-2xl shadow-md shadow-nitkkr-orange/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
            >
              <span x-text="saving ? 'Saving...' : '💾 Save All Changes'"></span>
            </button>
          </div>

          <!-- Navigation Tabs -->
          <div class="flex flex-wrap gap-2 pb-2">
            <button
              @click="activeTab = 'general'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'general' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🏠</span> General & Hero
            </button>

            <button
              @click="activeTab = 'vibes'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'vibes' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🔥</span> Vibe Tags Studio (<span x-text="vibeChips.length"></span>)
            </button>

            <button
              @click="activeTab = 'company'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'company' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🏢</span> Company Profile
            </button>

            <button
              @click="activeTab = 'announcements'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'announcements' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>📢</span> Live Banners
            </button>

            <button
              @click="activeTab = 'ads'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'ads' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>⚡</span> Ads & Sponsors
            </button>

            <button
              @click="activeTab = 'ordering'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'ordering' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🛍️</span> Ordering & WhatsApp
            </button>

            <button
              @click="activeTab = 'footer'"
              class="px-4 py-2.5 rounded-2xl font-bold text-xs transition-all flex items-center gap-2 cursor-pointer"
              :class="activeTab === 'footer' ? 'bg-nitkkr-orange text-white shadow-sm' : 'bg-white border border-nitkkr-orange/20 text-nitkkr-dark hover:bg-nitkkr-orange/10'"
            >
              <span>🦶</span> Footer Branding
            </button>
          </div>

          <!-- TAB 1: GENERAL & HERO -->
          <div x-show="activeTab === 'general'" class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
            <div>
              <h3 class="font-display text-lg font-bold text-nitkkr-dark">✨ Homepage Hero & SEO Meta</h3>
              <p class="text-xs text-nitkkr-gray">Live title, subtitle, and search description shown across the platform</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Homepage Main Title (H1)</label>
                <input type="text" x-model="settings.homepage_title" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Homepage Subtitle / Tagline</label>
                <input type="text" x-model="settings.homepage_tagline" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div>
                <label class="text-xs font-bold text-nitkkr-dark block mb-1">Meta Description (SEO & WhatsApp previews)</label>
                <textarea x-model="settings.meta_description" rows="2" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden leading-relaxed"></textarea>
              </div>
            </div>
          </div>

          <!-- TAB 2: VIBE TAGS STUDIO -->
          <div x-show="activeTab === 'vibes'" class="space-y-6">
            <div class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
                <div>
                  <h3 class="font-display text-lg font-bold text-nitkkr-dark flex items-center gap-2">
                    <span>🔥</span> Gen-Z Vibe Filters & Quick Search Tags
                  </h3>
                  <p class="text-xs text-nitkkr-gray">Manage the clickable quick pills shown right below the hero search bar on the homepage</p>
                </div>
              </div>

              <!-- Add New Vibe Chip Bar -->
              <div class="bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-2xl p-4 sm:p-5 space-y-4">
                <span class="text-xs font-bold text-nitkkr-dark block">➕ Add New Quick Vibe Pill</span>
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                  <div class="sm:col-span-2">
                    <label class="text-[11px] font-bold text-nitkkr-gray block mb-1">Icon</label>
                    <input type="text" x-model="newChip.icon" placeholder="⚡" class="w-full px-3 py-2 bg-white border border-nitkkr-orange/30 rounded-xl text-xs text-center font-bold" />
                  </div>
                  <div class="sm:col-span-4">
                    <label class="text-[11px] font-bold text-nitkkr-gray block mb-1">Label Text *</label>
                    <input type="text" x-model="newChip.label" placeholder="e.g. Biryani Craving 🍛" class="w-full px-3 py-2 bg-white border border-nitkkr-orange/30 rounded-xl text-xs font-bold" />
                  </div>
                  <div class="sm:col-span-4">
                    <label class="text-[11px] font-bold text-nitkkr-gray block mb-1">Target URL (/search?...)</label>
                    <input type="text" x-model="newChip.href" placeholder="/search?q=biryani" class="w-full px-3 py-2 bg-white border border-nitkkr-orange/30 rounded-xl text-xs font-mono font-semibold" />
                  </div>
                  <div class="sm:col-span-2 flex items-end">
                    <button
                      @click="addVibeChip()"
                      class="w-full py-2 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-colors cursor-pointer"
                    >
                      Add Chip
                    </button>
                  </div>
                </div>
              </div>

              <!-- Active Chips List -->
              <div class="space-y-3">
                <span class="text-xs font-bold text-nitkkr-dark block">Active Vibe Pills on Homepage (<span x-text="vibeChips.length"></span>)</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <template x-for="(chip, idx) in vibeChips" :key="idx">
                    <div class="bg-white border rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow-2xs transition-all" :class="chip.isEnabled ? 'border-amber-200' : 'border-slate-200 opacity-60 bg-slate-50'">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class="text-lg flex-shrink-0" x-text="chip.icon"></span>
                        <div class="min-w-0">
                          <input type="text" x-model="chip.label" class="text-xs font-bold text-nitkkr-dark bg-transparent border-b border-transparent hover:border-slate-300 focus:border-nitkkr-orange focus:outline-hidden w-full" />
                          <input type="text" x-model="chip.href" class="text-[10px] text-nitkkr-gray font-mono bg-transparent border-b border-transparent hover:border-slate-300 focus:border-nitkkr-orange focus:outline-hidden w-full truncate" />
                        </div>
                      </div>

                      <div class="flex items-center gap-2 flex-shrink-0">
                        <button
                          @click="toggleVibeChip(idx)"
                          class="px-2 py-1 rounded-lg text-[10px] font-bold cursor-pointer transition-colors"
                          :class="chip.isEnabled ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-600'"
                          x-text="chip.isEnabled ? 'Active 🟢' : 'Hidden ⚪'"
                        ></button>
                        <button
                          @click="removeVibeChip(idx)"
                          class="text-red-500 hover:text-red-700 p-1 text-xs cursor-pointer font-bold"
                          title="Delete Chip"
                        >
                          ✕
                        </button>
                      </div>
                    </div>
                  </template>
                </div>
              </div>

            </div>
          </div>

          <!-- TAB 3: COMPANY PROFILE & IDENTITY -->
          <div x-show="activeTab === 'company'" class="bg-white border border-nitkkr-orange/20 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
            <div class="pb-3 border-b border-slate-100">
              <h3 class="font-display text-lg font-bold text-nitkkr-dark flex items-center gap-2">
                <span>🏢</span> Company Profile & Corporate Identity
              </h3>
              <p class="text-xs text-nitkkr-gray">Configure platform name, legal entity, founder details, campus headquarters, and social links</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label class="text-xs font-bold text-nitkkr-dark">Company / Platform Display Name</label>
                <input type="text" x-model="settings.company_name" placeholder="Orandus" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div class="space-y-1.5">
                <label class="text-xs font-bold text-nitkkr-dark">Founder & Leadership Name(s)</label>
                <input type="text" x-model="settings.founder_name" placeholder="Manish Chauhan" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div class="space-y-1.5">
                <label class="text-xs font-bold text-nitkkr-dark">Registered Entity / Legal Organization</label>
                <input type="text" x-model="settings.company_legal_entity" placeholder="Orandus Technologies" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div class="space-y-1.5">
                <label class="text-xs font-bold text-nitkkr-dark">Brand Slogan / Tagline</label>
                <input type="text" x-model="settings.company_tagline" placeholder="Instant Menu Search & Direct Vendor Connect" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div class="space-y-1.5">
                <label class="text-xs font-bold text-nitkkr-dark">Official Support Email</label>
                <input type="email" x-model="settings.company_support_email" placeholder="support@orandus.in" class="w-full px-4 py-2.5 bg-nitkkr-cream/40 border border-nitkkr-orange/30 rounded-xl text-xs font-semibold text-nitkkr-dark focus:outline-hidden" />
              </div>

              <div class="space-y-1.5">
