---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
---

<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('siteSettingsAdmin', () => ({
      sidebarOpen: false,
      activeTab: 'general',
      saving: false,
      toastMsg: '',

      vibeChips: [
        { label: 'High Protein 🏋️‍♂️', icon: '⚡', href: '/search?tag=protein', isEnabled: true },
        { label: 'Late Night 2AM 🌙', icon: '🌙', href: '/search?tag=late-night', isEnabled: true },
        { label: 'Under ₹50 💸', icon: '💰', href: '/search?maxPrice=50', isEnabled: true },
        { label: 'Spicy Momos 🔥', icon: '🥢', href: '/search?q=momos', isEnabled: true },
        { label: 'Cheesy & Loaded 🧀', icon: '🧀', href: '/search?q=cheese', isEnabled: true },
        { label: 'Thick Shakes 🧋', icon: '🧋', href: '/search?category=beverages', isEnabled: true },
        { label: 'Pure Veg 🌱', icon: '🌱', href: '/search?isVeg=true', isEnabled: true },
        { label: 'Non-Veg 🍗', icon: '🍗', href: '/search?isVeg=false', isEnabled: true },
      ],

      newChip: {
        label: '',
        icon: '⚡',
        href: '/search?q='
      },

      announcementSlides: [
        {
          id: 'parantha-challenge-1100',
          badge: '🏆 20-MINUTE CAMPUS CHALLENGE',
          vendorName: 'Yummy Tummy Foods & Guest House',
          title: "Eat India's Biggest Parantha & Win ₹1,100 Cash!",
          description: "Finish 1 giant parantha in under 20 minutes and win a ₹1,100 cash prize! Visit near NIT Gate 2.",
          ctaText: 'Take the Challenge →',
          ctaLink: '/v/yummy-tummy-foods',
          gradient: 'from-amber-800 via-bistro-700 to-orange-800',
          icon: '🫓',
          isEnabled: true
        }
      ],

      newSlide: {
        badge: '🔥 CAMPUS OFFER',
        vendorName: 'Food Cave Fast Food',
        title: '',
        description: '',
        ctaText: 'Explore Menu →',
        ctaLink: '/search',
        gradient: 'from-orange-600 via-amber-600 to-rose-600',
        icon: '🍕'
      },

      settings: {
        homepage_title: 'Stop Asking “Bhai, Menu Bhej.”',
        homepage_tagline: 'Find campus food, menus and prices in seconds.',
        meta_description: 'Find campus food, menus and prices in seconds.',
        cloudflare_analytics_token: '769ece91027a424eae4907f4cd2e6d79',
        announcement_banner_enabled: 'false',
        announcement_banner_text: '',
        announcement_banner_type: 'info',
        announcement_carousel_enabled: 'true',
        announcement_carousel_json: '',
        ad_banner_enabled: 'false',
        ad_banner_badge: '⚡ SPONSORED DEAL',
        ad_banner_title: 'Kurukshetra Protein & Shake Hub',
        ad_banner_description: '15% Flat Student Discount on all Whey Shakes & Healthy Bowls! Show NIT ID.',
        ad_banner_image: '',
        ad_banner_cta: 'Claim Offer 💬',
        ad_banner_link: '',
        ordering_enabled: 'true',
        whatsapp_ordering_enabled: 'false',
        show_whatsapp_button: 'false',
        whatsapp_button_label: 'Order on WhatsApp',
        whatsapp_msg_template: 'Hi {vendor_name}! I would like to check availability from Orandus.',
        how_it_works_step3_title: '3. Call or Visit Counter',
        how_it_works_step3_desc: 'Call the vendor directly to check availability or walk up to their campus counter with exact dishes and prices ready. Zero commissions, zero markups!',
        maintenance_message: 'Ordering is temporarily paused for campus break. Vendors reopen tomorrow at 8 AM.',
        footer_tagline: 'Discover campus food spots, menus, prices and locations in one place.',
        footer_custom_note: 'Fast menus • Local food • Simple discovery',
        footer_copyright: 'Find Food. See the Menu.',
        
        // 🏢 Company Profile Settings
        company_name: 'Orandus',
        founder_name: '',
        company_legal_entity: 'Orandus Technologies',
        company_tagline: 'Find Food. See the Menu.',
        company_support_email: 'm.chauhan@zohomail.in',
        company_support_phone: '+91 89010 26416',
        company_address: 'Kurukshetra, Haryana 136119',
        company_instagram: 'https://instagram.com/orandus.in',
        company_linkedin: '',
        company_twitter: '',
        company_logo_url: '',
        company_favicon_url: '',
        company_mission: 'Discover campus food spots, menus, prices and locations in one place.'
      },

      async init() {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab');
        if (tab && ['general', 'vibes', 'company', 'announcements', 'ads', 'ordering', 'footer'].includes(tab)) {
          this.activeTab = tab;
        }
        await this.loadAll();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 4000);
      },

      async loadAll() {
        try {
          const res = await fetch('/api/admin/settings');
          if (res.ok) {
            const d = await res.json();
            this.settings = Object.assign({}, this.settings, d.settings || {});
            
            if (this.settings.vibe_chips_json) {
              try {
                const parsed = JSON.parse(this.settings.vibe_chips_json);
                if (Array.isArray(parsed) && parsed.length > 0) {
                  this.vibeChips = parsed;
                }
              } catch (e) {}
            }

            if (this.settings.announcement_carousel_json) {
              try {
                const parsedSlides = JSON.parse(this.settings.announcement_carousel_json);
                if (Array.isArray(parsedSlides) && parsedSlides.length > 0) {
                  this.announcementSlides = parsedSlides;
                }
              } catch (e) {}
            }
          }
        } catch (e) {
          console.error('Load settings error', e);
        }
      },

      addVibeChip() {
        if (!this.newChip.label.trim()) {
          alert('Chip label is required');
          return;
        }
        this.vibeChips.push({
          label: this.newChip.label.trim(),
          icon: this.newChip.icon || '⚡',
          href: this.newChip.href.trim() || '/search?q=' + encodeURIComponent(this.newChip.label.trim()),
          isEnabled: true
        });
        this.newChip = { label: '', icon: '⚡', href: '/search?q=' };
        this.showToast('Chip added! Click "Save All Changes" to publish.');
      },

      removeVibeChip(index) {
        this.vibeChips.splice(index, 1);
      },

      toggleVibeChip(index) {
        this.vibeChips[index].isEnabled = !this.vibeChips[index].isEnabled;
      },

      addSlide() {
        if (!this.newSlide.title.trim()) {
          alert('Offer / Announcement title is required');
          return;
        }
        this.announcementSlides.push({
          id: 'deal-' + Date.now(),
          badge: this.newSlide.badge.trim() || '🔥 CAMPUS DEAL',
          vendorName: this.newSlide.vendorName.trim() || 'Campus Food Spot',
          title: this.newSlide.title.trim(),
          description: this.newSlide.description.trim() || 'Special campus discount for NITKKR students.',
          ctaText: this.newSlide.ctaText.trim() || 'View Deal →',
          ctaLink: this.newSlide.ctaLink.trim() || '/search',
          gradient: this.newSlide.gradient || 'from-bistro-800 via-bistro-700 to-amber-700',
          icon: this.newSlide.icon || '🔥',
          isEnabled: true
        });
        this.newSlide = {
          badge: '🔥 CAMPUS OFFER',
          vendorName: 'Food Cave Fast Food',
          title: '',
          description: '',
          ctaText: 'Explore Menu →',
          ctaLink: '/search',
          gradient: 'from-bistro-800 via-bistro-700 to-amber-700',
          icon: '🍕'
        };
        this.showToast('Slide added! Click "Save All Changes" to publish live.');
      },

      removeSlide(index) {
        this.announcementSlides.splice(index, 1);
      },

      toggleSlide(index) {
        this.announcementSlides[index].isEnabled = !this.announcementSlides[index].isEnabled;
      },

      async saveAllSettings() {
        this.saving = true;
        try {
          this.settings.vibe_chips_json = JSON.stringify(this.vibeChips);
          this.settings.announcement_carousel_json = JSON.stringify(this.announcementSlides);

          const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: this.settings })
          });
          if (res.ok) {
            this.showToast('🎉 All website settings & deals carousel saved live!');
          } else {
            const errData = await res.json().catch(() => ({}));
            this.showToast('❌ ' + (errData.error || 'Failed to save settings'));
          }
        } catch (err) {
          this.showToast('❌ Network error saving settings');
        } finally {
          this.saving = false;
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      }
    }));
  });
</script>

<Layout title="Site Configuration & Controls - Orandus Ops" description="Control live hero text, Gen-Z vibe tags, company profile, ads, sponsors, and footer branding">
  <section class="min-h-screen bg-[#090D15] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    
    <div
      x-data="siteSettingsAdmin"
      class="flex-1 flex flex-col lg:flex-row min-h-screen"
    >
      <!-- Toast Notification -->
      <div
        x-show="toastMsg"
        x-transition
        class="fixed bottom-6 right-6 z-50 bg-[#161F30] border border-amber-500/40 text-amber-300 px-4 py-2.5 rounded-xl shadow-2xl font-medium text-xs flex items-center gap-2.5 backdrop-blur-md"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span x-text="toastMsg"></span>
      </div>

      <!-- Shared Sidebar Component -->
      <AdminSidebar currentPath="/admin/site-settings" />

      <!-- Main Content Area -->
      <main class="flex-1 p-3.5 sm:p-6 lg:p-7 overflow-y-auto space-y-5 max-w-6xl w-full">
        
        <!-- Header -->
        <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold mb-2">
              <span>⚙️</span> Global Configuration & Live Customizer
            </div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
              Website Control Center
            </h1>
            <p class="text-xs text-slate-400 mt-1">
              Customize homepage hero text, Gen-Z vibe tags, company identity, live alert banners, ads, and platform branding.
            </p>
          </div>

          <button
            @click="saveAllSettings()"
            :disabled="saving"
            class="px-5 py-2.5 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs rounded-xl shadow-sm shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer self-start sm:self-auto"
          >
            <span x-text="saving ? 'Saving...' : '💾 Save All Changes'"></span>
          </button>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex flex-wrap gap-1.5 p-1 bg-[#101726] border border-slate-800/80 rounded-2xl">
          <button
            @click="activeTab = 'general'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'general' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>🏠</span> General & Hero
          </button>

          <button
            @click="activeTab = 'vibes'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'vibes' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>🔥</span> Vibe Tags (<span x-text="vibeChips.length"></span>)
          </button>

          <button
            @click="activeTab = 'company'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'company' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>🏢</span> Company Profile
          </button>

          <button
            @click="activeTab = 'announcements'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'announcements' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>📢</span> Live Banners
          </button>

          <button
            @click="activeTab = 'ads'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'ads' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>⚡</span> Ads & Sponsors
          </button>

          <button
            @click="activeTab = 'ordering'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'ordering' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>🛍️</span> Ordering & WhatsApp
          </button>

          <button
            @click="activeTab = 'footer'"
            class="px-3.5 py-2 rounded-xl font-semibold text-xs transition-all flex items-center gap-2 cursor-pointer"
            :class="activeTab === 'footer' ? 'bg-slate-800 text-amber-300 shadow-xs ring-1 ring-amber-500/20' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'"
          >
            <span>🦶</span> Footer Branding
          </button>
        </div>

        <!-- TAB 1: GENERAL & HERO -->
        <div x-show="activeTab === 'general'" class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-5 shadow-sm">
          <div>
            <h3 class="font-display text-base font-bold text-white">✨ Homepage Hero & SEO Meta</h3>
            <p class="text-xs text-slate-400 mt-0.5">Live title, subtitle, and search description shown across the campus food discovery platform</p>
          </div>

          <div class="space-y-4">
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Homepage Main Title (H1)</label>
              <input type="text" x-model="settings.homepage_title" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Homepage Subtitle / Tagline</label>
              <input type="text" x-model="settings.homepage_tagline" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Meta Description (SEO & Social Sharing)</label>
              <textarea x-model="settings.meta_description" rows="2" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50 leading-relaxed"></textarea>
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">📊 Cloudflare Web Analytics Token</label>
              <input type="text" x-model="settings.cloudflare_analytics_token" placeholder="e.g. 769ece91027a424eae4907f4cd2e6d79" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-mono text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
              <p class="text-[11px] text-slate-500 mt-1">Free privacy-friendly telemetry from Cloudflare Web Analytics.</p>
            </div>
          </div>
        </div>

        <!-- TAB 2: VIBE TAGS STUDIO -->
        <div x-show="activeTab === 'vibes'" class="space-y-4">
          <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-5 shadow-sm">
            <div class="pb-3 border-b border-slate-800">
              <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
                <span>🔥</span> Campus Vibe Filters & Quick Tags
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Manage the clickable quick pills shown right below the hero search bar on the homepage</p>
            </div>

            <!-- Add New Vibe Chip Bar -->
            <div class="bg-[#0A0F1A] border border-slate-800 rounded-xl p-4 space-y-3">
              <span class="text-xs font-bold text-slate-200 block">➕ Add New Quick Vibe Pill</span>
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
                <div class="sm:col-span-2">
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Icon</label>
                  <input type="text" x-model="newChip.icon" placeholder="⚡" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs text-center font-bold text-slate-100" />
                </div>
                <div class="sm:col-span-4">
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Label Text *</label>
                  <input type="text" x-model="newChip.label" placeholder="e.g. Biryani Craving 🍛" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-100" />
                </div>
                <div class="sm:col-span-4">
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Target URL (/search?...)</label>
                  <input type="text" x-model="newChip.href" placeholder="/search?q=biryani" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-mono text-slate-300" />
                </div>
                <div class="sm:col-span-2 flex items-end">
                  <button
                    @click="addVibeChip()"
                    class="w-full py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl transition-all cursor-pointer"
                  >
                    Add Chip
                  </button>
                </div>
              </div>
            </div>

            <!-- Active Chips List -->
            <div class="space-y-3">
              <span class="text-xs font-bold text-slate-300 block">Active Vibe Pills on Homepage (<span x-text="vibeChips.length"></span>)</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <template x-for="(chip, idx) in vibeChips" :key="idx">
                  <div class="bg-[#0A0F1A] border rounded-xl p-3 flex items-center justify-between gap-3 shadow-2xs transition-all" :class="chip.isEnabled ? 'border-slate-800' : 'border-slate-800/40 opacity-50'">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                      <span class="text-lg flex-shrink-0" x-text="chip.icon"></span>
                      <div class="min-w-0 flex-1">
                        <input type="text" x-model="chip.label" class="text-xs font-bold text-slate-200 bg-transparent border-b border-transparent hover:border-slate-700 focus:border-amber-500 focus:outline-hidden w-full" />
                        <input type="text" x-model="chip.href" class="text-[10px] text-slate-400 font-mono bg-transparent border-b border-transparent hover:border-slate-700 focus:border-amber-500 focus:outline-hidden w-full truncate" />
                      </div>
                    </div>

                    <div class="flex items-center gap-2 flex-shrink-0">
                      <button
                        @click="toggleVibeChip(idx)"
                        class="px-2 py-0.5 rounded-md text-[10px] font-bold cursor-pointer transition-colors border"
                        :class="chip.isEnabled ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20' : 'bg-slate-800 text-slate-400 border-slate-700'"
                        x-text="chip.isEnabled ? 'Active 🟢' : 'Hidden ⚪'"
                      ></button>
                      <button
                        @click="removeVibeChip(idx)"
                        class="text-rose-400 hover:text-rose-300 p-1 text-xs cursor-pointer font-bold"
                        title="Delete Chip"
                      >✕</button>
                    </div>
                  </div>
                </template>
              </div>
            </div>

          </div>
        </div>

        <!-- TAB 3: COMPANY PROFILE & IDENTITY -->
        <div x-show="activeTab === 'company'" class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-5 shadow-sm">
          <div class="pb-3 border-b border-slate-800">
            <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
              <span>🏢</span> Company Profile & Corporate Identity
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">Configure platform name, legal entity, founder details, campus headquarters, and social links</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Company / Platform Display Name</label>
              <input type="text" x-model="settings.company_name" placeholder="Orandus" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Founder & Leadership Name(s)</label>
              <input type="text" x-model="settings.founder_name" placeholder="Manish Chauhan" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Registered Entity / Legal Organization</label>
              <input type="text" x-model="settings.company_legal_entity" placeholder="Orandus Technologies" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Brand Slogan / Tagline</label>
              <input type="text" x-model="settings.company_tagline" placeholder="Instant Menu Search & Direct Vendor Connect" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Official Support Email</label>
              <input type="email" x-model="settings.company_support_email" placeholder="m.chauhan@zohomail.in" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Official WhatsApp Helpline / Phone</label>
              <input type="text" x-model="settings.company_support_phone" placeholder="+91 89010 26416" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1 md:col-span-2">
              <label class="text-xs font-semibold text-slate-300">Operating Address</label>
              <input type="text" x-model="settings.company_address" placeholder="Kurukshetra, Haryana 136119" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Instagram Profile URL</label>
              <input type="text" x-model="settings.company_instagram" placeholder="https://instagram.com/orandus.in" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">LinkedIn Organization URL</label>
              <input type="text" x-model="settings.company_linkedin" placeholder="https://linkedin.com/company/orandus" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div class="space-y-1 md:col-span-2">
              <label class="text-xs font-semibold text-slate-300">Company Mission & About Summary</label>
              <textarea x-model="settings.company_mission" rows="3" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50 leading-relaxed"></textarea>
            </div>
          </div>
        </div>

        <!-- TAB 4: LIVE BANNERS & ANNOUNCEMENTS -->
        <div x-show="activeTab === 'announcements'" class="space-y-4">
          <!-- 1. Top Alert Banner -->
          <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div>
                <h3 class="font-display text-base font-bold text-white">📢 Campus Live Alert Bar</h3>
                <p class="text-xs text-slate-400 mt-0.5">Show an urgent campus broadcast notice at the top of the homepage</p>
              </div>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="settings.announcement_banner_enabled" :checked="settings.announcement_banner_enabled === 'true'" @change="settings.announcement_banner_enabled = $el.checked ? 'true' : 'false'" class="rounded text-amber-500 bg-[#0A0F1A] border-slate-700" />
                <span class="text-xs font-semibold text-slate-300">Show Banner</span>
              </label>
            </div>

            <div class="space-y-3.5">
              <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Banner Text</label>
                <input type="text" x-model="settings.announcement_banner_text" placeholder="e.g. Late Night Canteens open till 3:00 AM during mid-sem exams!" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
              </div>

              <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Banner Color Tone</label>
                <select x-model="settings.announcement_banner_type" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50">
                  <option value="info">🔵 Info / Announcement (Blue)</option>
                  <option value="offer">🎉 Offer / Discount (Orange/Amber)</option>
                  <option value="warning">⚠️ Notice / Weather Alert (Yellow)</option>
                  <option value="danger">🚨 Urgent / Vendor Closed (Red)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- 2. Dynamic Deals & Announcements Carousel Studio -->
          <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div>
                <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
                  <span>🎁</span> Campus Offers & Deals Carousel
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">Create, edit, and toggle dynamic announcement cards shown on the homepage</p>
              </div>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" x-model="settings.announcement_carousel_enabled" :checked="settings.announcement_carousel_enabled !== 'false'" @change="settings.announcement_carousel_enabled = $el.checked ? 'true' : 'false'" class="rounded text-amber-500 bg-[#0A0F1A] border-slate-700" />
                <span class="text-xs font-semibold text-slate-300">Show Carousel</span>
              </label>
            </div>

            <!-- Add New Slide -->
            <div class="bg-[#0A0F1A] border border-slate-800 rounded-xl p-4 space-y-3">
              <span class="text-xs font-bold text-slate-200 block">➕ Create New Announcement Slide</span>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                <div>
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Badge Tag</label>
                  <input type="text" x-model="newSlide.badge" placeholder="🔥 TODAY'S DEAL" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-100" />
                </div>
                <div>
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Food Vendor / Source</label>
                  <input type="text" x-model="newSlide.vendorName" placeholder="Food Cave" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-100" />
                </div>
                <div class="sm:col-span-2">
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Headline Offer *</label>
                  <input type="text" x-model="newSlide.title" placeholder="Free Hostel Delivery on ₹149+" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-100" />
                </div>
                <div class="sm:col-span-2">
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Details / Terms</label>
                  <input type="text" x-model="newSlide.description" placeholder="Direct delivery to all campus hostels till 2:00 AM" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-300" />
                </div>
                <div>
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Button CTA Text</label>
                  <input type="text" x-model="newSlide.ctaText" placeholder="Order Now →" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-medium text-slate-100" />
                </div>
                <div>
                  <label class="text-[11px] font-medium text-slate-400 block mb-1">Target Link (/v/... or /search)</label>
                  <input type="text" x-model="newSlide.ctaLink" placeholder="/v/food-cave" class="w-full px-3 py-2 bg-[#101726] border border-slate-800 rounded-xl text-xs font-mono text-slate-300" />
                </div>
                <div class="sm:col-span-2 lg:col-span-4 flex justify-end">
                  <button
                    @click="addSlide()"
                    class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl transition-all cursor-pointer"
                  >
                    Add Slide ➕
                  </button>
                </div>
              </div>
            </div>

            <!-- Active Slides List -->
            <div class="space-y-2.5">
              <span class="text-xs font-bold text-slate-300 block">Active Carousel Slides (<span x-text="announcementSlides.length"></span>)</span>
              <template x-for="(slide, sIdx) in announcementSlides" :key="sIdx">
                <div class="bg-[#0A0F1A] border rounded-xl p-3.5 space-y-3" :class="slide.isEnabled ? 'border-slate-800' : 'border-slate-800/40 opacity-50'">
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                      <span class="text-base" x-text="slide.icon || '🔥'"></span>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-amber-300 border border-slate-700" x-text="slide.badge"></span>
                      <span class="text-xs font-medium text-slate-400" x-text="slide.vendorName"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <button
                        @click="toggleSlide(sIdx)"
                        class="px-2 py-0.5 rounded-md text-[10px] font-bold cursor-pointer transition-colors border"
                        :class="slide.isEnabled ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20' : 'bg-slate-800 text-slate-400 border-slate-700'"
                        x-text="slide.isEnabled ? 'Active 🟢' : 'Hidden ⚪'"
                      ></button>
                      <button
                        @click="removeSlide(sIdx)"
                        class="text-rose-400 hover:text-rose-300 px-2 py-0.5 text-xs cursor-pointer font-semibold"
                        title="Delete Slide"
                      >✕ Delete</button>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                    <div>
                      <label class="text-[10px] text-slate-400 block">Headline</label>
                      <input type="text" x-model="slide.title" class="w-full font-semibold text-slate-200 border-b border-slate-800 py-1 bg-transparent focus:border-amber-500 focus:outline-hidden" />
                    </div>
                    <div>
                      <label class="text-[10px] text-slate-400 block">Details</label>
                      <input type="text" x-model="slide.description" class="w-full text-slate-400 border-b border-slate-800 py-1 bg-transparent focus:border-amber-500 focus:outline-hidden" />
                    </div>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- TAB 5: ADS & SPONSORS -->
        <div x-show="activeTab === 'ads'" class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <h3 class="font-display text-base font-bold text-white">⚡ In-Feed Sponsor Placement</h3>
              <p class="text-xs text-slate-400 mt-0.5">Display promotional sponsor cards between food vendors on the homepage</p>
            </div>

            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" x-model="settings.ad_banner_enabled" :checked="settings.ad_banner_enabled === 'true'" @change="settings.ad_banner_enabled = $el.checked ? 'true' : 'false'" class="rounded text-amber-500 bg-[#0A0F1A] border-slate-700" />
              <span class="text-xs font-semibold text-slate-300">Active Sponsor</span>
            </label>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Badge Tag</label>
              <input type="text" x-model="settings.ad_banner_badge" placeholder="⚡ SPONSORED DEAL" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Sponsor / Brand Title</label>
              <input type="text" x-model="settings.ad_banner_title" placeholder="Kurukshetra Protein Hub" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
            <div class="sm:col-span-2">
              <label class="text-xs font-semibold text-slate-300 block mb-1">Offer Description</label>
              <input type="text" x-model="settings.ad_banner_description" placeholder="15% Flat Student Discount on Whey Shakes & Bowls" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Button CTA Text</label>
              <input type="text" x-model="settings.ad_banner_cta" placeholder="Claim Offer 💬" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Target Link / WhatsApp</label>
              <input type="text" x-model="settings.ad_banner_link" placeholder="https://wa.me/918901026416" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
          </div>
        </div>

        <!-- TAB 6: ORDERING & WHATSAPP CONTROLS -->
        <div x-show="activeTab === 'ordering'" class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-5 shadow-sm">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
                <span>💬</span> WhatsApp & Campus Ordering Controls
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">Choose between WhatsApp 1-tap ordering or Direct Call & Visit Directory mode</p>
            </div>
            <div class="px-2.5 py-1 rounded-full text-xs font-semibold" :class="settings.whatsapp_ordering_enabled === 'true' && settings.show_whatsapp_button !== 'false' ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-300 border border-amber-500/20'">
              <span x-text="settings.whatsapp_ordering_enabled === 'true' && settings.show_whatsapp_button !== 'false' ? '🟢 WhatsApp Active' : '📞 Call & Menu Mode'"></span>
            </div>
          </div>

          <!-- Mode Selector Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div
              @click="settings.whatsapp_ordering_enabled = 'false'; settings.show_whatsapp_button = 'false'; settings.how_it_works_step3_title = '3. Call or Visit Counter'; settings.how_it_works_step3_desc = 'Call the vendor directly to check availability or walk up to their campus counter with exact dishes and prices ready. Zero commissions, zero markups!';"
              class="p-4 rounded-xl border-2 transition-all cursor-pointer space-y-2 flex flex-col justify-between"
              :class="settings.whatsapp_ordering_enabled !== 'true' || settings.show_whatsapp_button === 'false' ? 'border-amber-500/60 bg-amber-500/5' : 'border-slate-800 bg-[#0A0F1A] hover:border-slate-700'"
            >
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm text-white flex items-center gap-1.5">
                    <span>📞</span> Call & Menu Directory (Default)
                  </span>
                  <span x-show="settings.whatsapp_ordering_enabled !== 'true' || settings.show_whatsapp_button === 'false'" class="text-amber-400 font-bold text-xs">✓ Active</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                  Students browse menus, compare prices, and call or visit stalls directly without middleman markups.
                </p>
              </div>
              <div class="pt-2 text-[11px] font-medium text-slate-400 flex items-center gap-2">
                <span>• Hides WhatsApp button</span>
                <span>• Shows Call button</span>
              </div>
            </div>

            <div
              @click="settings.whatsapp_ordering_enabled = 'true'; settings.show_whatsapp_button = 'true'; settings.how_it_works_step3_title = '3. 1-Tap WhatsApp Order'; settings.how_it_works_step3_desc = 'Tap \'Order on WhatsApp\' to send a pre-filled greeting directly to the vendor owner. Zero commissions, zero middleman markups!';"
              class="p-4 rounded-xl border-2 transition-all cursor-pointer space-y-2 flex flex-col justify-between"
              :class="settings.whatsapp_ordering_enabled === 'true' && settings.show_whatsapp_button !== 'false' ? 'border-emerald-500/60 bg-emerald-500/5' : 'border-slate-800 bg-[#0A0F1A] hover:border-slate-700'"
            >
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm text-white flex items-center gap-1.5">
                    <span>💬</span> WhatsApp 1-Tap Ordering
                  </span>
                  <span x-show="settings.whatsapp_ordering_enabled === 'true' && settings.show_whatsapp_button !== 'false'" class="text-emerald-400 font-bold text-xs">✓ Active</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                  Displays green "Order on WhatsApp" button on vendor pages with pre-filled greeting text.
                </p>
              </div>
              <div class="pt-2 text-[11px] font-medium text-emerald-400 flex items-center gap-2">
                <span>• Shows WhatsApp button</span>
                <span>• Pre-filled chat template</span>
              </div>
            </div>
          </div>

          <!-- WhatsApp Template & CTA Labels -->
          <div class="space-y-3 pt-2 border-t border-slate-800">
            <h4 class="font-semibold text-xs text-slate-300 uppercase tracking-wider">Button CTA & Message Formatting</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">WhatsApp Button Text</label>
                <input type="text" x-model="settings.whatsapp_button_label" placeholder="Order on WhatsApp" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
              </div>
              <div>
                <label class="text-xs font-semibold text-slate-300 block mb-1">Pre-filled WhatsApp Message</label>
                <input type="text" x-model="settings.whatsapp_msg_template" placeholder="Hi {vendor_name}! I would like to check availability from Orandus." class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 7: FOOTER BRANDING -->
        <div x-show="activeTab === 'footer'" class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
          <div class="pb-3 border-b border-slate-800">
            <h3 class="font-display text-base font-bold text-white">🦶 Footer Branding Controls</h3>
            <p class="text-xs text-slate-400 mt-0.5">Controls text displayed at the bottom of public pages</p>
          </div>

          <div class="space-y-3.5">
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Footer Tagline</label>
              <input type="text" x-model="settings.footer_tagline" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Footer Highlight Note</label>
              <input type="text" x-model="settings.footer_custom_note" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>

            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-1">Copyright Line</label>
              <input type="text" x-model="settings.footer_copyright" class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50" />
            </div>
          </div>
        </div>

      </main>

    </div>
  </section>
</Layout>