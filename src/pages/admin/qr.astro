---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import { getActiveVendors, getQrAnalyticsData, getCategories, getAllMenuItemsForSearch, getAllReviews } from '../../lib/queries';

const initialVendors = await getActiveVendors();
const initialQrStats = await getQrAnalyticsData();
const initialCategories = await getCategories();
const initialMenuItems = await getAllMenuItemsForSearch();
const initialReviews = await getAllReviews();
---

<script is:inline define:vars={{ initialVendors, initialQrStats, initialCategories, initialMenuItems, initialReviews }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('qrStudio', () => ({
      sidebarOpen: false,
      vendors: Array.isArray(initialVendors) ? initialVendors : [],
      categories: Array.isArray(initialCategories) ? initialCategories : [],
      menuItems: Array.isArray(initialMenuItems) ? initialMenuItems : [],
      reviews: Array.isArray(initialReviews) ? initialReviews : [],
      stats: initialQrStats || { totalScans: 0, totalCalls: 0, totalWhatsApp: 0, totalInstalls: 0, campaigns: [], recentEvents: [] },
      
      // Campaign Configurator State
      destinationType: 'vendor', // 'vendor' | 'home' | 'late-night' | 'custom'
      selectedVendorSlug: initialVendors?.[0]?.slug || 'food-cave',
      customUrl: 'https://orandus.in',
      placement: 'counter_sticker', // 'counter_sticker' | 'table_tent' | 'hostel_poster' | 'gate_standee' | 'parcel_slip'
      customCampaignTag: '',
      
      // Card Styler State
      colorTheme: '#FF5200', // '#FF5200' | '#0F172A' | '#059669' | '#DC2626'
      cardTitle: 'Scan for Live Menu & Prices',
      cardSubtext: 'Direct Stall Call • Zero Commission',
      showLogoCenter: true,
      
      // UI State
      copied: false,
      loadingStats: false,
      toastMsg: '',

      init() {
        this.updateDefaultCampaignTag();
      },

      showToast(msg) {
        this.toastMsg = msg;
        setTimeout(() => { this.toastMsg = ''; }, 3500);
      },

      updateDefaultCampaignTag() {
        if (this.destinationType === 'vendor') {
          this.customCampaignTag = `${this.selectedVendorSlug}_${this.placement}`;
        } else if (this.destinationType === 'late-night') {
          this.customCampaignTag = `late_night_${this.placement}`;
        } else if (this.destinationType === 'home') {
          this.customCampaignTag = `campus_${this.placement}`;
        } else {
          this.customCampaignTag = `custom_${this.placement}`;
        }
      },

      get selectedVendorName() {
        const v = this.vendors.find(item => item.slug === this.selectedVendorSlug);
        return v ? v.name : 'Campus Food Spot';
      },

      get generatedTargetUrl() {
        let base = 'https://orandus.in';
        if (this.destinationType === 'vendor') {
          base = `https://orandus.in/v/${this.selectedVendorSlug}`;
        } else if (this.destinationType === 'late-night') {
          base = 'https://orandus.in/search?tag=late-night';
        } else if (this.destinationType === 'custom') {
          base = this.customUrl || 'https://orandus.in';
        }

        const tag = (this.customCampaignTag || 'qr_direct').toLowerCase().replace(/[^a-z0-9_-]+/g, '_');
        const sep = base.includes('?') ? '&' : '?';
        return `${base}${sep}utm_source=qr&utm_medium=${encodeURIComponent(this.placement)}&utm_campaign=${encodeURIComponent(tag)}`;
      },

      get qrImageSrc() {
        const encoded = encodeURIComponent(this.generatedTargetUrl);
        const darkColor = encodeURIComponent(this.colorTheme);
        return `/api/qr-generate?url=${encoded}&dark=${darkColor}&size=512&format=svg`;
      },

      get qrDownloadPngSrc() {
        const encoded = encodeURIComponent(this.generatedTargetUrl);
        const darkColor = encodeURIComponent(this.colorTheme);
        return `/api/qr-generate?url=${encoded}&dark=${darkColor}&size=1024&format=png`;
      },

      copyUrl() {
        navigator.clipboard.writeText(this.generatedTargetUrl);
        this.copied = true;
        this.showToast('📋 Tracking link copied to clipboard!');
        setTimeout(() => { this.copied = false; }, 3000);
      },

      printFlyer() {
        window.print();
      },

      async refreshStats() {
        this.loadingStats = true;
        try {
          const res = await fetch('/api/admin/qr');
          if (res.ok) {
            const data = await res.json();
            this.stats = data;
            this.showToast('🔄 Live QR telemetry updated');
          }
        } catch (e) {
          console.error('Refresh stats error:', e);
        } finally {
          this.loadingStats = false;
        }
      },

      async logout() {
        if (!confirm('Log out from Founder Panel?')) return;
        await fetch('/api/admin/auth', { method: 'DELETE' });
        window.location.href = '/admin/login';
      }
    }));
  });
</script>

<style>
  @media print {
    body * {
      visibility: hidden;
    }
    #printable-qr-card, #printable-qr-card * {
      visibility: visible;
    }
    #printable-qr-card {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      max-width: 480px;
      box-shadow: none !important;
      border: 1px solid #ddd !important;
    }
  }
</style>

<Layout title="QR Studio & Telemetry - Orandus Ops" description="Design, generate and track dynamic campus QR campaigns for stalls, tables and hostel notice boards">
  <section x-data="qrStudio" class="min-h-screen bg-[#090D15] flex flex-col lg:flex-row text-slate-200 antialiased font-sans">
    
    <!-- Toast Notification -->
    <div
      x-show="toastMsg"
      x-transition
      class="fixed bottom-6 right-6 z-50 bg-[#161F30] border border-amber-500/40 text-amber-300 px-4 py-2.5 rounded-xl shadow-2xl font-medium text-xs flex items-center gap-2.5 backdrop-blur-md"
    >
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span x-text="toastMsg"></span>
    </div>

    <!-- Admin Sidebar -->
    <AdminSidebar currentPath="/admin/qr" />

    <!-- 🚀 Main QR Studio Workspace -->
    <main class="flex-1 p-3.5 sm:p-6 lg:p-7 overflow-y-auto space-y-5 max-w-7xl w-full">
      
      <!-- Top Studio Hero Banner -->
      <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-4 sm:p-5 shadow-sm relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1.5 z-10">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-semibold">
            <span>📱</span> Physical-to-Digital Campus Engine
          </div>
          <h1 class="font-display text-xl sm:text-2xl font-bold text-white tracking-tight">
            Dynamic QR Studio & Telemetry
          </h1>
          <p class="text-xs text-slate-400 max-w-xl">
            Generate print-ready table tents, counter stickers, and hostel flyers with built-in telemetry to prove real order volume to campus food spots.
          </p>
        </div>

        <div class="flex items-center gap-2.5 z-10">
          <button
            @click="refreshStats()"
            :disabled="loadingStats"
            class="px-3 py-2 bg-[#0A0F1A] border border-slate-800 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-xs rounded-xl shadow-2xs transition-all flex items-center gap-2 cursor-pointer"
          >
            <span :class="loadingStats ? 'animate-spin' : ''">🔄</span> Refresh
          </button>
          <button
            @click="printFlyer()"
            class="px-4 py-2 bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs rounded-xl shadow-sm shadow-amber-500/20 transition-all flex items-center gap-2 cursor-pointer"
          >
            <span>🖨️</span> Print Standee
          </button>
        </div>
      </div>

      <!-- 📊 Real-Time QR Telemetry Metrics Bar -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Metric 1: Total Scans -->
        <div class="bg-[#101726] rounded-xl border border-slate-800/80 p-3.5 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-400">Physical Scans</span>
            <span class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 flex items-center justify-center text-xs">📱</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl font-bold text-white" x-text="stats.totalScans"></span>
            <span class="text-[10px] font-semibold text-emerald-400">Total verified</span>
          </div>
          <p class="text-[10px] text-slate-400">From posters & counter stickers</p>
        </div>

        <!-- Metric 2: Stall Calls Driven -->
        <div class="bg-[#101726] rounded-xl border border-slate-800/80 p-3.5 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-400">Stall Calls</span>
            <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">📞</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl font-bold text-emerald-400" x-text="stats.totalCalls"></span>
            <span class="text-[10px] font-semibold text-emerald-400" x-text="stats.totalScans > 0 ? ((stats.totalCalls / stats.totalScans) * 100).toFixed(1) + '% conv' : '0%'"></span>
          </div>
          <p class="text-[10px] text-slate-400">Direct stall orders via QR</p>
        </div>

        <!-- Metric 3: WhatsApp Chats -->
        <div class="bg-[#101726] rounded-xl border border-slate-800/80 p-3.5 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-400">WhatsApp Chats</span>
            <span class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">💬</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl font-bold text-emerald-300" x-text="stats.totalWhatsApp"></span>
            <span class="text-[10px] font-semibold text-slate-400">Leads</span>
          </div>
          <p class="text-[10px] text-slate-400">Menu inquiries sent</p>
        </div>

        <!-- Metric 4: PWA Saves -->
        <div class="bg-[#101726] rounded-xl border border-slate-800/80 p-3.5 space-y-2 shadow-xs">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-400">PWA Saves</span>
            <span class="w-7 h-7 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 flex items-center justify-center text-xs">📲</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-2xl font-bold text-white" x-text="stats.totalInstalls"></span>
            <span class="text-[10px] font-semibold text-amber-300">Retained</span>
          </div>
          <p class="text-[10px] text-slate-400">Installed from QR entry</p>
        </div>
      </div>

      <!-- 🎨 Studio Interactive Workbench: Controls (Left) & Live Printable Card (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        
        <!-- Left: Configuration & Styler Form (7 cols) -->
        <div class="lg:col-span-7 bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-5 shadow-sm">
          <div class="pb-3 border-b border-slate-800">
            <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
              <span>🎛️</span> Step 1: Campaign & Target Setup
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">Configure where the QR code directs the student and tag its physical placement</p>
          </div>

          <!-- Destination Selector -->
          <div class="space-y-3.5">
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-2">QR Target Route</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <button
                  type="button"
                  @click="destinationType = 'vendor'; updateDefaultCampaignTag()"
                  class="px-3 py-2 rounded-xl text-xs font-semibold border transition-all text-center cursor-pointer"
                  :class="destinationType === 'vendor' ? 'bg-slate-800 text-amber-300 border-amber-500/30 ring-1 ring-amber-500/20' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
                >
                  🏪 Food Vendor
                </button>
                <button
                  type="button"
                  @click="destinationType = 'late-night'; updateDefaultCampaignTag()"
                  class="px-3 py-2 rounded-xl text-xs font-semibold border transition-all text-center cursor-pointer"
                  :class="destinationType === 'late-night' ? 'bg-slate-800 text-amber-300 border-amber-500/30 ring-1 ring-amber-500/20' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
                >
                  🌙 Late Night
                </button>
                <button
                  type="button"
                  @click="destinationType = 'home'; updateDefaultCampaignTag()"
                  class="px-3 py-2 rounded-xl text-xs font-semibold border transition-all text-center cursor-pointer"
                  :class="destinationType === 'home' ? 'bg-slate-800 text-amber-300 border-amber-500/30 ring-1 ring-amber-500/20' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
                >
                  🌐 Homepage
                </button>
                <button
                  type="button"
                  @click="destinationType = 'custom'; updateDefaultCampaignTag()"
                  class="px-3 py-2 rounded-xl text-xs font-semibold border transition-all text-center cursor-pointer"
                  :class="destinationType === 'custom' ? 'bg-slate-800 text-amber-300 border-amber-500/30 ring-1 ring-amber-500/20' : 'bg-[#0A0F1A] border-slate-800 text-slate-400 hover:text-slate-200'"
                >
                  🔗 Custom URL
                </button>
              </div>
            </div>

            <!-- Conditional: Vendor Dropdown -->
            <div x-show="destinationType === 'vendor'" class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Select Campus Food Vendor</label>
              <select
                x-model="selectedVendorSlug"
                @change="updateDefaultCampaignTag()"
                class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50"
              >
                <template x-for="v in vendors" :key="v.slug">
                  <option :value="v.slug" x-text="v.name"></option>
                </template>
              </select>
            </div>

            <!-- Conditional: Custom URL Input -->
            <div x-show="destinationType === 'custom'" class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Custom Target URL</label>
              <input
                type="url"
                x-model="customUrl"
                class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50"
                placeholder="https://orandus.in/search?q=momos"
              />
            </div>

            <!-- Placement / Physical Medium -->
            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300">Physical Placement Medium</label>
              <select
                x-model="placement"
                @change="updateDefaultCampaignTag()"
                class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50"
              >
                <option value="counter_sticker">🏷️ Counter Sticker (Stall billing counter)</option>
                <option value="table_tent">📐 Dining Table Tent (Acrylic table stand)</option>
                <option value="hostel_poster">🏢 Hostel Notice Poster (Hostels 1–11 & lifts)</option>
                <option value="gate_standee">🚪 Campus Gate Standee (Gate 1 & Gate 2 walkway)</option>
                <option value="parcel_slip">📦 Food Parcel Bag Insert (Stapled with order)</option>
              </select>
            </div>

            <!-- Campaign Identifier -->
            <div class="space-y-1">
              <label class="text-xs font-semibold text-slate-300 flex items-center justify-between">
                <span>Unique Campaign Identifier (UTM Tag)</span>
                <span class="text-[10px] text-slate-500">Auto-formatted for telemetry</span>
              </label>
              <input
                type="text"
                x-model="customCampaignTag"
                class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-mono text-amber-300 focus:outline-hidden focus:border-amber-500/50"
                placeholder="e.g. food_cave_counter_sticker"
              />
            </div>
          </div>

          <!-- Step 2: Visual Card Customizer -->
          <div class="pt-4 border-t border-slate-800 space-y-3.5">
            <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
              <span>🎨</span> Step 2: Card Styler & Branding
            </h3>

            <!-- Color Palette Selector -->
            <div>
              <label class="text-xs font-semibold text-slate-300 block mb-2">QR Foreground Tone</label>
              <div class="flex items-center gap-2.5">
                <button
                  type="button"
                  @click="colorTheme = '#FF5200'"
                  class="flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-medium transition-all cursor-pointer"
                  :class="colorTheme === '#FF5200' ? 'border-amber-500 bg-amber-500/10 text-amber-300' : 'border-slate-800 bg-[#0A0F1A] text-slate-400 hover:text-slate-200'"
                >
                  <span class="w-3 h-3 rounded-full bg-[#FF5200]"></span>
                  <span>Orandus Orange</span>
                </button>
                <button
                  type="button"
                  @click="colorTheme = '#0F172A'"
                  class="flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-medium transition-all cursor-pointer"
                  :class="colorTheme === '#0F172A' ? 'border-amber-500 bg-amber-500/10 text-amber-300' : 'border-slate-800 bg-[#0A0F1A] text-slate-400 hover:text-slate-200'"
                >
                  <span class="w-3 h-3 rounded-full bg-slate-900 border border-slate-700"></span>
                  <span>Charcoal Black</span>
                </button>
                <button
                  type="button"
                  @click="colorTheme = '#059669'"
                  class="flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-medium transition-all cursor-pointer"
                  :class="colorTheme === '#059669' ? 'border-amber-500 bg-amber-500/10 text-amber-300' : 'border-slate-800 bg-[#0A0F1A] text-slate-400 hover:text-slate-200'"
                >
                  <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                  <span>Forest Emerald</span>
                </button>
              </div>
            </div>

            <!-- Card Headline Text -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-300">Print Card Headline</label>
                <input
                  type="text"
                  x-model="cardTitle"
                  class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50"
                  placeholder="Scan for Live Menu & Prices"
                />
              </div>

              <div class="space-y-1">
                <label class="text-xs font-semibold text-slate-300">Footer Sub-Headline</label>
                <input
                  type="text"
                  x-model="cardSubtext"
                  class="w-full px-3.5 py-2.5 bg-[#0A0F1A] border border-slate-800 rounded-xl text-xs font-medium text-slate-200 focus:outline-hidden focus:border-amber-500/50"
                  placeholder="Direct Stall Call • Zero Commission"
                />
              </div>
            </div>

            <!-- Generated Encoded Link Display -->
            <div class="p-3 bg-[#0A0F1A] rounded-xl border border-slate-800 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono uppercase text-slate-400">Live Telemetry Target URL:</span>
                <button
                  type="button"
                  @click="copyUrl()"
                  class="text-[11px] font-bold text-amber-400 hover:underline cursor-pointer"
                >
                  <span x-text="copied ? '✅ Copied!' : '📋 Copy Link'"></span>
                </button>
              </div>
              <p class="font-mono text-xs text-slate-300 break-all select-all" x-text="generatedTargetUrl"></p>
            </div>
          </div>

        </div>

        <!-- Right: Realtime Print-Ready Card Preview (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          
          <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
              <span class="text-xs font-semibold text-slate-300">Physical Print Preview</span>
              <span class="px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-300 border border-amber-500/20 font-mono text-[10px]" x-text="placement.replace('_', ' ').toUpperCase()"></span>
            </div>

            <!-- 🖨️ The Printable Standee Card Element (Crisp white for printers) -->
            <div
              id="printable-qr-card"
              class="bg-white border-2 border-slate-200 rounded-2xl p-6 text-center space-y-3.5 shadow-lg relative overflow-hidden"
            >
              <!-- Brand Header -->
              <div class="flex items-center justify-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-bold shadow-xs">
                  🍜
                </div>
                <span class="font-display font-extrabold text-lg text-slate-900 tracking-tight">Orandus</span>
                <span class="px-2 py-0.2 rounded-full bg-slate-900 text-white font-mono text-[8px] font-bold">CAMPUS</span>
              </div>

              <!-- Stall or Highlight Context -->
              <div class="space-y-0.5">
                <h4 class="font-display text-lg font-black text-slate-900 leading-tight" x-text="destinationType === 'vendor' ? selectedVendorName : cardTitle"></h4>
                <p class="text-[11px] font-bold text-amber-600 uppercase tracking-wider" x-text="destinationType === 'vendor' ? cardTitle : 'Campus Food & Menus'"></p>
              </div>

              <!-- High-Resolution QR Graphic Container with Center Logo Badge -->
              <div class="relative inline-block mx-auto p-2.5 bg-white rounded-xl border border-slate-200 shadow-xs">
                <img
                  :src="qrImageSrc"
                  alt="Campus Food QR Code"
                  class="w-48 h-48 mx-auto object-contain"
                  loading="eager"
                />
                <!-- Center Logo Badge Overlay -->
                <div
                  x-show="showLogoCenter"
                  class="absolute inset-0 m-auto w-10 h-10 bg-white rounded-lg shadow-md border border-slate-200 flex items-center justify-center text-lg pointer-events-none"
                >
                  🍜
                </div>
              </div>

              <!-- Scan CTA Instruction -->
              <div class="space-y-1 pt-1">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 text-white text-[11px] font-bold">
                  <span>📸</span> Scan with Any Camera / Phone
                </div>
                <p class="text-[11px] text-slate-600 font-semibold" x-text="cardSubtext"></p>
              </div>

              <!-- Footer Verification Note -->
              <div class="pt-2.5 border-t border-slate-100 text-[10px] text-slate-400 font-mono">
                <span>orandus.in • Zero Commissions Direct Connect</span>
              </div>
            </div>

            <!-- Download & Export Action Buttons -->
            <div class="grid grid-cols-2 gap-2.5 pt-4">
              <a
                :href="qrDownloadPngSrc"
                download="orandus_qr.png"
                class="px-3.5 py-2 bg-[#0A0F1A] hover:bg-slate-800 border border-slate-800 text-slate-200 text-center font-semibold text-xs rounded-xl shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>📥</span> Download PNG
              </a>
              <button
                type="button"
                @click="printFlyer()"
                class="px-3.5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded-xl shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>🖨️</span> Print Standee
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- 📈 Real-Time QR Physical Campaigns Leaderboard Table -->
      <div class="bg-[#101726] border border-slate-800/80 rounded-2xl p-5 sm:p-6 space-y-4 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
          <div>
            <h3 class="font-display text-base font-bold text-white flex items-center gap-2">
              <span>🏆</span> Active Campus QR Placements Leaderboard
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">Live scan volume, direct phone calls, and PWA installs driven by each poster & standee</p>
          </div>
          <button
            @click="refreshStats()"
            class="text-xs font-semibold text-amber-400 hover:underline cursor-pointer"
          >
            Live Sync 🔄
          </button>
        </div>

        <template x-if="stats.campaigns.length === 0">
          <div class="text-center py-10 bg-[#0A0F1A] rounded-xl border border-dashed border-slate-800 space-y-2">
            <span class="text-3xl block">📱</span>
            <p class="text-xs font-semibold text-slate-300">No physical scans recorded yet</p>
            <p class="text-[11px] text-slate-500 max-w-sm mx-auto">
              Download and place your first QR code standee on a campus counter or hostel notice board. Scans and call conversions will update here automatically.
            </p>
          </div>
        </template>

        <template x-if="stats.campaigns.length > 0">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#0A0F1A] border-b border-slate-800 text-slate-400 font-medium uppercase tracking-wider text-[10px]">
                <tr>
                  <th class="py-3 px-4">Placement / Campaign</th>
                  <th class="py-3 px-4">Medium</th>
                  <th class="py-3 px-4 text-center">Scans</th>
                  <th class="py-3 px-4 text-center">Stall Calls</th>
                  <th class="py-3 px-4 text-center">WhatsApp</th>
                  <th class="py-3 px-4 text-center">PWA Saves</th>
                  <th class="py-3 px-4 text-right">Conversion</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/60 font-normal">
                <template x-for="(camp, idx) in stats.campaigns" :key="idx">
                  <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="py-3 px-4 font-semibold text-slate-200 font-mono text-xs" x-text="camp.campaign"></td>
                    <td class="py-3 px-4 whitespace-nowrap">
                      <span class="px-2 py-0.5 rounded-md bg-[#0A0F1A] border border-slate-800 text-slate-300 text-[10px]" x-text="camp.medium"></span>
                    </td>
                    <td class="py-3 px-4 text-center font-bold text-amber-300 font-mono" x-text="camp.scans"></td>
                    <td class="py-3 px-4 text-center font-bold text-emerald-400 font-mono" x-text="camp.calls"></td>
                    <td class="py-3 px-4 text-center font-semibold text-emerald-300 font-mono" x-text="camp.whatsapp"></td>
                    <td class="py-3 px-4 text-center font-semibold text-blue-400 font-mono" x-text="camp.installs"></td>
                    <td class="py-3 px-4 text-right font-mono font-bold text-slate-200" x-text="camp.scans > 0 ? (((camp.calls + camp.whatsapp) / camp.scans) * 100).toFixed(1) + '%' : '0%'"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </template>
      </div>

    </main>
  </section>
</Layout>
