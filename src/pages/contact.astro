---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';
import { cleanWhatsAppHref, cleanDisplayPhone } from '../lib/utils';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);

const brandName = settingsObj.site_title || settingsObj.brand_name || 'Orandus';
const email = settingsObj.company_support_email || 'm.chauhan@zohomail.in';
const rawPhone = settingsObj.company_support_phone || '8901026416';
const whatsappDigits = rawPhone.replace(/\D/g, '').replace(/^91/, '') || '8901026416';
const displayPhone = cleanDisplayPhone(rawPhone, '8901026416');

const whatsappUrl = cleanWhatsAppHref(whatsappDigits, 'Hi! I have a question or suggestion: ');
const mailtoUrl = `mailto:${email}?subject=Inquiry%20-%20${encodeURIComponent(brandName)}&body=Hi%2C%0A%0AI%20wanted%20to%20reach%20out%20regarding%3A%0A%0A`;
---

<Layout title={`Contact & Support - ${brandName}`} description={`Get in touch, share feedback, report an issue, or submit your food spot for free listing.`}>
  <section class="min-h-screen bg-nitkkr-cream/60 py-10 sm:py-14 px-4">
    <div class="max-w-xl mx-auto space-y-6">
      
      <!-- Header -->
      <div class="text-center space-y-2">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-nitkkr-dark">📞 Contact & Support</h1>
        <p class="text-sm text-slate-600">Have feedback, spotted an outdated price, or want to list your food spot? Reach out anytime.</p>
      </div>

      <!-- Quick Contact Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs flex flex-col items-center text-center hover:shadow-md hover:border-nitkkr-orange/50 transition-all"
        >
          <span class="text-4xl mb-2">💬</span>
          <h3 class="font-bold text-base text-slate-900">WhatsApp</h3>
          <p class="text-xs text-slate-500 mt-1">{displayPhone}</p>
          <span class="mt-3 px-3 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Tap to Chat</span>
        </a>

        <!-- Email -->
        <a
          href={mailtoUrl}
          class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs flex flex-col items-center text-center hover:shadow-md hover:border-nitkkr-orange/50 transition-all"
        >
          <span class="text-4xl mb-2">📧</span>
          <h3 class="font-bold text-base text-slate-900">Email</h3>
          <p class="text-xs text-slate-500 mt-1">{email}</p>
          <span class="mt-3 px-3 py-1.5 bg-slate-100 text-slate-700 text-xs font-bold rounded-full">Send Message</span>
        </a>
      </div>

      <!-- Section Divider -->
      <div class="relative py-2">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200/60"></div>
        </div>
        <div class="relative flex justify-center text-xs">
          <span class="bg-nitkkr-cream px-3 text-slate-400 font-semibold uppercase tracking-wider text-[10px]">Food Spot Owners</span>
        </div>
      </div>

      <!-- Vendor Listing Form -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-6 sm:p-8 border border-amber-200/80 shadow-xs space-y-4">
        <div class="space-y-1">
          <h2 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
            <span>🏪</span> List Your Food Spot
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Run a food spot near campus? Submit your details below to get listed for free. Zero commissions, zero onboarding fees.
          </p>
        </div>

        <form
          id="vendor-listing-form"
          class="space-y-4 pt-1"
          onsubmit="event.preventDefault(); submitVendorForm();"
        >
          <div>
            <label for="spot_name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Food Spot Name *</label>
            <input 
              id="spot_name"
              type="text" 
              placeholder="e.g. Royal Fast Food & Shakes" 
              required 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all"
            />
          </div>
          
          <div>
            <label for="spot_phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Your Phone / WhatsApp Number *</label>
            <input 
              id="spot_phone"
              type="tel" 
              placeholder="e.g. 98765 43210" 
              required 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all"
            />
          </div>

          <div>
            <label for="spot_location" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Location / Area (Optional)</label>
            <input 
              id="spot_location"
              type="text" 
              placeholder="e.g. Main Market, Near Entrance Gate" 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20 transition-all"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3.5 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-sm rounded-xl transition-all shadow-sm active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2"
          >
            <span>💬</span> Submit via WhatsApp
          </button>
        </form>

        <p class="text-xs text-slate-400 text-center">
          Generates a formatted listing request and opens WhatsApp directly.
        </p>
      </div>

    </div>
  </section>

  <script is:inline define:vars={{ whatsappDigits, brandName }}>
    function submitVendorForm() {
      const nameInput = document.getElementById('spot_name');
      const phoneInput = document.getElementById('spot_phone');
      const locationInput = document.getElementById('spot_location');

      const name = nameInput ? nameInput.value.trim() : '';
      const phone = phoneInput ? phoneInput.value.trim() : '';
      const location = locationInput && locationInput.value.trim() ? locationInput.value.trim() : 'Campus / Local Area';

      if (!name || !phone) return;

      const message = `Hi! I would like to list my food spot on ${brandName}:\n\n` +
                      `• Name: ${name}\n` +
                      `• Contact: ${phone}\n` +
                      `• Location: ${location}`;

      const url = `https://wa.me/91${whatsappDigits}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    }
  </script>
</Layout>