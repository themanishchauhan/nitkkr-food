---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { cleanWhatsAppHref } from '../lib/utils';

const whatsappPhone = '8901026416';
const email = 'm.chauhan@zohomail.in';
const whatsappUrl = cleanWhatsAppHref(whatsappPhone, 'Hi Orandus Team! ');
const mailtoUrl = `mailto:${email}?subject=Feedback%20-%20Orandus&body=Hey%20Orandus%20team%2C%0A%0AI%20wanted%20to%20share%20some%20feedback%3A%0A%0A`;
---

<Layout title="Connect & Support - Orandus" description="Get in touch with the Orandus team, share feedback, or list your food spot.">
  <section class="min-h-screen bg-nitkkr-cream py-12 px-4">
    <div class="max-w-xl mx-auto space-y-6">
      
      <!-- Header -->
      <div class="text-center space-y-2">
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-nitkkr-dark">📞 Connect & Support</h1>
        <p class="text-sm text-slate-600">Found a bug? Want a feature? Running a food spot? Just want to say hi?</p>
      </div>

      <!-- Quick Actions: Student Feedback First -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs flex flex-col items-center text-center hover:shadow-md hover:border-nitkkr-orange/50 transition-all"
        >
          <span class="text-4xl mb-2">💬</span>
          <h3 class="font-bold text-base text-slate-900">WhatsApp</h3>
          <p class="text-xs text-slate-500 mt-1">Fastest way to reach us</p>
          <span class="mt-3 px-3 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Tap to Chat</span>
        </a>

        <!-- Email -->
        <a
          href={mailtoUrl}
          class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs flex flex-col items-center text-center hover:shadow-md hover:border-nitkkr-orange/50 transition-all"
        >
          <span class="text-4xl mb-2">📧</span>
          <h3 class="font-bold text-base text-slate-900">Email</h3>
          <p class="text-xs text-slate-500 mt-1">For detailed feedback or collabs</p>
          <span class="mt-3 px-3 py-1.5 bg-slate-100 text-slate-700 text-xs font-bold rounded-full">Opens Mail App</span>
        </a>
      </div>

      <!-- Divider -->
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-slate-200/60"></div>
        </div>
        <div class="relative flex justify-center text-xs">
          <span class="bg-nitkkr-cream px-3 text-slate-400 font-semibold">Food Spot Owners</span>
        </div>
      </div>

      <!-- Vendor Listing Form -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-amber-200/80 shadow-xs space-y-4">
        <h2 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
          <span>🏪</span> List Your Food Spot
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Run a food spot near campus? Drop your details and we'll add it for free. Zero commissions, direct student connect.
        </p>

        <form
          action={`https://wa.me/91${whatsappPhone}`}
          method="GET"
          target="_blank"
          class="space-y-4 pt-2"
        >
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Food Spot Name</label>
            <input 
              type="text" 
              name="text" 
              placeholder="e.g. Sharma Fast Food & Chai" 
              required 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20"
            />
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Your WhatsApp Number</label>
            <input 
              type="tel" 
              name="text" 
              placeholder="e.g. 98765 43210" 
              required 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Area / Location (Optional)</label>
            <input 
              type="text" 
              name="text" 
              placeholder="e.g. Near main gate, market area" 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-nitkkr-orange focus:ring-2 focus:ring-nitkkr-orange/20"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3.5 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-sm rounded-xl transition-all shadow-sm active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2"
          >
            <span>💬</span> Send on WhatsApp
          </button>
        </form>

        <p class="text-xs text-slate-400 text-center">
          Opens WhatsApp with a pre-filled message. Just hit send.
        </p>
      </div>

    </div>
  </section>
</Layout>