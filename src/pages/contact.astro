---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);

const email = settingsObj.contact_email || 'admin@nitkkr-food.com';
const phone = settingsObj.support_whatsapp || '+91 98765 43210';
const instagram = settingsObj.instagram_url || 'https://instagram.com/nitkkr_food';

---

<Layout title="Contact & Vendor Support - NITKKR Food" description="Get in touch with the NITKKR Food team or request to list your vendor eatery.">
  <section class="min-h-screen bg-nitkkr-cream py-12 px-4">
    <div class="max-w-2xl mx-auto space-y-6">
      <div class="text-center space-y-2">
        <a href="/" class="text-xs text-slate-500 hover:text-nitkkr-orange mb-1 inline-block font-semibold">← Back to Home</a>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-nitkkr-dark">📞 Connect & Support</h1>
        <p class="text-xs sm:text-sm text-slate-600">Have feedback, want to report an issue, or list your food vendor / eatery?</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-white rounded-3xl p-6 border border-amber-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-3xl mb-2 block">💬</span>
            <h3 class="font-bold text-base text-slate-900">WhatsApp Support</h3>
            <p class="text-xs text-slate-500 mt-1">Chat directly with the campus admin team for quick help.</p>
          </div>
          <a
            href={`https://wa.me/${phone.replace(/[^0-9]/g, '')}?text=Hi%20NITKKR%20Food%20Team!`}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-flex items-center justify-center gap-2 w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-all shadow-xs"
          >
            <span>💬 Message on WhatsApp</span>
          </a>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-amber-200/80 shadow-xs flex flex-col justify-between">
          <div>
            <span class="text-3xl mb-2 block">📧</span>
            <h3 class="font-bold text-base text-slate-900">Email Inquiries</h3>
            <p class="text-xs text-slate-500 mt-1">For partnerships, student team collabs, or feedback.</p>
          </div>
          <a
            href={`mailto:${email}`}
            class="mt-4 inline-flex items-center justify-center gap-2 w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-all shadow-xs"
          >
            <span>✉️ Send Email</span>
          </a>
        </div>
      </div>

      <!-- Vendor Onboarding Form Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-amber-200/80 shadow-xs space-y-4">
        <h2 class="font-display font-bold text-lg text-slate-900 flex items-center gap-2">
          <span>🏪</span> List Your Food Vendor / Eatery
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed">
          Are you running an eatery near NIT Kurukshetra campus (Gate 1, Gate 2, DB Hall, or Market)? Send us your vendor name and phone number to get listed!
        </p>

        <form
          action={`https://wa.me/${phone.replace(/[^0-9]/g, '')}`}
          method="GET"
          target="_blank"
          class="space-y-3 pt-2"
        >
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Vendor / Eatery Name</label>
            <input type="text" name="text" placeholder="e.g. Sharma Fast Food & Chai" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
          </div>
          <button
            type="submit"
            class="w-full py-3 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-all shadow-sm active:scale-95 cursor-pointer"
          >
            Submit Vendor Listing via WhatsApp →
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

