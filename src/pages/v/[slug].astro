---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import AdBanner from '../../components/AdBanner.astro';
import ReviewModal from '../../components/ReviewModal.astro';
import { getVendorBySlug, getMenuItemsWithReviewStats, getReviewsByVendor, getCategories, getAllSiteSettings } from '../../lib/queries';
import { formatOperatingHours, cleanTelHref, cleanDisplayPhone, cleanWhatsAppHref, formatRating, getVendorTimingStatus, isPureVegVendor } from '../../lib/utils';
import { getOptimizedImageUrl, getResponsiveSrcSet } from '../../lib/images';

const { slug } = Astro.params;
const vendor = await getVendorBySlug(slug as string);

if (!vendor) {
  return Astro.redirect('/404');
}

const isPureVeg = isPureVegVendor(vendor);

const [menuItems, allCategories, vendorReviews, settings] = await Promise.all([
  getMenuItemsWithReviewStats(vendor.id),
  getCategories(),
  getReviewsByVendor(vendor.id),
  getAllSiteSettings()
]);

const categoryCounts = new Map<number | string, number>();
for (const item of menuItems) {
  if (item.categoryId) categoryCounts.set(item.categoryId, (categoryCounts.get(item.categoryId) || 0) + 1);
  if (item.categorySlug) categoryCounts.set(item.categorySlug, (categoryCounts.get(item.categorySlug) || 0) + 1);
}

const categories = allCategories
  .filter((c: any) => (categoryCounts.get(c.id) || categoryCounts.get(c.slug) || 0) > 0)
  .sort((a: any, b: any) => {
    const countA = categoryCounts.get(a.id) || categoryCounts.get(a.slug) || 0;
    const countB = categoryCounts.get(b.id) || categoryCounts.get(b.slug) || 0;
    if (countB !== countA) {
      return countB - countA; // Decreasing order: show categories with more items first
    }
    return (a.displayOrder || 0) - (b.displayOrder || 0);
  });
const closedDays = (vendor as any).closedDays || ((vendor.slug === 'the-hangry-club' || vendor.slug === 'hangry-club') ? ['Tuesday'] : null);
const timing = getVendorTimingStatus(vendor.opensAt, vendor.closesAt, undefined, closedDays);
const isBackendActive = vendor.isActive !== undefined ? Boolean(vendor.isActive) : ((vendor as any).is_active !== undefined ? Boolean((vendor as any).is_active) : true);
const isVendorOpen = isBackendActive && timing.isOpen;
const isOpen = isVendorOpen;
const vendorNote = (vendor as any).notice || (vendor as any).description || ((vendor.slug === 'the-hangry-club' || vendor.slug === 'hangry-club') ? 'Closed on Tuesdays' : null);
const vendorReviewCount = vendorReviews.length;
const vendorAvgRating = vendorReviewCount > 0
  ? formatRating(vendorReviews.reduce((sum: number, r: any) => sum + (r.rating || 0), 0) / vendorReviewCount)
  : null;

const heroCoverUrl = getOptimizedImageUrl(vendor.image || '/og-default.jpg', { width: 800, quality: 80, format: 'auto' });
const heroCoverSrcSet = getResponsiveSrcSet(vendor.image || '/og-default.jpg', [400, 640, 800, 1200]);

const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const adEnabled = settingsObj.ad_banner_enabled === 'true';
const showWhatsApp = settingsObj.whatsapp_ordering_enabled === 'true' && settingsObj.show_whatsapp_button !== 'false';
const whatsAppLabel = settingsObj.whatsapp_button_label || 'Order on WhatsApp';
const msgTemplate = (settingsObj.whatsapp_msg_template || `Hi ${vendor.name}! I'd like to check menu availability from Orandus.`).replace('{vendor_name}', vendor.name);

const formattedHours = formatOperatingHours(vendor.opensAt, vendor.closesAt);
const vendorTelLink = cleanTelHref(vendor.phone);
const vendorDisplayPhone = cleanDisplayPhone(vendor.phone);
const vendorWhatsAppLink = cleanWhatsAppHref(vendor.whatsapp || vendor.phone, msgTemplate);


let deliversToList: string[] = [];
if (Array.isArray(vendor.deliversTo)) {
  deliversToList = vendor.deliversTo;
} else if (typeof vendor.deliversTo === 'string') {
  try {
    deliversToList = JSON.parse(vendor.deliversTo);
  } catch (e) {
    deliversToList = vendor.deliversTo.split(',').map((s: string) => s.trim()).filter(Boolean);
  }
}
if (!deliversToList || deliversToList.length === 0) {
  deliversToList = ['Campus wide'];
}
deliversToList = deliversToList.map((s: string) =>
  s.replace(/NITKKR\s*campus\s*all/gi, 'Campus wide')
   .replace(/NITKKR\s*campus/gi, 'Campus wide')
   .replace(/NITKKR/gi, 'Campus')
   .replace(/NIT Kurukshetra/gi, 'Campus')
);

const shareUrl = new URL(`/v/${vendor.slug}`, Astro.url.origin || Astro.site || 'https://orandus.pages.dev').href;
const shareTitle = `${vendor.name} - Orandus`;
const shareText = `Check out ${vendor.name} on Orandus - ${menuItems.length} dishes available, opens ${formattedHours}`;

const googleMapsQuery = (vendor.latitude && vendor.longitude)
  ? `${vendor.latitude},${vendor.longitude}`
  : encodeURIComponent(`${vendor.name}, ${vendor.address}`);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${googleMapsQuery}`;
---

<Layout
  title={`${vendor.name} - Orandus`}
  description={`${menuItems.length} items • ${formattedHours}${deliversToList.length > 0 ? ' • ' + deliversToList.join(', ') : ''}`}
  ogImage={vendor.image || '/og-default.jpg'}
  ogUrl={shareUrl}
>
  <section class="min-h-screen bg-bistro-50 pb-32">
    <!-- Immersive Cover Photo Hero -->
    <div class="relative w-full h-56 sm:h-72 bg-neutral-900 overflow-hidden">

      <img
        src={heroCoverUrl}
        srcset={heroCoverSrcSet}
        sizes="(max-width: 640px) 100vw, 800px"
        alt={vendor.name}
        width="800"
        height="288"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class={`w-full h-full object-cover filter brightness-90 transform scale-105 transition-transform duration-700 ${!isVendorOpen ? 'grayscale opacity-75' : 'opacity-80'}`}
      />

      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/40"></div>

      <!-- Top Navigation Bar over Hero -->
      <div class="absolute top-4 left-0 right-0 max-w-2xl mx-auto px-4 flex items-center justify-between z-10">
        <button
          type="button"
          onclick="if (document.referrer && document.referrer.includes(window.location.host)) { history.back(); } else if (window.history.length > 1) { history.back(); } else { window.location.href = '/'; }"
          class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-black/60 transition-all active:scale-95 shadow-md cursor-pointer"
          aria-label="Go back to previous page"
          title="Back"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
      </div>

      <!-- Hero Vendor Info Content -->
      <div class="absolute bottom-4 left-0 right-0 max-w-2xl mx-auto px-4 text-white z-10">
        <div class="flex items-center gap-2 flex-wrap mb-1">
          <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight drop-shadow-sm">{vendor.name}</h1>
          {isPureVeg && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-black bg-emerald-600 text-white shadow-md border border-emerald-400">
              <span class="w-3 h-3 border border-white rounded-[2px] flex items-center justify-center p-[1px] bg-white">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              </span>
              <span>PURE VEG</span>
            </span>
          )}
          {vendorReviewCount > 0 && vendorAvgRating && (
            <button
              type="button"
              onclick={`window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: null, name: 'All Dishes', mode: 'read' } }))`}
              class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black bg-amber-400 text-slate-950 shadow-md hover:bg-amber-300 transition-all cursor-pointer"
              title="View student reviews"
            >
              <span>★</span>
              <span>{vendorAvgRating}</span>
              <span class="text-slate-800 font-semibold text-[11px]">({vendorReviewCount} reviews)</span>
            </button>
          )}
        </div>
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-white/90 hover:text-white transition-all drop-shadow group cursor-pointer"
          title="Open in Google Maps"
        >
          <span class="group-hover:scale-125 transition-transform inline-block">📍</span>
          <span class="hover:underline underline-offset-2">{vendor.address}</span>
          <svg class="w-3 h-3 text-white/75 group-hover:text-white transition-opacity inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Main Content Container -->
    <div class="max-w-2xl mx-auto px-4 -mt-3 relative z-20">
      <!-- Vendor Status & Info Card -->
      <div class={`rounded-2xl p-4 shadow-sm border mb-5 space-y-3 ${isVendorOpen ? 'bg-white border-slate-100' : 'bg-slate-50/90 border-slate-200'}`}>
        <!-- Top Row: Backend Open/Closed Tag + Operating Hours (Only these two) -->
        <div class="flex items-center gap-2.5 flex-wrap">
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold ${isVendorOpen ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/80' : 'bg-slate-100 text-slate-600 border border-slate-200'}`}>
            <span class={`w-2 h-2 rounded-full ${isVendorOpen ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`}></span>
            <span>{isVendorOpen ? 'Open' : 'Closed'}</span>
          </span>

          <span class="text-xs font-medium text-slate-600 flex items-center gap-1.5">
            <span>🕒</span>
            <span>{formattedHours}</span>
          </span>

          {!isVendorOpen && timing.statusText && (
            <span class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200/80 px-2 py-0.5 rounded-lg">
              {timing.statusText}
            </span>
          )}
        </div>

        {deliversToList.length > 0 && (
          <div class={`pt-2 border-t flex items-center gap-2 text-xs text-slate-600 ${isVendorOpen ? 'border-slate-100' : 'border-slate-200/80'}`}>
            <span class="text-base">🛵</span>
            <span><strong class="text-slate-800 font-semibold">Delivers to:</strong> {deliversToList.join(', ')}</span>
          </div>
        )}

        <!-- 📢 Simple Notice / Note Section -->
        {vendorNote && (
          <div class={`pt-2 border-t flex items-start gap-2 text-xs ${isVendorOpen ? 'border-slate-100' : 'border-slate-200/80'}`}>
            <span class="text-amber-600 font-bold flex items-center gap-1 flex-shrink-0">
              <span>📢</span> Notice:
            </span>
            <span class="text-slate-700 font-medium">{vendorNote}</span>
          </div>
        )}
      </div>

      <!-- In-Menu Campus Ad / Sponsor Section -->
      {adEnabled && (
        <AdBanner
          badge={settingsObj.ad_banner_badge || '⚡ SPONSORED DEAL'}
          title={settingsObj.ad_banner_title || 'Fresh Protein & Shake Hub'}
          description={settingsObj.ad_banner_description || '15% Flat Student Discount on all Whey Shakes & Healthy Bowls!'}
          image={settingsObj.ad_banner_image || ''}
          cta={settingsObj.ad_banner_cta || 'Claim Offer 💬'}
          link={settingsObj.ad_banner_link || '#'}
        />
      )}

      <!-- Modern Category Tabs and Dishes List with Unified Floating Dock -->
      {menuItems.length > 0 ? (
        <CategoryTabs
          categories={categories}
          menuItems={menuItems}
          vendorSlug={vendor.slug}
          vendorName={vendor.name}
          vendorPhone={vendor.phone || ''}
          vendorWhatsApp={vendor.whatsapp || ''}
          isVendorOpen={isVendorOpen}
          vendorTelLink={vendorTelLink}
          vendorDisplayPhone={vendorDisplayPhone}
          vendorWhatsAppLink={vendorWhatsAppLink}
          showWhatsApp={showWhatsApp}
          whatsAppLabel={whatsAppLabel}
          shareUrl={shareUrl}
          shareTitle={shareTitle}
          shareText={shareText}
          deliversTo={deliversToList}
          formattedHours={formattedHours}
          timingStatus={timing.statusText}
        />
      ) : (
        <div class="bg-white rounded-3xl border border-slate-100 p-10 text-center shadow-sm">
          <p class="text-4xl mb-3">🍱</p>
          <h3 class="text-base font-bold text-slate-800">No dishes listed yet</h3>
          <p class="text-xs text-slate-500 mt-1">You can call the vendor directly to check today's campus specials.</p>
        </div>
      )}
    </div>

    <!-- Reusable Student Review Modal -->
    <ReviewModal vendorReviews={vendorReviews} menuItems={menuItems} />

  </section>
</Layout>