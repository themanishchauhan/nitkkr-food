---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import ShareButton from '../../components/ShareButton.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import QRCodeModal from '../../components/QRCodeModal.astro';
import { getVendorBySlug, getMenuItemsWithReviewStats, getReviewsByVendor, getCategories, isVendorOpenNow } from '../../lib/queries';

const { slug } = Astro.params;
const vendor = await getVendorBySlug(slug as string);

if (!vendor) {
  return Astro.redirect('/404');
}

const menuItems = await getMenuItemsWithReviewStats(vendor.id);
const categories = await getCategories();
const isOpen = isVendorOpenNow(vendor.opensAt, vendor.closesAt);
const stallReviews = await getReviewsByVendor(vendor.id);
const stallReviewCount = stallReviews.length;
const stallAvgRating = stallReviewCount > 0
  ? (stallReviews.reduce((sum: number, r: any) => sum + (r.rating || 0), 0) / stallReviewCount).toFixed(1)
  : null;

const shareUrl = new URL(`/v/${vendor.slug}`, Astro.site).href;
const shareTitle = `${vendor.name} - NITKKR Food`;
const shareText = `Check out ${vendor.name} on NITKKR Food - ${menuItems.length} dishes available, opens ${vendor.opensAt}–${vendor.closesAt}`;
---

<Layout
  title={`${vendor.name} - NITKKR Food`}
  description={`${menuItems.length} items • ${vendor.opensAt}–${vendor.closesAt} • ${vendor.deliversTo.join(', ')}`}
  ogImage={vendor.image || '/og-default.jpg'}
  ogUrl={shareUrl}
>
  <section class="min-h-screen bg-slate-50 pb-32">
    <!-- Immersive Cover Photo Hero -->
    <div class="relative w-full h-56 sm:h-72 bg-neutral-900 overflow-hidden">
      <img
        src={vendor.image || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1200&auto=format&fit=crop&q=80'}
        alt={vendor.name}
        class="w-full h-full object-cover opacity-80 filter brightness-90 transform scale-105 transition-transform duration-700"
      />
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/40"></div>

      <!-- Top Navigation Bar over Hero -->
      <div class="absolute top-4 left-0 right-0 max-w-2xl mx-auto px-4 flex items-center justify-between z-10">
        <a
          href="/"
          class="w-10 h-10 rounded-full bg-black/40 backdrop-blur-md border border-white/20 text-white flex items-center justify-center hover:bg-black/60 transition-all active:scale-95 shadow-md"
          aria-label="Back to home"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </a>

        <div class="flex items-center gap-2">
          <QRCodeModal vendorName={vendor.name} vendorSlug={vendor.slug} shareUrl={shareUrl} />
        </div>
      </div>

      <!-- Hero Stall Info Content -->
      <div class="absolute bottom-4 left-0 right-0 max-w-2xl mx-auto px-4 text-white z-10">
        <div class="flex items-center gap-2 flex-wrap mb-1">
          <h1 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight drop-shadow-sm">{vendor.name}</h1>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-white/20 backdrop-blur-md text-white border border-white/30">
            ✓ Campus Stall
          </span>
        </div>
        <p class="text-xs sm:text-sm text-white/90 flex items-center gap-1.5 drop-shadow">
          <span>📍</span>
          <span class="truncate">{vendor.address}</span>
        </p>
      </div>
    </div>

    <!-- Main Content Container -->
    <div class="max-w-2xl mx-auto px-4 -mt-3 relative z-20">
      <!-- Info & Badges Pill Card -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 mb-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <!-- Status & Hours & Rating -->
          <div class="flex items-center gap-2 flex-wrap">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${isOpen ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}`}>
              <span class={`w-2 h-2 rounded-full ${isOpen ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}></span>
              <span>{isOpen ? 'Open Now' : 'Closed'}</span>
            </span>

            <span class="text-xs font-medium text-slate-500 flex items-center gap-1">
              <span>🕒</span>
              <span>{vendor.opensAt} – {vendor.closesAt}</span>
            </span>

            <!-- Stall Overall Rating Badge -->
            {stallAvgRating ? (
              <button
                type="button"
                onclick={`window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: null, name: 'All Dishes', mode: 'read' } }))`}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-full text-xs font-bold transition-all cursor-pointer shadow-2xs"
                title="View student reviews"
              >
                <span class="text-amber-500">★</span>
                <span>{stallAvgRating}</span>
                <span class="text-slate-400 font-normal text-[11px]">({stallReviewCount})</span>
              </button>
            ) : (
              <button
                type="button"
                onclick={`window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: null, name: 'General Feedback', mode: 'write' } }))`}
                class="inline-flex items-center gap-1 px-2.5 py-1 bg-slate-50 hover:bg-amber-50 text-slate-600 hover:text-amber-800 border border-slate-200 hover:border-amber-200 rounded-full text-xs font-semibold transition-all cursor-pointer"
              >
                <span>⭐</span>
                <span>Rate Stall</span>
              </button>
            )}
          </div>

          <!-- Share Button -->
          <div class="flex-shrink-0">
            <ShareButton url={shareUrl} title={shareTitle} text={shareText} />
          </div>
        </div>

        {vendor.deliversTo && vendor.deliversTo.length > 0 && (
          <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-2 text-xs text-slate-600">
            <span class="text-base">🛵</span>
            <span><strong class="text-slate-800 font-semibold">Delivers to:</strong> {vendor.deliversTo.join(', ')}</span>
          </div>
        )}
      </div>

      <!-- Menu Section Header -->
      <div class="mb-4 flex items-center justify-between">
        <div>
          <h2 class="font-display text-xl font-extrabold text-slate-900 flex items-center gap-2">
            <span>🍽️</span> Menu ({menuItems.length})
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Explore dishes, tap ratings to read student reviews or leave feedback</p>
        </div>

        {stallReviewCount > 0 && (
          <button
            type="button"
            onclick={`window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: null, name: 'All Dishes', mode: 'read' } }))`}
            class="text-xs font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-3 py-1.5 rounded-xl transition-all flex items-center gap-1 cursor-pointer"
          >
            <span>💬</span>
            <span>{stallReviewCount} Reviews</span>
          </button>
        )}
      </div>

      <!-- Modern Category Tabs and Dishes List -->
      {menuItems.length > 0 ? (
        <CategoryTabs categories={categories} menuItems={menuItems} />
      ) : (
        <div class="bg-white rounded-3xl border border-slate-100 p-10 text-center shadow-sm">
          <p class="text-4xl mb-3">🍱</p>
          <h3 class="text-base font-bold text-slate-800">No dishes listed yet</h3>
          <p class="text-xs text-slate-500 mt-1">You can still order directly from the stall owner via WhatsApp or Call below.</p>
        </div>
      )}
    </div>

    <!-- Student Review & Feedback Modal (Read & Write) -->
    <div
      x-data={`{
        showModal: false,
        activeTab: 'read',
        itemId: null,
        itemName: '',
        studentName: '',
        rating: 5,
        comment: '',
        loading: false,
        submitted: false,
        error: '',
        reviewsList: ${JSON.stringify(stallReviews)},
        menuItemsList: ${JSON.stringify(menuItems)},
        init() {
          window.addEventListener('open-review-modal', (e) => {
            this.itemId = e.detail?.id || null;
            this.itemName = e.detail?.name || (this.itemId ? (this.menuItemsList.find(m => m.id === this.itemId)?.name || '') : 'General Feedback');
            this.activeTab = e.detail?.mode || (this.filteredReviews.length > 0 ? 'read' : 'write');
            this.rating = 5;
            this.comment = '';
            this.studentName = localStorage.getItem('student_name') || '';
            this.submitted = false;
            this.error = '';
            this.showModal = true;
          });
        },
        get filteredReviews() {
          if (!this.itemId) return this.reviewsList;
          return this.reviewsList.filter(r => r.menuItemId === this.itemId);
        },
        get modalAvgRating() {
          const revs = this.filteredReviews;
          if (revs.length === 0) return '0.0';
          const sum = revs.reduce((acc, r) => acc + (r.rating || 0), 0);
          return (sum / revs.length).toFixed(1);
        },
        async submitReview() {
          if (!this.studentName.trim()) {
            this.error = 'Please enter your name / hostel';
            return;
          }
          if (!this.itemId && this.menuItemsList.length > 0) {
            this.itemId = this.menuItemsList[0].id;
          }
          this.loading = true;
          this.error = '';
          try {
            localStorage.setItem('student_name', this.studentName.trim());
            const res = await fetch('/api/reviews', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                menuItemId: this.itemId,
                studentName: this.studentName.trim(),
                rating: this.rating,
                comment: this.comment.trim() || undefined
              })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              this.submitted = true;
              const newReview = {
                id: Date.now(),
                menuItemId: this.itemId,
                studentName: this.studentName.trim(),
                rating: this.rating,
                comment: this.comment.trim(),
                createdAt: new Date().toISOString(),
                menuItemName: this.itemName || 'Dish'
              };
              this.reviewsList.unshift(newReview);
              setTimeout(() => {
                this.activeTab = 'read';
                this.submitted = false;
              }, 1800);
            } else {
              this.error = data.error || 'Failed to submit review';
            }
          } catch (err) {
            this.error = 'Network error. Please try again.';
          } finally {
            this.loading = false;
          }
        }
      }`}
      x-init="init()"
    >
      <div
        x-show="showModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md p-4"
        @click.self="showModal = false"
      >
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-100 flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95 duration-200">
          
          <!-- Modal Header -->
          <div class="px-6 pt-5 pb-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-display font-bold text-lg text-slate-900">⭐ Student Reviews</h3>
                <template x-if="filteredReviews.length > 0">
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800" x-text="modalAvgRating + ' ★ (' + filteredReviews.length + ')'"></span>
                </template>
              </div>
              <p class="text-xs text-slate-500 mt-0.5 truncate max-w-xs" x-text={`itemName ? 'Dish: ' + itemName : 'Stall: ' + ${JSON.stringify(vendor.name)}`}></p>
            </div>
            <button @click="showModal = false" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 font-bold text-lg flex items-center justify-center cursor-pointer transition-colors" aria-label="Close modal">&times;</button>
          </div>

          <!-- Tabs: Read Reviews vs Write Review -->
          <div class="flex border-b border-slate-100 px-6 bg-white">
            <button
              type="button"
              @click="activeTab = 'read'"
              :class="activeTab === 'read' ? 'border-amber-500 text-amber-800 font-bold' : 'border-transparent text-slate-500 hover:text-slate-700 font-medium'"
              class="py-3 px-4 border-b-2 text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
            >
              <span>💬 Read Feedback</span>
              <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 font-semibold" x-text="filteredReviews.length"></span>
            </button>
            <button
              type="button"
              @click="activeTab = 'write'"
              :class="activeTab === 'write' ? 'border-amber-500 text-amber-800 font-bold' : 'border-transparent text-slate-500 hover:text-slate-700 font-medium'"
              class="py-3 px-4 border-b-2 text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
            >
              <span>✍️ Write Review</span>
            </button>
          </div>

          <!-- Tab Content Area -->
          <div class="p-6 overflow-y-auto flex-1 space-y-4">
            
            <!-- READ TAB -->
            <div x-show="activeTab === 'read'" class="space-y-3">
              <template x-if="filteredReviews.length === 0">
                <div class="text-center py-8 bg-slate-50 rounded-2xl border border-slate-100 p-6">
                  <span class="text-4xl mb-2 block">🌟</span>
                  <h4 class="font-bold text-sm text-slate-800">No reviews yet for this dish</h4>
                  <p class="text-xs text-slate-500 mt-1 mb-4">Be the first student to review and help campus foodies!</p>
                  <button
                    type="button"
                    @click="activeTab = 'write'"
                    class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl transition-all cursor-pointer shadow-sm"
                  >
                    ✍️ Write the First Review
                  </button>
                </div>
              </template>

              <template x-for="rev in filteredReviews" :key="rev.id">
                <div class="bg-slate-50/80 hover:bg-slate-50 border border-slate-200/70 rounded-2xl p-4 transition-all">
                  <div class="flex items-start justify-between gap-2 mb-1.5">
                    <div>
                      <h5 class="font-bold text-xs sm:text-sm text-slate-900" x-text="rev.studentName"></h5>
                      <p class="text-[10px] text-slate-400" x-text="new Date(rev.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })"></p>
                    </div>
                    <div class="flex items-center gap-0.5 px-2 py-0.5 bg-amber-100/80 text-amber-800 rounded-lg text-xs font-bold">
                      <span class="text-amber-500">★</span>
                      <span x-text="rev.rating"></span>
                    </div>
                  </div>
                  <template x-if="rev.comment">
                    <p class="text-xs text-slate-700 mt-2 leading-relaxed bg-white/70 p-2.5 rounded-xl border border-slate-100" x-text="rev.comment"></p>
                  </template>
                </div>
              </template>
            </div>

            <!-- WRITE TAB -->
            <div x-show="activeTab === 'write'">
              <!-- Success View -->
              <div x-show="submitted" class="text-center py-8">
                <span class="text-5xl mb-2 block">🎉</span>
                <h4 class="font-display font-bold text-lg text-emerald-700">Thank You!</h4>
                <p class="text-xs text-slate-500 mt-1">Your review has been submitted and is now live.</p>
              </div>

              <!-- Form View -->
              <form x-show="!submitted" @submit.prevent="submitReview()" class="space-y-4">
                <div x-show="error" x-cloak class="p-3 bg-rose-50 text-rose-700 text-xs rounded-xl border border-rose-100" x-text="error"></div>

                <!-- Select Dish if not specified -->
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Select Dish</label>
                  <select
                    x-model="itemId"
                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:border-amber-500 focus:bg-white transition-colors"
                  >
                    <template x-for="item in menuItemsList" :key="item.id">
                      <option :value="item.id" x-text="item.name + ' (₹' + Number(item.price).toFixed(0) + ')'"></option>
                    </template>
                  </select>
                </div>

                <!-- Star Picker -->
                <div class="bg-slate-50 p-3.5 rounded-2xl text-center border border-slate-100">
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Your Rating</label>
                  <div class="flex items-center justify-center gap-2 text-3xl">
                    <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
                      <button
                        type="button"
                        @click="rating = star"
                        class="cursor-pointer transition-transform hover:scale-125 focus:outline-none"
                        :class="star <= rating ? 'text-amber-400' : 'text-slate-200'"
                      >
                        ★
                      </button>
                    </template>
                  </div>
                  <span class="text-[11px] font-bold text-amber-700 mt-1 block" x-text="rating === 5 ? '5/5 • Outstanding! 🔥' : rating === 4 ? '4/5 • Very Good 👍' : rating === 3 ? '3/5 • Average 🙂' : rating === 2 ? '2/5 • Below expectations 🙁' : '1/5 • Terrible 👎'"></span>
                </div>

                <!-- Student Name -->
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Your Name & Hostel *</label>
                  <input
                    type="text"
                    x-model="studentName"
                    placeholder="e.g. Aman (Hostel 7)"
                    required
                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-amber-500 focus:bg-white transition-colors"
                  />
                </div>

                <!-- Comment -->
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Review Feedback (Optional)</label>
                  <textarea
                    x-model="comment"
                    rows="3"
                    placeholder="How was the taste, portion size, packaging or preparation speed?"
                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-amber-500 focus:bg-white transition-colors resize-none"
                  ></textarea>
                </div>

                <div class="flex gap-3 pt-2">
                  <button
                    type="button"
                    @click="showModal = false"
                    class="flex-1 py-3 border border-slate-200 text-slate-600 font-bold text-xs rounded-xl hover:bg-slate-50 transition-colors cursor-pointer"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    :disabled="loading"
                    class="flex-1 py-3 bg-amber-500 text-white font-bold text-xs rounded-xl hover:bg-amber-600 transition-colors shadow-sm disabled:opacity-50 cursor-pointer"
                    x-text="loading ? 'Submitting...' : 'Submit Review'"
                  ></button>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- 📱 Sleek Floating Glassmorphism Order Bar (Zomato/Swiggy Style) -->
    <div class="fixed bottom-0 left-0 right-0 z-40 bg-white/90 backdrop-blur-xl border-t border-slate-200/80 px-4 py-3 shadow-[0_-8px_24px_rgba(0,0,0,0.08)]">
      <div class="max-w-2xl mx-auto flex items-center gap-3">
        <!-- Call Button -->
        <a
          href={`tel:+91${vendor.phone}`}
          class="flex-1 py-3.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-2xl font-bold text-sm text-center transition-all flex items-center justify-center gap-2 active:scale-98"
          aria-label="Call stall"
        >
          <span class="text-base">📞</span>
          <span>Call</span>
        </a>

        <!-- WhatsApp Brand Button -->
        <a
          href={`https://wa.me/91${vendor.whatsapp || vendor.phone}?text=${encodeURIComponent(`Hi ${vendor.name}! I'd like to place an order from NITKKR Food.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-[2.5] py-3.5 px-5 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white rounded-2xl font-extrabold text-sm text-center transition-all flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-500/25 active:scale-98"
          aria-label="Order on WhatsApp"
        >
          <svg class="w-5 h-5 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.194 1.871.18.51-.013 1.745-.87 2.014-1.762.27-.9.07-1.653-.599-2.185C18.918 15.288 17.787 14.532 17.472 14.382z"/>
          </svg>
          <span>Order on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</Layout>