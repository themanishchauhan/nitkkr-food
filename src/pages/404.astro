---
export const prerender = false;
Astro.response.status = 404;
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found | Orandus" description="The page, stall, or dish you are looking for could not be found on Orandus.">
  <section class="min-h-[80vh] bg-gradient-to-b from-nitkkr-cream via-amber-50/30 to-white flex items-center justify-center px-4 py-16">
    <div class="max-w-md w-full text-center space-y-6">
      <div class="relative inline-block">
        <span class="text-8xl select-none" aria-hidden="true">🥣</span>
        <span class="absolute -top-2 -right-2 px-3 py-1 bg-rose-500 text-white font-black text-xs rounded-full shadow-md animate-pulse">404</span>
      </div>
      
      <div class="space-y-2">
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Looking for a late snack?</h1>
        <p class="text-slate-600 text-sm leading-relaxed max-w-sm mx-auto">
          We couldn't find this exact food stall or page around NIT Kurukshetra. It might have moved or changed timing!
        </p>
      </div>

      <div class="space-y-3 pt-2">
        <a
          href="/search"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 bg-gradient-to-r from-amber-500 to-nitkkr-orange text-white rounded-2xl font-bold text-sm hover:from-amber-600 hover:to-orange-700 shadow-md shadow-orange-500/20 active:scale-98 transition-all"
        >
          <span>🔍</span> Search Campus Food & Dishes
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-3 bg-white text-slate-700 border border-slate-200 hover:border-nitkkr-orange hover:text-nitkkr-orange rounded-2xl font-bold text-sm shadow-2xs active:scale-98 transition-all"
        >
          <span>🏠</span> Back to Homepage
        </a>
      </div>

      <p class="text-xs text-slate-400">
        Need help? Check our <a href="/contact" class="text-nitkkr-orange font-semibold hover:underline">Contact page</a> or view <a href="/how-it-works" class="text-nitkkr-orange font-semibold hover:underline">How It Works</a>.
      </p>
    </div>
  </section>
</Layout>