---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const brandName = settingsObj.site_title || settingsObj.brand_name || 'Orandus';
const customAbout = settingsObj.about_custom_text || '';
---

<Layout title={`About - ${brandName}`} description={`Learn how ${brandName} helps students discover food spots, menus, and prices across campus in one simple place.`}>
  <section class="min-h-screen bg-nitkkr-cream/60 py-10 sm:py-14 px-4">
    <div class="max-w-3xl mx-auto space-y-8">
      
      <!-- Hero Header -->
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-amber-200/80 shadow-xs space-y-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 border border-amber-200 rounded-full text-[11px] font-bold text-amber-900 uppercase tracking-wider">
          <span>🌱</span> Our Mission
        </div>
        
        <h1 class="font-display text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Finding campus food, simplified.
        </h1>

        <div class="space-y-4 text-sm sm:text-base text-slate-700 leading-relaxed pt-2">
          <p>
            Around campus, dozens of popular food spots serve students every single day — yet finding updated menus, accurate prices, and operating hours has always been harder than it needs to be.
          </p>
          <p>
            Most eateries rely purely on word-of-mouth or fragmented chat messages. Students end up guessing what is open, asking around for menu photos, or settling for whatever is closest.
          </p>
          <p class="font-semibold text-slate-900">
            We built <span class="text-nitkkr-orange">{brandName}</span> to make discovery seamless.
          </p>
          <p>
            One centralized platform to browse authentic menus, verify transparent prices, check live opening hours, and reach food spots directly. No sign-ups or downloads required — just open and explore.
          </p>
          <div class="p-4 bg-amber-50/80 rounded-2xl border border-amber-200 text-amber-950 text-xs sm:text-sm font-medium">
            ✨ <strong>Core principle:</strong> Fast, accurate, and completely free discovery for students and food lovers alike.
          </div>
        </div>
      </div>

      {customAbout && (
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-amber-200/80 shadow-xs space-y-2">
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Notice</h3>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">{customAbout}</p>
        </div>
      )}

      <!-- What We Stand For -->
      <div class="space-y-4">
        <h2 class="font-display font-bold text-xl text-slate-900">What We Stand For</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- 1: Built for Students -->
          <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-amber-100/70 border border-amber-200 flex items-center justify-center text-lg">
              🎓
            </div>
            <h3 class="font-display font-bold text-base text-slate-900">Built for Students</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              No mandatory account creation. No lengthy onboarding. Open the catalog, find the dish you crave, and place your inquiry in seconds.
            </p>
            <div class="pt-2 flex flex-wrap items-center gap-2 text-xs font-bold text-nitkkr-orange">
              <span>⚡ Instant</span>
              <span class="text-slate-300">·</span>
              <span>✨ Intuitive</span>
              <span class="text-slate-300">·</span>
              <span>🎯 Accurate</span>
            </div>
          </div>

          <!-- 2: Supporting Local Food Spots -->
          <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100/70 border border-emerald-200 flex items-center justify-center text-lg">
              🏪
            </div>
            <h3 class="font-display font-bold text-base text-slate-900">Empowering Local Vendors</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Local food spots often lack dedicated digital platforms. We provide them with free, verified digital menu listings so students can easily discover their specialties.
            </p>
            <p class="text-xs text-slate-500 italic pt-1">
              Zero listing fees. Zero commissions. 100% direct vendor support.
            </p>
          </div>

          <!-- 3: Transparent Information -->
          <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-100/70 border border-indigo-200 flex items-center justify-center text-lg">
              📋
            </div>
            <h3 class="font-display font-bold text-base text-slate-900">Transparent Pricing</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Real menu prices directly from the counter. No hidden delivery fees, inflated markups, or surprise service charges.
            </p>
            <p class="text-xs font-bold text-indigo-700 pt-1">
              🔍 Verified menu items and prices.
            </p>
          </div>

          <!-- 4: Simple Over Complex -->
          <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-rose-100/70 border border-rose-200 flex items-center justify-center text-lg">
              💡
            </div>
            <h3 class="font-display font-bold text-base text-slate-900">Simplicity First</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Great discovery does not require complicated algorithms. Clear categories, smart dietary filters, and direct contact numbers are all you need.
            </p>
            <p class="text-xs font-bold text-slate-800 pt-1">
              🤝 Focused on genuine utility.
            </p>
          </div>

        </div>
      </div>

      <!-- Quick Action Bar -->
      <div class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-3xl p-6 sm:p-8 text-white shadow-md flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="font-display font-extrabold text-lg sm:text-xl">Ready to explore?</h3>
          <p class="text-xs text-white/90">Find dishes, food spots, prices, and direct contact details.</p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/search"
            class="px-5 py-2.5 bg-white text-orange-600 hover:bg-orange-50 active:scale-95 font-bold text-xs rounded-2xl shadow-sm transition-all flex items-center gap-1.5"
          >
            <span>🔍</span>
            <span>Search Dishes</span>
          </a>
          <a
            href="/search?tab=vendors"
            class="px-5 py-2.5 bg-black/20 hover:bg-black/30 active:scale-95 text-white font-bold text-xs rounded-2xl transition-all flex items-center gap-1.5"
          >
            <span>🏪</span>
            <span>Food Spots</span>
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>