---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsObj = settings.reduce((acc, s) => { acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const customAbout = settingsObj.about_custom_text || '';
---

<Layout title="About Us - NITKKR Food" description="About NITKKR Food, built for the students of National Institute of Technology, Kurukshetra.">
  <section class="min-h-screen bg-nitkkr-cream py-12 px-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-6 sm:p-10 border border-amber-200/80 shadow-sm space-y-6">
      <div>
        <a href="/" class="text-xs text-slate-500 hover:text-nitkkr-orange mb-2 inline-block font-semibold">← Back to Home</a>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-nitkkr-dark">🍜 About NITKKR Food</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Built by students, for students at NIT Kurukshetra.</p>
      </div>

      {customAbout ? (
        <div class="p-5 bg-amber-50/80 rounded-2xl border border-amber-200 text-xs sm:text-sm text-slate-800 leading-relaxed whitespace-pre-line">
          {customAbout}
        </div>
      ) : null}

      <div class="space-y-4 text-xs sm:text-sm text-slate-700 leading-relaxed">
        <p>
          <strong>NITKKR Food</strong> was born out of a simple late-night hostel problem: <em>"Where do we order food from right now, what are the exact prices, and who delivers to Hostel 7 or DB Hall?"</em>
        </p>
        <p>
          Instead of passing around blurry paper menu photos in WhatsApp groups, NITKKR Food brings all campus eateries, night canteens, dhabas, and food stalls into one ultra-fast, mobile-friendly digital directory.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4">
          <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 text-center">
            <span class="text-2xl font-bold text-amber-900 block">20+</span>
            <span class="text-[11px] text-amber-700 font-medium">Campus Stalls</span>
          </div>
          <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 text-center">
            <span class="text-2xl font-bold text-amber-900 block">0%</span>
            <span class="text-[11px] text-amber-700 font-medium">Commission Fees</span>
          </div>
          <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 text-center">
            <span class="text-2xl font-bold text-amber-900 block">&lt; 1 sec</span>
            <span class="text-[11px] text-amber-700 font-medium">Instant Menu Search</span>
          </div>
        </div>

        <p class="pt-2">
          We believe in supporting local campus vendors while providing students with transparent prices, authentic reviews, and lightning-fast WhatsApp ordering.
        </p>
      </div>
    </div>
  </section>
</Layout>
