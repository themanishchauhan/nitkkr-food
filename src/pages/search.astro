            <button type="button" @click="query = 'paneer'; activeCat = 'all'; vibeTag = 'all'; priceBracket = 'all'; vegFilter = 'all'; vendorFilter = 'all'; displayLimit = 20;" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">🧀 Paneer</button>
