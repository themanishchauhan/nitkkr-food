---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import ReviewModal from '../components/ReviewModal.astro';
import { getCategories, getAllSiteSettings, getActiveVendors, getAllMenuItemsForSearch } from '../lib/queries';

const initialQuery = Astro.url.searchParams.get('q')?.trim() || '';
const initialCategory = Astro.url.searchParams.get('category')?.trim() || '';
const initialMaxPrice = Astro.url.searchParams.get('maxPrice')?.trim() || '';
const initialIsVeg = Astro.url.searchParams.get('isVeg')?.trim() || '';
const initialTag = Astro.url.searchParams.get('tag')?.trim() || '';
const initialTab = Astro.url.searchParams.get('tab')?.trim() || 'dishes';

const categories = await getCategories();
const initialVendors = await getActiveVendors();
const initialItems = await getAllMenuItemsForSearch();
const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const showWhatsApp = settingsObj.whatsapp_ordering_enabled === 'true' && settingsObj.show_whatsapp_button !== 'false';
---

<Layout
  title={initialQuery ? `Search: ${initialQuery} - NITKKR Food` : 'Search Food & Vendors - NITKKR Food'}
  description="Search dishes and food vendors across NIT Kurukshetra campus"
>

  <script is:inline define:vars={{ initialQuery, initialCategory, initialMaxPrice, initialIsVeg, initialTag, initialTab, showWhatsApp, initialVendors, initialItems }}>

    function normalizePhonetics(str) {
      return (str || '').toLowerCase()
        .replace(/aa/g, 'a')
        .replace(/ee/g, 'i')
        .replace(/oo/g, 'u')
        .replace(/nn/g, 'n')
        .replace(/tt/g, 't')
        .replace(/pp/g, 'p')
        .replace(/rr/g, 'r')
        .replace(/ll/g, 'l')
        .replace(/mm/g, 'm')
        .replace(/kk/g, 'k')
        .replace(/ss/g, 's')
        .replace(/zz/g, 'z')
        .replace(/ph/g, 'f')
        .replace(/bh/g, 'b')
        .replace(/dh/g, 'd')
        .replace(/th/g, 't')
        .replace(/sh/g, 's');
    }

    function levenshteinDist(a, b) {
      if (a === b) return 0;
      if (!a.length) return b.length;
      if (!b.length) return a.length;
      var matrix = [];
      for (var i = 0; i <= b.length; i++) matrix[i] = [i];
      for (var j = 0; j <= a.length; j++) matrix[0][j] = j;
      for (var i = 1; i <= b.length; i++) {
        for (var j = 1; j <= a.length; j++) {
          if (b.charAt(i - 1) === a.charAt(j - 1)) {
            matrix[i][j] = matrix[i - 1][j - 1];
          } else {
            matrix[i][j] = Math.min(matrix[i - 1][j - 1] + 1, matrix[i][j - 1] + 1, matrix[i - 1][j] + 1);
          }
        }
      }
      return matrix[b.length][a.length];
    }

    function isFuzzyTokenMatch(queryToken, targetWords, fullText) {
      if (fullText.indexOf(queryToken) !== -1) return true;

      // Check singular / plural
      if (queryToken.endsWith('s') && fullText.indexOf(queryToken.slice(0, -1)) !== -1) return true;
      if (queryToken.endsWith('es') && fullText.indexOf(queryToken.slice(0, -2)) !== -1) return true;

      var normQuery = normalizePhonetics(queryToken);

      for (var k = 0; k < targetWords.length; k++) {
        var word = targetWords[k];
        if (!word) continue;

        if (word.indexOf(queryToken) !== -1 || queryToken.indexOf(word) !== -1) return true;

        var normWord = normalizePhonetics(word);
        if (normWord.indexOf(normQuery) !== -1 || normQuery.indexOf(normWord) !== -1) return true;

        if (queryToken.length >= 4 && Math.abs(queryToken.length - word.length) <= 2) {
          var maxAllowedDist = queryToken.length > 5 ? 2 : 1;
          if (levenshteinDist(queryToken, word) <= maxAllowedDist) return true;
          if (levenshteinDist(normQuery, normWord) <= maxAllowedDist) return true;
        }
      }

      return false;
    }

    window.searchPage = function() {
      return {
        activeTab: (initialTab === 'stalls' || initialTab === 'vendors') ? 'vendors' : 'dishes',
        query: initialQuery,
        activeCat: initialCategory || 'all',
        vibeTag: initialTag || 'all',
        priceBracket: initialMaxPrice ? (initialMaxPrice === '50' ? 'under-50' : (initialMaxPrice === '100' ? '50-100' : (initialMaxPrice === '150' ? '100-150' : (initialMaxPrice === '150+' ? 'above-150' : initialMaxPrice)))) : 'all',
        vegFilter: initialIsVeg === 'true' ? 'veg' : ((initialIsVeg === 'false' || initialIsVeg === 'nonveg' || initialIsVeg === 'non-veg') ? 'nonveg' : 'all'),
        vendorFilter: 'all',
        displayLimit: 20,
        expandedVendors: {},
        allVendors: Array.isArray(initialVendors) ? initialVendors : [],
        allItems: Array.isArray(initialItems) ? initialItems : [],
        selectedItem: null,
        showDetailModal: false,
        formatCount(count) {
          var num = Number(count) || 0;
          return num > 99 ? '99+' : String(num);
        },
        toggleVendorExpand(vendorName) {
          this.expandedVendors[vendorName] = !this.expandedVendors[vendorName];
        },
        loadMore() {
          this.displayLimit += 20;
        },
        openDetail(item) {
          this.selectedItem = item;
          this.showDetailModal = true;
        },
        switchTab(tab) {
          this.activeTab = tab;
          try {
            var url = new URL(window.location.href);
            if (tab === 'vendors') {
              url.searchParams.set('tab', 'vendors');
            } else {
              url.searchParams.delete('tab');
            }
            window.history.replaceState(null, '', url.toString());
          } catch (e) {}
        },

        getTelHref(phone) {
          if (!phone) return '#';
          var digits = String(phone).replace(/[^0-9]/g, '');
          if (digits.length === 10) return 'tel:+91' + digits;
          if (digits.length > 10 && digits.startsWith('91')) return 'tel:+' + digits;
          return 'tel:+91' + digits.slice(-10);
        },
        getWhatsAppHref(phone) {
          if (!phone) return '#';
          var digits = String(phone).replace(/[^0-9]/g, '');
          var full = digits.length === 10 ? '91' + digits : (digits.startsWith('91') ? digits : '91' + digits.slice(-10));
          return 'https://wa.me/' + full;
        },

        async init() {
          window.addEventListener('review-updated', (e) => {
            const { menuItemId, rating } = e.detail || {};
            if (!menuItemId) return;
            const target = this.allItems.find(i => Number(i.id) === Number(menuItemId));
            if (target) {
              const currentCount = Number(target.reviewCount) || 0;
              const currentAvg = Number(target.avgRating) || Number(rating) || 5;
              const newCount = currentCount + 1;
              const newAvg = ((currentAvg * currentCount + Number(rating)) / newCount).toFixed(1);
              target.reviewCount = newCount;
              target.avgRating = newAvg;
              if (this.selectedItem && Number(this.selectedItem.id) === Number(menuItemId)) {
                this.selectedItem.reviewCount = newCount;
                this.selectedItem.avgRating = newAvg;
              }
            }
          });

          if (this.allItems.length === 0 || this.allVendors.length === 0) {
            try {
              const res = await fetch('/api/search.json?limit=250');
              if (res.ok) {
                const data = await res.json();
                const items = data.hits || data.results || [];
                if (items.length > 0) {
                  this.allItems = items;
                }
              }
            } catch (e) {}
          }
        },


        get matchingVendor() {
          if (!this.query.trim()) return null;
          var q = this.query.trim().toLowerCase();
          var matches = this.filteredVendors;
          for (var i = 0; i < matches.length; i++) {
            var v = matches[i];
            if (v.name && v.name.toLowerCase().includes(q)) return v;
          }
          return null;
        },


        isVendorOpen(opensAt, closesAt) {
          if (!opensAt || !closesAt) return true;
          try {
            var istFormatter = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: false });
            var parts = istFormatter.format(new Date()).split(':');
            var curTotal = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
            var oParts = opensAt.split(':');
            var cParts = closesAt.split(':');
            var openTotal = parseInt(oParts[0], 10) * 60 + parseInt(oParts[1], 10);
            var closeTotal = parseInt(cParts[0], 10) * 60 + parseInt(cParts[1], 10);
            if (openTotal < closeTotal) return curTotal >= openTotal && curTotal < closeTotal;
            if (openTotal > closeTotal) return curTotal >= openTotal || curTotal < closeTotal;
            return true;
          } catch (e) {
            return true;
          }
        },


        getVendorMatchCount(vendorId) {
          if (!vendorId) return 0;
          return this.filteredItems.filter(function(i) {
            return i.vendorId === vendorId || i.stallId === vendorId;
          }).length;
        },

        get filteredVendors() {
          var matchingItemVendorIds = new Set();
          var matchedItems = this.filteredItems;
          for (var j = 0; j < matchedItems.length; j++) {
            var itm = matchedItems[j];
            if (itm.vendorId) matchingItemVendorIds.add(itm.vendorId);
            if (itm.stallId) matchingItemVendorIds.add(itm.stallId);
          }

          var vList = this.allVendors;

          if (this.query.trim()) {
            var rawQuery = this.query.toLowerCase().trim();
            var tokens = rawQuery.split(/\s+/).filter(Boolean);

            return vList.filter(function(v) {
              var nameLower = (v.name || '').toLowerCase();
              var addrLower = (v.address || '').toLowerCase();
              var descLower = (v.description || '').toLowerCase();
              var full = nameLower + ' ' + addrLower + ' ' + descLower;
              var words = full.split(/[\s,()\/+-]+/).filter(Boolean);

              var directMatch = tokens.every(function(t) {
                return isFuzzyTokenMatch(t, words, full);
              });

              var hasMatchingItems = matchingItemVendorIds.has(v.id);

              return directMatch || hasMatchingItems;
            });
          }

          return vList;
        },


        get matchingStall() {
          if (!this.query.trim()) return null;
          var matches = this.filteredVendors;
          return matches.length > 0 ? matches[0] : null;
        },

        get filteredItems() {
          var list = this.allItems;

          // 1. Category Filter
          if (this.activeCat && this.activeCat !== 'all') {
            var catSlug = this.activeCat.toLowerCase();
            list = list.filter(function(i) {
              return (i.categorySlug && i.categorySlug.toLowerCase() === catSlug) ||
                     (i.categoryName && i.categoryName.toLowerCase() === catSlug);
            });
          }

          // 2. Gen-Z Lifestyle & Vibe Filter
          if (this.vibeTag && this.vibeTag !== 'all') {
            var vibe = this.vibeTag.toLowerCase();
            list = list.filter(function(i) {
              var nameLower = (i.name || '').toLowerCase();
              var descLower = (i.description || '').toLowerCase();
              var rawTags = Array.isArray(i.tags) ? i.tags : (typeof i.tags === 'string' ? [i.tags] : []);
              var tags = rawTags.map(function(t) { return String(t).toLowerCase(); });
              var full = nameLower + ' ' + descLower + ' ' + tags.join(' ');

              if (vibe === 'protein') {
                return tags.indexOf('protein') !== -1 || tags.indexOf('gym') !== -1 || tags.indexOf('fitness') !== -1 ||
                       /paneer|egg|chicken|soya|bhurji|protein|whey|chana|tofu|peanut/i.test(full);
              }
              if (vibe === 'late-night') {
                return tags.indexOf('late-night') !== -1 || tags.indexOf('midnight') !== -1 || tags.indexOf('snack') !== -1 ||
                       /maggi|roll|fries|sandwich|canteen|coffee|tea|burger/i.test(full);
              }
              if (vibe === 'spicy') {
                return tags.indexOf('spicy') !== -1 || tags.indexOf('crispy') !== -1 || tags.indexOf('hot') !== -1 ||
                       /spicy|peri|schezwan|chilli|momo|kurkure|crispy|tandoori/i.test(full);
              }
              if (vibe === 'cheese') {
                return tags.indexOf('cheese') !== -1 || tags.indexOf('cheesy') !== -1 || tags.indexOf('cheat-meal') !== -1 ||
                       /cheese|cheesy|mozzarella|pizza|loaded|garlic bread|pasta/i.test(full);
              }
              if (vibe === 'shakes') {
                return (i.categorySlug && i.categorySlug.indexOf('beverage') !== -1) ||
                       /shake|smoothie|coffee|cold coffee|boba|oreo|kitkat|mojito/i.test(full);
              }
              if (vibe === 'healthy') {
                return tags.indexOf('healthy') !== -1 || tags.indexOf('fresh') !== -1 ||
                       /juice|fruit|salad|sprouts|green tea|coconut|curd/i.test(full);
              }
              if (vibe === 'bestseller') {
                return tags.indexOf('bestseller') !== -1 || tags.indexOf('popular') !== -1 || tags.indexOf('top-rated') !== -1 || tags.indexOf('chef-special') !== -1;
              }
              return tags.indexOf(vibe) !== -1 || full.indexOf(vibe) !== -1;
            });
          }

          // 3. Smart Mutual Price Brackets
          if (this.priceBracket && this.priceBracket !== 'all') {
            var b = this.priceBracket;
            list = list.filter(function(i) {
              var p = Number(i.price);
              if (isNaN(p)) return false;
              if (b === 'under-50' || b === '50') return p <= 50;
              if (b === '50-100' || b === '100') return p > 50 && p <= 100;
              if (b === '100-150' || b === '150') return p > 100 && p <= 150;
              if (b === 'above-150' || b === '150+') return p > 150;
              return true;
            });
          }

          // 4. Diet Filter
          if (this.vegFilter === 'veg') {
            list = list.filter(function(i) { return i.isVeg === true || i.isVeg === 1; });
          } else if (this.vegFilter === 'nonveg' || this.vegFilter === 'non-veg') {
            list = list.filter(function(i) { return !i.isVeg; });
          }

          // 4.5. Eatery / Vendor Filter
          if (this.vendorFilter && this.vendorFilter !== 'all') {
            var vFilter = this.vendorFilter.toLowerCase();
            list = list.filter(function(i) {
              var vSlug = (i.vendorSlug || '').toLowerCase();
              var vName = (i.vendorName || '').toLowerCase();
              return vSlug === vFilter || vName === vFilter || String(i.vendorId) === vFilter;
            });
          }

          // 5. Keyword & Typo-Tolerant Search
          if (!this.query.trim()) {
            return list;
          }

          var rawQuery = this.query.toLowerCase().trim();
          var tokens = rawQuery.split(/\s+/).filter(Boolean);

          return list
            .map(function(item) {
              var nameLower = (item.name || '').toLowerCase();
              var descLower = (item.description || '').toLowerCase();
              var vendorLower = (item.vendorName || '').toLowerCase();
              var categoryLower = (item.categoryName || '').toLowerCase();
              var rawItemTags = Array.isArray(item.tags) ? item.tags : (typeof item.tags === 'string' ? [item.tags] : []);
              var tagsText = rawItemTags.join(' ').toLowerCase();
              var fullSearchText = nameLower + ' ' + descLower + ' ' + vendorLower + ' ' + categoryLower + ' ' + tagsText;

              var targetWords = fullSearchText.split(/[\s,()\/+-]+/).filter(Boolean);

              var allTokensMatch = tokens.every(function(token) {
                return isFuzzyTokenMatch(token, targetWords, fullSearchText);
              });

              if (!allTokensMatch) return null;

              var score = 0;
              if (nameLower === rawQuery) score += 100;
              else if (nameLower.indexOf(rawQuery) === 0) score += 50;
              else if (nameLower.indexOf(rawQuery) !== -1) score += 30;

              tokens.forEach(function(token) {
                if (nameLower.indexOf(token) !== -1) score += 15;
                if (tagsText.indexOf(token) !== -1) score += 8;
                if (vendorLower.indexOf(token) !== -1) score += 5;
                if (descLower.indexOf(token) !== -1) score += 2;
              });

              return { item: item, score: score };
            })
            .filter(Boolean)
            .sort(function(a, b) { return b.score - a.score; })
            .map(function(entry) { return entry.item; });
        },

        get visibleItems() {
          return this.filteredItems.slice(0, this.displayLimit);
        },

        get activeVendorsInSearch() {
          var counts = {};
          var list = this.filteredItems;
          var vList = [];
          for (var i = 0; i < list.length; i++) {
            var itm = list[i];
            var vName = itm.vendorName || 'Campus Eatery';
            var vSlug = itm.vendorSlug || itm.vendorName || '';
            if (!counts[vName]) {
              counts[vName] = { name: vName, slug: vSlug, vendorId: itm.vendorId, count: 0 };
              vList.push(counts[vName]);
            }
            counts[vName].count++;
          }
          return vList;
        },

        get isMultiVendor() {
          return this.activeVendorsInSearch.length > 1 && this.vendorFilter === 'all';
        },

        get groupedDishesByVendor() {
          var grouped = [];
          var map = {};
          var list = this.filteredItems;
          for (var k = 0; k < list.length; k++) {
            var itm = list[k];
            var vName = itm.vendorName || 'Campus Eatery';
            if (!map[vName]) {
              map[vName] = {
                name: vName,
                slug: itm.vendorSlug || '',
                vendorId: itm.vendorId,
                address: itm.vendorAddress || 'NIT Kurukshetra Campus',
                items: []
              };
              grouped.push(map[vName]);
            }
            map[vName].items.push(itm);
          }
          return grouped;
        }
      };
    };
  </script>

  <section
    x-data="searchPage()"
    x-init="init()"
    class="min-h-screen bg-bistro-50 pb-20"
  >

    <div class="max-w-2xl mx-auto px-4 py-8">
      <div class="mb-5">
        <a href="/" class="inline-flex items-center gap-2 text-nitkkr-gray hover:text-bistro-600 transition-colors mb-4 text-sm font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Home
        </a>

        <!-- Live Search Input -->
        <div class="relative w-full">
          <input
            type="search"
            x-model="query"
            @keydown.enter="$el.blur()"
            @search="$el.blur()"
            placeholder="Search food vendors (Food Cave) or dishes (paratha, noodles, maggi)..."
            class="w-full px-5 py-4 pr-12 text-lg bg-white border-2 border-bistro-200 rounded-2xl
                   hover:border-bistro-400 focus:border-bistro-500 focus:outline-none focus:ring-4 focus:ring-bistro-500/10
                   shadow-sm transition-all duration-200"
            enterkeyhint="search"
          />
          <button
            type="button"
            @click="document.querySelector('input[type=search]')?.blur()"
            class="absolute right-3 top-1/2 -translate-y-1/2 p-2 text-bistro-500 hover:scale-110 transition-transform cursor-pointer"
            aria-label="Search"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>


        <!-- Tab Switcher: Dishes vs Vendors -->
        <div class="flex gap-2 mt-3 bg-white p-1.5 rounded-2xl border border-bistro-200/80 shadow-2xs">
          <button
            type="button"
            @click="switchTab('dishes')"
            :class="activeTab === 'dishes' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'text-slate-700 hover:bg-bistro-50 font-semibold'"
            class="flex-1 py-2 rounded-xl text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>🍱</span>
            <span>Dishes</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px]" :class="activeTab === 'dishes' ? 'bg-white/20 text-white' : 'bg-bistro-100 text-bistro-600'" x-text="formatCount(filteredItems.length)"></span>
          </button>
          <button
            type="button"
            @click="switchTab('vendors')"
            :class="activeTab === 'vendors' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'text-slate-700 hover:bg-bistro-50 font-semibold'"
            class="flex-1 py-2 rounded-xl text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>🏪</span>
            <span>Campus Vendors</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px]" :class="activeTab === 'vendors' ? 'bg-white/20 text-white' : 'bg-bistro-100 text-bistro-600'" x-text="formatCount(filteredVendors.length)"></span>
          </button>
        </div>

        <!-- Filter Controls for Dishes tab (Restored & Cleaned Up) -->
        <div x-show="activeTab === 'dishes'" class="mt-3 space-y-2.5">
          
          <!-- 0. Multi-Vendor Fast Selector (when dishes come from multiple stalls) -->
          <template x-if="activeVendorsInSearch.length > 1">
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block px-0.5">🏪 Campus Eateries:</span>
              <div class="flex gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs">
                <button
                  type="button"
                  @click="vendorFilter = 'all'; displayLimit = 20;"
                  :class="vendorFilter === 'all' ? 'bg-slate-900 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-slate-400 font-semibold'"
                  class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-all cursor-pointer text-xs"
                >
                  All Eateries (<span x-text="formatCount(allItems.length)"></span>)
                </button>
                <template x-for="v in activeVendorsInSearch" :key="v.name">
                  <button
                    type="button"
                    @click="vendorFilter = (vendorFilter === v.slug ? 'all' : v.slug); displayLimit = 20;"
                    :class="vendorFilter === v.slug ? 'bg-nitkkr-orange text-white border-nitkkr-orange font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-nitkkr-orange font-semibold'"
                    class="px-2.5 py-1 rounded-xl border whitespace-nowrap transition-all cursor-pointer text-xs flex items-center gap-1"
                  >
                    <span>🏪</span>
                    <span x-text="v.name"></span>
                    <span class="text-[10px] opacity-80" x-text="`(${formatCount(v.count)})`"></span>
                  </button>
                </template>
              </div>
            </div>
          </template>

          <!-- 1. Gen-Z Cravings & Lifestyle Vibe Bar -->
          <div class="space-y-1">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block px-0.5">🔥 Student Cravings & Vibes:</span>
            <div class="flex gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs" role="group" aria-label="Filter by vibe">
              <button
                type="button"
                @click="vibeTag = 'all'; displayLimit = 20;"
                :class="vibeTag === 'all' ? 'bg-slate-900 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-amber-400 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-all cursor-pointer text-xs"
              >
                All Vibes
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'protein' ? 'all' : 'protein'); displayLimit = 20;"
                :class="vibeTag === 'protein' ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-amber-200 hover:bg-amber-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-all cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🏋️‍♂️</span> High Protein
              </button>
              <button
