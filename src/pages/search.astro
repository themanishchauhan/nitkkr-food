---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import ReviewModal from '../components/ReviewModal.astro';
import { getCategories, getAllSiteSettings, getActiveVendors, getAllMenuItemsForSearch } from '../lib/queries';

const initialQuery = Astro.url.searchParams.get('q')?.trim() || '';
const initialCategory = Astro.url.searchParams.get('category')?.trim() || '';
const initialMaxPrice = Astro.url.searchParams.get('maxPrice')?.trim() || '';
const initialIsVeg = Astro.url.searchParams.get('isVeg')?.trim() || '';
const initialTag = Astro.url.searchParams.get('tag')?.trim() || '';
const initialTab = Astro.url.searchParams.get('tab')?.trim() || 'dishes';

const [categories, initialVendors, allSearchItems, settings] = await Promise.all([
  getCategories(),
  getActiveVendors(),
  getAllMenuItemsForSearch(),
  getAllSiteSettings(),
]);
const initialItems = initialQuery
  ? allSearchItems.filter((i: any) => i.name.toLowerCase().includes(initialQuery.toLowerCase()) || (Array.isArray(i.tags) && i.tags.join(' ').toLowerCase().includes(initialQuery.toLowerCase()))).slice(0, 40)
  : allSearchItems.slice(0, 30);
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const showWhatsApp = settingsObj.whatsapp_ordering_enabled === 'true' && settingsObj.show_whatsapp_button !== 'false';
---

<Layout
  title={initialQuery ? `Search: ${initialQuery} - Orandus` : 'Search Food & Menus - Orandus'}
  description="Find campus food, menus and prices in seconds."
>

  <script is:inline src="/scripts/search-engine.js"></script>
  <script is:inline define:vars={{ initialQuery, initialCategory, initialMaxPrice, initialIsVeg, initialTag, initialTab, showWhatsApp, initialVendors, initialItems }}>
    window.__SEARCH_CONFIG__ = { initialQuery, initialCategory, initialMaxPrice, initialIsVeg, initialTag, initialTab, showWhatsApp, initialVendors, initialItems };
  </script>

  <section
    x-data="searchPage(window.__SEARCH_CONFIG__)"
    x-init="init()"
    class="min-h-screen bg-bistro-50 pb-20"
  >

    <div class="max-w-2xl mx-auto px-4 py-8">
      <div class="mb-5">
        <!-- Live Search Input -->
        <div class="relative w-full">
          <input
            type="search"
            x-model.debounce.150ms="query"
            @keydown.enter="$el.blur()"
            @search="$el.blur()"
            placeholder="Search food spots (Food Cave) or dishes (paratha, noodles, maggi)..."
            class="w-full px-5 py-4 pr-20 text-lg bg-white border-2 border-bistro-200 rounded-2xl
                   hover:border-bistro-400 focus:border-bistro-500 focus:outline-none focus:ring-4 focus:ring-bistro-500/10
                   shadow-sm transition-all duration-200"
            enterkeyhint="search"
          />

          <!-- Clear Query Button (shows when query is present) -->
          <button
            type="button"
            x-show="query"
            @click="query = ''; syncUrl();"
            class="absolute right-12 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-slate-600 transition-colors cursor-pointer"
            aria-label="Clear search"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <button
            type="button"
            @click="document.querySelector('input[type=search]')?.blur()"
            class="absolute right-3 top-1/2 -translate-y-1/2 p-2 text-bistro-500 hover:scale-110 transition-transform cursor-pointer"
            aria-label="Search"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>


        <!-- Tab Switcher: Dishes vs Vendors -->
        <div class="flex gap-2 mt-3 bg-white p-1.5 rounded-2xl border border-bistro-200/80 shadow-2xs">
          <button
            type="button"
            @click="switchTab('dishes')"
            :class="activeTab === 'dishes' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'text-slate-700 hover:bg-bistro-50 font-semibold'"
            class="flex-1 py-2 rounded-xl text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>🍱</span>
            <span>Dishes</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px]" :class="activeTab === 'dishes' ? 'bg-white/20 text-white' : 'bg-bistro-100 text-bistro-600'" x-text="formatCount(filteredItems.length)"></span>
          </button>
          <button
            type="button"
            @click="switchTab('vendors')"
            :class="activeTab === 'vendors' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'text-slate-700 hover:bg-bistro-50 font-semibold'"
            class="flex-1 py-2 rounded-xl text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>🏪</span>
            <span>Food Spots</span>
            <span class="px-1.5 py-0.5 rounded-full text-[10px]" :class="activeTab === 'vendors' ? 'bg-white/20 text-white' : 'bg-bistro-100 text-bistro-600'" x-text="formatCount(filteredVendors.length)"></span>
          </button>
        </div>

        <!-- Filter Controls for Dishes tab -->
        <div x-show="activeTab === 'dishes'" class="mt-3 space-y-2.5">
          
          <!-- 1. Gen-Z Cravings & Lifestyle Vibe Bar -->
          <div class="space-y-1">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block px-0.5">🔥 Student Cravings & Vibes:</span>
            <div class="flex gap-1.5 overflow-x-auto pb-1 scrollbar-none overscroll-x-contain touch-pan-x text-xs" role="group" aria-label="Filter by vibe">
              <button
                type="button"
                @click="vibeTag = 'all'; displayLimit = 20;"
                :class="vibeTag === 'all' ? 'bg-slate-900 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-amber-400 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
              >
                All Vibes
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'protein' ? 'all' : 'protein'); displayLimit = 20;"
                :class="vibeTag === 'protein' ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-amber-200 hover:bg-amber-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🏋️‍♂️</span> High Protein
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'late-night' ? 'all' : 'late-night'); displayLimit = 20;"
                :class="vibeTag === 'late-night' ? 'bg-indigo-600 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-indigo-200 hover:bg-indigo-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🌙</span> Late Night 2AM
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'spicy' ? 'all' : 'spicy'); displayLimit = 20;"
                :class="vibeTag === 'spicy' ? 'bg-rose-600 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-rose-200 hover:bg-rose-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🔥</span> Spicy & Crispy
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'cheese' ? 'all' : 'cheese'); displayLimit = 20;"
                :class="vibeTag === 'cheese' ? 'bg-yellow-500 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-yellow-200 hover:bg-yellow-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🧀</span> Cheesy Loaded
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'shakes' ? 'all' : 'shakes'); displayLimit = 20;"
                :class="vibeTag === 'shakes' ? 'bg-purple-600 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-purple-200 hover:bg-purple-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🧋</span> Thick Shakes
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'bestseller' ? 'all' : 'bestseller'); displayLimit = 20;"
                :class="vibeTag === 'bestseller' ? 'bg-emerald-600 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-emerald-200 hover:bg-emerald-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>⭐</span> Top Rated
              </button>
              <button
                type="button"
                @click="vibeTag = (vibeTag === 'healthy' ? 'all' : 'healthy'); displayLimit = 20;"
                :class="vibeTag === 'healthy' ? 'bg-teal-600 text-white font-bold shadow-xs' : 'bg-white text-slate-800 border border-teal-200 hover:bg-teal-50 font-semibold'"
                class="px-2.5 py-1 rounded-xl whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
              >
                <span>🥑</span> Healthy & Fresh
              </button>
            </div>
          </div>

          <!-- 2. Smart Distinct Price Brackets & Diet Bar -->
          <div class="flex flex-wrap items-center justify-between gap-1.5 text-xs pt-1.5 border-t border-slate-200/60">
            <div class="flex items-center gap-1 flex-wrap">
              <span class="font-semibold text-slate-500 mr-1 text-[11px]">💰 Budget:</span>
              <button
                type="button"
                @click="priceBracket = 'all'; displayLimit = 20;"
                :class="priceBracket === 'all' ? 'bg-bistro-500 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
                class="px-2 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
              >
                Any
              </button>
              <button
                type="button"
                @click="priceBracket = (priceBracket === 'under-50' ? 'all' : 'under-50'); displayLimit = 20;"
                :class="priceBracket === 'under-50' ? 'bg-bistro-500 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
                class="px-2 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
                title="Pocket friendly: ₹10 - ₹50"
              >
                ≤ ₹50
              </button>
              <button
                type="button"
                @click="priceBracket = (priceBracket === '50-100' ? 'all' : '50-100'); displayLimit = 20;"
                :class="priceBracket === '50-100' ? 'bg-bistro-500 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
                class="px-2 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
                title="Quick Meals: ₹51 - ₹100"
              >
                ₹50 – ₹100
              </button>
              <button
                type="button"
                @click="priceBracket = (priceBracket === '100-150' ? 'all' : '100-150'); displayLimit = 20;"
                :class="priceBracket === '100-150' ? 'bg-bistro-500 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
                class="px-2 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
                title="Combos & Thalis: ₹101 - ₹150"
              >
                ₹100 – ₹150
              </button>
              <button
                type="button"
                @click="priceBracket = (priceBracket === 'above-150' ? 'all' : 'above-150'); displayLimit = 20;"
                :class="priceBracket === 'above-150' ? 'bg-bistro-500 text-white font-bold shadow-xs' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
                class="px-2 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer text-xs"
                title="Platters & Treats: > ₹150"
              >
                ₹150+
              </button>
            </div>

            <!-- 3 Dietary Preference Sections: Veg, Non-Veg, Eggs (Subtle, refined colors) -->
            <div class="flex items-center gap-1 flex-wrap">
              <button
                type="button"
                @click="vegFilter = (vegFilter === 'veg' ? 'all' : 'veg'); displayLimit = 20;"
                :class="vegFilter === 'veg' ? 'bg-emerald-700 text-white shadow-xs font-bold' : 'bg-emerald-50/80 text-emerald-800 border border-emerald-300/80 hover:bg-emerald-100 font-semibold'"
                class="px-2.5 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
                title="Filter Pure Veg dishes"
              >
                <span>🌱</span> Veg
              </button>
              <button
                type="button"
                @click="vegFilter = (vegFilter === 'egg' ? 'all' : 'egg'); displayLimit = 20;"
                :class="vegFilter === 'egg' ? 'bg-amber-600 text-white shadow-xs font-bold' : 'bg-amber-50/80 text-amber-900 border border-amber-300/80 hover:bg-amber-100 font-semibold'"
                class="px-2.5 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
                title="Filter dishes with Egg"
              >
                <span>🥚</span> Eggs
              </button>
              <button
                type="button"
                @click="vegFilter = (vegFilter === 'nonveg' ? 'all' : 'nonveg'); displayLimit = 20;"
                :class="vegFilter === 'nonveg' ? 'bg-rose-700 text-white shadow-xs font-bold' : 'bg-rose-50/80 text-rose-800 border border-rose-300/80 hover:bg-rose-100 font-semibold'"
                class="px-2.5 py-0.5 rounded-lg transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1 text-xs"
                title="Filter Non-Veg dishes"
              >
                <span>🍗</span> Non-Veg
              </button>
            </div>
          </div>
        </div>

        <!-- 3. Result counter and reset button -->
        <p class="mt-2.5 text-xs font-semibold text-nitkkr-gray flex items-center justify-between px-0.5">
          <span x-show="activeTab === 'dishes'" x-text="`Found ${formatCount(filteredItems.length)} dish${filteredItems.length === 1 ? '' : 'es'}`"></span>
          <span x-show="activeTab === 'vendors'" x-text="`Found ${formatCount(filteredVendors.length)} food spot${filteredVendors.length === 1 ? '' : 's'}`"></span>
          <button
            x-show="query || activeCat !== 'all' || vibeTag !== 'all' || priceBracket !== 'all' || vegFilter !== 'all'"
            @click="resetAllFilters()"
            class="text-bistro-600 hover:underline font-bold cursor-pointer text-xs"
          >
            Reset Filters
          </button>
        </p>
      </div>

      <!-- 4. Category Filter Pills (for Dishes) -->
      {categories.length > 0 && (
        <div x-show="activeTab === 'dishes'" class="mb-4">
          <div class="flex gap-1.5 overflow-x-auto pb-1 px-4 sm:px-0 scrollbar-none overscroll-x-contain touch-pan-x" role="group" aria-label="Filter by category">
            <button
              type="button"
              @click="activeCat = 'all'; displayLimit = 20;"
              :class="activeCat === 'all' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'"
              class="px-3 py-1 rounded-xl text-xs whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer"
            >
              All Categories
            </button>
            {categories.map((cat: any) => (
              <button
                type="button"
                @click={`activeCat = (activeCat === '${cat.slug}' ? 'all' : '${cat.slug}'); displayLimit = 20;`}
                :class={`activeCat === '${cat.slug}' ? 'bg-bistro-500 text-white shadow-xs font-bold' : 'bg-white text-slate-700 border border-slate-200 hover:border-bistro-400 font-semibold'`}
                class="px-3 py-1 rounded-xl text-xs whitespace-nowrap transition-colors duration-150 active:scale-95 cursor-pointer flex items-center gap-1"
              >
                <span aria-hidden="true">{cat.icon}</span>
                <span>{cat.name}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- ================= 🏪 VENDORS VIEW ================= -->
      <div x-show="activeTab === 'vendors'" class="space-y-3" role="list">
        <template x-for="vendor in filteredVendors" :key="vendor.id">
          <div
            class="p-3.5 sm:p-4 rounded-2xl border transition-all duration-200 flex flex-col gap-2.5 group"
            :class="isVendorOpen(vendor.opensAt, vendor.closesAt)
              ? 'bg-white border-slate-200/90 hover:border-bistro-400 shadow-2xs hover:shadow-md'
              : 'bg-slate-50/70 border-slate-200 opacity-75 grayscale-[40%] hover:grayscale-0 hover:opacity-100'"
          >
            <!-- Top Content Row: Thumbnail + Info + Closed Badge (Only when closed) -->
            <div class="flex items-start gap-3 sm:gap-3.5 min-w-0">
              <!-- Vendor Thumbnail -->
              <a :href="`/v/${vendor.slug}`" class="relative w-16 h-16 sm:w-18 sm:h-18 rounded-2xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-100 shadow-2xs block">
                <img
                  :src="getThumbnailUrl(vendor.image, 160)"
                  alt=""
                  width="72"
                  height="72"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  :class="!isVendorOpen(vendor.opensAt, vendor.closesAt) ? 'grayscale opacity-80' : ''"
                  loading="lazy"
                  decoding="async"
                />
              </a>

              <!-- Vendor Text Information -->
              <div class="flex-1 min-w-0">
                <!-- Header: Vendor Name (truncated) + Top-Right Closed Badge (when closed) -->
                <div class="flex items-start justify-between gap-2 w-full">
                  <a :href="`/v/${vendor.slug}`" class="min-w-0 flex-1">
                    <h3
                      class="font-display font-bold text-sm sm:text-base truncate transition-colors"
                      :class="isVendorOpen(vendor.opensAt, vendor.closesAt) ? 'text-slate-900 group-hover:text-bistro-600' : 'text-slate-600'"
                      x-text="vendor.name"
                    ></h3>
                  </a>
                  
                  <!-- Show Closed Badge ONLY when restaurant is closed -->
                  <template x-if="!isVendorOpen(vendor.opensAt, vendor.closesAt)">
                    <div class="flex-shrink-0">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] sm:text-[11px] font-semibold bg-slate-200/80 text-slate-600 border border-slate-300/70 whitespace-nowrap shadow-2xs">
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                        <span>Closed</span>
                      </span>
                    </div>
                  </template>
                </div>

                <!-- Address -->
                <p class="text-xs text-slate-500 mt-1 flex items-center gap-1.5 truncate">
                  <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="truncate" x-text="vendor.address || 'Campus Area'"></span>
                </p>

                <!-- Search Matching Badge if applicable -->
                <template x-if="query.trim() ? (getVendorMatchCount(vendor.id) > 0) : false">
                  <div class="mt-1">
                    <span class="text-[10px] font-bold text-amber-800 bg-amber-50/80 border border-amber-200/80 px-2 py-0.5 rounded-md inline-flex items-center gap-1">
                      <span>✨</span>
                      <span x-text="formatCount(getVendorMatchCount(vendor.id)) + ' matching items'"></span>
                    </span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Bottom Row: Dynamic Timing on Left, Actions (Call, WhatsApp, Shortened Menu) on Right -->
            <div class="flex items-center justify-between gap-2 pt-2 border-t border-slate-100/90 w-full flex-wrap sm:flex-nowrap">
              <!-- Dynamic Timing Status Pill Badge (Matches visual pill styling from vendor header) -->
              <!-- Dynamic Timing Status Pill Badge (Matches visual pill styling from vendor header) -->
              <div class="flex items-center min-w-0">
                <span
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border shadow-2xs whitespace-nowrap"
                  :class="getVendorTimingBadgeClass(vendor)"
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                    :class="getVendorTimingDotClass(vendor)"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="truncate"
                    x-text="getVendorTimingText(vendor)"
                  >Open Today</span>
                </span>
              </div>

              <!-- Actions Group -->
              <div class="flex items-center gap-1.5 flex-shrink-0 ml-auto">
                <!-- Shortened Call Icon Button -->
                <a
                  :href="getTelHref(vendor.phone)"
                  class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all active:scale-95 shadow-2xs cursor-pointer border border-slate-200/60"
                  aria-label="Call vendor"
                  title="Call"
                >
                  <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </a>

                <!-- WhatsApp Icon Button -->
                <template x-if="showWhatsApp">
                  <a
                    :href="getWhatsAppHref(vendor.whatsapp || vendor.phone)"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/80 flex items-center justify-center transition-all active:scale-95 shadow-2xs cursor-pointer"
                    aria-label="WhatsApp vendor"
                    title="WhatsApp"
                  >
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                    </svg>
                  </a>
                </template>

                <!-- Shortened, Tasteful "Menu" CTA Button -->
                <a
                  :href="`/v/${vendor.slug}`"
                  class="px-3 py-1.5 sm:py-2 bg-gradient-to-r from-amber-500 to-bistro-500 hover:from-amber-600 hover:to-bistro-600 text-white rounded-xl text-xs font-bold transition-all shadow-2xs hover:shadow-xs active:scale-95 flex items-center gap-1 cursor-pointer"
                >
                  <span>Menu</span>
                  <svg class="w-3.5 h-3.5 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </template>

        <div x-show="filteredVendors.length === 0" class="text-center py-16 text-nitkkr-gray bg-white rounded-2xl border border-bistro-200 p-8">
          <p class="text-3xl mb-2">🏪</p>
          <p class="text-lg font-bold text-nitkkr-dark">No food spots found</p>
          <p class="text-xs text-nitkkr-gray mt-1">Try searching for a different food spot name or location.</p>
        </div>
      </div>

      <!-- ================= 🍱 DISHES VIEW ================= -->
      <div x-show="activeTab === 'dishes'" class="space-y-4" role="list" aria-label="Search results">
        
        <!-- Highlighted Matching Vendor Banner if query matches a vendor -->
        <template x-if="matchingVendor">
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 flex items-center justify-between gap-3 mb-2 shadow-xs">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-2xl">🏪</span>
              <div class="min-w-0">
                <p class="text-xs text-amber-800 font-semibold">Matching Food Spot</p>
                <h4 class="font-bold text-sm text-nitkkr-dark truncate" x-text="matchingVendor.name"></h4>
                <div class="flex items-center gap-2 flex-wrap mt-1">
                  <span
                    class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold border shadow-2xs whitespace-nowrap"
                    :class="getMatchingVendorBadgeClass(matchingVendor)"
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                      :class="getVendorTimingDotClass(matchingVendor)"
                      aria-hidden="true"
                    ></span>
                    <span x-text="getVendorTimingText(matchingVendor)"></span>
                  </span>
                  <p class="text-[11px] text-nitkkr-gray truncate" x-text="matchingVendor.address"></p>
                </div>
              </div>
            </div>
            <a
              :href="`/v/${matchingVendor.slug}`"
              class="px-3.5 py-2 bg-gradient-to-r from-amber-500 to-nitkkr-orange hover:from-amber-600 hover:to-orange-700 text-white text-xs font-bold rounded-xl whitespace-nowrap shadow-xs hover:shadow-md transition-all flex items-center gap-1.5 active:scale-95"
            >
              <svg class="w-3.5 h-3.5 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              <span>View Full Menu</span>
            </a>
          </div>
        </template>

        <!-- 🍱 Mixed Dishes Stream (Unified across all vendors with vendor badges & pagination) -->
        <div class="space-y-2.5">
          <template x-for="item in visibleItems" :key="item.id">
            <div
              @click="openDetail(item)"
              class="bg-white rounded-2xl border border-slate-200/80 p-3 sm:p-3.5 flex items-center justify-between gap-3
                     hover:border-bistro-400 hover:shadow-md transition-all duration-200 cursor-pointer group select-none active:scale-[0.99]"
            >
              <!-- Left: Dish Thumbnail Image -->
              <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-100">
                <img
                  :src="getThumbnailUrl(item.image, 128)"
                  :alt="item.name"
                  width="64"
                  height="64"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Middle: Veg/Non-Veg icon + Dish Name + Vendor & Category & Rating -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 min-w-0">
                  <!-- Veg / Egg / Non-Veg Indicator -->
                  <span
                    class="w-3.5 h-3.5 rounded-xs border flex items-center justify-center flex-shrink-0"
                    :class="{
                      'border-emerald-600 bg-emerald-50': getItemDiet(item) === 'veg',
                      'border-amber-500 bg-amber-50': getItemDiet(item) === 'egg',
                      'border-rose-600 bg-rose-50': getItemDiet(item) === 'nonveg'
                    }"
                    :title="getItemDiet(item) === 'veg' ? 'Pure Veg' : (getItemDiet(item) === 'egg' ? 'Contains Egg' : 'Non-Veg')"
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full"
                      :class="{
                        'bg-emerald-600': getItemDiet(item) === 'veg',
                        'bg-amber-500': getItemDiet(item) === 'egg',
                        'bg-rose-600': getItemDiet(item) === 'nonveg'
                      }"
                    ></span>
                  </span>

                  <h3 class="font-bold text-sm sm:text-base text-slate-900 truncate group-hover:text-bistro-600 transition-colors" x-text="item.name"></h3>
                </div>

                <div class="flex items-center gap-1.5 mt-0.5 text-xs text-slate-400 truncate">
                  <span class="font-medium text-slate-700 truncate bg-slate-100 px-1.5 py-0.5 rounded-md" x-text="item.vendorName || 'Campus Food Spot'"></span>
                  <span class="text-slate-300">•</span>
                  <span class="truncate" x-text="item.categoryName || 'Campus Fast Food'"></span>
                  <template x-if="item.avgRating ? (item.reviewCount > 0) : false">
                    <span class="inline-flex items-center gap-0.5 text-amber-600 font-bold text-[11px] bg-amber-50 px-1.5 py-0.2 rounded-md border border-amber-200/60 ml-1">
                      <span>★</span>
                      <span x-text="item.avgRating"></span>
                      <span class="text-[10px] text-amber-700 opacity-80" x-text="'(' + item.reviewCount + ')'"></span>
                    </span>
                  </template>
                </div>
              </div>

              <!-- Right: Bold Price + Arrow Hint -->
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="text-bistro-600 font-extrabold text-base sm:text-lg whitespace-nowrap" x-text="'₹' + Number(item.price).toFixed(0)"></span>
                <span class="text-slate-300 group-hover:text-bistro-600 group-hover:translate-x-0.5 transition-all text-base font-bold">›</span>
              </div>
            </div>
          </template>

          <!-- Load More Pagination Button -->
          <template x-if="filteredItems.length > visibleItems.length">
            <div class="text-center pt-3 pb-2">
              <p class="text-[11px] font-semibold text-slate-400 mb-2" x-text="`Showing ${formatCount(visibleItems.length)} of ${formatCount(filteredItems.length)} dishes`"></p>
              <button
                type="button"
                @click="loadMore()"
                class="px-6 py-2.5 bg-white border border-slate-200 hover:border-nitkkr-orange hover:text-nitkkr-orange text-slate-800 font-bold text-xs rounded-2xl shadow-xs transition-all active:scale-95 cursor-pointer"
              >
                Load Next 20 Dishes ↓
              </button>
            </div>
          </template>
        </div>

        <!-- Empty State -->
        <div x-show="filteredItems.length === 0" class="text-center py-12 text-nitkkr-gray bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-8 space-y-3 shadow-2xs">
          <p class="text-3xl">🔍</p>
          <p class="text-base font-bold text-slate-900">No dishes found matching your filters</p>
          <p class="text-xs text-slate-500">Tap one of these popular campus cravings:</p>
          <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1 max-w-sm mx-auto">
            <button type="button" @click="resetAllFilters(); query = 'maggi';" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">🍜 Maggi</button>
            <button type="button" @click="resetAllFilters(); query = 'chai';" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">☕ Chai</button>
            <button type="button" @click="resetAllFilters(); query = 'chowmein';" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">🥢 Chowmein</button>
            <button type="button" @click="resetAllFilters(); query = 'paneer';" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">🧀 Paneer</button>
            <button type="button" @click="resetAllFilters(); query = 'shake';" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 border border-amber-200 rounded-full text-xs font-semibold cursor-pointer transition-all">🥤 Cold Shake</button>
          </div>
          <div>
            <button
              type="button"
              @click="resetAllFilters()"
              class="mt-2 px-4 py-1.5 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 text-xs font-bold rounded-xl transition-all cursor-pointer"
            >
              Reset All Filters
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- 🌟 Dish Detail Popup Modal in Search -->
    <div
      x-show="showDetailModal ? Boolean(selectedItem) : false"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs"
      @click.self="showDetailModal = false"
      @keydown.escape.window="showDetailModal = false"
    >
      <template x-if="selectedItem">
        <div
          x-transition:enter="transition ease-out duration-300 transform"
          x-transition:enter-start="scale-95 translate-y-4 opacity-0"
          x-transition:enter-end="scale-100 translate-y-0 opacity-100"
          class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl border border-amber-200/50 space-y-0 relative text-slate-900"
        >
          <!-- Modal Close Button -->
          <button
            @click="showDetailModal = false"
            class="absolute top-3.5 right-3.5 z-20 w-8 h-8 rounded-full bg-black/50 text-white flex items-center justify-center hover:bg-black/70 transition-colors backdrop-blur-xs cursor-pointer font-bold"
            aria-label="Close details"
          >
            ✕
          </button>

          <!-- Large Dish Image Cover -->
          <div class="relative w-full h-48 sm:h-56 bg-slate-100 overflow-hidden">
            <img
              :src="getThumbnailUrl(selectedItem.image, 600)"
              :alt="selectedItem.name"
              class="w-full h-full object-cover"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20"></div>

            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white">
              <span
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold shadow-md"
                :class="{
                  'bg-emerald-600 text-white': getItemDiet(selectedItem) === 'veg',
                  'bg-amber-500 text-white': getItemDiet(selectedItem) === 'egg',
                  'bg-rose-600 text-white': getItemDiet(selectedItem) === 'nonveg'
                }"
              >
                <span x-text="getItemDiet(selectedItem) === 'veg' ? '🌱 Pure Veg' : (getItemDiet(selectedItem) === 'egg' ? '🥚 Contains Egg' : '🍗 Non-Veg')"></span>
              </span>

              <span class="text-2xl font-black text-white drop-shadow-md" x-text="'₹' + Number(selectedItem.price).toFixed(0)"></span>
            </div>
          </div>

          <!-- Modal Body Content -->
          <div class="p-5 sm:p-6 space-y-4">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h2 class="font-display text-xl sm:text-2xl font-extrabold text-slate-900" x-text="selectedItem.name"></h2>
              </div>
              <p class="text-xs text-slate-400 mt-0.5" x-text="(selectedItem.vendorName || 'Food Cave') + ' · ' + (selectedItem.categoryName || 'Fast Food')"></p>
            </div>

            <!-- Description -->
            <div class="bg-amber-50/50 rounded-2xl p-3.5 border border-amber-200/50">
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed" x-text="selectedItem.description || 'Freshly prepared campus specialty made with authentic ingredients.'"></p>
            </div>

            <!-- Tags -->
            <template x-if="selectedItem.tags ? (selectedItem.tags.length > 0) : false">
              <div class="flex flex-wrap gap-1.5 items-center">
                <span class="text-[11px] font-bold text-slate-400 mr-1">Tags:</span>
                <template x-for="tag in selectedItem.tags" :key="tag">
                  <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg" x-text="'#' + tag"></span>
                </template>
              </div>
            </template>

            <!-- Reviews / Ratings & Action Row -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
              <div class="flex items-center gap-2">
                <span class="text-amber-500 text-lg">★</span>
                <div>
                  <p class="text-xs font-extrabold text-slate-900" x-text="selectedItem.avgRating ? selectedItem.avgRating + ' / 5.0' : 'No ratings yet'"></p>
                  <p class="text-[10px] text-slate-400" x-text="selectedItem.reviewCount > 0 ? selectedItem.reviewCount + (selectedItem.reviewCount === 1 ? ' student review' : ' student reviews') : 'Be the first to rate'"></p>
                </div>
              </div>

              <div class="flex items-center gap-1.5 ml-auto">
                <template x-if="selectedItem.reviewCount > 0">
                  <button
                    type="button"
                    @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'read' } }))"
                    class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                  >
                    <span>💬</span> Reviews (<span x-text="selectedItem.reviewCount"></span>)
                  </button>
                </template>

                <button
                  type="button"
                  @click="showDetailModal = false; window.dispatchEvent(new CustomEvent('open-review-modal', { detail: { id: selectedItem.id, name: selectedItem.name, mode: 'write' } }))"
                  class="px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                >
                  <span>⭐</span> Rate Dish
                </button>
              </div>
            </div>

            <!-- Secondary Actions: View Full Menu & Direct Call -->
            <div class="pt-2 flex items-center gap-2">
              <a
                :href="`/v/${selectedItem.vendorSlug || 'food-cave'}`"
                class="flex-1 py-2.5 bg-bistro-500 hover:bg-bistro-600 text-white font-bold text-xs rounded-xl shadow-sm text-center transition-all cursor-pointer whitespace-nowrap"
              >
                <span>View Full Vendor Menu ➔</span>
              </a>

              <template x-if="selectedItem.vendorPhone">
                <a
                  :href="getTelHref(selectedItem.vendorPhone)"
                  class="px-3.5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl text-center transition-all cursor-pointer flex items-center gap-1.5"
                >
                  <span>📞</span> Call
                </a>
              </template>
            </div>
          </div>

        </div>
      </template>
    </div>

    <!-- Reusable Review Modal for Search -->
    <ReviewModal menuItems={initialItems} />

  </section>
</Layout>