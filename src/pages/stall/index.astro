---
import Layout from '../../layouts/Layout.astro';
import { getCategories, getAllMenuItemsByVendor } from '../../lib/queries';

const sessionCookie = Astro.cookies.get('stall_session');
let member = null;
let vendor = null;
let menuItems = [];
let categories = [];

if (sessionCookie) {
  try {
    member = JSON.parse(decodeURIComponent(sessionCookie.value));
    if (member.vendorId) {
      vendor = { id: member.vendorId, name: 'Stall' };
      categories = await getCategories();
      menuItems = await getAllMenuItemsByVendor(member.vendorId);
    }
  } catch (e) {
    console.error('Session parse error:', e);
  }
}

if (!member) {
  return Astro.redirect('/stall-join');
}
---

<Layout title={`${vendor?.name || 'Stall'} Dashboard - NITKKR Food`} description="Manage your stall menu">
  <section class="min-h-screen bg-nitkkr-cream py-8 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <a href="/" class="text-xs text-nitkkr-gray hover:text-nitkkr-orange mb-1 inline-block">← Back to Campus Food</a>
          <h1 class="font-display text-2xl font-bold text-nitkkr-dark flex items-center gap-2">
            <span>🍽️</span> {vendor?.name || 'Stall'} Dashboard
          </h1>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold">Stall Member</span>
          <button @click="logout()" class="px-3 py-1.5 bg-nitkkr-cream hover:bg-nitkkr-orange/10 text-nitkkr-dark border border-nitkkr-orange/30 rounded-xl font-bold text-xs transition-colors cursor-pointer">
            Logout
          </button>
        </div>
      </div>

      <div
        x-data="stallDashboard()"
        x-init="menuItems = initialMenuItems; categories = initialCategories; vendorName = initialVendorName"
        :data-initial-menu-items="JSON.stringify(menuItems)"
        :data-initial-categories="JSON.stringify(categories)"
        :data-initial-vendor-name="vendor?.name || 'Stall'"
        class="space-y-6"
      >
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display font-bold text-lg text-nitkkr-dark" x-text="vendorName + ' - Menu Management'"></h2>
          <button
            @click="showMenuItemModal = true; resetMenuItemForm()"
            class="px-4 py-2 bg-nitkkr-orange hover:bg-nitkkr-orange-dark text-white font-bold text-xs rounded-xl transition-all shadow-sm flex items-center gap-1.5 cursor-pointer"
          >
            <span>➕</span> Add Menu Item
          </button>
        </div>

        <div x-show="menuLoading" class="card p-8 text-center text-nitkkr-gray">
          <p class="text-lg">Loading menu items...</p>
        </div>

        <template x-if="!menuLoading">
          <div class="space-y-3" x-show="menuItems.length > 0">
            <template x-for="item in menuItems" :key="item.id">
              <div class="card p-4 bg-white rounded-2xl border border-nitkkr-orange/20 shadow-sm flex flex-col sm:flex-row sm:items-center gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <h3 class="font-semibold text-nitkkr-dark" x-text="item.name"></h3>
                      <p class="text-xs text-nitkkr-gray mt-0.5" x-text="item.categoryName || 'Uncategorized'"></p>
                    </div>
                    <span class="text-nitkkr-orange font-bold text-lg whitespace-nowrap" x-text="'₹' + Number(item.price).toFixed(0)"></span>
                  </div>
                  <p class="text-xs text-nitkkr-gray mt-1 line-clamp-2" x-text="item.description || ''"></p>
                  <div class="flex items-center gap-2 mt-2">
                    <span class="px-2 py-0.5 text-[10px] font-bold rounded-full" :class="item.isVeg ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'" x-text="item.isVeg ? '🌱 Veg' : '🍗 Non-Veg'"></span>
                    <span class="px-2 py-0.5 bg-nitkkr-cream text-nitkkr-orange text-[10px] font-bold rounded-full" x-text="item.isAvailable ? 'Available' : 'Hidden'"></span>
                    <template x-for="tag in (item.tags || [])" :key="tag">
                      <span class="px-2 py-0.5 bg-gray-100 text-gray-700 text-[10px] rounded-full" x-text="tag"></span>
                    </template>
                  </div>
                </div>
                <div class="flex items-center gap-2 sm:ml-4">
                  <button
                    @click="editMenuItem(item)"
                    class="px-3 py-1.5 bg-nitkkr-cream hover:bg-nitkkr-orange/10 text-nitkkr-orange border border-nitkkr-orange/30 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                  >
                    Edit
                  </button>
                  <button
                    @click="deleteMenuItem(item.id)"
                    class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                  >
                    Delete
                  </button>
                  <button
                    @click="toggleAvailability(item)"
                    class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 border border-blue-200 rounded-lg font-bold text-xs transition-colors cursor-pointer"
                    x-text="item.isAvailable ? 'Hide' : 'Show'"
                  >
                  </button>
                </div>
              </div>
            </template>
          </div>

          <div x-show="menuItems.length === 0" class="card p-8 text-center text-nitkkr-gray">
            <p class="text-2xl mb-2">📭</p>
            <p class="font-medium">No menu items yet</p>
            <p class="text-xs mt-1">Click "Add Menu Item" to get started</p>
          </div>
        </template>

        <!-- Add/Edit Menu Item Modal -->
        <div
          x-show="showMenuItemModal"
          class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
          style="display: none;"
          @click.self="showMenuItemModal = false"
        >
          <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-nitkkr-orange/30">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display font-bold text-lg text-nitkkr-dark" x-text="editingMenuItem ? 'Edit Menu Item' : 'Add Menu Item'"></h3>
              <button @click="showMenuItemModal = false" class="text-nitkkr-gray hover:text-nitkkr-dark font-bold text-xl cursor-pointer">&times;</button>
            </div>

            <form @submit.prevent="saveMenuItem()" class="space-y-3">
              <div x-show="error" x-transition class="mb-3 p-3 bg-red-50 text-red-700 text-xs rounded-lg" x-text="error"></div>

              <input type="hidden" x-model="editingMenuItemId" />

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Item Name *</label>
                <input type="text" x-model="menuItemName" required placeholder="e.g. Steamed Paneer Momos" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Price (₹) *</label>
                <input type="number" step="0.5" min="0" x-model.number="menuItemPrice" required placeholder="e.g. 70" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
              </div>

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Category</label>
                <select x-model="menuItemCategoryId" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange">
                  <option value="">Select Category</option>
                  <template x-for="cat in categories" :key="cat.id">
                    <option :value="String(cat.id)" x-text="cat.icon + ' ' + cat.name"></option>
                  </template>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Description</label>
                <textarea x-model="menuItemDescription" rows="2" placeholder="e.g. 8 pcs with spicy red chutney" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange resize-none"></textarea>
              </div>

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Image URL</label>
                <input type="url" x-model="menuItemImage" placeholder="https://example.com/image.jpg" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="flex items-center gap-2">
                  <input type="checkbox" x-model="menuItemIsVeg" id="menuItemIsVeg" class="w-4 h-4 text-nitkkr-orange border-nitkkr-orange/30 rounded focus:ring-nitkkr-orange" />
                  <label for="menuItemIsVeg" class="text-xs font-medium text-nitkkr-dark cursor-pointer">🌱 Vegetarian</label>
                </div>
                <div class="flex items-center gap-2">
                  <input type="checkbox" x-model="menuItemIsAvailable" id="menuItemIsAvailable" class="w-4 h-4 text-nitkkr-orange border-nitkkr-orange/30 rounded focus:ring-nitkkr-orange" />
                  <label for="menuItemIsAvailable" class="text-xs font-medium text-nitkkr-dark cursor-pointer">Available</label>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-nitkkr-dark mb-1">Tags (comma separated)</label>
                <input type="text" x-model="menuItemTags" placeholder="bestseller, spicy, snack" class="w-full px-3 py-2 bg-nitkkr-cream border border-nitkkr-orange/20 rounded-xl text-xs outline-none focus:border-nitkkr-orange" />
              </div>

              <div class="pt-3 flex gap-2">
                <button type="button" @click="showMenuItemModal = false" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-cream text-nitkkr-dark rounded-xl text-xs font-bold hover:bg-gray-200 cursor-pointer disabled:opacity-50">Cancel</button>
                <button type="submit" :disabled="loading" class="flex-1 py-2.5 bg-nitkkr-orange text-white rounded-xl text-xs font-bold hover:bg-nitkkr-orange-dark shadow-sm cursor-pointer disabled:opacity-50">
                  <span x-show="!loading" x-text="editingMenuItem ? 'Update Item' : 'Add Item'"></span>
                  <span x-show="loading">Saving...</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <script is:inline>
        function stallDashboard() {
          return {
            vendorId: 0,
            vendorName: '',
            menuLoading: false,
            menuItems: [],
            categories: [],
            showMenuItemModal: false,
            editingMenuItem: false,
            editingMenuItemId: null,
            menuItemName: '',
            menuItemPrice: '',
            menuItemCategoryId: '',
            menuItemDescription: '',
            menuItemImage: '',
            menuItemIsVeg: true,
            menuItemIsAvailable: true,
            menuItemTags: '',
            loading: false,
            error: null,

            async init() {},

            resetMenuItemForm() {
              this.editingMenuItem = false;
              this.editingMenuItemId = null;
              this.menuItemName = '';
              this.menuItemPrice = '';
              this.menuItemCategoryId = '';
              this.menuItemDescription = '';
              this.menuItemImage = '';
              this.menuItemIsVeg = true;
              this.menuItemIsAvailable = true;
              this.menuItemTags = '';
            },

            editMenuItem(item) {
              this.editingMenuItem = true;
              this.editingMenuItemId = item.id;
              this.menuItemName = item.name;
              this.menuItemPrice = item.price;
              this.menuItemCategoryId = item.categoryId ? String(item.categoryId) : '';
              this.menuItemDescription = item.description || '';
              this.menuItemImage = item.image || '';
              this.menuItemIsVeg = item.isVeg;
              this.menuItemIsAvailable = item.isAvailable;
              this.menuItemTags = (item.tags || []).join(', ');
              this.showMenuItemModal = true;
            },

            async saveMenuItem() {
              if (!this.menuItemName.trim() || this.menuItemPrice === '') {
                this.error = 'Name and price are required';
                return;
              }
              this.loading = true;
              this.error = null;
              try {
                const payload = {
                  vendorId: this.vendorId,
                  categoryId: this.menuItemCategoryId || null,
                  name: this.menuItemName.trim(),
                  description: this.menuItemDescription.trim() || null,
                  price: parseFloat(this.menuItemPrice),
                  image: this.menuItemImage.trim() || null,
                  isVeg: this.menuItemIsVeg,
                  isAvailable: this.menuItemIsAvailable,
                  tags: this.menuItemTags.split(',').map(t => t.trim()).filter(t => t),
                };

                let res, data;
                if (this.editingMenuItem) {
                  res = await fetch(`/api/admin/menu/${this.editingMenuItemId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                  });
                } else {
                  res = await fetch('/api/admin/menu', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                  });
                }
                data = await res.json();
                if (res.ok && data.success) {
                  await this.loadMenuItems();
                  this.showMenuItemModal = false;
                  this.resetMenuItemForm();
                  alert('🎉 Menu item ' + (this.editingMenuItem ? 'updated' : 'added') + ' successfully!');
                  this.loading = false;
                  return;
                } else {
                  this.error = data.error || 'Failed to save menu item';
                }
              } catch (err) {
                console.error('Save menu item error:', err);
                this.error = 'Network error - please try again';
              }
              this.loading = false;
            },

            async deleteMenuItem(id) {
              if (!confirm('Delete this menu item?')) return;
              try {
                const res = await fetch(`/api/admin/menu/${id}`, {
                  method: 'DELETE'
                });
                if (res.ok) {
                  await this.loadMenuItems();
                  alert('Menu item deleted');
                }
              } catch (e) {
                console.error('Delete menu item error:', e);
                alert('Failed to delete menu item');
              }
            },

            async toggleAvailability(item) {
              try {
                const res = await fetch(`/api/admin/menu/${item.id}`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ isAvailable: !item.isAvailable })
                });
                if (res.ok) {
                  await this.loadMenuItems();
                }
              } catch (e) {
                console.error('Toggle availability error:', e);
                alert('Failed to update availability');
              }
            },

            async loadMenuItems() {
              this.menuLoading = true;
              try {
                const res = await fetch(`/api/admin/menu?vendorId=${this.vendorId}`);
                if (res.ok) {
                  const data = await res.json();
                  this.menuItems = data.items || [];
                }
              } catch (e) {
                console.error('Failed to load menu items:', e);
              } finally {
                this.menuLoading = false;
              }
            },

            logout() {
              document.cookie = 'stall_session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; Secure; SameSite=Lax';
              window.location.href = '/stall-join';
            }
          };
        }
      </script>
    </div>
  </section>
</Layout>