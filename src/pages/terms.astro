---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const brandName = settingsObj.site_title || settingsObj.brand_name || 'Orandus';
const customTerms = settingsObj.terms_custom_text || '';
---

<Layout title={`Terms of Service - ${brandName}`} description={`Terms and conditions for using ${brandName}.`}>
  <section class="min-h-screen bg-nitkkr-cream/60 py-10 sm:py-14 px-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-6 sm:p-10 border border-amber-200/80 shadow-xs space-y-6">
      
      <div class="border-b border-slate-100 pb-4">
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark tracking-tight">📜 Terms of Service</h1>
        <p class="text-xs text-slate-500 mt-1">Last updated: September 2026</p>
      </div>

      {customTerms ? (
        <div class="p-4 bg-amber-50/80 rounded-2xl border border-amber-200 text-xs sm:text-sm text-slate-800 leading-relaxed whitespace-pre-line">
          {customTerms}
        </div>
      ) : null}

      <div class="space-y-5 text-xs sm:text-sm text-slate-700 leading-relaxed">
        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">1. Nature of the Platform</h2>
          <p>{brandName} is an independent food discovery directory for campus eateries, cafes, and local food vendors. We provide convenient access to menus, prices, dish information, operating hours, and direct contact details.</p>
          <p class="mt-2">{brandName} is <strong>not</strong> a restaurant, kitchen, delivery service, or financial intermediary. We do not prepare food, handle delivery logistics, or collect customer payments. {brandName} charges zero commissions on transactions between users and vendors.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">2. Direct Vendor Interactions</h2>
          <p>When you contact a food spot — whether via phone call, WhatsApp, or in person at the counter — you are interacting directly and exclusively with that independent vendor.</p>
          <p class="mt-2">Order placement, item availability, fulfillment time, pricing confirmation, food hygiene, delivery arrangements, cancellations, and refunds remain entirely between you and the respective vendor. {brandName} is not a party to your transaction.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">3. Menu Information & Pricing</h2>
          <p>We work diligently to ensure menu listings, prices, operating hours, and dietary tags are accurate and up to date. However, vendors may modify their pricing, recipes, or item availability without immediate notice.</p>
          <p class="mt-2">We encourage customers to confirm specific prices and item availability directly with the vendor when placing an inquiry or order.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">4. Community Feedback & Conduct</h2>
          <p>User reviews help the campus community discover great dining spots. Reviews must remain honest, constructive, and respectful. Defamatory, abusive, fraudulent, or promotional spam content will be promptly removed.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">5. External Links</h2>
          <p>{brandName} provides direct links to third-party services, including WhatsApp, Google Maps, and phone dialers, purely for user convenience. When you navigate to an external service, their respective terms and privacy policies apply.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">6. Service Availability</h2>
          <p>{brandName} is provided on an "as-is" and "as-available" basis. While we strive for continuous reliability, we do not warrant that service will be uninterrupted or error-free at all times.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">7. Policy Updates</h2>
          <p>We may periodically update these terms to reflect platform enhancements or operational changes. Continued use of {brandName} signifies acceptance of the updated terms.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">8. Contact Us</h2>
          <p>If you have any questions or feedback regarding these terms, please reach out via our <a href="/contact" class="text-nitkkr-orange font-bold hover:underline">Contact & Support page</a>.</p>
        </div>
      </div>

    </div>
  </section>
</Layout>