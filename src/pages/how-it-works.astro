---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const brandName = settingsObj.site_title || settingsObj.brand_name || 'Orandus';

const isWhatsAppEnabled = settingsObj.whatsapp_ordering_enabled === 'true' && settingsObj.show_whatsapp_button !== 'false';
const step3Title = settingsObj.how_it_works_step3_title || (isWhatsAppEnabled ? '3. 1-Tap WhatsApp Order' : '3. Call or Visit');
const step3Desc = settingsObj.how_it_works_step3_desc || (isWhatsAppEnabled 
  ? 'Tap "Order on WhatsApp" to send a pre-filled item list directly to the food spot.' 
  : 'Call the food spot to verify availability, or walk up to their counter with dishes and prices in mind.');
const step3Icon = isWhatsAppEnabled ? '💬' : '📞';
---

<Layout title={`How It Works - ${brandName}`} description={`Discover how easy it is to find campus food spots, browse verified menus, check live hours, and connect with vendors.`}>
  <section class="min-h-screen bg-nitkkr-cream/60 py-10 sm:py-14 px-4">
    <div class="max-w-3xl mx-auto space-y-8">
      
      <div class="text-center space-y-2">
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-nitkkr-dark tracking-tight">📖 How It Works</h1>
        <p class="text-sm text-slate-600 max-w-md mx-auto">Discover food spots, check verified menus, and connect directly with campus eateries.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs text-center space-y-3">
          <span class="text-4xl block" aria-hidden="true">🔍</span>
          <h3 class="font-display font-bold text-base text-slate-900">1. Search & Filter</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Search specific dishes (momos, parathas, shakes) or filter by <strong>High Protein 🏋️‍♂️</strong>, <strong>Late Night 🌙</strong>, or <strong>Budget 💰</strong>.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs text-center space-y-3">
          <span class="text-4xl block" aria-hidden="true">⭐</span>
          <h3 class="font-display font-bold text-base text-slate-900">2. Check Menus & Prices</h3>
          <p class="text-sm text-slate-600 leading-relaxed">View transparent prices, vegetarian and non-veg tags, live operating hours, and authentic community ratings.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-amber-200/80 shadow-xs text-center space-y-3">
          <span class="text-4xl block" aria-hidden="true">{step3Icon}</span>
          <h3 class="font-display font-bold text-base text-slate-900">{step3Title}</h3>
          <p class="text-sm text-slate-600 leading-relaxed">{step3Desc}</p>
        </div>
      </div>

      <div class="bg-gradient-to-r from-amber-500 to-nitkkr-orange rounded-3xl p-6 sm:p-8 text-white text-center space-y-4 shadow-md">
        <h3 class="font-display text-xl sm:text-2xl font-bold">Run a Food Spot?</h3>
        <p class="text-sm text-white/90 max-w-lg mx-auto">Get your spot and dishes in front of thousands of hungry students daily. Free listing, zero commissions.</p>
        <a href="/contact" class="inline-block px-6 py-3 bg-white text-nitkkr-orange font-bold text-sm rounded-xl hover:bg-amber-50 active:scale-95 transition-all shadow-sm">
          List Your Food Spot
        </a>
      </div>

    </div>
  </section>
</Layout>