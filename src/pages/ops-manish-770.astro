---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
---

<Layout title="NITKKR Food - Founder Access">
  <section class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-12 text-slate-100">
    <div class="max-w-md w-full">
      <div class="bg-slate-900/90 backdrop-blur-md rounded-3xl border border-slate-800 shadow-2xl p-8 space-y-6">
        <div class="text-center space-y-2">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl flex items-center justify-center text-2xl mx-auto shadow-lg shadow-orange-500/20">
            🔐
          </div>
          <h1 class="font-display text-2xl font-bold text-white tracking-wide">NITKKR Food Ops</h1>
          <p class="text-slate-400 text-xs">Private Founder Operations & Stall Management</p>
        </div>

        <form
          x-data="{
            username: 'manishchauhan',
            password: '',
            pin: '',
            loading: false,
            error: '',
            async submitLogin() {
              if (!this.username.trim() || !this.password) {
                this.error = 'Username and password are required';
                return;
              }
              this.loading = true;
              this.error = '';
              try {
                const res = await fetch('/api/admin/auth', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    username: this.username.trim(),
                    password: this.password,
                    pin: this.pin.trim()
                  })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                  window.location.href = '/admin';
                } else {
                  this.error = data.error || 'Access Denied: Invalid credentials';
                }
              } catch (err) {
                this.error = 'Network error. Please try again.';
              } finally {
                this.loading = false;
              }
            }
          }"
          @submit.prevent="submitLogin()"
          class="space-y-4 pt-2"
        >
          <div x-show="error" x-cloak class="p-3.5 bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs rounded-xl font-medium" x-text="error"></div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Admin Username</label>
            <input
              type="text"
              x-model="username"
              required
              placeholder="manishchauhan"
              class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Admin Password</label>
            <input
              type="password"
              x-model="password"
              required
              placeholder="Enter your password"
              class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Security PIN (If set in Cloudflare)</label>
            <input
              type="password"
              x-model="pin"
              maxlength="8"
              placeholder="e.g. 770990"
              class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-white placeholder-slate-500 outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 transition-all font-mono tracking-widest"
            />
          </div>

          <button
            type="submit"
            :disabled="loading"
            class="w-full py-3.5 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-orange-500/20 active:scale-98 disabled:opacity-50 flex items-center justify-center gap-2 cursor-pointer mt-4"
          >
            <span x-show="loading" class="flex items-center gap-2">
              <svg class="animate-spin h-4 w-4 text-white" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
              Verifying...
            </span>
            <span x-show="!loading">Unlock Control Center →</span>
          </button>
        </form>

        <div class="text-center pt-2">
          <a href="/" class="text-xs text-slate-500 hover:text-slate-300 transition-colors">← Back to Public Website</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
