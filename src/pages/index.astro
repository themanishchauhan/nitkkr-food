---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import FilterChips from '../components/FilterChips.astro';
import VendorCard from '../components/VendorCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getActiveVendors, getCategories, isVendorOpenNow, getAllMinPricesByVendor, getAllSiteSettings } from '../lib/queries';

const vendors = await getActiveVendors();
const categories = await getCategories();
const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);

const heroTitle = settingsObj.homepage_title || 'Hungry? We got you. 🍜';
const heroTagline = settingsObj.homepage_tagline || 'Explore campus eateries & food vendors around NIT Kurukshetra';
const bannerEnabled = settingsObj.announcement_banner_enabled === 'true';
const bannerText = settingsObj.announcement_banner_text || '';
const bannerType = settingsObj.announcement_banner_type || 'info';

const adEnabled = settingsObj.ad_banner_enabled === 'true';
const adBadge = settingsObj.ad_banner_badge || '⚡ SPONSORED DEAL';
const adTitle = settingsObj.ad_banner_title || 'Kurukshetra Protein & Shake Hub';
const adDesc = settingsObj.ad_banner_description || '15% Flat Student Discount on all Whey Shakes & Healthy Bowls! Show NIT ID.';
const adImage = settingsObj.ad_banner_image || '';
const adCta = settingsObj.ad_banner_cta || 'Claim Offer 💬';
const adLink = settingsObj.ad_banner_link || '#';

const minPrices = await getAllMinPricesByVendor();
const vendorsWithStatus = (vendors || []).map((v: any) => ({
  ...v,
  isOpen: isVendorOpenNow(v.opensAt, v.closesAt),
  minPrice: minPrices[v.id] ?? null,
}));

let vibeChips: any[] | undefined = undefined;
if (settingsObj.vibe_chips_json) {
  try {
    vibeChips = JSON.parse(settingsObj.vibe_chips_json);
  } catch (e) {}
}

---

<Layout title="NITKKR Food - Find Food Around Campus Instantly" description="Explore food vendors around NIT Kurukshetra. View menus, dishes, prices, and call directly.">

  <section class="min-h-screen bg-gradient-to-b from-nitkkr-cream via-amber-50/20 to-white pb-16">
    <div class="max-w-2xl mx-auto px-4 py-5 sm:py-8 space-y-4 sm:space-y-6">
      
      <!-- Live Campus Announcement Banner (if enabled) -->
      {bannerEnabled && bannerText && (
        <div class={`p-3.5 rounded-2xl border text-xs sm:text-sm font-semibold flex items-center gap-2.5 shadow-sm ${
          bannerType === 'offer' ? 'bg-amber-50 border-amber-300 text-amber-900' :
          bannerType === 'warning' ? 'bg-yellow-50 border-yellow-300 text-yellow-900' :
          bannerType === 'danger' ? 'bg-rose-50 border-rose-300 text-rose-900' :
          'bg-blue-50 border-blue-300 text-blue-900'
        }`}>
          <span class="text-base flex-shrink-0">
            {bannerType === 'offer' ? '🎉' : bannerType === 'warning' ? '⚠️' : bannerType === 'danger' ? '🚨' : '📢'}
          </span>
          <p class="min-w-0 flex-1 leading-snug">{bannerText}</p>
        </div>
      )}

      <!-- Clean Hero Section -->
      <div class="text-center space-y-1.5 pt-2">
        <h1 class="font-display text-3xl sm:text-5xl font-black text-nitkkr-dark tracking-tight">
          {heroTitle}
        </h1>
        <p class="text-nitkkr-gray text-xs sm:text-base font-medium max-w-md mx-auto">
          {heroTagline}
        </p>
      </div>

      <!-- Search Input -->
      <div>
        <SearchBar placeholder="What are you craving? chowmein, paratha, cold coffee, roll..." />
      </div>

      <!-- Student Cravings & Vibes Filter Chips -->
      <div>
        <FilterChips chips={vibeChips} />
      </div>

      <!-- Browse by Category Section -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-display text-lg sm:text-xl font-bold flex items-center gap-2 text-nitkkr-dark">
            <span class="text-bistro-500" aria-hidden="true">🍽️</span>
            Browse by Category
          </h2>
          <span class="text-xs font-semibold text-slate-400">{categories.length} categories</span>
        </div>
        <div class="grid grid-cols-4 gap-2 sm:gap-3">
          {categories.map((cat: any) => (
            <CategoryCard category={cat} />
          ))}
        </div>
      </div>

      <!-- In-Feed Campus Ad / Sponsor Section (if enabled) -->
      {adEnabled && (
        <AdBanner
          badge={adBadge}
          title={adTitle}
          description={adDesc}
          image={adImage}
          cta={adCta}
          link={adLink}
        />
      )}

      <!-- Campus Vendors Section -->
      <div>
        <div class="flex items-center justify-between mb-3.5">
          <h2 class="font-display text-lg sm:text-xl font-bold flex items-center gap-2 text-nitkkr-dark">
            <span>🏪</span>
            Campus Vendors & Eateries
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          </h2>
          <span class="text-xs font-bold text-bistro-600 bg-bistro-100 px-2.5 py-0.5 rounded-full border border-bistro-200">
            {vendorsWithStatus.length} Active
          </span>
        </div>

        <div class="space-y-3">
          {vendorsWithStatus.map(v => (
            <VendorCard vendor={v} isOpen={v.isOpen} />
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>