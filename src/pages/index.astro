---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';
import FilterChips from '../components/FilterChips.astro';
import AnnouncementCarousel from '../components/AnnouncementCarousel.astro';
import VendorCard from '../components/VendorCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import AdBanner from '../components/AdBanner.astro';
import { getActiveVendors, getCategories, isVendorOpenNow, getAllMinPricesByVendor, getAllSiteSettings } from '../lib/queries';

const vendors = await getActiveVendors();
const categories = await getCategories();
const displayCategories = (categories || [])
  .filter((c: any) => c.slug && c.name && c.slug !== 'pizza')
  .slice(0, 6);

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);

const rawTitle = settingsObj.homepage_title;
const heroTitle = (!rawTitle || rawTitle.includes('Hungry? We got you') || rawTitle === 'Find Food. See the Menu.')
  ? 'Stop Asking “Bhai, Menu Bhej.”'
  : rawTitle;

const rawTagline = settingsObj.homepage_tagline;
const heroTagline = (!rawTagline || rawTagline.includes('Explore campus') || rawTagline.includes('Search 20+') || rawTagline.includes('Discover campus food spots'))
  ? 'Find campus food, menus and prices in seconds.'
  : rawTagline;
const bannerEnabled = settingsObj.announcement_banner_enabled === 'true';
const bannerText = settingsObj.announcement_banner_text || '';
const bannerType = settingsObj.announcement_banner_type || 'info';

const carouselEnabled = settingsObj.announcement_carousel_enabled !== 'false';
let announcementSlides: any[] | undefined = undefined;
if (settingsObj.announcement_carousel_json) {
  try {
    const parsed = JSON.parse(settingsObj.announcement_carousel_json);
    if (Array.isArray(parsed) && parsed.length > 0) {
      announcementSlides = parsed;
    }
  } catch (e) {}
}

const adEnabled = settingsObj.ad_banner_enabled === 'true';
const adBadge = settingsObj.ad_banner_badge || '⚡ SPONSORED DEAL';
const adTitle = settingsObj.ad_banner_title || 'Kurukshetra Protein & Shake Hub';
const adDesc = settingsObj.ad_banner_description || '15% Flat Student Discount on all Whey Shakes & Healthy Bowls! Show NIT ID.';
const adImage = settingsObj.ad_banner_image || '';
const adCta = settingsObj.ad_banner_cta || 'Claim Offer 💬';
const adLink = settingsObj.ad_banner_link || '#';

function shuffleArray<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const minPrices = await getAllMinPricesByVendor();
const rawVendorsWithStatus = (vendors || []).map((v: any) => ({
  ...v,
  isOpen: isVendorOpenNow(v.opensAt, v.closesAt),
  minPrice: minPrices[v.id] ?? null,
}));

// Fair multi-vendor rotation: open stalls randomized first, followed by closed stalls randomized
const openVendors = shuffleArray(rawVendorsWithStatus.filter((v: any) => v.isOpen));
const closedVendors = shuffleArray(rawVendorsWithStatus.filter((v: any) => !v.isOpen));
const vendorsWithStatus = [...openVendors, ...closedVendors];

let vibeChips: any[] | undefined = undefined;
if (settingsObj.vibe_chips_json) {
  try {
    vibeChips = JSON.parse(settingsObj.vibe_chips_json);
  } catch (e) {}
}
---

<Layout title="Orandus - Food Spots & Menus" description="Find campus food, menus and prices in seconds.">

  <section class="min-h-screen bg-gradient-to-b from-nitkkr-cream via-amber-50/20 to-white pb-20">
    <div class="max-w-2xl mx-auto px-4 py-8 sm:py-12 space-y-6 sm:space-y-7">
      
      <!-- Live Campus Announcement Banner (if enabled) -->
      {bannerEnabled && bannerText && (
        <div class={`p-3.5 rounded-2xl border text-xs sm:text-sm font-semibold flex items-center gap-2.5 shadow-sm ${
          bannerType === 'offer' ? 'bg-amber-50 border-amber-300 text-amber-900' :
          bannerType === 'warning' ? 'bg-yellow-50 border-yellow-300 text-yellow-900' :
          bannerType === 'danger' ? 'bg-rose-50 border-rose-300 text-rose-900' :
          'bg-blue-50 border-blue-300 text-blue-900'
        }`}>
          <span class="text-base flex-shrink-0">
            {bannerType === 'offer' ? '🎉' : bannerType === 'warning' ? '⚠️' : bannerType === 'danger' ? '🚨' : '📢'}
          </span>
          <p class="min-w-0 flex-1 leading-snug">{bannerText}</p>
        </div>
      )}

      <!-- Clean Hero Section with Generous Breathing Room -->
      <div class="text-center space-y-2.5 pt-2 sm:pt-4">
        <h1 class="font-display text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
          {heroTitle}
        </h1>
        <p class="text-slate-500 text-xs sm:text-base font-medium max-w-lg mx-auto leading-relaxed">
          {heroTagline}
        </p>
      </div>

      <!-- Search Input & Quick Vibe Filters Card -->
      <div class="space-y-2.5">
        <SearchBar placeholder="What are you craving? chowmein, paratha, cold coffee, roll..." />
        <FilterChips chips={vibeChips} />
      </div>

      <!-- 🎁 Dynamic Campus Offers & Announcements Carousel (Backend Managed with Smooth Transitions) -->
      {carouselEnabled && (
        <div>
          <AnnouncementCarousel slides={announcementSlides} />
        </div>
      )}

      <!-- Browse by Category Section (Top Compact Categories) -->
      <div>
        <div class="flex items-center justify-between mb-2.5 px-0.5">
          <h2 class="font-display text-sm sm:text-base font-bold flex items-center gap-1.5 text-slate-900">
            <span class="text-nitkkr-orange" aria-hidden="true">🍽️</span>
            Popular Categories
          </h2>
          <a href="/search" class="text-xs font-bold text-nitkkr-orange hover:underline">
            View All ({categories.length}) →
          </a>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
          {displayCategories.map((cat: any) => (
            <CategoryCard category={cat} />
          ))}
        </div>
      </div>

      <!-- In-Feed Campus Ad / Sponsor Section (if enabled) -->
      {adEnabled && (
        <AdBanner
          badge={adBadge}
          title={adTitle}
          description={adDesc}
          image={adImage}
          cta={adCta}
          link={adLink}
        />
      )}

      <!-- Campus Vendors Section -->
      <div>
        <div class="flex items-center justify-between mb-3.5 px-0.5">
          <h2 class="font-display text-base sm:text-lg font-bold flex items-center gap-2 text-slate-900">
            <span>🏪</span>
            Food Spots
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          </h2>
          <span class="text-xs font-bold text-nitkkr-orange bg-orange-50 px-2.5 py-0.5 rounded-full border border-orange-200">
            {vendorsWithStatus.length} Active
          </span>
        </div>

        <div class="space-y-3">
          {vendorsWithStatus.map((v: any) => (
            <VendorCard vendor={v} isOpen={v.isOpen} />
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>