---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { getAllSiteSettings } from '../lib/queries';

const settings = await getAllSiteSettings();
const settingsList = Array.isArray(settings) ? settings : [];
const settingsObj = settingsList.reduce((acc: any, s: any) => { if (s && s.key) acc[s.key] = s.value; return acc; }, {} as Record<string, string>);
const brandName = settingsObj.site_title || settingsObj.brand_name || 'Orandus';
const customPrivacy = settingsObj.privacy_custom_text || '';
---

<Layout title={`Privacy Policy - ${brandName}`} description={`Privacy policy and data handling practices for ${brandName}.`}>
  <section class="min-h-screen bg-nitkkr-cream/60 py-10 sm:py-14 px-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-6 sm:p-10 border border-amber-200/80 shadow-xs space-y-6">
      
      <div class="border-b border-slate-100 pb-4">
        <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-nitkkr-dark tracking-tight">🔒 Privacy Policy</h1>
        <p class="text-xs text-slate-500 mt-1">Last updated: September 2026</p>
      </div>

      {customPrivacy ? (
        <div class="p-4 bg-amber-50/80 rounded-2xl border border-amber-200 text-xs sm:text-sm text-slate-800 leading-relaxed whitespace-pre-line">
          {customPrivacy}
        </div>
      ) : null}

      <div class="space-y-5 text-xs sm:text-sm text-slate-700 leading-relaxed">
        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">1. Scope of the Service</h2>
          <p>{brandName} is a local food discovery platform designed to help you browse menus, discover nearby eateries, check live operating hours, and connect directly with food spots.</p>
          <p class="mt-2">We are not a delivery service or payment gateway. We do not process transactions, handle financial details, or charge markups on meals.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">2. Information Collection</h2>
          <p>You can freely browse menus and search food spots without creating an account. We do not require registration, passwords, or personal profiles.</p>
          <p class="mt-2">The only data stored includes:</p>
          <ul class="list-disc list-inside mt-2 space-y-1 ml-2 text-slate-600">
            <li>Filter preferences (saved locally on your device to keep your favorite dietary or price filters active)</li>
            <li>Dismissal status of the app installation prompt</li>
            <li>Voluntary review information (display name, rating, and comment if you choose to review a food spot)</li>
          </ul>
          <p class="mt-2">We do not collect personal phone numbers, payment information, or precise background GPS tracking.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">3. Public Reviews & Ratings</h2>
          <p>Feedback submitted via the review form is public and visible to other users. Please do not share personal phone numbers, sensitive information, or private data in review submissions.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">4. Review Deletion Requests</h2>
          <p>If you need a previously submitted review edited or removed, simply contact us via our <a href="/contact" class="text-nitkkr-orange font-bold hover:underline">Contact & Support page</a>, and we will assist you promptly.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">5. Device-Only Local Storage</h2>
          <p>Client preferences are stored strictly within your web browser's local storage. This data never leaves your device and can be cleared at any time via your browser settings.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">6. External Services & Communications</h2>
          <p>When tapping a WhatsApp or phone link, communication takes place directly on those respective platforms. We do not have access to your private messages, conversations, or call logs.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">7. Privacy-First Analytics</h2>
          <p>We utilize lightweight, cookie-less server metrics to measure page views, popular search keywords, and technical error rates. We do not use third-party cross-site trackers or invasive ad pixels.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">8. Data Selling Prohibition</h2>
          <p>We do not sell, rent, or trade user information to advertisers or data brokers under any circumstances.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">9. Vendor Corrections</h2>
          <p>If you own or manage a food outlet listed on {brandName} and wish to update prices, photos, timings, or contact numbers, reach out through our <a href="/contact" class="text-nitkkr-orange font-bold hover:underline">Contact page</a>.</p>
        </div>

        <div>
          <h2 class="font-bold text-base text-slate-900 mb-1">10. Contact Us</h2>
          <p>For questions or privacy inquiries, please visit our <a href="/contact" class="text-nitkkr-orange font-bold hover:underline">Contact & Support page</a>.</p>
        </div>
      </div>

    </div>
  </section>
</Layout>