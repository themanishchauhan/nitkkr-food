{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nitkkr-food",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2024-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}